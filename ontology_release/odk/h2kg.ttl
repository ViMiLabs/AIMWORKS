###  https://w3id.org/h2kg/hydrogen-ontology#SuspensionIntrinsicViscosityCoefficient
h2kg:SuspensionIntrinsicViscosityCoefficient rdf:type owl:Class ;
                                             rdfs:subClassOf h2kg:RheologicalCharacteristic ;
                                             dcterms:description "A dimensionless coefficient in a suspension-viscosity model that quantifies the first-order contribution of dispersed-particle volume fraction to relative viscosity."@en ;
                                             dcterms:provenance "Added as curated H2KG v2 taxonomy scaffolding through the versioned taxonomy registry."@en ;
                                             rdfs:label "Suspension intrinsic-viscosity coefficient"@en ;
                                             skos:definition "A dimensionless coefficient in a suspension-viscosity model that quantifies the first-order contribution of dispersed-particle volume fraction to relative viscosity."@en ;
                                             skos:prefLabel "Suspension intrinsic-viscosity coefficient"@en ;
                                             skos:scopeNote "Use for the intrinsic-viscosity coefficient in Krieger-Dougherty-type suspension models, not for polymer-solution intrinsic viscosity."@en ;
                                             h2kg:canonicalSemanticRole "Characteristic" ;
                                             h2kg:correctionAction "apply" ;
                                             h2kg:definitionStatus "curated" ;
                                             h2kg:governanceStatus "approved" ;
                                             h2kg:migrationAction "apply" ;
                                             h2kg:taxonomyModule "core" ;
                                             h2kg:taxonomyTopBranch "Characteristic" .


