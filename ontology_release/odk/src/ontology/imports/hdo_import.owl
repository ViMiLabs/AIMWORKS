AnnotationAssertion(rdfs:label <https://purls.helmholtz-metadaten.de/hob/HDO_00000013> "digital object"@en)
AnnotationAssertion(rdfs:label <https://purls.helmholtz-metadaten.de/hob/HDO_00000013> "digitales Objekt"@de)
SubClassOf(<https://purls.helmholtz-metadaten.de/hob/HDO_00000013> <https://purls.helmholtz-metadaten.de/hob/HDO_00000005>)

