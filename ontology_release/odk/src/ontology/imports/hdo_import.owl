AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://purls.helmholtz-metadaten.de/hob/HDO_00007004> "A generically dependent continuant which realizes a signifier role."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://purls.helmholtz-metadaten.de/hob/HDO_00007004> "Ein generisch abhängiges Kontinuum, das eine Signifier-Rolle umsetzt."@de)
AnnotationAssertion(rdfs:label <https://purls.helmholtz-metadaten.de/hob/HDO_00007004> "Zeichen"@de)
AnnotationAssertion(rdfs:label <https://purls.helmholtz-metadaten.de/hob/HDO_00007004> "signifier"@en)
EquivalentClasses(<https://purls.helmholtz-metadaten.de/hob/HDO_00007004> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/BFO_0000031> ObjectSomeValuesFrom(<https://purls.helmholtz-metadaten.de/hob/HDO_00006036> <https://purls.helmholtz-metadaten.de/hob/HDO_00007003>)))
SubClassOf(<https://purls.helmholtz-metadaten.de/hob/HDO_00007004> <http://purl.obolibrary.org/obo/BFO_0000031>)
