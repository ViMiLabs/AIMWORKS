                            rdfs:subClassOf h2kg:WorkflowProfile ;
                            dcterms:description "Captures explicitly stated recipe/process parameters from the Methods section (not measured; specified)."@en ;
                            dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
                            rdfs:label "Procedure Specification"@en ;
                            skos:altLabel "curing procedure"@en ,
                                          "experimental procedure"@en ,
                                          "specified"@en ;
                            skos:definition "A workflow profile that specifies the expected scientific content or conditions identified as Procedure Specification."@en ;
                            skos:prefLabel "Procedure Specification"@en ;
                            h2kg:canonicalSemanticRole "WorkflowProfile" ;
                            h2kg:definitionStatus "expert-draft-role-corrected" ;
                            h2kg:migrationAction "promote-role-typed-vocabulary-to-owl-class" ;
                            h2kg:reviewStatus "domain-expert-reviewed" ;
                            h2kg:reviewerDecision "approved-domain-expert-review" ;
                            h2kg:taxonomyModule "core" ;
                            h2kg:taxonomyTopBranch "InformationEntity" .


###  https://w3id.org/h2kg/hydrogen-ontology#Process
h2kg:Process rdf:type owl:Class ;
             rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ;
             dcterms:description "A class representing a process that transforms material, produces data, or changes the state of a system in H2KG."@en ;
             dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
             rdfs:label "Process"@en ;
             skos:definition "An activity or temporal development in which matter or information is transformed, measured, analyzed, or used."@en ;
             skos:prefLabel "Process"@en ;
             h2kg:canonicalSemanticRole "Process" ;
             h2kg:definitionStatus "curated-structural" ;
             h2kg:migrationAction "preserve-existing-class" ;
             h2kg:reviewStatus "domain-expert-reviewed" ;
             h2kg:reviewerDecision "approved-domain-expert-review" ;
             h2kg:taxonomyModule "core" ;
             h2kg:taxonomyTopBranch "Process" .


