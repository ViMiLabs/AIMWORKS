#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/type
dc:type rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
dcterms:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/identifier
dcterms:identifier rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/isReplacedBy
dcterms:isReplacedBy rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/provenance
dcterms:provenance rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
dcterms:publisher rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/references
dcterms:references rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
dcterms:source rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broadMatch
skos:broadMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#notation
skos:notation rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#scopeNote
skos:scopeNote rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/homepage
foaf:homepage rdf:type owl:AnnotationProperty .


###  https://w3id.org/h2kg/hydrogen-ontology#appliesToProfile
h2kg:appliesToProfile rdf:type owl:AnnotationProperty ;
                      dcterms:description "An annotation property stating which H2KG application profile or profiles explicitly include a term in their published module."@en ;
                      rdfs:label "appliesToProfile"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#canonicalSemanticRole
h2kg:canonicalSemanticRole rdf:type owl:AnnotationProperty ;
                           rdfs:label "canonical semantic role"@en ;
                           skos:definition "Records the canonical H2KG semantic role assigned after separating scientific identity from a contextual workflow role."@en .


###  https://w3id.org/h2kg/hydrogen-ontology#definitionStatus
h2kg:definitionStatus rdf:type owl:AnnotationProperty ;
                      rdfs:label "definition status"@en ;
                      skos:definition "Records whether a definition is curated, generated as an expert draft, or retained for compatibility."@en .


###  https://w3id.org/h2kg/hydrogen-ontology#migrationAction
h2kg:migrationAction rdf:type owl:AnnotationProperty ;
                     rdfs:label "migration action"@en ;
                     skos:definition "Records how a resource is handled during migration to the H2KG v2 taxonomy."@en .


###  https://w3id.org/h2kg/hydrogen-ontology#reviewStatus
h2kg:reviewStatus rdf:type owl:AnnotationProperty ;
                  rdfs:label "review status"@en ;
                  skos:definition "Records the governance review state of an H2KG resource."@en .


###  https://w3id.org/h2kg/hydrogen-ontology#reviewerDecision
h2kg:reviewerDecision rdf:type owl:AnnotationProperty ;
                      rdfs:label "reviewer decision"@en ;
                      skos:definition "Records the current domain-review decision for a taxonomy placement."@en .


###  https://w3id.org/h2kg/hydrogen-ontology#taxonomyModule
h2kg:taxonomyModule rdf:type owl:AnnotationProperty ;
                    rdfs:label "taxonomy module"@en ;
                    skos:definition "Identifies the H2KG module in which a reusable class is maintained."@en .


###  https://w3id.org/h2kg/hydrogen-ontology#taxonomyTopBranch
h2kg:taxonomyTopBranch rdf:type owl:AnnotationProperty ;
                       rdfs:label "taxonomy top branch"@en ;
                       skos:definition "Identifies the top-level H2KG branch reached by a class."@en .


###  https://w3id.org/h2kg/hydrogen-ontology#technologyApplicability
h2kg:technologyApplicability rdf:type owl:AnnotationProperty ;
                             rdfs:label "technology applicability"@en ;
                             skos:definition "Identifies a hydrogen or electrochemical technology profile in which a reusable class is explicitly applicable."@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/ns/prov#generated
<http://www.w3.org/ns/prov#generated> rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#used
<http://www.w3.org/ns/prov#used> rdf:type owl:ObjectProperty .


###  https://w3id.org/h2kg/hydrogen-ontology#atCurrentDensity
h2kg:atCurrentDensity rdf:type owl:ObjectProperty ;
                      rdfs:domain h2kg:DataPoint ;
                      rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
                      dcterms:description "An object property relating a data point to the current-density value at which it is reported."@en ;
                      rdfs:label "atCurrentDensity"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#fromMeasurement
h2kg:fromMeasurement rdf:type owl:ObjectProperty ;
                     rdfs:domain h2kg:DataPoint ;
                     rdfs:range h2kg:Measurement ;
                     dcterms:description "An object property relating a data point to the measurement from which it was generated."@en ;
                     rdfs:label "fromMeasurement"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#hasInputData
h2kg:hasInputData rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://www.w3.org/ns/prov#used> ;
                  rdfs:domain h2kg:Process ;
                  rdfs:range h2kg:Data ;
                  dcterms:description "An object property relating a process or measurement to data used as an input."@en ;
                  rdfs:label "hasInputData"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#hasInputMaterial
h2kg:hasInputMaterial rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://www.w3.org/ns/prov#used> ;
                      rdfs:domain h2kg:Process ;
                      rdfs:range h2kg:Matter ;
                      dcterms:description "An object property relating a process or measurement to a material entity that serves as an input."@en ;
                      rdfs:label "hasInputMaterial"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#hasMeasurementSubject
h2kg:hasMeasurementSubject rdf:type owl:ObjectProperty ;
                           rdfs:domain h2kg:Measurement ;
                           rdfs:range h2kg:Matter ;
                           rdfs:label "has measurement subject"@en ;
                           skos:definition "Relates a measurement to the material, specimen, component, or system whose characteristics are investigated."@en .


###  https://w3id.org/h2kg/hydrogen-ontology#hasMetadata
h2kg:hasMetadata rdf:type owl:ObjectProperty ;
                 rdfs:range h2kg:Metadata ;
                 dcterms:description "An object property relating a resource to metadata that describes its identity, provenance, structure, or contextual information."@en ;
                 rdfs:label "hasMetadata"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#hasOutputData
h2kg:hasOutputData rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://www.w3.org/ns/prov#generated> ;
                   rdfs:domain h2kg:Process ;
                   rdfs:range h2kg:Data ;
                   dcterms:description "An object property relating a measurement or process to data generated as an output."@en ;
                   rdfs:label "hasOutputData"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#hasOutputMaterial
h2kg:hasOutputMaterial rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://www.w3.org/ns/prov#generated> ;
                       rdfs:domain h2kg:Process ;
                       rdfs:range h2kg:Matter ;
                       dcterms:description "An object property relating a process to a material entity produced as an output."@en ;
                       rdfs:label "hasOutputMaterial"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#hasParameter
h2kg:hasParameter rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://www.w3.org/ns/prov#used> ;
                  rdfs:domain h2kg:Process ;
                  rdfs:range h2kg:Parameter ;
                  dcterms:description "An object property relating a process or measurement to a parameter that specifies one of its inputs, settings, or operating conditions."@en ;
                  rdfs:label "hasParameter"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#hasPart
h2kg:hasPart rdf:type owl:ObjectProperty ;
             owl:inverseOf h2kg:isPartOf ;
             dcterms:description "An object property relating an entity or process to a constituent part."@en ;
             rdfs:label "hasPart"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#hasProperty
h2kg:hasProperty rdf:type owl:ObjectProperty ;
                 rdfs:domain h2kg:Measurement ;
                 rdfs:range h2kg:Property ;
                 dcterms:description "An object property relating a measurement to a property that is determined, reported, or otherwise associated with that measurement."@en ;
                 dcterms:isReplacedBy h2kg:measures ;
                 rdfs:label "hasProperty"@en ;
                 owl:deprecated "true"^^xsd:boolean .


###  https://w3id.org/h2kg/hydrogen-ontology#hasQuantityValue
h2kg:hasQuantityValue rdf:type owl:ObjectProperty ;
                      dcterms:description "An object property relating a parameter, property, or data point to the quantity value that expresses it."@en ;
                      rdfs:label "hasQuantityValue"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#hasReferenceScale
h2kg:hasReferenceScale rdf:type owl:ObjectProperty ;
                       rdfs:domain h2kg:InformationEntity ;
                       rdfs:range h2kg:ReferenceScale ;
                       rdfs:label "has reference scale"@en ;
                       skos:definition "Relates an information entity or result record to the reference scale against which a potential or related quantity is expressed."@en .


###  https://w3id.org/h2kg/hydrogen-ontology#hasSubProcess
h2kg:hasSubProcess rdf:type owl:ObjectProperty ;
                   owl:inverseOf h2kg:isSubProcessOf ;
                   dcterms:description "An object property relating a process to a subprocess that forms part of its overall execution."@en ;
                   rdfs:label "hasSubProcess"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#isPartOf
h2kg:isPartOf rdf:type owl:ObjectProperty ;
              dcterms:description "An object property relating an entity or process to a larger entity or process of which it forms a part."@en ;
              rdfs:label "isPartOf"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#isSubProcessOf
h2kg:isSubProcessOf rdf:type owl:ObjectProperty ;
                    dcterms:description "An object property relating a subprocess to the larger process of which it forms a part."@en ;
                    rdfs:label "isSubProcessOf"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#measures
h2kg:measures rdf:type owl:ObjectProperty ;
              rdfs:domain h2kg:Measurement ;
              rdfs:range h2kg:Property ;
              dcterms:description "An object property relating a measurement to a property that it determines."@en ;
              rdfs:label "measures"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#normalizedTo
h2kg:normalizedTo rdf:type owl:ObjectProperty ;
                  rdfs:range h2kg:NormalizationBasis ;
                  dcterms:description "An object property relating a property or result to the basis used for its normalization."@en ;
                  rdfs:label "normalizedTo"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#ofProperty
h2kg:ofProperty rdf:type owl:ObjectProperty ;
                rdfs:domain h2kg:DataPoint ;
                rdfs:range h2kg:Property ;
                dcterms:description "An object property relating a data point to the property represented by that data point."@en ;
                rdfs:label "ofProperty"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#referenceElectrode
h2kg:referenceElectrode rdf:type owl:ObjectProperty ;
                        dcterms:description "An object property relating an electrochemical measurement setup or process to the reference electrode it uses."@en ;
                        dcterms:isReplacedBy h2kg:hasReferenceScale ,
                                             h2kg:usesReferenceElectrode ;
                        rdfs:label "referenceElectrode"@en ;
                        owl:deprecated "true"^^xsd:boolean .


###  https://w3id.org/h2kg/hydrogen-ontology#usesInstrument
h2kg:usesInstrument rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://www.w3.org/ns/prov#used> ;
                    rdfs:domain h2kg:Process ;
                    rdfs:range h2kg:Instrument ;
                    dcterms:description "An object property relating a process or measurement to an instrument used to carry it out or support it."@en ;
                    rdfs:label "usesInstrument"@en .


###  https://w3id.org/h2kg/hydrogen-ontology#usesReferenceElectrode
h2kg:usesReferenceElectrode rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf <http://www.w3.org/ns/prov#used> ;
                            rdfs:domain h2kg:Measurement ;
                            rdfs:range h2kg:ReferenceElectrode ;
                            rdfs:label "uses reference electrode"@en ;
                            skos:definition "Relates an electrochemical measurement to the reference electrode used in its measurement arrangement."@en .


###  https://w3id.org/h2kg/hydrogen-ontology#usesSoftware
h2kg:usesSoftware rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://www.w3.org/ns/prov#used> ;
                  rdfs:domain h2kg:Process ;
                  rdfs:range h2kg:SoftwareArtifact ;
                  rdfs:label "uses software"@en ;
                  skos:definition "Relates a process to a software artifact used to execute, control, process, analyze, simulate, or visualize its data."@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/h2kg/hydrogen-ontology#hasIdentifier
h2kg:hasIdentifier rdf:type owl:DatatypeProperty ;
                   rdfs:range rdfs:Literal ;
                   dcterms:description "A datatype property relating a resource to a literal identifier used to distinguish or reference it."@en ;
                   rdfs:label "hasIdentifier"@en .


#################################################################
#    Classes
#################################################################

###  http://qudt.org/schema/qudt/QuantityValue
<http://qudt.org/schema/qudt/QuantityValue> rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Activity
<http://www.w3.org/ns/prov#Activity> rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Agent
<http://www.w3.org/ns/prov#Agent> rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Entity
<http://www.w3.org/ns/prov#Entity> rdf:type owl:Class .


###  https://w3id.org/h2kg/hydrogen-ontology#ACAmplitude
h2kg:ACAmplitude rdf:type owl:Class ;
                 rdfs:subClassOf h2kg:QuantitativeCharacteristic ;
                 dcterms:description "A parameter specifying acamplitude used to characterize Electrochemical Impedance Spectroscopy Potentiostatic and Electrochemical Impedance Spectroscopy Galvanostatic."@en ;
                 dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
                 rdfs:label "ACAmplitude"@en ;
                 skos:definition "A parameter specifying acamplitude used to characterize Electrochemical Impedance Spectroscopy Potentiostatic and Electrochemical Impedance Spectroscopy Galvanostatic."@en ;
                 skos:prefLabel "ACAmplitude"@en ;
                 h2kg:canonicalSemanticRole "Characteristic" ;
                 h2kg:definitionStatus "source-curated" ;
                 h2kg:migrationAction "promote-role-typed-vocabulary-to-owl-class" ;
                 h2kg:reviewStatus "domain-expert-reviewed" ;
                 h2kg:reviewerDecision "approved-domain-expert-review" ;
                 h2kg:taxonomyModule "core" ;
                 h2kg:taxonomyTopBranch "Characteristic" .


###  https://w3id.org/h2kg/hydrogen-ontology#ACInputAmplitude
h2kg:ACInputAmplitude rdf:type owl:Class ;
                      rdfs:subClassOf h2kg:QuantitativeCharacteristic ;
                      dcterms:description "A parameter specifying amplitude of the AC sinusoidal signal used to read impedance for strain sensing (not the small-signal EIS perturbation amplitude)."@en ;
                      dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
                      rdfs:label "AC Input Amplitude"@en ;
                      skos:definition "A parameter specifying amplitude of the AC sinusoidal signal used to read impedance for strain sensing (not the small-signal EIS perturbation amplitude)."@en ;
                      skos:prefLabel "AC Input Amplitude"@en ;
                      h2kg:canonicalSemanticRole "Characteristic" ;
                      h2kg:definitionStatus "source-curated" ;
                      h2kg:migrationAction "promote-role-typed-vocabulary-to-owl-class" ;
                      h2kg:reviewStatus "domain-expert-reviewed" ;
                      h2kg:reviewerDecision "approved-domain-expert-review" ;
                      h2kg:taxonomyModule "core" ;
                      h2kg:taxonomyTopBranch "Characteristic" .


###  https://w3id.org/h2kg/hydrogen-ontology#AFMInstrument
h2kg:AFMInstrument rdf:type owl:Class ;
                   rdfs:subClassOf h2kg:ProbeMicroscope ;
                   dcterms:description "An atomic force microscopy instrument used for in-situ or ex-situ topography and microstructure imaging of catalyst layers, membranes, and related electrochemical materials."@en ;
                   dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
                   rdfs:label "AFM Instrument"@en ;
                   skos:altLabel "AFM (NanoMan VS"@en ,
                                 "Agilent 5500 AFM microscope"@en ,
                                 "Multimode 8 AFM (Bruker)"@en ,
                                 "atomic force microscope"@en ;
                   skos:definition "An atomic force microscopy instrument used for in-situ or ex-situ topography and microstructure imaging of catalyst layers, membranes, and related electrochemical materials."@en ;
                   skos:prefLabel "AFM Instrument"@en ;
                   h2kg:canonicalSemanticRole "Instrument" ;
                   h2kg:definitionStatus "source-curated" ;
                   h2kg:migrationAction "promote-role-typed-vocabulary-to-owl-class" ;
                   h2kg:reviewStatus "domain-expert-reviewed" ;
                   h2kg:reviewerDecision "approved-domain-expert-review" ;
                   h2kg:taxonomyModule "core" ;
                   h2kg:taxonomyTopBranch "Matter" .


###  https://w3id.org/h2kg/hydrogen-ontology#AFMScanSpeed
h2kg:AFMScanSpeed rdf:type owl:Class ;
                  rdfs:subClassOf h2kg:QuantitativeCharacteristic ;
                  dcterms:description "A parameter denoting the scan speed or line-scan rate used during atomic force microscopy acquisition."@en ;
                  dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
                  rdfs:label "AFM Scan Speed"@en ;
