                                                        rdfs:subClassOf h2kg:SpectroscopyMeasurement ;
                                                        dcterms:description "A potentiostatic electrochemical impedance spectroscopy measurement performed under defined gas-side, thermal, humidity, pressure, and potential-control conditions to generate impedance datasets for subsequent analysis."@en ;
                                                        dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
                                                        rdfs:label "Electrochemical Impedance Spectroscopy Potentiostatic"@en ;
                                                        skos:altLabel "EIS"@en ,
                                                                      "electrochemical impedance spectroscopy"@en ,
                                                                      "impedance spectroscopy"@en ;
                                                        skos:definition "A potentiostatic electrochemical impedance spectroscopy measurement performed under defined gas-side, thermal, humidity, pressure, and potential-control conditions to generate impedance datasets for subsequent analysis."@en ;
                                                        skos:prefLabel "Electrochemical Impedance Spectroscopy Potentiostatic"@en ;
                                                        h2kg:canonicalSemanticRole "Measurement" ;
                                                        h2kg:definitionStatus "source-curated" ;
                                                        h2kg:migrationAction "promote-role-typed-vocabulary-to-owl-class" ;
                                                        h2kg:reviewStatus "domain-expert-reviewed" ;
                                                        h2kg:reviewerDecision "approved-domain-expert-review" ;
                                                        h2kg:taxonomyModule "core" ;
                                                        h2kg:taxonomyTopBranch "Process" .


