<https://w3id.org/h2kg/examples/xps#xps-pass-energy-setting>
  a h2kg:Parameter, h2kg:XPSPassEnergy ;
  rdfs:label "XPS pass energy setting"@en ;
  h2kg:hasQuantityValue <https://w3id.org/h2kg/examples/xps#xps-pass-energy-setting-qv> .

<https://w3id.org/h2kg/examples/xps#xps-take-off-angle-setting>
  a h2kg:Parameter, h2kg:XPSTakeOffAngle ;
  rdfs:label "XPS take-off angle setting"@en ;
  h2kg:hasQuantityValue <https://w3id.org/h2kg/examples/xps#xps-take-off-angle-setting-qv> .

<https://w3id.org/h2kg/examples/xps#xps-analysis-area-setting>
  a h2kg:Parameter, h2kg:XPSAnalysisArea ;
  rdfs:label "XPS analysis area setting"@en ;
  h2kg:hasQuantityValue <https://w3id.org/h2kg/examples/xps#xps-analysis-area-setting-qv> .

<https://w3id.org/h2kg/examples/xps#xps-pass-energy-setting-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "20"^^xsd:decimal ;
  qudt:quantityKind quantitykind:Energy ;
  qudt:unit unit:EV .

<https://w3id.org/h2kg/examples/xps#xps-take-off-angle-setting-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "45"^^xsd:decimal ;
  qudt:quantityKind quantitykind:PlaneAngle ;
  qudt:unit unit:DEG .

<https://w3id.org/h2kg/examples/xps#xps-analysis-area-setting-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "400"^^xsd:decimal ;
  qudt:quantityKind quantitykind:Area ;
  qudt:unit unit:MicroM2 .

<https://w3id.org/h2kg/examples/xps#binding-energy-datapoint-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "284.8"^^xsd:decimal ;
  qudt:quantityKind quantitykind:Energy ;
  qudt:unit unit:EV .

<https://w3id.org/h2kg/examples/xps#c1s-atomic-percent-datapoint-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "72"^^xsd:decimal ;
  qudt:quantityKind quantitykind:AtomPercent, quantitykind:AtomicPercent, quantitykind:Dimensionless ;
  qudt:unit unit:PERCENT .

<https://w3id.org/h2kg/examples/xps#o1s-atomic-percent-datapoint-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "15"^^xsd:decimal ;
  qudt:quantityKind quantitykind:AtomPercent, quantitykind:AtomicPercent, quantitykind:Dimensionless ;
  qudt:unit unit:PERCENT .

<https://w3id.org/h2kg/examples/xps#f1s-atomic-percent-datapoint-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "8"^^xsd:decimal ;
  qudt:quantityKind quantitykind:AtomPercent, quantitykind:AtomicPercent, quantitykind:Dimensionless ;
  qudt:unit unit:PERCENT .

<https://w3id.org/h2kg/examples/xps#n1s-atomic-percent-datapoint-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "3"^^xsd:decimal ;
  qudt:quantityKind quantitykind:AtomPercent, quantitykind:AtomicPercent, quantitykind:Dimensionless ;
  qudt:unit unit:PERCENT .

<https://w3id.org/h2kg/examples/xps#carbon-to-oxygen-ratio-datapoint-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "4.8"^^xsd:decimal ;
