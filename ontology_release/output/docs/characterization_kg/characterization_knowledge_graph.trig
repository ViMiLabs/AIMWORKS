    h2kg:QuantitativeCharacteristic a owl:Class ;
        rdfs:label "Quantitative characteristic"@en ;
        dcterms:description "A property whose value can be expressed using a number, quantity kind, unit, range, distribution, or mathematical object."@en ;
        dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
        rdfs:subClassOf h2kg:Property ;
        skos:definition "A property whose value can be expressed using a number, quantity kind, unit, range, distribution, or mathematical object."@en ;
        skos:prefLabel "Quantitative characteristic"@en ;
        skos:scopeNote "This characteristic can be selected as a workflow parameter through a Parameter record; contextual parameter use does not alter its intrinsic classification."@en ;
        h2kg:canonicalSemanticRole "Characteristic" ;
        h2kg:correctionAction "retain" ;
        h2kg:definitionStatus "structural" ;
        h2kg:governanceStatus "approved" ;
        h2kg:migrationAction "retain" ;
        h2kg:taxonomyModule "core" ;
        h2kg:taxonomyTopBranch "Characteristic" .

    h2kg:Matter a owl:Class ;
        rdfs:label "Matter"@en ;
        dcterms:description "A physical entity that can participate in a hydrogen-electrochemical process, measurement, or system configuration."@en ;
        dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
        rdfs:subClassOf prov:Entity ;
        skos:definition "A physical entity that can participate in a hydrogen-electrochemical process, measurement, or system configuration."@en ;
        skos:prefLabel "Matter"@en ;
        h2kg:canonicalSemanticRole "Matter" ;
        h2kg:correctionAction "retain" ;
        h2kg:definitionStatus "structural" ;
        h2kg:governanceStatus "approved" ;
        h2kg:migrationAction "retain" ;
        h2kg:taxonomyModule "core" ;
        h2kg:taxonomyTopBranch "Matter" .

    h2kg:Process a owl:Class ;
        rdfs:label "Process"@en ;
        dcterms:description "An activity or temporal development in which matter or information is transformed, measured, analyzed, or used."@en ;
        dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
        rdfs:subClassOf prov:Activity ;
        skos:definition "An activity or temporal development in which matter or information is transformed, measured, analyzed, or used."@en ;
        skos:prefLabel "Process"@en ;
        h2kg:canonicalSemanticRole "Process" ;
        h2kg:correctionAction "retain" ;
        h2kg:definitionStatus "structural" ;
        h2kg:governanceStatus "approved" ;
        h2kg:migrationAction "retain" ;
        h2kg:taxonomyModule "core" ;
        h2kg:taxonomyTopBranch "Process" .

    h2kg:Parameter a owl:Class ;
        rdfs:label "Parameter"@en ;
        dcterms:description "A parameter record retained as the stable H2KG anchor for a selected input, setting, or condition of a process, measurement, analysis, or model execution."@en ;
        dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
        rdfs:subClassOf h2kg:ParameterRecord ;
        skos:definition "A parameter record retained as the stable H2KG anchor for a selected input, setting, or condition of a process, measurement, analysis, or model execution."@en ;
        skos:prefLabel "Parameter"@en ;
        h2kg:canonicalSemanticRole "ParameterRecord" ;
        h2kg:correctionAction "retain" ;
        h2kg:definitionStatus "structural" ;
        h2kg:governanceStatus "approved" ;
        h2kg:migrationAction "retain" ;
        h2kg:taxonomyModule "core" ;
        h2kg:taxonomyTopBranch "InformationEntity" .

    h2kg:Metadata a owl:Class ;
        rdfs:label "Metadata"@en ;
        dcterms:description "Data that describes the identity, context, provenance, structure, management, or interpretation of another entity."@en ;
        dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
        rdfs:subClassOf h2kg:Data ;
        skos:definition "Data that describes the identity, context, provenance, structure, management, or interpretation of another entity."@en ;
        skos:prefLabel "Metadata"@en ;
        h2kg:canonicalSemanticRole "Metadata" ;
        h2kg:correctionAction "retain" ;
        h2kg:definitionStatus "structural" ;
        h2kg:governanceStatus "approved" ;
        h2kg:migrationAction "retain" ;
        h2kg:taxonomyModule "core" ;
        h2kg:taxonomyTopBranch "InformationEntity" .
}

