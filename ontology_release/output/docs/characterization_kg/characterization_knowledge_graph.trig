<https://w3id.org/h2kg/examples/characterization/graph/taxonomy> {
    h2kg:AFMInstrument a owl:Class ;
        rdfs:label "AFM Instrument"@en ;
        dcterms:description "An atomic force microscopy instrument used for in-situ or ex-situ topography and microstructure imaging of catalyst layers, membranes, and related electrochemical materials."@en ;
        dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
        rdfs:subClassOf h2kg:ProbeMicroscope ;
        skos:altLabel "AFM (NanoMan VS"@en,
            "Agilent 5500 AFM microscope"@en,
            "Multimode 8 AFM (Bruker)"@en,
            "atomic force microscope"@en ;
        skos:definition "An atomic force microscopy instrument used for in-situ or ex-situ topography and microstructure imaging of catalyst layers, membranes, and related electrochemical materials."@en ;
        skos:prefLabel "AFM Instrument"@en ;
        h2kg:canonicalSemanticRole "Instrument" ;
        h2kg:correctionAction "retain" ;
        h2kg:definitionStatus "source" ;
        h2kg:governanceStatus "approved" ;
        h2kg:migrationAction "retain" ;
        h2kg:taxonomyModule "core" ;
        h2kg:taxonomyTopBranch "Matter" .

    h2kg:AFMTipNominalRadius a owl:Class ;
        rdfs:label "AFM Tip Nominal Radius"@en ;
        dcterms:description "A nominal geometric characteristic specifying the reported radius of curvature of an atomic-force-microscopy probe tip."@en ;
        dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
        rdfs:subClassOf h2kg:MorphologicalCharacteristic ;
        skos:altLabel "AFM tip radius"@en,
            "tip radius"@en ;
        skos:definition "A nominal geometric characteristic specifying the reported radius of curvature of an atomic-force-microscopy probe tip."@en ;
        skos:prefLabel "AFM Tip Nominal Radius"@en ;
        skos:scopeNote "This characteristic can be selected as a workflow parameter through a Parameter record; contextual parameter use does not alter its intrinsic classification."@en ;
        h2kg:canonicalSemanticRole "Characteristic" ;
        h2kg:correctionAction "retain" ;
        h2kg:definitionStatus "curated" ;
        h2kg:governanceStatus "approved" ;
        h2kg:migrationAction "retain" ;
        h2kg:taxonomyModule "core" ;
        h2kg:taxonomyTopBranch "Characteristic" .

    h2kg:AtomicForceMicroscopyMeasurement a owl:Class ;
        rdfs:label "Atomic force microscopy"@en ;
        dcterms:description "A measurement process that uses atomic force microscopy for in-situ or ex-situ surface-topography and microstructure characterization, including catalyst-layer and membrane-electrode-assembly imaging as well as adsorbed-ionomer structure analysis."@en ;
        dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
        rdfs:subClassOf h2kg:ProbeMicroscopyMeasurement ;
        skos:altLabel "AFM"@en,
            "AFM imaging"@en,
            "Atomic Force Microscopy Measurement"@en,
            "atomic force microscopy"@en ;
        skos:definition "A measurement process that uses atomic force microscopy for in-situ or ex-situ surface-topography and microstructure characterization, including catalyst-layer and membrane-electrode-assembly imaging as well as adsorbed-ionomer structure analysis."@en ;
