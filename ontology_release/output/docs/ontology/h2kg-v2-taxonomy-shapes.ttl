@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix h2kg: <https://w3id.org/h2kg/hydrogen-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

h2kg:TaxonomyClassShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "Every H2KG class must have exactly one correction action." ;
            sh:minCount 1 ;
            sh:path h2kg:correctionAction ],
        [ sh:maxCount 1 ;
            sh:message "Every H2KG class must have exactly one canonical semantic role." ;
            sh:minCount 1 ;
            sh:path h2kg:canonicalSemanticRole ],
        [ sh:maxCount 1 ;
            sh:message "Every H2KG class must have exactly one migration action." ;
            sh:minCount 1 ;
            sh:path h2kg:migrationAction ],
        [ sh:maxCount 1 ;
            sh:message "Every H2KG class must have exactly one governance status." ;
            sh:minCount 1 ;
            sh:path h2kg:governanceStatus ],
        [ sh:maxCount 1 ;
            sh:message "Every H2KG class must have exactly one definition status." ;
            sh:minCount 1 ;
            sh:path h2kg:definitionStatus ],
        [ sh:maxCount 1 ;
            sh:message "Every H2KG class must have a definition." ;
            sh:minCount 1 ;
            sh:path skos:definition ],
        [ sh:maxCount 1 ;
            sh:message "Every H2KG class must have exactly one preferred label." ;
            sh:minCount 1 ;
            sh:path skos:prefLabel ],
        [ sh:maxCount 1 ;
            sh:message "Every H2KG class must identify exactly one top-level taxonomy branch." ;
            sh:minCount 1 ;
            sh:path h2kg:taxonomyTopBranch ],
        [ sh:maxCount 1 ;
            sh:message "Every H2KG class must record migration provenance." ;
            sh:minCount 1 ;
            sh:path dcterms:provenance ],
        [ sh:maxCount 1 ;
            sh:message "Every H2KG class must have exactly one taxonomy module." ;
            sh:minCount 1 ;
            sh:path h2kg:taxonomyModule ] ;
    sh:targetClass owl:Class .
