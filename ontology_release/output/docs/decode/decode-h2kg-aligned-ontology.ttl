        decode-workflow:fitting-of-the-europium-model,
        decode-workflow:gas-permeability-of-a-gdl-with-defined-compression,
        decode-workflow:iet-1d-mea-with-water-transport-eis-model,
        decode-workflow:iet-1d-performance-model-for-mea-prediction,
        decode-workflow:image-classification-of-x-ray-tomography-data,
        decode-workflow:image-x-ray-tomography-data-parameter-extraction-3d,
        decode-workflow:modeling-of-hydrophobic-treatment-of-gdl,
        decode-workflow:modeling-of-mpl-coating-of-gdl,
        decode-workflow:mpl-parameter-estimation-from-gdl-and-substrate-data,
