decode:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence"@en ;
    rdfs:isDefinedBy <https://w3id.org/h2kg/decode/ontology> ;
    rdfs:range xsd:string .

decode:definitionSeedSha256 a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://w3id.org/h2kg/decode/ontology> .

decode:definitionStatus a owl:DatatypeProperty ;
    rdfs:label "definition status"@en ;
    rdfs:isDefinedBy <https://w3id.org/h2kg/decode/ontology> ;
    rdfs:range xsd:string .

decode:downstreamWorkflow a owl:ObjectProperty ;
