    rdfs:label "Image X-ray tomography data parameter extraction 3D"@en ;
    dcterms:source decode-workflow:ai-based-generation-of-structural-digital-twins-of-multi-scale-tomographies,
        decode-workflow:cea-mea-model-europium-2d,
