<https://w3id.org/h2kg/decode/ontology> a owl:Ontology ;
    dcterms:creator "DECODE consortium",
        "H2KG development team" ;
    dcterms:description "An H2KG-aligned ontology and provenance-preserving occurrence graph for DECODE hydrogen-technology workflows."@en ;
    dcterms:issued "2026-09-23"^^xsd:date ;
    dcterms:rights "License pending confirmation by DECODE governance; no open reuse license is asserted for this release."@en ;
    dcterms:title "DECODE H2KG-Aligned Workflow Ontology"@en ;
    owl:imports <https://w3id.org/h2kg/hydrogen-ontology> ;
    owl:versionIRI <https://w3id.org/h2kg/decode/ontology/releases/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    decode:definitionSeedSha256 "1655e3c3724b1318607a16f977aa8cef8408500805f956a68f4ccc4466e9c838" ;
    decode:definitionStatus "expert-draft" ;
    decode:sourceWorkflowCount 137 .

decode:SourceOccurrence a owl:Class ;
    rdfs:label "source occurrence"@en ;
    rdfs:isDefinedBy <https://w3id.org/h2kg/decode/ontology> ;
    rdfs:subClassOf prov:Entity .

decode:SourceEdge a owl:Class ;
    rdfs:label "source edge"@en ;
    rdfs:isDefinedBy <https://w3id.org/h2kg/decode/ontology> ;
    rdfs:subClassOf prov:Entity .

decode:SemanticProjection a owl:Class ;
    rdfs:label "semantic projection"@en ;
    rdfs:isDefinedBy <https://w3id.org/h2kg/decode/ontology> ;
    rdfs:subClassOf prov:Entity .

