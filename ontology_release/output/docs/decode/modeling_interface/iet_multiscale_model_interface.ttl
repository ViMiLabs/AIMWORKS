decode:iet-multiscale-model-interface a prov:Bundle ;
    rdfs:label "IET multiscale model interface (PDF-derived schema)" ;
    dcterms:description "Value-free, PDF-derived DECODE extraction schema for the ITC, CTP, and PTP model chain." ;
    decode:sourcePdfFilename "Modeling methods inputs outputs FZJ.pdf" ;
    decode:sourcePdfSha256 "84ed58b3e9909e229e8aba452095f7cacf8dc907757cf464b5640c4b7ab26b78" .

