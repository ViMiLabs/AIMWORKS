PREFIX h2kg: <https://w3id.org/h2kg/hydrogen-ontology#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?caseKey ?resultLabel ?propertyLabel ?bearerLabel WHERE {
  GRAPH ?semanticGraph { ?result a h2kg:DataPoint ; rdfs:label ?resultLabel ; h2kg:ofProperty ?property .
?property rdfs:label ?propertyLabel ; h2kg:isCharacteristicOf ?bearer . ?bearer rdfs:label ?bearerLabel . }
  FILTER(STRSTARTS(STR(?semanticGraph), "https://w3id.org/h2kg/examples/characterization/graph/semantic/"))
  BIND(STRAFTER(STR(?semanticGraph), "https://w3id.org/h2kg/examples/characterization/graph/semantic/") AS ?caseKey)
} ORDER BY ?caseKey ?resultLabel ?propertyLabel
