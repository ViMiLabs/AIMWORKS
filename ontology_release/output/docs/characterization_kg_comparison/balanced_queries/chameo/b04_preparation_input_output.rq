PREFIX chameo: <https://w3id.org/emmo/domain/characterisation-methodology/chameo#>
PREFIX emmo: <https://w3id.org/emmo#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?caseKey ?processLabel ?inputMaterialLabel ?outputMaterialLabel WHERE {
  GRAPH ?semanticGraph {
    ?process a chameo:SamplePreparation ; rdfs:label ?processLabel ; chameo:hasSampleForPreparation ?input ; <https://w3id.org/emmo#EMMO_c4bace1d_4db0_4cd3_87e9_18122bae2840> ?output .
    ?input rdfs:label ?inputMaterialLabel . ?output rdfs:label ?outputMaterialLabel .
  }
  FILTER(STRSTARTS(STR(?semanticGraph), "https://example.org/aimworks/chameo-characterization/graph/semantic/"))
  BIND(STRAFTER(STR(?semanticGraph), "https://example.org/aimworks/chameo-characterization/graph/semantic/") AS ?caseKey)
} ORDER BY ?caseKey ?processLabel ?inputMaterialLabel ?outputMaterialLabel
