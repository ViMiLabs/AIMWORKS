<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"><key id="label" for="all" attr.name="label" attr.type="string" /><key id="description" for="all" attr.name="description" attr.type="string" /><key id="semantic_role" for="all" attr.name="semantic_role" attr.type="string" /><key id="io_id" for="all" attr.name="io_id" attr.type="string" /><key id="predicate" for="all" attr.name="predicate" attr.type="string" /><key id="source_kind" for="all" attr.name="source_kind" attr.type="string" /><graph id="iet-multiscale-model-interface" edgedefault="directed"><node id="itc"><data key="label">IET ink to composition model</data><data key="description">PDF-defined ITC computational model stage in the DECODE multiscale interface schema.</data><data key="semantic_role">Process</data><data key="io_id">itc</data></node><node id="ctp"><data key="label">IET composition to property model</data><data key="description">PDF-defined CTP computational model stage in the DECODE multiscale interface schema.</data><data key="semantic_role">Process</data><data key="io_id">ctp</data></node><node id="ptp"><data key="label">IET 1D Performance model for MEA (prediction)</data><data key="description">PDF-defined PTP computational model stage in the DECODE multiscale interface schema.</data><data key="semantic_role">Process</data><data key="io_id">ptp</data></node><node id="IO_CMP_CatalystSupportRatio"><data key="label">Platinum-to-carbon mass ratio</data><data key="description">Mass ratio of platinum catalyst to carbon support in the catalyst layer.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CatalystSupportRatio</data></node><node id="IO_CMP_ICRatio"><data key="label">Ionomer-to-carbon ratio</data><data key="description">Mass ratio of dry ionomer to carbon support in the catalyst layer.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_ICRatio</data></node><node id="IO_CMP_IonomerCatalystDispersionParameter"><data key="label">Ionomer-catalyst dispersion parameter</data><data key="description">Parameter describing the tendency of ionomer to spread over the platinum-on-carbon surface rather than form larger ionomer aggregates.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_IonomerCatalystDispersionParameter</data></node><node id="IO_CMP_TotalPoreVolume"><data key="label">Total pore volume</data><data key="description">Total volume of void space within a specified material or structure.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_TotalPoreVolume</data></node><node id="IO_MAT_CatalystPoreSizeDistribution_phi1"><data key="label">CCL primary-pore volume fraction</data><data key="description">Fraction of the total pore volume assigned to primary pores in the ionomer-free platinum-on-carbon structure of a cathode catalyst layer.</data><data key="semantic_role">Property</data><data key="io_id">IO_MAT_CatalystPoreSizeDistribution_phi1</data></node><node id="IO_MAT_CatalystPoreSizeDistribution_phi2"><data key="label">CCL secondary-pore volume fraction</data><data key="description">Fraction of the total pore volume assigned to secondary pores in the ionomer-free platinum-on-carbon structure of a cathode catalyst layer.</data><data key="semantic_role">Property</data><data key="io_id">IO_MAT_CatalystPoreSizeDistribution_phi2</data></node><node id="IO_MAT_CatalystPoreSizeDistribution_rMu1"><data key="label">CCL primary-pore geometric-mean radius</data><data key="description">Geometric mean, equal to the median, of the volume-weighted lognormal pore-radius distribution for primary pores in a cathode catalyst layer.</data><data key="semantic_role">Property</data><data key="io_id">IO_MAT_CatalystPoreSizeDistribution_rMu1</data></node><node id="IO_MAT_CatalystPoreSizeDistribution_rMu2"><data key="label">CCL secondary-pore geometric-mean radius</data><data key="description">Geometric mean, equal to the median, of the volume-weighted lognormal pore-radius distribution for secondary pores in a cathode catalyst layer.</data><data key="semantic_role">Property</data><data key="io_id">IO_MAT_CatalystPoreSizeDistribution_rMu2</data></node><node id="IO_MAT_CatalystPoreSizeDistribution_sigmaR1"><data key="label">CCL primary-pore logarithmic radius deviation</data><data key="description">Dimensionless standard deviation in the volume-weighted lognormal distribution of primary-pore radii, calculated using the natural logarithm.</data><data key="semantic_role">Property</data><data key="io_id">IO_MAT_CatalystPoreSizeDistribution_sigmaR1</data></node><node id="IO_MAT_CatalystPoreSizeDistribution_sigmaR2"><data key="label">CCL secondary-pore logarithmic radius deviation</data><data key="description">Dimensionless standard deviation in the volume-weighted lognormal distribution of secondary-pore radii, calculated using the natural logarithm.</data><data key="semantic_role">Property</data><data key="io_id">IO_MAT_CatalystPoreSizeDistribution_sigmaR2</data></node><node id="IO_CMP_IonomerCatalystDegreeAlignment_deltaDAC"><data key="label">Carbon-support-induced ionomer alignment degree</data><data key="description">Degree of molecular alignment induced in the adjacent ionomer film by the carbon-support surface.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_IonomerCatalystDegreeAlignment_deltaDAC</data></node><node id="IO_CMP_IonomerCatalystDegreeAlignment_deltaDAPt"><data key="label">Platinum-surface-induced ionomer alignment degree</data><data key="description">Degree of molecular alignment induced in the adjacent ionomer film by the platinum surface.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_IonomerCatalystDegreeAlignment_deltaDAPt</data></node><node id="IO_CMP_IonomerCatalystDegreeAlignment_deltaDAinf"><data key="label">Limiting ionomer alignment degree</data><data key="description">Limiting degree of ionomer molecular alignment in a thick film where the influence of the platinum-on-carbon surface is negligible.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_IonomerCatalystDegreeAlignment_deltaDAinf</data></node><node id="IO_MAT_CatalystSupportContactAngle"><data key="label">Carbon-support water contact angle</data><data key="description">Water contact angle of the bare carbon-support surface used to describe its intrinsic wettability.</data><data key="semantic_role">Property</data><data key="io_id">IO_MAT_CatalystSupportContactAngle</data></node><node id="IO_MAT_CatalystActiveParticleContactAngle"><data key="label">Platinum-surface water contact angle</data><data key="description">Water contact angle of the bare platinum surface used to describe its intrinsic wettability.</data><data key="semantic_role">Property</data><data key="io_id">IO_MAT_CatalystActiveParticleContactAngle</data></node><node id="IO_MAT_IonomerContactAngles_thetaHI"><data key="label">Ideal hydrophilic ionomer contact angle</data><data key="description">Limiting water contact angle of an ideally hydrophilic aligned ionomer surface used as the hydrophilic endpoint of the model wetting relation.</data><data key="semantic_role">Property</data><data key="io_id">IO_MAT_IonomerContactAngles_thetaHI</data></node><node id="IO_MAT_IonomerContactAngles_thetaHO"><data key="label">Ideal hydrophobic ionomer contact angle</data><data key="description">Limiting water contact angle of an ideally hydrophobic aligned ionomer surface used as the hydrophobic endpoint of the model wetting relation.</data><data key="semantic_role">Property</data><data key="io_id">IO_MAT_IonomerContactAngles_thetaHO</data></node><node id="IO_MAT_IonomerInitialFilmThickness"><data key="label">Initial ionomer film thickness</data><data key="description">Limiting effective thickness of the ionomer film on the covered platinum-on-carbon surface as ionomer loading approaches zero, representing the characteristic thickness of the first deposited ionomer layer.</data><data key="semantic_role">Property</data><data key="io_id">IO_MAT_IonomerInitialFilmThickness</data></node><node id="IO_CMP_MeanPoreRadiusInsideTheIonomer"><data key="label">Equivalent ionomer patch radius</data><data key="description">Equivalent radius representing the characteristic size of finite ionomer patches distributed over the secondary-pore surface.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_MeanPoreRadiusInsideTheIonomer</data></node><node id="IO_MAT_CatalystActiveParticleDiameter"><data key="label">Platinum particle radius</data><data key="description">Radius of a platinum catalyst particle used to characterize particle geometry.</data><data key="semantic_role">Property</data><data key="io_id">IO_MAT_CatalystActiveParticleDiameter</data></node><node id="IO_CMP_SurfaceTensionOfWaterAtT353k"><data key="label">Surface tension</data><data key="description">Interfacial free energy per unit area associated with the surface of a liquid.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_SurfaceTensionOfWaterAtT353k</data></node><node id="IO_MAT_IonomerDensityDry"><data key="label">Dry ionomer density</data><data key="description">Mass density of dry ionomer used to convert ionomer mass into ionomer volume.</data><data key="semantic_role">Property</data><data key="io_id">IO_MAT_IonomerDensityDry</data></node><node id="IO_MAT_CatalystActiveParticleDensity"><data key="label">Platinum density</data><data key="description">Mass density of platinum used to relate platinum loading to the amount and surface coverage of catalyst particles.</data><data key="semantic_role">Property</data><data key="io_id">IO_MAT_CatalystActiveParticleDensity</data></node><node id="IO_CMP_DensityOfCarbon"><data key="label">Carbon density</data><data key="description">Mass density of the carbon-support material.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_DensityOfCarbon</data></node><node id="IO_SIM_CapillaryPressureRange"><data key="label">Capillary-pressure axis data</data><data key="description">Array of capillary-pressure values used as the pressure axis for evaluating a cathode-catalyst-layer water-retention curve.</data><data key="semantic_role">Data</data><data key="io_id">IO_SIM_CapillaryPressureRange</data></node><node id="IO_CMP_CCLWaterRetentionCurve"><data key="label">CCL water-saturation data</data><data key="description">Array giving the fraction of cathode-catalyst-layer pore volume flooded with liquid water at each capillary pressure in the water-retention curve.</data><data key="semantic_role">Data</data><data key="io_id">IO_CMP_CCLWaterRetentionCurve</data></node><node id="IO_CMP_CCLFractionHydrophilicPores"><data key="label">CCL accessible primary-pore volume fraction</data><data key="description">Normalized fraction of the remaining accessible cathode-catalyst-layer pore volume belonging to primary pores after accounting for ionomer filling.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CCLFractionHydrophilicPores</data></node><node id="IO_CMP_CCLFractionHydrophobicPores"><data key="label">CCL accessible secondary-pore volume fraction</data><data key="description">Normalized fraction of the remaining accessible cathode-catalyst-layer pore volume belonging to secondary pores after accounting for ionomer filling.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CCLFractionHydrophobicPores</data></node><node id="IO_CMP_CCLEffectiveIonomerCoverage"><data key="label">CCL effective ionomer coverage</data><data key="description">Fraction of the total secondary-pore surface covered by ionomer in a cathode catalyst layer.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CCLEffectiveIonomerCoverage</data></node><node id="IO_CMP_CCLIonomerEffectiveFilmThickness"><data key="label">Equivalent ionomer film thickness</data><data key="description">Effective uniform thickness of the ionomer film obtained from its volume and the secondary-pore area it covers.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CCLIonomerEffectiveFilmThickness</data></node><node id="IO_CMP_CCLStructuralParameters_A1"><data key="label">CCL primary-pore specific surface area</data><data key="description">Specific surface area of the primary-pore domain of the ionomer-free reference structure per unit carbon mass, calculated from the primary-pore size distribution.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CCLStructuralParameters_A1</data></node><node id="IO_CMP_CCLStructuralParameters_A2"><data key="label">CCL secondary-pore specific surface area</data><data key="description">Specific surface area of the secondary-pore domain of the ionomer-free reference structure per unit carbon mass, calculated from the secondary-pore size distribution.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CCLStructuralParameters_A2</data></node><node id="IO_CMP_CCLStructuralParameters_Apores"><data key="label">CCL total-pore specific surface area</data><data key="description">Total specific surface area of the primary- and secondary-pore network of the ionomer-free cathode-catalyst-layer reference structure per unit carbon mass.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CCLStructuralParameters_Apores</data></node><node id="IO_CMP_CCLStructuralParameters_deltaDA"><data key="label">CCL ionomer alignment degree</data><data key="description">Degree of alignment of ionomer sidechains and backbones after accounting for the platinum-on-carbon surface and the decay of alignment with film thickness.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CCLStructuralParameters_deltaDA</data></node><node id="IO_CMP_CCLStructuralParameters_ThetaPtC"><data key="label">Platinum-carbon pore-wall contact angle</data><data key="description">Effective water contact angle of the uncovered platinum-on-carbon pore wall determined from the surface contributions of platinum and carbon.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CCLStructuralParameters_ThetaPtC</data></node><node id="IO_CMP_CCLStructuralParameters_ThetaIon"><data key="label">Ionomer-coated pore-wall contact angle</data><data key="description">Effective water contact angle of an ionomer-coated pore wall determined by the ionomer degree of alignment.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CCLStructuralParameters_ThetaIon</data></node><node id="IO_CMP_CCLStructuralParameters_thetaCCL"><data key="label">CCL mean contact angle</data><data key="description">Arithmetic mean of local cathode-catalyst-layer pore contact angles, with primary- and secondary-pore distributions weighted by their shares of total pore volume remaining after ionomer filling.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CCLStructuralParameters_thetaCCL</data></node><node id="IO_CMP_CCLStructuralParameters_thetaCCLHI"><data key="label">CCL hydrophilic-pore mean contact angle</data><data key="description">Pore-volume-weighted arithmetic mean of contact angles below 90 degrees, considering cathode-catalyst-layer pore volume remaining after ionomer filling.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CCLStructuralParameters_thetaCCLHI</data></node><node id="IO_CMP_CCLStructuralParameters_thetaCCLHO"><data key="label">CCL hydrophobic-pore mean contact angle</data><data key="description">Pore-volume-weighted arithmetic mean of contact angles above 90 degrees, considering cathode-catalyst-layer pore volume remaining after ionomer filling.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CCLStructuralParameters_thetaCCLHO</data></node><node id="IO_CMP_CCLFractionHydrophobicPores_XHO"><data key="label">CCL secondary-pore hydrophobic volume fraction</data><data key="description">Fraction of secondary-pore volume with hydrophobic wetting behavior, corresponding to contact angles greater than 90 degrees.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CCLFractionHydrophobicPores_XHO</data></node><node id="IO_SIM_PoreSizeRange"><data key="label">Pore-radius axis data</data><data key="description">Array of pore-radius values used as the size axis for evaluating cathode-catalyst-layer pore-size and contact-angle distributions.</data><data key="semantic_role">Data</data><data key="io_id">IO_SIM_PoreSizeRange</data></node><node id="IO_CMP_CCLRefinedPoreSizeDistributionContactAngleDistribution_PSD"><data key="label">CCL refined pore-size-distribution data</data><data key="description">Normalized pore-volume density per natural-logarithmic interval of pore radius, combining primary and secondary pores after accounting for ionomer filling.</data><data key="semantic_role">Data</data><data key="io_id">IO_CMP_CCLRefinedPoreSizeDistributionContactAngleDistribution_PSD</data></node><node id="IO_SIM_ContactAngleRange"><data key="label">Contact-angle cosine axis data</data><data key="description">Array of contact-angle cosine values used as the angular axis for evaluating the cathode-catalyst-layer contact-angle distribution.</data><data key="semantic_role">Data</data><data key="io_id">IO_SIM_ContactAngleRange</data></node><node id="IO_CMP_CCLRefinedPoreSizeDistributionContactAngleDistribution_CAD"><data key="label">CCL contact-angle-distribution data</data><data key="description">Normalized cathode-catalyst-layer contact-angle distribution on the specified cosine grid, combining primary- and secondary-pore contributions.</data><data key="semantic_role">Data</data><data key="io_id">IO_CMP_CCLRefinedPoreSizeDistributionContactAngleDistribution_CAD</data></node><node id="IO_CMP_PercolationThreshold"><data key="label">Percolation threshold X_c</data><data key="description">PDF interface variable IO_CMP_PercolationThreshold; expected scalar value; reported unit [-]; PDF page(s) 3, 7.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_PercolationThreshold</data></node><node id="IO_CMP_VolumeFractionOfElectrolyte"><data key="label">Volume fraction of electrolyte X_el</data><data key="description">PDF interface variable IO_CMP_VolumeFractionOfElectrolyte; expected scalar value; reported unit [-]; PDF page(s) 3, 7.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_VolumeFractionOfElectrolyte</data></node><node id="IO_CMP_VolumeFractionOfSolidPhasePtC"><data key="label">Volume fraction of solid phase (Pt + C) X_PtC</data><data key="description">PDF interface variable IO_CMP_VolumeFractionOfSolidPhasePtC; expected scalar value; reported unit [-]; PDF page(s) 3, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_VolumeFractionOfSolidPhasePtC</data></node><node id="IO_CMP_CCLPorosity"><data key="label">Volume fraction of pores in CCL X_p_CCL</data><data key="description">PDF interface variable IO_CMP_CCLPorosity; expected scalar value; reported unit [-]; PDF page(s) 3, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CCLPorosity</data></node><node id="IO_CMP_VolumeFractionOfTotalHIPoresInCCL"><data key="label">Volume fraction of total HI pores in CCL X_p_HI</data><data key="description">PDF interface variable IO_CMP_VolumeFractionOfTotalHIPoresInCCL; expected scalar value; reported unit [-]; PDF page(s) 3, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_VolumeFractionOfTotalHIPoresInCCL</data></node><node id="IO_CMP_VolumeFractionOfHIPrimaryPoresInCCL"><data key="label">Volume fraction of HI primary pores in CCL X_p_HI_mu</data><data key="description">PDF interface variable IO_CMP_VolumeFractionOfHIPrimaryPoresInCCL; expected scalar value; reported unit [-]; PDF page(s) 3, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_VolumeFractionOfHIPrimaryPoresInCCL</data></node><node id="IO_CMP_VolumeFractionOfHISecondaryPoresInCCL"><data key="label">Volume fraction of HI secondary pores in CCL X_p_HI_M</data><data key="description">PDF interface variable IO_CMP_VolumeFractionOfHISecondaryPoresInCCL; expected scalar value; reported unit [-]; PDF page(s) 3, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_VolumeFractionOfHISecondaryPoresInCCL</data></node><node id="IO_CMP_RatioOfHiPrimaryToSecondaryPores"><data key="label">Ratio of HI primary to secondary pores chi_CCL</data><data key="description">PDF interface variable IO_CMP_RatioOfHiPrimaryToSecondaryPores; expected scalar value; reported unit [-]; PDF page(s) 3, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_RatioOfHiPrimaryToSecondaryPores</data></node><node id="IO_CMP_VolumeFractionOfHOPoresInCCL"><data key="label">Volume fraction of HO pores in CCL X_p_HO</data><data key="description">PDF interface variable IO_CMP_VolumeFractionOfHOPoresInCCL; expected scalar value; reported unit [-]; PDF page(s) 3, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_VolumeFractionOfHOPoresInCCL</data></node><node id="IO_CMP_MPLPorosity"><data key="label">Volume fraction of pores in MPL X_p_MPL</data><data key="description">PDF interface variable IO_CMP_MPLPorosity; expected scalar value; reported unit [-]; PDF page(s) 3, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_MPLPorosity</data></node><node id="IO_CMP_VolumeFractionOfPrimaryPoresInMPL"><data key="label">Volume fraction of primary pores in MPL X_p_MPL_mu</data><data key="description">PDF interface variable IO_CMP_VolumeFractionOfPrimaryPoresInMPL; expected scalar value; reported unit [-]; PDF page(s) 3, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_VolumeFractionOfPrimaryPoresInMPL</data></node><node id="IO_CMP_VolumeFractionOfSecondaryPoresInMPL"><data key="label">Volume fraction of secondary pores in MPL X_p_MPL_M</data><data key="description">PDF interface variable IO_CMP_VolumeFractionOfSecondaryPoresInMPL; expected scalar value; reported unit [-]; PDF page(s) 3, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_VolumeFractionOfSecondaryPoresInMPL</data></node><node id="IO_CMP_RatioOfMPLPoresToCracks"><data key="label">Ratio of MPL pores to cracks chi_MPL</data><data key="description">PDF interface variable IO_CMP_RatioOfMPLPoresToCracks; expected scalar value; reported unit [-]; PDF page(s) 3, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_RatioOfMPLPoresToCracks</data></node><node id="IO_CMP_VolumeFractionOfPrimaryPoresInGDL"><data key="label">Volume fraction of primary pores in GDL X_p_GDL_mu</data><data key="description">PDF interface variable IO_CMP_VolumeFractionOfPrimaryPoresInGDL; expected scalar value; reported unit [-]; PDF page(s) 3, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_VolumeFractionOfPrimaryPoresInGDL</data></node><node id="IO_CMP_VolumeFractionOfSecondaryPoresInGDL"><data key="label">Volume fraction of secondary pores in GDL X_p_GDL_M</data><data key="description">PDF interface variable IO_CMP_VolumeFractionOfSecondaryPoresInGDL; expected scalar value; reported unit [-]; PDF page(s) 3, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_VolumeFractionOfSecondaryPoresInGDL</data></node><node id="IO_CMP_RelativeWaterVolumeFractionInIonomer"><data key="label">Relative water volume fraction in ionomer epsilon_el</data><data key="description">PDF interface variable IO_CMP_RelativeWaterVolumeFractionInIonomer; expected scalar value; reported unit [-]; PDF page(s) 3, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_RelativeWaterVolumeFractionInIonomer</data></node><node id="IO_CMP_CriticalRadiusOfBottleneckPoresInCcl"><data key="label">Critical radius of bottleneck pores in CCL r_crit</data><data key="description">PDF interface variable IO_CMP_CriticalRadiusOfBottleneckPoresInCcl; expected scalar value; reported unit [m]; PDF page(s) 3, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CriticalRadiusOfBottleneckPoresInCcl</data></node><node id="IO_CMP_CharacteristicRadiusOfPrimaryHiPores"><data key="label">Characteristic radius of primary HI pores r_mu_HI</data><data key="description">PDF interface variable IO_CMP_CharacteristicRadiusOfPrimaryHiPores; expected scalar value; reported unit [m]; PDF page(s) 3, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CharacteristicRadiusOfPrimaryHiPores</data></node><node id="IO_CMP_CharacteristicRadiusOfSecondaryHiPores"><data key="label">Characteristic radius of secondary HI pores r_M_HI</data><data key="description">PDF interface variable IO_CMP_CharacteristicRadiusOfSecondaryHiPores; expected scalar value; reported unit [m]; PDF page(s) 4, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CharacteristicRadiusOfSecondaryHiPores</data></node><node id="IO_CMP_CharacteristicRadiusOfHoPoresInCcl"><data key="label">Characteristic radius of HO pores in CCL r_HO</data><data key="description">PDF interface variable IO_CMP_CharacteristicRadiusOfHoPoresInCcl; expected scalar value; reported unit [m]; PDF page(s) 4, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CharacteristicRadiusOfHoPoresInCcl</data></node><node id="IO_CMP_RadiusOfWaterFilledPoresInIonomer"><data key="label">Radius of water-filled pores in ionomer r_el</data><data key="description">PDF interface variable IO_CMP_RadiusOfWaterFilledPoresInIonomer; expected scalar value; reported unit [m]; PDF page(s) 4, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_RadiusOfWaterFilledPoresInIonomer</data></node><node id="IO_CMP_MinimalPoreRadiusInCcl"><data key="label">Minimal pore radius in CCL r_min</data><data key="description">PDF interface variable IO_CMP_MinimalPoreRadiusInCcl; expected scalar value; reported unit [m]; PDF page(s) 4, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_MinimalPoreRadiusInCcl</data></node><node id="IO_CMP_MaximalPoreRadiusInCcl"><data key="label">Maximal pore radius in CCL r_max</data><data key="description">PDF interface variable IO_CMP_MaximalPoreRadiusInCcl; expected scalar value; reported unit [m]; PDF page(s) 4, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_MaximalPoreRadiusInCcl</data></node><node id="IO_CMP_ReferenceCapillaryRadiusInCclHoPores"><data key="label">Reference capillary radius in CCL HO pores r_c_ref</data><data key="description">PDF interface variable IO_CMP_ReferenceCapillaryRadiusInCclHoPores; expected scalar value; reported unit [m]; PDF page(s) 4, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_ReferenceCapillaryRadiusInCclHoPores</data></node><node id="IO_CMP_CharacteristicRadiusOfPoresInMpl"><data key="label">Characteristic radius of pores in MPL r_MPL_mu</data><data key="description">PDF interface variable IO_CMP_CharacteristicRadiusOfPoresInMpl; expected scalar value; reported unit [m]; PDF page(s) 4, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_CharacteristicRadiusOfPoresInMpl</data></node><node id="IO_CMP_RadiusOfPoresCorrespondingToCracksInMpl"><data key="label">Radius of pores corresponding to cracks in MPL r_MPL_M</data><data key="description">PDF interface variable IO_CMP_RadiusOfPoresCorrespondingToCracksInMpl; expected scalar value; reported unit [m]; PDF page(s) 4, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_RadiusOfPoresCorrespondingToCracksInMpl</data></node><node id="IO_CMP_MinimalPoreRadiusInMpl"><data key="label">Minimal pore radius in MPL r_MPL_min</data><data key="description">PDF interface variable IO_CMP_MinimalPoreRadiusInMpl; expected scalar value; reported unit [m]; PDF page(s) 4, 8.</data><data key="semantic_role">Property</data><data key="io_id">IO_CMP_MinimalPoreRadi