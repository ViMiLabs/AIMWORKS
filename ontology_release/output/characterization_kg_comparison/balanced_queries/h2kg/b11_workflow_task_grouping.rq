PREFIX h2kg: <https://w3id.org/h2kg/hydrogen-ontology#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?caseKey ?workflowLabel (COUNT(DISTINCT ?task) AS ?taskCount) WHERE {
  GRAPH ?semanticGraph {
    ?workflow a h2kg:Process ; rdfs:label ?workflowLabel ; h2kg:hasPart ?task .
  }
  FILTER(STRSTARTS(STR(?semanticGraph), "https://w3id.org/h2kg/examples/characterization/graph/semantic/"))
  BIND(STRAFTER(STR(?semanticGraph), "https://w3id.org/h2kg/examples/characterization/graph/semantic/") AS ?caseKey)
} GROUP BY ?caseKey ?workflowLabel ORDER BY ?caseKey
