PREFIX chameo: <https://w3id.org/emmo/domain/characterisation-methodology/chameo#>
PREFIX emmo: <https://w3id.org/emmo#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?caseKey ?workflowLabel (COUNT(DISTINCT ?task) AS ?taskCount) WHERE {
  GRAPH ?semanticGraph {
    ?workflow a chameo:CharacterisationWorkflow ; rdfs:label ?workflowLabel ; chameo:hasCharacterisationTask ?task .
  }
  FILTER(STRSTARTS(STR(?semanticGraph), "https://example.org/aimworks/chameo-characterization/graph/semantic/"))
  BIND(STRAFTER(STR(?semanticGraph), "https://example.org/aimworks/chameo-characterization/graph/semantic/") AS ?caseKey)
} GROUP BY ?caseKey ?workflowLabel ORDER BY ?caseKey
