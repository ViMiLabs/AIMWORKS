PREFIX h2kg: <https://w3id.org/h2kg/hydrogen-ontology#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?caseKey (COUNT(DISTINCT ?measurement) AS ?measurementCount) (COUNT(DISTINCT ?result) AS ?resultCount) WHERE {
  GRAPH ?semanticGraph { ?measurement a h2kg:Measurement . OPTIONAL { ?result a h2kg:DataPoint . } }
  FILTER(STRSTARTS(STR(?semanticGraph), "https://w3id.org/h2kg/examples/characterization/graph/semantic/")) BIND(STRAFTER(STR(?semanticGraph), "https://w3id.org/h2kg/examples/characterization/graph/semantic/") AS ?caseKey)
} GROUP BY ?caseKey ORDER BY ?caseKey
