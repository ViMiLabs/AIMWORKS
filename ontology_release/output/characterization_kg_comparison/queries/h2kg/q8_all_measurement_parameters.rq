PREFIX h2kg: <https://w3id.org/h2kg/hydrogen-ontology#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?caseKey ?parameterLabel ?value ?unit WHERE { { GRAPH <https://w3id.org/h2kg/examples/characterization/graph/semantic/tem> {
    ?measurement a h2kg:Measurement ; h2kg:hasParameter ?parameter .
    ?parameter rdfs:label ?parameterLabel ; h2kg:ofProperty ?property .
    OPTIONAL { ?property h2kg:hasQuantityValue ?qv . ?qv qudt:numericValue ?value ; qudt:unit ?unit . }
    BIND("tem" AS ?caseKey)
  } } UNION
{ GRAPH <https://w3id.org/h2kg/examples/characterization/graph/semantic/sem> {
    ?measurement a h2kg:Measurement ; h2kg:hasParameter ?parameter .
    ?parameter rdfs:label ?parameterLabel ; h2kg:ofProperty ?property .
    OPTIONAL { ?property h2kg:hasQuantityValue ?qv . ?qv qudt:numericValue ?value ; qudt:unit ?unit . }
    BIND("sem" AS ?caseKey)
  } } UNION
{ GRAPH <https://w3id.org/h2kg/examples/characterization/graph/semantic/afm> {
    ?measurement a h2kg:Measurement ; h2kg:hasParameter ?parameter .
    ?parameter rdfs:label ?parameterLabel ; h2kg:ofProperty ?property .
    OPTIONAL { ?property h2kg:hasQuantityValue ?qv . ?qv qudt:numericValue ?value ; qudt:unit ?unit . }
    BIND("afm" AS ?caseKey)
  } } UNION
{ GRAPH <https://w3id.org/h2kg/examples/characterization/graph/semantic/fib_sem> {
    ?measurement a h2kg:Measurement ; h2kg:hasParameter ?parameter .
    ?parameter rdfs:label ?parameterLabel ; h2kg:ofProperty ?property .
    OPTIONAL { ?property h2kg:hasQuantityValue ?qv . ?qv qudt:numericValue ?value ; qudt:unit ?unit . }
    BIND("fib_sem" AS ?caseKey)
  } } UNION
{ GRAPH <https://w3id.org/h2kg/examples/characterization/graph/semantic/ic_sem> {
    ?measurement a h2kg:Measurement ; h2kg:hasParameter ?parameter .
    ?parameter rdfs:label ?parameterLabel ; h2kg:ofProperty ?property .
    OPTIONAL { ?property h2kg:hasQuantityValue ?qv . ?qv qudt:numericValue ?value ; qudt:unit ?unit . }
    BIND("ic_sem" AS ?caseKey)
  } } UNION
{ GRAPH <https://w3id.org/h2kg/examples/characterization/graph/semantic/neutron_tomography> {
    ?measurement a h2kg:Measurement ; h2kg:hasParameter ?parameter .
    ?parameter rdfs:label ?parameterLabel ; h2kg:ofProperty ?property .
    OPTIONAL { ?property h2kg:hasQuantityValue ?qv . ?qv qudt:numericValue ?value ; qudt:unit ?unit . }
    BIND("neutron_tomography" AS ?caseKey)
  } } UNION
{ GRAPH <https://w3id.org/h2kg/examples/characterization/graph/semantic/synchrotron_radiography> {
    ?measurement a h2kg:Measurement ; h2kg:hasParameter ?parameter .
    ?parameter rdfs:label ?parameterLabel ; h2kg:ofProperty ?property .
    OPTIONAL { ?property h2kg:hasQuantityValue ?qv . ?qv qudt:numericValue ?value ; qudt:unit ?unit . }
    BIND("synchrotron_radiography" AS ?caseKey)
  } } UNION
{ GRAPH <https://w3id.org/h2kg/examples/characterization/graph/semantic/synchrotron_tomography> {
    ?measurement a h2kg:Measurement ; h2kg:hasParameter ?parameter .
    ?parameter rdfs:label ?parameterLabel ; h2kg:ofProperty ?property .
    OPTIONAL { ?property h2kg:hasQuantityValue ?qv . ?qv qudt:numericValue ?value ; qudt:unit ?unit . }
    BIND("synchrotron_tomography" AS ?caseKey)
  } } } ORDER BY ?caseKey ?parameterLabel
