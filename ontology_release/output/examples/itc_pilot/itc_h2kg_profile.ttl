h2kg:InkToCompositionModel
  a h2kg:Process ;
  skos:prefLabel "Ink-to-Composition Model"@en ;
  rdfs:label "Ink-to-Composition Model"@en ;
  dcterms:description "A computational process that predicts cathode-catalyst-layer composition and wetting descriptors from catalyst, ionomer, pore-structure, wettability, and constituent-density inputs."@en ;
  dcterms:source <https://doi.org/10.1016/j.electacta.2022.140850> ;
  skos:altLabel "IET ink to composition model"@en, "ITC model"@en .

h2kg:PlatinumToCarbonMassRatio
  a h2kg:Property ;
  skos:prefLabel "Platinum-to-carbon mass ratio"@en ;
  rdfs:label "Platinum-to-carbon mass ratio"@en ;
  dcterms:description "Mass ratio of platinum catalyst to carbon support in the catalyst layer."@en ;
  dcterms:source <https://doi.org/10.1016/j.electacta.2022.140850> ;
  skos:altLabel "catalyst-support ratio"@en ;
  skos:notation "mPt:C" ;
  dcterms:identifier "IO_CMP_CatalystSupportRatio" ;
  dcterms:relation h2kg:ITCQuantityGuidance_PlatinumToCarbonMassRatio .

h2kg:ITCQuantityGuidance_PlatinumToCarbonMassRatio
  a qudt:QuantityValue ;
  dcterms:description "Value-free QUDT guidance for Platinum-to-carbon mass ratio; the curated source reports [-]."@en ;
  qudt:unit unit:UNITLESS ;
  qudt:quantityKind quantitykind:Dimensionless ;
  dcterms:source <https://doi.org/10.1016/j.electacta.2022.140850> .

h2kg:IonomerToCarbonRatio
  a h2kg:Property ;
  skos:prefLabel "Ionomer-to-carbon ratio"@en ;
  skos:altLabel "I/C-ratio"@en, "ITC ionomer-to-carbon ratio"@en ;
  dcterms:description "Mass ratio of dry ionomer to carbon support in the catalyst layer."@en ;
  skos:notation "mI:C" ;
  dcterms:source <https://doi.org/10.1016/j.electacta.2022.140850> ;
  rdfs:label "Ionomer-to-carbon ratio"@en ;
  dcterms:identifier "IO_CMP_ICRatio" ;
  dcterms:relation h2kg:ITCQuantityGuidance_IonomerToCarbonRatio .

h2kg:ITCQuantityGuidance_IonomerToCarbonRatio
  a qudt:QuantityValue ;
