  qudt:unit unit:UNITLESS ;
  qudt:quantityKind quantitykind:Dimensionless ;
  dcterms:source <https://doi.org/10.1016/j.electacta.2022.140850> .

h2kg:TotalPoreVolume
  a h2kg:Property ;
  skos:prefLabel "Total pore volume"@en ;
  rdfs:label "Total pore volume"@en ;
  skos:altLabel "ITC total pore volume"@en ;
  dcterms:description "Total volume of primary and secondary pores in the ionomer-free platinum-on-carbon structure per unit mass of carbon."@en ;
