  qudt:unit unit:UNITLESS ;
  qudt:quantityKind quantitykind:Dimensionless ;
  dcterms:source <https://doi.org/10.1016/j.electacta.2022.140850> .

h2kg:IonomerCatalystDispersionParameter
  a h2kg:Property ;
  skos:prefLabel "Ionomer-catalyst dispersion parameter"@en ;
  rdfs:label "Ionomer-catalyst dispersion parameter"@en ;
  dcterms:description "Parameter describing the tendency of ionomer to spread over the platinum-on-carbon surface rather than form larger ionomer aggregates."@en ;
  dcterms:source <https://doi.org/10.1016/j.electacta.2022.140850> ;
  skos:notation "kA" ;
  dcterms:identifier "IO_CMP_IonomerCatalystDispersionParameter" ;
