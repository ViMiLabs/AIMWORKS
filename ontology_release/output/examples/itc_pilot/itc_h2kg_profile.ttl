  dcterms:description "Value-free QUDT guidance for Total pore volume; the curated source reports [m^3/gC]. Values are normalized per unit carbon mass."@en ;
  qudt:unit unit:M3-PER-GM ;
  qudt:quantityKind quantitykind:SpecificVolume ;
  dcterms:source <https://doi.org/10.1016/j.electacta.2022.140850> .

