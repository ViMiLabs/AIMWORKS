     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/h2kg/h2kg-full.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/h2kg/releases/2026-10-14/h2kg-full.owl"/>
        <dcterms:contributor>Institute of Energy Technologies (IET), Theory and Computation of Energy Materials (IET-3), Forschungszentrum Juelich GmbH, 52428 Juelich, Germany</dcterms:contributor>
        <dcterms:creator>Electrochemistry Research Group</dcterms:creator>
        <dcterms:description xml:lang="en">A modular ontology for materials, components, processes, measurements, information entities, characteristics, and provenance in hydrogen electrochemical research.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:publisher>Forschungszentrum Juelich GmbH</dcterms:publisher>
        <dcterms:references rdf:resource="http://purl.org/holy/ns#"/>
        <dcterms:references rdf:resource="https://w3id.org/emmo"/>
        <dcterms:references rdf:resource="https://w3id.org/emmo/domain/electrochemistry"/>
        <dcterms:references rdf:resource="https://w3id.org/emmo/domain/pemfc"/>
        <dcterms:references rdf:resource="https://w3id.org/emmo/domain/characterisation-methodology/chameo#"/>
        <dcterms:references rdf:resource="https://w3id.org/emmo/domain/coating#"/>
        <dcterms:references rdf:resource="https://w3id.org/emmo/domain/equivalent-circuit-model#"/>
        <dcterms:references rdf:resource="https://w3id.org/emmo/domain/manufacturing#"/>
        <dcterms:references rdf:resource="https://w3id.org/emmo/domain/microscopy#"/>
        <dcterms:title xml:lang="en">H2KG Application Ontology for Hydrogen Electrochemical Systems</dcterms:title>
        <rdfs:seeAlso rdf:resource="http://purl.org/holy/ns#BipolarPlate"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/holy/ns#CatalystLayer"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/holy/ns#FuelCellStack"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/holy/ns#GasDiffusionLayer"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/holy/ns#Gasket"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/holy/ns#Membrane"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/holy/ns#MembraneElectrodeAssembly"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/holy/ns#PolymerElectrolyteMembraneFuelCell"/>
        <rdfs:seeAlso rdf:resource="https://vimilabs.github.io/AIMWORKS/ontology/h2kg-v2-external-bridge.ttl"/>
        <rdfs:seeAlso rdf:resource="https://vimilabs.github.io/AIMWORKS/pages/tib-benchmark.html"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_03a0ccc9_21fe_46a1_a143_50147fbe3200"/>
