        <rdfs:subClassOf rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#SupportedMetalCatalyst"/>
        <dcterms:description xml:lang="en">proposed_definition=Dealloyed Pt-Ni alloy nanoparticles supported on high surface area carbon (d-PtNi/C) used as cathode electrocatalyst.; Paper mentions approximate composition Pt3Ni2 after acid dealloying; not present as a dedicated term in ontology.</dcterms:description>
