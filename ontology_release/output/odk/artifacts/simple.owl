    <skos:altLabel xml:lang="en">λ_an</skos:altLabel>
    <skos:altLabel xml:lang="en">λ_anode</skos:altLabel>
    <skos:definition xml:lang="en">Ratio of the molar hydrogen supply rate to the anode to the stoichiometric hydrogen-consumption rate corresponding to the operating current; for a single hydrogen fuel cell the latter is I/(2F).</skos:definition>
