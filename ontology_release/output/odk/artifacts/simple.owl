    <skos:altLabel xml:lang="en">ink density</skos:altLabel>
    <skos:altLabel xml:lang="en">ρ_b</skos:altLabel>
    <skos:definition xml:lang="en">A property denoting bulk density computed from mass/volume of printed lattice body.</skos:definition>
    <skos:prefLabel xml:lang="en">Bulk Density</skos:prefLabel>
