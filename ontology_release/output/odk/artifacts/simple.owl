    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/homepage"/>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#appliesToProfile -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#appliesToProfile">
        <terms:description xml:lang="en">An annotation property stating which H2KG application profile or profiles explicitly include a term in their published module.</terms:description>
        <rdfs:label xml:lang="en">appliesToProfile</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#canonicalSemanticRole -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#canonicalSemanticRole">
        <rdfs:label xml:lang="en">canonical semantic role</rdfs:label>
        <skos:definition xml:lang="en">Records the canonical H2KG semantic role assigned after separating scientific identity from a contextual workflow role.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#correctionAction -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#correctionAction">
        <rdfs:label xml:lang="en">correction action</rdfs:label>
        <skos:definition xml:lang="en">Records the apply, retain, split, replace, or safe-deprecation action used for a taxonomy resource.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#definitionStatus -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#definitionStatus">
        <rdfs:label xml:lang="en">definition status</rdfs:label>
        <skos:definition xml:lang="en">Records whether a definition is sourced, curated, structural, or retained as legacy content.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#governanceStatus -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#governanceStatus">
        <rdfs:label xml:lang="en">governance status</rdfs:label>
        <skos:definition xml:lang="en">Records the approved or legacy governance state of an H2KG resource.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#migrationAction -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#migrationAction">
        <rdfs:label xml:lang="en">migration action</rdfs:label>
        <skos:definition xml:lang="en">Records how a resource is handled during migration to the H2KG v2 taxonomy.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#taxonomyModule -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#taxonomyModule">
        <rdfs:label xml:lang="en">taxonomy module</rdfs:label>
        <skos:definition xml:lang="en">Identifies the H2KG module in which a reusable class is maintained.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#taxonomyTopBranch -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#taxonomyTopBranch">
        <rdfs:label xml:lang="en">taxonomy top branch</rdfs:label>
        <skos:definition xml:lang="en">Identifies the top-level H2KG branch reached by a class.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#technologyApplicability -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#technologyApplicability">
        <rdfs:label xml:lang="en">technology applicability</rdfs:label>
        <skos:definition xml:lang="en">Identifies a hydrogen or electrochemical technology profile in which a reusable class is explicitly applicable.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/ns/prov#generated -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#generated"/>
    


    <!-- http://www.w3.org/ns/prov#used -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#used"/>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#atCurrentDensity -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#atCurrentDensity">
        <terms:description xml:lang="en">An object property relating a data point to the current-density value at which it is reported.</terms:description>
        <rdfs:label xml:lang="en">atCurrentDensity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#fromMeasurement -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#fromMeasurement">
        <terms:description xml:lang="en">An object property relating a data point to the measurement from which it was generated.</terms:description>
        <rdfs:label xml:lang="en">fromMeasurement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#hasInputData -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#hasInputData">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
        <terms:description xml:lang="en">An object property relating a process or measurement to data used as an input.</terms:description>
        <rdfs:label xml:lang="en">hasInputData</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#hasInputMaterial -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#hasInputMaterial">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
        <terms:description xml:lang="en">An object property relating a process or measurement to a material entity that serves as an input.</terms:description>
        <rdfs:label xml:lang="en">hasInputMaterial</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#hasMeasurementSubject -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#hasMeasurementSubject">
        <rdfs:label xml:lang="en">has measurement subject</rdfs:label>
        <skos:definition xml:lang="en">Relates a measurement to the material, specimen, component, or system whose characteristics are investigated.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#hasMetadata -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#hasMetadata">
        <terms:description xml:lang="en">An object property relating a resource to metadata that describes its identity, provenance, structure, or contextual information.</terms:description>
        <rdfs:label xml:lang="en">hasMetadata</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#hasOutputData -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#hasOutputData">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#generated"/>
        <terms:description xml:lang="en">An object property relating a measurement or process to data generated as an output.</terms:description>
        <rdfs:label xml:lang="en">hasOutputData</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#hasOutputMaterial -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#hasOutputMaterial">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#generated"/>
        <terms:description xml:lang="en">An object property relating a process to a material entity produced as an output.</terms:description>
        <rdfs:label xml:lang="en">hasOutputMaterial</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#hasParameter -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#hasParameter">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
        <terms:description xml:lang="en">Relates a process or measurement occurrence to a Parameter record that specifies one selected workflow condition.</terms:description>
        <rdfs:label xml:lang="en">hasParameter</rdfs:label>
        <skos:definition xml:lang="en">Relates a process or measurement occurrence to a Parameter record that specifies one selected workflow condition.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#hasPart -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#hasPart">
        <owl:inverseOf rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#isPartOf"/>
        <terms:description xml:lang="en">An object property relating an entity or process to a constituent part.</terms:description>
        <rdfs:label xml:lang="en">hasPart</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#hasQuantityValue -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#hasQuantityValue">
        <terms:description xml:lang="en">Relates a property occurrence to its QUDT quantity-value representation.</terms:description>
        <rdfs:label xml:lang="en">hasQuantityValue</rdfs:label>
        <skos:definition xml:lang="en">Relates a property occurrence to its QUDT quantity-value representation.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#hasReferenceScale -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#hasReferenceScale">
        <rdfs:label xml:lang="en">has reference scale</rdfs:label>
        <skos:definition xml:lang="en">Relates an information entity or result record to the reference scale against which a potential or related quantity is expressed.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#hasSubProcess -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#hasSubProcess">
        <owl:inverseOf rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#isSubProcessOf"/>
        <terms:description xml:lang="en">An object property relating a process to a subprocess that forms part of its overall execution.</terms:description>
        <rdfs:label xml:lang="en">hasSubProcess</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#isCharacteristicOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#isCharacteristicOf">
        <rdfs:label xml:lang="en">is characteristic of</rdfs:label>
        <skos:definition xml:lang="en">Relates a characteristic occurrence to the resource that bears or is described by that characteristic. More specific bearer constraints are expressed in workflow profiles.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#isPartOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#isPartOf">
        <terms:description xml:lang="en">An object property relating an entity or process to a larger entity or process of which it forms a part.</terms:description>
        <rdfs:label xml:lang="en">isPartOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#isSubProcessOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#isSubProcessOf">
        <terms:description xml:lang="en">An object property relating a subprocess to the larger process of which it forms a part.</terms:description>
        <rdfs:label xml:lang="en">isSubProcessOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#measures -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#measures">
        <terms:description xml:lang="en">An object property relating a measurement to a property that it determines.</terms:description>
        <rdfs:label xml:lang="en">measures</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#normalizedTo -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#normalizedTo">
        <terms:description xml:lang="en">An object property relating a property or result to the basis used for its normalization.</terms:description>
        <rdfs:label xml:lang="en">normalizedTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#ofProperty -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#ofProperty">
        <terms:description xml:lang="en">Relates an information record, such as a Parameter or DataPoint, to the property occurrence that the record specifies or reports.</terms:description>
        <rdfs:label xml:lang="en">ofProperty</rdfs:label>
        <skos:definition xml:lang="en">Relates an information record, such as a Parameter or DataPoint, to the property occurrence that the record specifies or reports.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#referenceElectrode -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#referenceElectrode">
        <terms:description xml:lang="en">An object property relating an electrochemical measurement setup or process to the reference electrode it uses.</terms:description>
        <terms:isReplacedBy rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#hasReferenceScale"/>
        <terms:isReplacedBy rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#usesReferenceElectrode"/>
        <rdfs:label xml:lang="en">referenceElectrode</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#usesInstrument -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#usesInstrument">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
        <terms:description xml:lang="en">An object property relating a process or measurement to an instrument used to carry it out or support it.</terms:description>
        <rdfs:label xml:lang="en">usesInstrument</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#usesReferenceElectrode -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#usesReferenceElectrode">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
        <rdfs:label xml:lang="en">uses reference electrode</rdfs:label>
        <skos:definition xml:lang="en">Relates an electrochemical measurement to the reference electrode used in its measurement arrangement.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/h2kg/hydrogen-ontology#usesSoftware -->

    <owl:ObjectProperty rdf:about="https://w3id.org/h2kg/hydrogen-ontology#usesSoftware">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
        <rdfs:label xml:lang="en">uses software</rdfs:label>
        <skos:definition xml:lang="en">Relates a process to a software artifact used to execute, control, process, analyze, simulate, or visualize its data.</skos:definition>
    </owl:ObjectProperty>
</rdf:RDF>



