  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#OxygenVolumeFraction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Oxygen Volume Fraction</rdfs:label>
