    <skos:altLabel xml:lang="en">Dynamic Vapor Sorption Measurement</skos:altLabel>
    <skos:altLabel xml:lang="en">dynamic vapor sorption</skos:altLabel>
    <skos:definition xml:lang="en">A sorption measurement that monitors specimen mass while controlling vapor activity or relative humidity to determine vapor uptake, desorption, or sorption kinetics.</skos:definition>
    <skos:prefLabel xml:lang="en">Dynamic vapor sorption</skos:prefLabel>
    <h2kg:canonicalSemanticRole>Measurement</h2kg:canonicalSemanticRole>
    <h2kg:correctionAction>retain</h2kg:correctionAction>
