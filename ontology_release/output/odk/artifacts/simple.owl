  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#ScanningElectronMicroscopyImaging">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Scanning electron microscopy</rdfs:label>
    <dcterms:description xml:lang="en">A measurement process that uses scanning electron microscopy imaging to determine catalyst particle diameter, catalyst-layer morphology, catalyst-layer thickness, grain size, and carbon nanotube forest height using SEM Instrument and generating SEM Image Dataset, SEM Micrograph Dataset, and Microstructure Image Dataset.</dcterms:description>
    <dcterms:provenance xml:lang="en">Migrated from the asserted H2KG v1 source through the versioned taxonomy registry.</dcterms:provenance>
    <rdfs:subClassOf rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#ElectronMicroscopyMeasurement"/>
    <skos:altLabel xml:lang="en">SEM</skos:altLabel>
    <skos:altLabel xml:lang="en">SEM images</skos:altLabel>
    <skos:altLabel xml:lang="en">SEM imaging</skos:altLabel>
    <skos:altLabel xml:lang="en">Scanning Electron Microscopy Imaging</skos:altLabel>
    <skos:altLabel xml:lang="en">scanning electron microscopy</skos:altLabel>
    <skos:definition xml:lang="en">A measurement process that uses scanning electron microscopy imaging to determine catalyst particle diameter, catalyst-layer morphology, catalyst-layer thickness, grain size, and carbon nanotube forest height using SEM Instrument and generating SEM Image Dataset, SEM Micrograph Dataset, and Microstructure Image Dataset.</skos:definition>
    <skos:prefLabel xml:lang="en">Scanning electron microscopy</skos:prefLabel>
    <h2kg:canonicalSemanticRole>Measurement</h2kg:canonicalSemanticRole>
    <h2kg:correctionAction>retain</h2kg:correctionAction>
    <h2kg:definitionStatus>source</h2kg:definitionStatus>
