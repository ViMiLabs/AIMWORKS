  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#QuantumDot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Quantum Dot</rdfs:label>
    <dcterms:description xml:lang="en">A nanoscale material structure in which charge carriers are confined in all three spatial dimensions, resulting in discrete, size-dependent electronic states.</dcterms:description>
    <dcterms:provenance xml:lang="en">Migrated from the asserted H2KG v1 source through the versioned taxonomy registry.</dcterms:provenance>
    <rdfs:subClassOf rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#MaterialEntity"/>
    <skos:altLabel xml:lang="en">QD</skos:altLabel>
    <skos:altLabel xml:lang="en">colloidal quantum dot</skos:altLabel>
    <skos:definition xml:lang="en">A nanoscale material structure in which charge carriers are confined in all three spatial dimensions, resulting in discrete, size-dependent electronic states.</skos:definition>
    <skos:prefLabel xml:lang="en">Quantum Dot</skos:prefLabel>
    <h2kg:canonicalSemanticRole>Matter</h2kg:canonicalSemanticRole>
    <h2kg:correctionAction>retain</h2kg:correctionAction>
    <h2kg:definitionStatus>curated</h2kg:definitionStatus>
    <h2kg:governanceStatus>approved</h2kg:governanceStatus>
    <h2kg:migrationAction>retain</h2kg:migrationAction>
    <h2kg:taxonomyModule>core</h2kg:taxonomyModule>
    <h2kg:taxonomyTopBranch>Matter</h2kg:taxonomyTopBranch>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#BulkDensity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bulk Density</rdfs:label>
    <dcterms:description xml:lang="en">A property denoting bulk density computed from mass/volume of printed lattice body.</dcterms:description>
