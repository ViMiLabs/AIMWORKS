    <h2kg:taxonomyModule>core</h2kg:taxonomyModule>
    <h2kg:taxonomyTopBranch>Characteristic</h2kg:taxonomyTopBranch>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#AnodePotential">
