  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#DynamicVaporSorptionMeasurement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dynamic vapor sorption</rdfs:label>
    <dcterms:description xml:lang="en">A sorption measurement that monitors specimen mass while controlling vapor activity or relative humidity to determine vapor uptake, desorption, or sorption kinetics.</dcterms:description>
    <dcterms:provenance xml:lang="en">Migrated from the asserted H2KG v1 source through the versioned taxonomy registry.</dcterms:provenance>
