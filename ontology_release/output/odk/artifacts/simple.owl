    <skos:definition xml:lang="en">A dimensionless coefficient in a suspension-viscosity model that quantifies the first-order contribution of dispersed-particle volume fraction to relative viscosity.</skos:definition>
    <skos:prefLabel xml:lang="en">Suspension intrinsic-viscosity coefficient</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Use for the intrinsic-viscosity coefficient in Krieger-Dougherty-type suspension models, not for polymer-solution intrinsic viscosity.</skos:scopeNote>
    <h2kg:canonicalSemanticRole>Characteristic</h2kg:canonicalSemanticRole>
    <h2kg:correctionAction>apply</h2kg:correctionAction>
    <h2kg:definitionStatus>curated</h2kg:definitionStatus>
