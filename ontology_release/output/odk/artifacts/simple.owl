  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#AcidBaseTitrationMeasurement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Acid-base titration</rdfs:label>
    <dcterms:description xml:lang="en">A composition measurement in which an acidic or basic titrant is added to determine the amount or concentration of a complementary basic or acidic analyte.</dcterms:description>
    <dcterms:provenance xml:lang="en">Migrated from the asserted H2KG v1 source through the versioned taxonomy registry.</dcterms:provenance>
