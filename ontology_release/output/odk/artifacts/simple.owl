    <skos:altLabel xml:lang="en">acid-base titration</skos:altLabel>
    <skos:definition xml:lang="en">A composition measurement in which an acidic or basic titrant is added to determine the amount or concentration of a complementary basic or acidic analyte.</skos:definition>
    <skos:prefLabel xml:lang="en">Acid-base titration</skos:prefLabel>
