    <rdfs:label xml:lang="en">fromMeasurement</rdfs:label>
    <dcterms:description xml:lang="en">An object property relating a data point to the measurement from which it was generated.</dcterms:description>
    <rdfs:domain rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#DataPoint"/>
    <rdfs:range rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#Measurement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#usesSoftware">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">uses software</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#Process"/>
    <rdfs:range rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#SoftwareArtifact"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
    <skos:definition xml:lang="en">Relates a process to a software artifact used to execute, control, process, analyze, simulate, or visualize its data.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#canonicalSemanticRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">canonical semantic role</rdfs:label>
    <skos:definition xml:lang="en">Records the canonical H2KG semantic role assigned after separating scientific identity from a contextual workflow role.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#correctionAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">correction action</rdfs:label>
    <skos:definition xml:lang="en">Records the apply, retain, split, replace, or safe-deprecation action used for a taxonomy resource.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#usesReferenceElectrode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">uses reference electrode</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#Measurement"/>
    <rdfs:range rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#ReferenceElectrode"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
    <skos:definition xml:lang="en">Relates an electrochemical measurement to the reference electrode used in its measurement arrangement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#normalizedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">normalizedTo</rdfs:label>
    <dcterms:description xml:lang="en">An object property relating a property or result to the basis used for its normalization.</dcterms:description>
    <rdfs:range rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#NormalizationBasis"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#hasInputMaterial">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasInputMaterial</rdfs:label>
    <dcterms:description xml:lang="en">An object property relating a process or measurement to a material entity that serves as an input.</dcterms:description>
    <rdfs:domain rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#Process"/>
    <rdfs:range rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#Matter"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#migrationAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">migration action</rdfs:label>
    <skos:definition xml:lang="en">Records how a resource is handled during migration to the H2KG v2 taxonomy.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#technologyApplicability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">technology applicability</rdfs:label>
    <skos:definition xml:lang="en">Identifies a hydrogen or electrochemical technology profile in which a reusable class is explicitly applicable.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#usesInstrument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">usesInstrument</rdfs:label>
    <dcterms:description xml:lang="en">An object property relating a process or measurement to an instrument used to carry it out or support it.</dcterms:description>
    <rdfs:domain rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#Process"/>
    <rdfs:range rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#Instrument"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/h2kg/hydrogen-ontology#hasMetadata">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasMetadata</rdfs:label>
    <dcterms:description xml:lang="en">An object property relating a resource to metadata that describes its identity, provenance, structure, or contextual information.</dcterms:description>
    <rdfs:range rdf:resource="https://w3id.org/h2kg/hydrogen-ontology#Metadata"/>
  </rdf:Description>
</rdf:RDF>
