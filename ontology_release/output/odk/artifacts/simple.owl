<?xml version="1.0"?>
<rdf:RDF xmlns="http://purl.obolibrary.org/obo/h2kg/h2kg-simple.owl#"
     xml:base="http://purl.obolibrary.org/obo/h2kg/h2kg-simple.owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:hydrogen-ontology="https://w3id.org/h2kg/hydrogen-ontology#">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/h2kg/h2kg-simple.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/h2kg/releases/2026-10-19/h2kg-simple.owl"/>
        <terms:contributor>Institute of Energy Technologies (IET), Theory and Computation of Energy Materials (IET-3), Forschungszentrum Juelich GmbH, 52428 Juelich, Germany</terms:contributor>
        <terms:creator>Electrochemistry Research Group</terms:creator>
        <terms:description xml:lang="en">A modular ontology for materials, components, processes, measurements, information entities, characteristics, and provenance in hydrogen electrochemical research.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:publisher>Forschungszentrum Juelich GmbH</terms:publisher>
        <terms:references rdf:resource="http://purl.org/holy/ns#"/>
        <terms:references rdf:resource="https://w3id.org/emmo"/>
        <terms:references rdf:resource="https://w3id.org/emmo/domain/electrochemistry"/>
        <terms:references rdf:resource="https://w3id.org/emmo/domain/pemfc"/>
        <terms:references rdf:resource="https://w3id.org/emmo/domain/characterisation-methodology/chameo#"/>
        <terms:references rdf:resource="https://w3id.org/emmo/domain/coating#"/>
        <terms:references rdf:resource="https://w3id.org/emmo/domain/equivalent-circuit-model#"/>
        <terms:references rdf:resource="https://w3id.org/emmo/domain/manufacturing#"/>
        <terms:references rdf:resource="https://w3id.org/emmo/domain/microscopy#"/>
        <terms:title xml:lang="en">H₂KG Domain Ontology for Hydrogen Electrochemical Systems</terms:title>
        <rdfs:seeAlso rdf:resource="http://purl.org/holy/ns#BipolarPlate"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/holy/ns#CatalystLayer"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/holy/ns#FuelCellStack"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/holy/ns#GasDiffusionLayer"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/holy/ns#Gasket"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/holy/ns#Membrane"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/holy/ns#MembraneElectrodeAssembly"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/holy/ns#PolymerElectrolyteMembraneFuelCell"/>
        <rdfs:seeAlso rdf:resource="https://vimilabs.github.io/AIMWORKS/ontology/h2kg-v2-external-bridge.ttl"/>
        <rdfs:seeAlso rdf:resource="https://vimilabs.github.io/AIMWORKS/pages/tib-benchmark.html"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_03a0ccc9_21fe_46a1_a143_50147fbe3200"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_31f4498b_aeb1_47b9_8bb8_8b0f55ed6a56"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_4edc0d47_1f7e_4cb2_b710_7f76b76742bc"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_7729c34e_1ae9_403d_b933_1765885e7f29"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_80263f65_7f6c_477a_8818_a85080f74c24"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_a9fc3f77_e48e_4bce_b118_044d608722f6"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_c6605d77_6b8c_42ce_9f7d_befeddb5d5f2"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_f3345489_17f2_4a8e_a74b_6e81f19180a7"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/pemfc#EMMO_01f7c538_3de2_4028_92c1_8cc93832dd76"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/pemfc#EMMO_099d5163_117a_4176_ba48_af54a61c4c8d"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/pemfc#EMMO_143d21b5_d044_4af3_a9f9_22928f2516c1"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/pemfc#EMMO_2ffda0a1_a5fc_4a55_aad8_d91d7cbb101d"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/pemfc#EMMO_6da0e770_9dcf_43ff_865f_21121a53ca67"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/pemfc#EMMO_9d51634d_db42_4697_8dda_58e74a8df826"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/pemfc#EMMO_abe17c61_6a3d_4ec6_b4db_450b5654dbc6"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/pemfc#EMMO_b24401b7_35e4_40be_8c8b_36ee8869cc1a"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/pemfc#EMMO_e072436a_2656_4e03_b600_a7f41c486339"/>
        <rdfs:seeAlso rdf:resource="https://www.fz-juelich.de/en/iet/iet-3/divisions-1/artificial-material-intelligence"/>
        <owl:versionInfo>2.3.0</owl:versionInfo>
        <owl:versionInfo>2026-10-19</owl:versionInfo>
        <foaf:homepage rdf:resource="https://www.fz-juelich.de/en/iet/iet-3/divisions-1/artificial-material-intelligence"/>
    </owl:Ontology>
    


