    <rdfs:label xml:lang="en">Suspension intrinsic-viscosity coefficient</rdfs:label>
    <dcterms:description xml:lang="en">A dimensionless coefficient in a suspension-viscosity model that quantifies the first-order contribution of dispersed-particle volume fraction to relative viscosity.</dcterms:description>
    <dcterms:provenance xml:lang="en">Added as curated H2KG v2 taxonomy scaffolding through the versioned taxonomy registry.</dcterms:provenance>
