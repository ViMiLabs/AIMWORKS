        h2kg:CatalystInk ;
    h2kg:hasMeasurementSubject h2kg:CarbonSupport,
        h2kg:CatalystInk ;
    h2kg:hasOutputData h2kg:AgglomerateSizeDistributionDataset ;
    h2kg:hasParameter h2kg:AgglomerateDiameter,
        h2kg:AgglomerateShape,
        h2kg:ContactSpringCoefficient,
        h2kg:CriticalDielectricConstant,
        h2kg:DEMTimeStep,
        h2kg:DebyeLength,
        h2kg:DielectricConstant,
        h2kg:HamakerConstant,
        h2kg:IonicStrength,
        h2kg:IonomerEquivalentWeight,
        h2kg:IonomerToCarbonRatio,
        h2kg:LogNormalStandardDeviation,
        h2kg:NormalizedPolymerForceFactor,
        h2kg:PolymerForceExponentialCoefficient,
        h2kg:PolymerForceProportionalityConstant,
        h2kg:SimulationParticleCount,
        h2kg:SimulationTimeStepCount,
        h2kg:SolidContentFraction,
        h2kg:Temperature,
        h2kg:Viscosity,
        h2kg:ZetaPotential ;
    h2kg:measures h2kg:CatalystLayerPorosity,
        h2kg:CatalystLayerThickness,
        h2kg:InterAgglomeratePoreSize,
        h2kg:MeanParticleSize .

