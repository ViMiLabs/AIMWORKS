    dcterms:description "Spectrophotometer used to measure optical properties (ΔE, etc.) of printed films (Section 2.4.1.5)."@en ;
    skos:altLabel "EXACT–PANTONE X-rite spectrophotometer"@en ;
    skos:prefLabel "Xrite Spectrophotometer"@en .

h2kg:YieldStress a h2kg:Property ;
    rdfs:label "Yield Stress"@en ;
    dcterms:description "A property denoting stress at which ink transitions from solid-like to liquid-like behavior (taken at G'/G\" crossover)."@en ;
    skos:altLabel "gel strength"@en,
        "shear yield stress"@en,
        "tau_y"@en ;
    skos:prefLabel "Yield Stress"@en ;
    h2kg:hasQuantityValue <https://w3id.org/h2kg/hydrogen-ontology/legacy-source/YieldStress_QV-51299dd13be6> .

h2kg:ZIF67 a h2kg:Matter ;
    rdfs:label "ZIF 67"@en ;
    dcterms:description "Metal–organic framework precursor (ZIF-67) used as template/precursor to generate NCNTFs support during pyrolysis."@en ;
    skos:altLabel "zeolitic imidazolate framework-67"@en ;
    skos:prefLabel "ZIF 67"@en .

h2kg:ZeroShearViscosity a h2kg:Property ;
    rdfs:label "Zero Shear Viscosity"@en ;
    dcterms:description "A property denoting zero shear viscosity and determined in Rheology Measurement."@en ;
    skos:prefLabel "Zero Shear Viscosity"@en ;
    h2kg:hasQuantityValue <https://w3id.org/h2kg/hydrogen-ontology/legacy-source/ZeroShearViscosity_QV-db2315141aa5> .

h2kg:ZetaPotentialAnalyzer a h2kg:Instrument ;
    rdfs:label "Zeta Potential Analyzer"@en ;
    dcterms:description "Instrument used to measure zeta potential; not present as named Instrument in ontology."@en ;
    skos:altLabel "Malvern Zetasizer Nano ZS90 (zeta potential)"@en ;
    skos:prefLabel "Zeta Potential Analyzer"@en .

h2kg:ZetaPotentialStabilityThreshold a h2kg:Parameter ;
    rdfs:label "Zeta Potential Stability Threshold"@en ;
    dcterms:description "A parameter specifying rule-of-thumb absolute zeta potential thresholds for dispersion stability cited in the paper."@en ;
    skos:altLabel "mV stability threshold"@en,
        "mV threshold"@en ;
    skos:prefLabel "Zeta Potential Stability Threshold"@en ;
    h2kg:hasQuantityValue <https://w3id.org/h2kg/hydrogen-ontology/legacy-source/ZetaPotentialStabilityThreshold_QV-984ce40b84db> .

h2kg:ZrB2VolumePercent a h2kg:Parameter ;
    rdfs:label "Zr B 2 Volume Percent"@en ;
    dcterms:description "A parameter specifying zr B 2 volume percent used to characterize Ink Formulation Specification."@en ;
    skos:prefLabel "Zr B 2 Volume Percent"@en ;
    h2kg:hasQuantityValue <https://w3id.org/h2kg/hydrogen-ontology/legacy-source/ZrB2VolumePercent_QV-903d7a32b9aa> .

h2kg:hasPart a owl:ObjectProperty ;
    rdfs:label "hasPart"@en ;
    dcterms:description "An object property relating an entity or process to a constituent part."@en .

h2kg:hasSubProcess a owl:ObjectProperty ;
    rdfs:label "hasSubProcess"@en ;
    dcterms:description "An object property relating a process to a subprocess that forms part of its overall execution."@en .

h2kg:pHMeter a h2kg:Instrument ;
    rdfs:label "pH Meter"@en ;
    dcterms:description "An instrument corresponding to a pH meter and used in surface basicity measurement."@en ;
    skos:prefLabel "pH Meter"@en .

