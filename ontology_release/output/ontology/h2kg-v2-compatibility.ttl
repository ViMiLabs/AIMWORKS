h2kg:MicrobialFuelCellPolarizationMeasurement a h2kg:Measurement ;
    rdfs:label "Microbial Fuel Cell Polarization Measurement"@en ;
    dcterms:description "Polarization/power-curve measurement of a microbial fuel cell (MFC) from open-circuit voltage to 0 mV, used to compute current density and peak power density."@en ;
    skos:prefLabel "Microbial Fuel Cell Polarization Measurement"@en ;
    h2kg:hasInputMaterial h2kg:ActivatedSludge,
        h2kg:AirBreathingCathode,
        h2kg:PotassiumChlorideElectrolyte,
        h2kg:PotassiumPhosphateBuffer,
        h2kg:SodiumAcetate ;
    h2kg:hasMeasurementSubject h2kg:ActivatedSludge,
        h2kg:AirBreathingCathode,
        h2kg:PotassiumChlorideElectrolyte,
        h2kg:PotassiumPhosphateBuffer,
        h2kg:SodiumAcetate ;
    h2kg:hasOutputData h2kg:PolarizationCurveDataset ;
    h2kg:hasParameter h2kg:CellActiveArea,
        h2kg:ExternalResistance,
        h2kg:ScanRate ;
    h2kg:measures h2kg:AnodePotential,
        h2kg:AreaNormalizedAnodeResistance,
        h2kg:AreaNormalizedCathodeResistance,
        h2kg:AreaNormalizedOverallResistance,
        h2kg:CODRemovalEfficiency,
        h2kg:CathodePotential,
        h2kg:CoulombicEfficiency,
        h2kg:CurrentDensity,
        h2kg:MaximumCurrentDensity,
        h2kg:NormalizedEnergyRecovery,
        h2kg:OpenCircuitVoltage,
        h2kg:OperatingVoltage,
        h2kg:PeakPowerDensity,
        h2kg:TotalInternalResistance ;
    h2kg:usesInstrument <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_a9fc3f77_e48e_4bce_b118_044d608722f6>,
        h2kg:AgAgCl,
        h2kg:ElectrochemicalWorkstation ;
    h2kg:usesReferenceElectrode h2kg:AgAgCl .

