    h2kg:hasMeasurementSubject h2kg:CatalystInk ;
    h2kg:hasParameter h2kg:DwellTime,
        h2kg:ShearStrain,
        h2kg:Temperature,
        h2kg:ViscosityRecoveryHighShearDuration,
        h2kg:ViscosityRecoveryShearRateHigh,
        h2kg:ViscosityRecoveryShearRateLow ;
    h2kg:measures h2kg:ThixotropyHysteresisArea,
        h2kg:ThixotropyRecoveryFraction,
        h2kg:Viscosity ;
    h2kg:usesInstrument h2kg:Rheometer .

h2kg:ThreePointFlexuralStrengthMeasurement a h2kg:Measurement ;
    rdfs:label "Three Point Flexural Strength Measurement"@en ;
