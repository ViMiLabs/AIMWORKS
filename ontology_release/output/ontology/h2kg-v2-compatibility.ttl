h2kg:AirBreathingCathodeFabrication a h2kg:Manufacturing ;
    rdfs:label "Air Breathing Cathode Fabrication"@en ;
    dcterms:description "Fabrication of air-breathing cathode pellets from AC/CB/PTFE mixture plus catalyst, pressed onto stainless-steel mesh current collector."@en ;
