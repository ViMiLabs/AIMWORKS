    skos:altLabel "acid-doped PAA/PVA"@en ;
    skos:prefLabel "Acid Doped PAAPVA Hydrogel"@en .

h2kg:AcidDoping a h2kg:Manufacturing ;
    rdfs:label "Acid Doping"@en ;
    dcterms:description "Process of doping cross-linked PAA/PVA films by immersion in sulfuric acid solution to tune ionic strength."@en ;
    skos:altLabel "phosphoric acid doping"@en ;
    skos:prefLabel "Acid Doping"@en .

h2kg:AcidEtchingProcess a h2kg:Manufacturing ;
    rdfs:label "Acid Etching Process"@en ;
    dcterms:description "Acid washing/etching step to remove Fe species (6 M HCl, repeated)."@en ;
    skos:altLabel "acid etching"@en ;
    skos:prefLabel "Acid Etching Process"@en ;
    h2kg:hasInputMaterial h2kg:HydrochloricAcid ;
    h2kg:hasParameter h2kg:AcidEtchingRepetitions,
        h2kg:HydrochloricAcidConcentration .

h2kg:AcidLeachingProcess a h2kg:Manufacturing ;
    rdfs:label "Acid Leaching Process"@en ;
    dcterms:description "Process to generate silica nanosheets from vermiculite by acid treatment."@en ;
    skos:altLabel "acid leaching"@en,
        "acid–leaching method"@en,
        "oxalic acid leaching"@en ;
    skos:prefLabel "Acid Leaching Process"@en ;
