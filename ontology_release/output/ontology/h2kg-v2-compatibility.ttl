h2kg:ThroughPlaneElectronicConductivityMeasurement a h2kg:Measurement ;
    rdfs:label "Through Plane Electronic Conductivity Measurement"@en ;
    dcterms:description "A measurement process that uses through plane electronic conductivity measurement to determine Through Plane Electronic Conductivity, Scaling Exponent T, and Electrical Percolation Threshold Volume Fraction using Micro Ohm Meter, Gold Plated Probes, and Pneumatic Jack and generating Conductivity Dataset."@en ;
    skos:altLabel "electrical conductivity measurement"@en,
        "through-plane conductivity test"@en,
        "through-plane tests"@en ;
    skos:prefLabel "Through Plane Electronic Conductivity Measurement"@en ;
    h2kg:hasOutputData h2kg:ConductivityDataset ;
    h2kg:hasParameter h2kg:BallMillingTime,
        h2kg:BiasPotential,
        h2kg:CatalystLayerThickness,
        h2kg:DryingTemperature,
        h2kg:GeometricArea,
        h2kg:IonomerToCarbonRatio,
        h2kg:MeasurementGap,
        h2kg:ParticleVolumeFraction,
        h2kg:Temperature,
        h2kg:WaterMassFractionInSolventMixture ;
    h2kg:measures h2kg:ElectricalPercolationThresholdVolumeFraction,
        h2kg:ScalingExponentT,
        h2kg:ThroughPlaneElectronicConductivity ;
    h2kg:usesInstrument <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_a9fc3f77_e48e_4bce_b118_044d608722f6>,
        h2kg:GoldPlatedProbes,
        h2kg:MicroOhmMeter,
        h2kg:PneumaticJack,
        h2kg:Rheometer .

h2kg:ThroughPlaneGasTransportMeasurement a h2kg:Measurement ;
    dcterms:description "A measurement process that uses Through-Plane gas transport measurement to determine Local Oxygen Transport Resistance, Effective Oxygen Diffusion Coefficient, and Mass Transport Resistance using Through-Plane Transport Cell and Environmental Chamber and generating Experiment Dataset."@en ;
    skos:altLabel "through-plane gas transport"@en ;
    skos:prefLabel "Through-Plane Gas Transport Measurement"@en ;
