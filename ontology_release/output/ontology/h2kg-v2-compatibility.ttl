h2kg:AtomicForceMicroscopyMeasurement a h2kg:Measurement ;
    rdfs:label "Atomic Force Microscopy Measurement"@en ;
    dcterms:description "A measurement process that uses atomic force microscopy for in-situ or ex-situ surface-topography and microstructure characterization, including catalyst-layer and membrane-electrode-assembly imaging as well as adsorbed-ionomer structure analysis."@en ;
    skos:altLabel "AFM"@en,
        "AFM imaging"@en,
        "atomic force microscopy"@en ;
    skos:prefLabel "Atomic Force Microscopy Measurement"@en ;
    h2kg:hasInputMaterial <http://purl.org/holy/ns#CatalystLayer>,
        h2kg:CatalystCoatedMembrane,
        h2kg:CathodeCatalystLayer,
        h2kg:MEAAssembly,
        h2kg:PFSAIonomer,
        h2kg:Pt111Surface,
        h2kg:SolventMixture ;
    h2kg:hasMeasurementSubject <http://purl.org/holy/ns#CatalystLayer>,
        h2kg:CatalystCoatedMembrane,
        h2kg:CathodeCatalystLayer,
        h2kg:MEAAssembly,
        h2kg:PFSAIonomer,
        h2kg:Pt111Surface,
        h2kg:SolventMixture ;
    h2kg:hasOutputData h2kg:MicrostructureImageDataset,
        h2kg:SurfaceTopographyDataset ;
    h2kg:hasParameter h2kg:AFMScanSpeed,
        h2kg:AFMTipNominalRadius,
        h2kg:AlcoholMassFractionInSolventMixture,
        h2kg:CantileverResonanceFrequency,
        h2kg:CantileverSpringConstant,
        h2kg:DwellTime,
        h2kg:IonomerMassFraction,
        h2kg:MicroscopyMeasuredArea,
        h2kg:RelativeHumidity,
        h2kg:SolventType,
        h2kg:Temperature,
        h2kg:WaterMassFractionInSolventMixture ;
    h2kg:measures h2kg:AdsorbedAggregateLateralSize,
        h2kg:CatalystLayerMorphology,
        h2kg:FilmThickness,
        h2kg:GrapheneFlakeThickness,
        h2kg:GrapheneLayerStepHeight,
        h2kg:IonomerFilmThickness,
        h2kg:IonomerPatchSurfaceCoverage,
        h2kg:IonomerThinFilmThickness,
        h2kg:MeanParticleSize,
        h2kg:PatternSurfaceCoverage,
        h2kg:SurfaceRoughnessRa,
        h2kg:SurfaceRoughnessRq ;
    h2kg:usesInstrument h2kg:AFMInstrument .

h2kg:AtomicLayerDeposition a h2kg:Manufacturing ;
