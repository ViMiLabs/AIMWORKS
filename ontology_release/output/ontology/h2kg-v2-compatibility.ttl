h2kg:AgNWSurfaceDensity a h2kg:Parameter ;
    rdfs:label "Ag NW Surface Density"@en ;
    dcterms:description "A parameter specifying areal loading / surface density of deposited AgNW network (used to describe percolation threshold in coated films)."@en ;
    skos:altLabel "mg/m²"@en,
        "percolation threshold surface density"@en,
        "surface density"@en ;
    skos:prefLabel "Ag NW Surface Density"@en ;
    h2kg:hasQuantityValue <https://w3id.org/h2kg/hydrogen-ontology/legacy-source/AgNWSurfaceDensity_QV-398082c85287> .

h2kg:Agent a owl:Class ;
    dcterms:description "A class representing an agent that is responsible for carrying out a process, producing data, or contributing to the provenance of a resource in H2KG."@en ;
    rdfs:subClassOf prov:Agent .

h2kg:AgglomerateSurfaceArea a h2kg:Property ;
