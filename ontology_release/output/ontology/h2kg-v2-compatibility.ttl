        h2kg:MEAAssembly,
        h2kg:Oxygen ;
    h2kg:hasOutputData h2kg:LimitingCurrentDataset,
        h2kg:LocalOxygenTransportResistanceDataset ;
    h2kg:hasParameter h2kg:AnodeGasComposition,
        h2kg:AnodeGasVolumetricFlowRate,
        h2kg:BiasPotential,
        h2kg:CathodeGasComposition,
        h2kg:CathodeGasVolumetricFlowRate,
        h2kg:CellActiveArea,
        h2kg:CellPressure,
        h2kg:LowerPotentialLimit,
        h2kg:OperatingTemperature,
        h2kg:OxygenPartialPressure,
        h2kg:OxygenVolumeFraction,
        h2kg:OxygenVolumePercent,
        h2kg:PotentialWindow,
        h2kg:RelativeHumidityOperation,
        h2kg:ScanRate,
        h2kg:UpperPotentialLimit ;
