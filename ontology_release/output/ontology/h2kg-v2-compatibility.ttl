                <http://qudt.org/vocab/quantitykind/ThermodynamicTemperature> ;
            qudt:unit <http://qudt.org/vocab/unit/DEG_C>,
                <http://qudt.org/vocab/unit/K> ],
        <https://w3id.org/h2kg/hydrogen-ontology/legacy-source/Temperature_QV-0ad59820c6fa> .

h2kg:CatalystInk a h2kg:Matter ;
    dcterms:description "Catalyst-layer ink/slurry composed of carbon + PFSA dispersion + solvents, prior to coating."@en ;
    skos:altLabel "HC catalyst ink"@en,
        "PFSA reference ink"@en,
        "catalyst solution"@en ;
    skos:prefLabel "Catalyst Ink"@en .

h2kg:Data a owl:Class ;
    dcterms:description "A class representing data produced, used, or referenced by a process or measurement in H2KG."@en ;
    rdfs:subClassOf prov:Entity .

h2kg:Manufacturing a owl:Class ;
    dcterms:description "A class representing a manufacturing process that prepares, assembles, coats, or otherwise fabricates a material or device in H2KG."@en ;
    rdfs:subClassOf h2kg:Process .

h2kg:Instrument a owl:Class ;
    dcterms:description "A class representing an instrument used to perform, support, or control a measurement or manufacturing process in H2KG."@en ;
    rdfs:subClassOf prov:Entity .

h2kg:Measurement a owl:Class ;
    dcterms:description "A class representing a measurement process that determines one or more properties of a material, device, or system in H2KG."@en ;
    rdfs:subClassOf h2kg:Process .

h2kg:Matter a owl:Class ;
    dcterms:description "A class representing a material entity that participates in a process, measurement, or device configuration in H2KG."@en .

h2kg:Property a owl:Class ;
    dcterms:description "A class representing a property that can be measured, computed, or otherwise assigned to a material, process, or system in H2KG."@en .

h2kg:Parameter a owl:Class ;
    dcterms:description "A class representing a parameter specified as an input, setting, or condition for a process or measurement in H2KG."@en .

[] a h2kg:DataPoint ;
    h2kg:hasQuantityValue [ a qudt:QuantityValue ;
            qudt:quantityKind <http://qudt.org/vocab/quantitykind/AreaPerMass> ;
            qudt:unit <http://qudt.org/vocab/unit/M2-PER-GM> ] ;
    h2kg:normalizedTo h2kg:CatalystMass ;
    h2kg:ofProperty h2kg:ElectrochemicallyActiveSurfaceArea .

[] a qudt:QuantityValue ;
    qudt:quantityKind <http://qudt.org/vocab/quantitykind/Dimensionless>,
        <http://qudt.org/vocab/quantitykind/DimensionlessRatio>,
        <http://qudt.org/vocab/quantitykind/MassRatio> ;
    qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

[] a h2kg:DataPoint ;
    h2kg:hasQuantityValue [ a qudt:QuantityValue ;
            qudt:quantityKind <http://qudt.org/vocab/quantitykind/Resistance> ;
            qudt:unit <http://qudt.org/vocab/unit/OHM> ] ;
    h2kg:ofProperty h2kg:OhmicResistance .
