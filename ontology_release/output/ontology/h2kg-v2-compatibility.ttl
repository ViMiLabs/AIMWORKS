    skos:altLabel "Al layer"@en,
        "aluminium metal layer"@en ;
    skos:prefLabel "Aluminum Thin Film Layer"@en .

h2kg:AnionExchangeMembrane a h2kg:Matter ;
    rdfs:label "Anion Exchange Membrane"@en ;
