    dcterms:description "Diluted acetic acid used as peptiser for pseudo-boehmite."@en ;
    skos:altLabel "acetic acid"@en ;
    skos:prefLabel "Acetic Acid Solution"@en .

h2kg:Acetonitrile a h2kg:Matter ;
