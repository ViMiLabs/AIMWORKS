    skos:altLabel "MATLAB®"@en ;
    skos:prefLabel "MATLAB Software"@en .

h2kg:MEAAssemblyGap a h2kg:Parameter ;
    rdfs:label "MEA Assembly Gap"@en ;
    dcterms:description "A parameter specifying proposed_new_term. paper_context: Fixed gap used during MEA assembly/hot-pressing (e.g., 740 µm or 800 µm)."@en ;
    skos:altLabel "constant gap"@en,
        "hot-press gap"@en ;
