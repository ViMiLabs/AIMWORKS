h2kg:MEAAssemblyProcess a h2kg:Manufacturing ;
    dcterms:description "Manufacturing step that assembles catalyst-coated membranes, gas diffusion layers, and sealing components into a membrane electrode assembly ready for single-cell testing."@en ;
    skos:altLabel "MEA assembly"@en ;
    skos:prefLabel "MEA Assembly Process"@en ;
    prov:used h2kg:AnodeGDE,
        h2kg:CatalystCoatedMembrane,
        h2kg:CathodeGDE,
        h2kg:GasDiffusionLayer,
        h2kg:Gasket,
        h2kg:Nafion211Membrane,
        h2kg:Nafion212Membrane,
        h2kg:ProtonExchangeMembrane,
        h2kg:ProtonatedMembrane ;
    h2kg:hasInputMaterial h2kg:AnodeGDE,
        h2kg:CatalystCoatedMembrane,
        h2kg:CathodeGDE,
        h2kg:GasDiffusionLayer,
        h2kg:Gasket,
        h2kg:Nafion211Membrane,
        h2kg:Nafion212Membrane,
        h2kg:ProtonExchangeMembrane,
        h2kg:ProtonatedMembrane ;
    h2kg:hasOutputMaterial h2kg:MEAAssembly ;
    h2kg:hasParameter h2kg:AssemblyTorque,
        h2kg:CellActiveArea,
        h2kg:CompressionPercent,
        h2kg:CompressionPressure,
        h2kg:GasketThickness ;
    h2kg:usesInstrument h2kg:TorqueWrench .

h2kg:MEADurabilityMeasurement a h2kg:Measurement ;
    rdfs:label "MEA Durability Measurement"@en ;
    dcterms:description "Fuel-cell durability/stability measurement in MEA under constant applied voltage (0.4 V) with current monitored vs time."@en ;
    skos:prefLabel "MEA Durability Measurement"@en ;
    h2kg:hasInputMaterial <https://w3id.org/emmo/domain/pemfc#EMMO_099d5163_117a_4176_ba48_af54a61c4c8d> ;
    h2kg:hasMeasurementSubject <https://w3id.org/emmo/domain/pemfc#EMMO_099d5163_117a_4176_ba48_af54a61c4c8d> ;
    h2kg:hasParameter h2kg:BiasPotential,
        h2kg:CathodeStoichiometricRatio,
        h2kg:CellPressure,
        h2kg:CellVoltage,
        h2kg:CurrentDensity,
        h2kg:ExternalResistance,
        h2kg:FuelCellOperationTime,
        h2kg:OperatingTemperature,
        h2kg:RelativeHumidity,
        h2kg:Temperature ;
    h2kg:measures h2kg:CellVoltage,
        h2kg:CellVoltageLoss,
        h2kg:CellVoltageLossPercent,
        h2kg:CurrentDensity,
        h2kg:CurrentDensityDecayRate,
        h2kg:DurabilityWithCyclingHours,
        h2kg:DurabilityWithoutCyclingHours,
        h2kg:ECSALossPercent,
        h2kg:FuelCellOperationTime,
        h2kg:MassActivityLossPercent,
        h2kg:PeakPowerDensity ;
    h2kg:usesInstrument h2kg:FuelCellTestStation .

