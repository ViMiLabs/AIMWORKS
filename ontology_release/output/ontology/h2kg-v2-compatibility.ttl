h2kg:AnalyticalCentrifugeSedimentationMeasurement a h2kg:Measurement ;
    rdfs:label "Analytical Centrifuge Sedimentation Measurement"@en ;
    dcterms:description "Accelerated sedimentation/stability characterization using analytical centrifuge (AC); not present as named Measurement in ontology."@en ;
