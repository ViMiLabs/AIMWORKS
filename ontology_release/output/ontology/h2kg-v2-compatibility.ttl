h2kg:ACAmplitude a h2kg:Parameter ;
    dcterms:description "A parameter specifying acamplitude used to characterize Electrochemical Impedance Spectroscopy Potentiostatic and Electrochemical Impedance Spectroscopy Galvanostatic."@en ;
    skos:prefLabel "ACAmplitude"@en ;
    h2kg:hasQuantityValue [ a qudt:QuantityValue ;
            qudt:quantityKind <http://qudt.org/vocab/quantitykind/ElectricPotential>,
                <http://qudt.org/vocab/quantitykind/ElectricPotentialAmplitude>,
                <http://qudt.org/vocab/quantitykind/ElectricPotentialDifference>,
                <http://qudt.org/vocab/quantitykind/RelativeAmplitude>,
                <http://qudt.org/vocab/quantitykind/Voltage>,
                <http://qudt.org/vocab/quantitykind/VoltageAmplitude> ;
            qudt:unit <http://qudt.org/vocab/unit/MilliV>,
                <http://qudt.org/vocab/unit/PERCENT> ] .

h2kg:AcidDopingLevel a h2kg:Property ;
    rdfs:label "Acid Doping Level"@en ;
    dcterms:description "A property denoting phosphoric-acid doping level of PBI/PIM membrane (mol PA per mol repeat unit)."@en ;
    skos:altLabel "ADL"@en,
        "PA-doping level"@en,
        "PA_dop"@en ;
    skos:prefLabel "Acid Doping Level"@en ;
    h2kg:hasQuantityValue <https://w3id.org/h2kg/hydrogen-ontology/legacy-source/AcidDopingLevel_QV-83e463b55d39> .

h2kg:ActivatedSludge a h2kg:Matter ;
    rdfs:label "Activated Sludge"@en ;
    dcterms:description "Activated sludge inoculum used in microbial fuel cell electrolyte."@en,
        "Activated sludge mixed with buffer (50:50) used as MFC anolyte/catholyte medium in performance tests."@en ;
    skos:altLabel "AS"@en ;
    skos:prefLabel "Activated Sludge"@en .

h2kg:AgglomerateShape a h2kg:Parameter ;
    rdfs:label "Agglomerate Shape"@en ;
    dcterms:description "A parameter specifying geometric morphology of agglomerates (spherical vs branched) varied in simulations."@en ;
    skos:altLabel "branched agglomerates"@en,
        "spherical agglomerates"@en ;
    skos:prefLabel "Agglomerate Shape"@en .

h2kg:AlcoholMoleFractionInSolventMixture a h2kg:Parameter ;
    rdfs:label "Alcohol Mole Fraction In Solvent Mixture"@en ;
    dcterms:description "A parameter specifying alcohol mole fraction in solvent mixture used to characterize Solvent Property Lookup."@en ;
    skos:altLabel "[alcohol]/[alcohol+water] (mol ratio)"@en ;
    skos:prefLabel "Alcohol Mole Fraction In Solvent Mixture"@en ;
    h2kg:hasQuantityValue <https://w3id.org/h2kg/hydrogen-ontology/legacy-source/AlcoholMoleFractionInSolventMixture_QV-a9bf46a3b3a4> .

h2kg:Alumina a h2kg:Matter ;
    rdfs:label "Alumina"@en ;
    dcterms:description "Aluminum oxide ceramic phase formed after sintering (gamma/delta/theta/alpha transitions)."@en ;
    skos:altLabel "alpha-alumina"@en,
        "aluminium oxide buffer layer"@en,
        "aluminum oxide"@en ;
    skos:prefLabel "Alumina"@en .

h2kg:AluminumFoilSubstrate a h2kg:Matter ;
    rdfs:label "Aluminum Foil Substrate"@en ;
