h2kg:AmbientPressureChemicalVaporDepositionSynthesis a h2kg:Manufacturing ;
    rdfs:label "Ambient Pressure Chemical Vapor Deposition Synthesis"@en ;
    dcterms:description "A manufacturing process for ambient pressure chemical vapor deposition synthesis using Silver Foil, Selenium Powder, and Catalyst Layer with Tube Furnace and producing Beta Ag 2 Se, Carbon Nanotube Forest, and Amorphous Carbon Deposit."@en ;
    skos:altLabel "AP-CVD"@en,
        "ambient pressure CVD"@en,
        "ambient pressure-chemical vapor deposition"@en ;
    skos:prefLabel "Ambient Pressure Chemical Vapor Deposition Synthesis"@en ;
    h2kg:hasInputMaterial <http://purl.org/holy/ns#CatalystLayer>,
        h2kg:EthyleneGas,
        h2kg:Hydrogen,
        h2kg:Nitrogen,
        h2kg:SeleniumPowder,
        h2kg:SilverFoil,
        h2kg:Water ;
    h2kg:hasOutputMaterial h2kg:AmorphousCarbonDeposit,
        h2kg:BetaAg2Se,
        h2kg:CarbonNanotubeForest,
        h2kg:NCNTFsSupport ;
    h2kg:hasParameter h2kg:AnnealingDuration,
        h2kg:AnnealingTemperature,
        h2kg:DwellTime,
        h2kg:EthyleneVolumetricFlowRate,
        h2kg:GasVolumetricFlowRate,
        h2kg:HydrogenVolumetricFlowRate,
        h2kg:NitrogenSourceVolumetricFlowRate,
        h2kg:NitrogenVolumetricFlowRate,
        h2kg:PrePurgeTime,
        h2kg:PreReductionTime,
        h2kg:ReactionTemperature,
        h2kg:ReactionTime,
        h2kg:WaterVaporVolumetricFlowRate ;
    h2kg:usesInstrument h2kg:TubeFurnace .

