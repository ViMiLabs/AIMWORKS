    h2kg:hasParameter h2kg:CellPressure,
        h2kg:GasComposition,
        h2kg:OperatingTemperature,
        h2kg:RelativeHumidity ;
    h2kg:measures h2kg:EffectiveOxygenDiffusionCoefficient,
        h2kg:LocalOxygenTransportResistance,
        h2kg:MassTransportResistance ;
    h2kg:usesInstrument h2kg:EnvironmentalChamber,
        h2kg:ThroughPlaneTransportCell .

h2kg:ThroughPlaneThermalConductivityMeasurement a h2kg:Measurement ;
    rdfs:label "Through Plane Thermal Conductivity Measurement"@en ;
    dcterms:description "Description (paper-context): Ex-situ through-plane measurement of catalyst-layer thermal conductivity using a custom heat-flux/temperature-gradient rig (Fourier-law-based)."@en ;
