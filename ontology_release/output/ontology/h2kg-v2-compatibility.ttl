    dcterms:description "Measurement of linear shrinkage (%) between as-cured and pyrolyzed flexural bars in height/width/length directions."@en ;
    skos:prefLabel "Linear Shrinkage Measurement"@en ;
    h2kg:measures h2kg:LinearShrinkageHeight,
        h2kg:LinearShrinkageLength,
        h2kg:LinearShrinkageWidth .

h2kg:LinearStage a h2kg:Instrument ;
    rdfs:label "Linear Stage"@en ;
    dcterms:description "Vertical linear motion stage moving the build platform between DLP and DIW positions."@en ;
    skos:altLabel "vertical z stage"@en ;
    skos:prefLabel "Linear Stage"@en .

h2kg:LiquidEthanePlungeFreezing a h2kg:Manufacturing ;
    rdfs:label "Liquid Ethane Plunge Freezing"@en ;
    dcterms:description "Specimen preparation step: plunge/immersion freezing of TEM grids into liquid ethane to vitrify the ink/dispersion and avoid ice-crystal artifacts."@en ;
    skos:altLabel "immersion freezing into liquid ethane"@en,
        "plunge freezing"@en,
        "rapid freezing by liquid ethane"@en ;
    skos:prefLabel "Liquid Ethane Plunge Freezing"@en ;
    h2kg:hasInputMaterial h2kg:EthaneCryogen ;
    h2kg:usesInstrument h2kg:AutomaticPlungeFreezer .

h2kg:LiquidNitrogenFreezingTreatment a h2kg:Manufacturing ;
    rdfs:label "Liquid Nitrogen Freezing Treatment"@en ;
    dcterms:description "Cryogenic release step: liquid nitrogen scattered over MEA just before peeling decal substrate to improve transfer yield."@en ;
    skos:altLabel "LN_1–LN_4 treatment"@en,
        "liquid nitrogen freezing method"@en ;
    skos:prefLabel "Liquid Nitrogen Freezing Treatment"@en .

h2kg:LiquidPhaseExfoliationProcess a h2kg:Manufacturing ;
    rdfs:label "Liquid Phase Exfoliation Process"@en ;
    dcterms:description "Exfoliation of SN into few-layer nanosheets using ultrasonication in ethanol."@en ;
    skos:altLabel "liquid–phase exfoliation"@en ;
    skos:prefLabel "Liquid Phase Exfoliation Process"@en ;
    h2kg:hasInputMaterial h2kg:SilicaNanosheet ;
    h2kg:hasOutputMaterial h2kg:ExfoliatedSilicaNanosheet .

h2kg:LiquidStateLigandExchange a h2kg:Manufacturing ;
    rdfs:label "Liquid State Ligand Exchange"@en ;
    dcterms:description "Ligand exchange performed in solution phase to create CQD inks (phase transfer approach)."@en ;
    skos:altLabel "solution-phase ligand exchange"@en ;
    skos:prefLabel "Liquid State Ligand Exchange"@en .

h2kg:LiteratureMicrostructureCompilation a h2kg:Measurement ;
    rdfs:label "Literature Microstructure Compilation"@en ;
    dcterms:description "A measurement process that uses literature microstructure compilation to determine Carbon Black Particle Size, Catalyst Layer Thickness, and Inter Agglomerate Pore Size."@en ;
    skos:altLabel "review compilation"@en ;
    skos:prefLabel "Literature Microstructure Compilation"@en ;
    h2kg:measures h2kg:CarbonBlackParticleSize,
        h2kg:CatalystLayerThickness_2,
        h2kg:InterAgglomeratePoreSize,
        h2kg:IonomerFilmThickness,
        h2kg:PrimaryAgglomeratePoreSize,
        h2kg:PtParticleSize,
        h2kg:ZetaPotentialStabilityThreshold .

h2kg:LiteratureReviewSynthesis a h2kg:Measurement ;
    rdfs:label "Literature Review Synthesis"@en ;
    dcterms:description "A measurement process that uses literature review synthesis to determine Micropore Surface Area, Micropore Volume, and Mesopore Volume."@en ;
    skos:altLabel "literature review"@en,
        "literature synthesis"@en,
        "review synthesis"@en ;
    skos:prefLabel "Literature Review Synthesis"@en ;
    h2kg:hasParameter h2kg:OperatingTemperature,
        h2kg:RelativeHumidity ;
    h2kg:measures h2kg:EffectiveIonicConductivity,
        h2kg:IonExchangeCapacity,
        h2kg:MesoporeVolume,
        h2kg:MicroporeSurfaceArea,
        h2kg:MicroporeVolume,
        h2kg:OxygenPermeability,
        h2kg:WaterUptakeIndicator .

h2kg:LithiumChloride a h2kg:Matter ;
    rdfs:label "Lithium Chloride"@en ;
    dcterms:description "Not found in ONTOLOGY.jsonld; used as dispersing/foaming agent in catalyst ink."@en ;
    skos:prefLabel "Lithium Chloride"@en .

h2kg:MATLABSoftware a h2kg:Instrument ;
