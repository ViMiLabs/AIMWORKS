        h2kg:LocalGasTransportResistance,
        h2kg:LocalOxygenTransportResistance,
        h2kg:MassTransportResistance,
        h2kg:PressureDependentGasDiffusionResistance,
        h2kg:PressureIndependentGasDiffusionResistance,
