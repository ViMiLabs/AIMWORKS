    h2kg:hasMeasurementSubject h2kg:CastorOil,
        h2kg:SoybeanOil ;
    h2kg:measures h2kg:AcidDopingLevel,
        h2kg:AcidValue .

h2kg:AcidDopedPAAPVAHydrogel a h2kg:Matter ;
    rdfs:label "Acid Doped PAAPVA Hydrogel"@en ;
