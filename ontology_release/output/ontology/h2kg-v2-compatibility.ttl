        h2kg:Vermiculite ;
    h2kg:hasOutputMaterial h2kg:AcidLeachedSteamActivatedFeNCCatalyst,
        h2kg:SilicaNanosheet .

h2kg:AcidTreatmentOfCCM a h2kg:Manufacturing ;
    rdfs:label "Acid Treatment Of CCM"@en ;
    dcterms:description "A manufacturing process for acid treatment of CCM using Catalyst Coated Membrane."@en ;
    skos:altLabel "acid-treated CCM"@en ;
    skos:prefLabel "Acid Treatment Of CCM"@en ;
    h2kg:hasInputMaterial h2kg:CatalystCoatedMembrane .

h2kg:AcidUptakeMeasurement a h2kg:Measurement ;
    rdfs:label "Acid Uptake Measurement"@en ;
    dcterms:description "Measurement of phosphoric acid uptake and acid doping level (ADL) by mass difference."@en ;
    skos:altLabel "PA uptake measurement"@en ;
    skos:prefLabel "Acid Uptake Measurement"@en ;
