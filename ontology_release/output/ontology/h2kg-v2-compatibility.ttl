<http://purl.org/holy/ns#FuelCellStack> a h2kg:Matter ;
    rdfs:label "Fuel Cell Stack"@en ;
    dcterms:description "Multi-cell fuel cell stack used in aging experiments (commercial Ballard NEXA, Proton Motor PM200)."@en ;
    skos:prefLabel "Fuel Cell Stack"@en .

<http://purl.org/holy/ns#Gasket> a h2kg:Matter ;
    skos:altLabel "PTFE gasket"@en,
        "gaskets"@en ;
    skos:prefLabel "Gasket"@en .

<https://w3id.org/emmo/domain/pemfc#EMMO_abe17c61_6a3d_4ec6_b4db_450b5654dbc6> a h2kg:UNKNOWN ;
    rdfs:label "Proton Exchange Membrane Fuel Cell"@en ;
    dcterms:description "desc: PEM fuel cell context for MEA testing in this paper."@en ;
    skos:altLabel "PEM fuel cell"@en,
        "PEMFC"@en ;
    skos:exactMatch <http://purl.org/holy/ns#PolymerElectrolyteMembraneFuelCell> ;
    skos:prefLabel "Proton Exchange Membrane Fuel Cell"@en .

h2kg:ATRFTIRMeasurement a h2kg:Measurement ;
    rdfs:label "ATRFTIR Measurement"@en ;
    dcterms:description "ATR–FTIR measurement to assess ester cross-link stability over acid exposure time."@en ;
    skos:altLabel "ATR–FTIR"@en,
        "FTIR"@en ;
    skos:prefLabel "ATRFTIR Measurement"@en .

h2kg:AcceleratedStressTestVoltageCycling a h2kg:Measurement,
        h2kg:Process ;
    rdfs:label "Accelerated Stress Test Voltage Cycling"@en ;
    dcterms:description "Operational accelerated stress test process that cycles cell voltage between defined limits in order to assess fuel-cell durability under controlled operating conditions."@en ;
    skos:altLabel "AST"@en,
        "accelerated stress testing"@en,
        "voltage cycling"@en ;
    skos:prefLabel "Accelerated Stress Test Voltage Cycling"@en ;
    prov:used h2kg:MEAAssembly ;
    h2kg:hasInputMaterial h2kg:MEAAssembly ;
    h2kg:hasMeasurementSubject h2kg:MEAAssembly ;
    h2kg:hasOutputData h2kg:ASTDataset ;
    h2kg:hasParameter h2kg:AnodeGasComposition,
        h2kg:AnodeGasVolumetricFlowRate,
        h2kg:AnodeStoichiometricRatio,
        h2kg:CathodeGasComposition,
        h2kg:CathodeGasVolumetricFlowRate,
        h2kg:CathodeStoichiometricRatio,
        h2kg:CellPressure,
        h2kg:CompressionPressure,
        h2kg:DwellTime,
        h2kg:LowerPotentialLimit,
        h2kg:NumberOfCycles,
        h2kg:OperatingTemperature,
        h2kg:PotentialRampTime,
        h2kg:PotentialWindow,
        h2kg:RelativeHumidityAST,
        h2kg:ScanRate,
        h2kg:UpperPotentialLimit ;
    h2kg:measures h2kg:HalfWavePotentialShiftRelativeToNafion ;
    h2kg:usesInstrument h2kg:ElectricLoad,
        h2kg:FuelCellTestCell,
        h2kg:FuelCellTestStation .

