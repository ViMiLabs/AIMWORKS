    dcterms:description "Thermal treatment used to crosslink PAA/PVA via ester bonds."@en ;
    skos:altLabel "thermal drying"@en,
        "thermal treatment in air"@en ;
    skos:prefLabel "Thermal Crosslinking"@en ;
    h2kg:hasInputMaterial h2kg:PrintedCompositeStructure ;
    h2kg:hasOutputMaterial h2kg:PrintedCompositeStructure ;
    h2kg:hasParameter h2kg:DryingTemperature,
        h2kg:HeatingRate ;
    h2kg:usesInstrument h2kg:MuffleFurnace .

h2kg:ThermalCuringProcess a h2kg:Manufacturing ;
    rdfs:label "Thermal Curing Process"@en ;
    dcterms:description "Thermal curing schedule applied after printing to cross-link PCS prior to pyrolysis (vacuum oven ramps/holds)."@en ;
    skos:altLabel "thermal curing"@en ;
    skos:prefLabel "Thermal Curing Process"@en ;
    h2kg:hasParameter h2kg:BakeTemperature,
        h2kg:CuringTime,
        h2kg:DwellTime,
        h2kg:RampRate,
        h2kg:Temperature ;
    h2kg:usesInstrument h2kg:Oven .

h2kg:ThermalDecompositionElectrodePreparation a h2kg:Manufacturing ;
    rdfs:label "Thermal Decomposition Electrode Preparation"@en ;
    dcterms:description "A manufacturing process for thermal decomposition electrode preparation using Cobalt Hexadecanethiolate, Nickel Butanethiolate, and Carbon Cloth Substrate."@en ;
    skos:altLabel "thermal decomposition"@en,
        "thermal decomposition method"@en ;
    skos:prefLabel "Thermal Decomposition Electrode Preparation"@en ;
    h2kg:hasInputMaterial h2kg:CarbonClothSubstrate,
        h2kg:CobaltHexadecanethiolate,
        h2kg:NickelButanethiolate ;
    h2kg:hasParameter h2kg:AnnealingTemperature,
        h2kg:AnnealingTime .

h2kg:ThermalOxidationOfAluminumFilm a h2kg:Manufacturing ;
    rdfs:label "Thermal Oxidation Of Aluminum Film"@en ;
    dcterms:description "Heat treatment in air to convert deposited aluminum film to alumina buffer layer."@en ;
    skos:altLabel "calcining in air to oxidize aluminum"@en ;
    skos:prefLabel "Thermal Oxidation Of Aluminum Film"@en ;
    h2kg:hasInputMaterial h2kg:AluminumThinFilmLayer ;
    h2kg:hasOutputMaterial h2kg:Alumina ;
    h2kg:hasParameter h2kg:AnnealingTemperature,
        h2kg:AnnealingTime .

h2kg:ThermogravimetricAnalysisMeasurement a h2kg:Measurement ;
    rdfs:label "Thermogravimetric Analysis Measurement"@en ;
    dcterms:description "Thermogravimetric analysis used to quantify polymer grafting via mass loss."@en ;
    skos:altLabel "thermogravimetric analysis"@en ;
    skos:prefLabel "Thermogravimetric Analysis Measurement"@en ;
    h2kg:hasInputMaterial h2kg:MSACappedQuantumDot,
        h2kg:OleicAcidCappedQuantumDot,
        h2kg:PrintedCompositeStructure,
        h2kg:VulcanXC72RCarbonBlack ;
    h2kg:hasMeasurementSubject h2kg:MSACappedQuantumDot,
        h2kg:OleicAcidCappedQuantumDot,
        h2kg:PrintedCompositeStructure,
        h2kg:VulcanXC72RCarbonBlack ;
    h2kg:hasOutputData h2kg:ThermalAnalysisDataset ;
    h2kg:hasParameter h2kg:GasComposition,
        h2kg:HeatingRate,
        h2kg:MassFlowRate,
        h2kg:OxygenVolumeFraction,
        h2kg:OxygenVolumePercent,
        h2kg:SampleMass,
        h2kg:Temperature ;
    h2kg:measures h2kg:BinderMassLossFraction,
        h2kg:CarbonNanotubeCompleteDecompositionTemperature,
        h2kg:CarbonNanotubeDecompositionOnsetTemperature,
        h2kg:CarbonYield,
        h2kg:CeramicYield,
        h2kg:LigandDensityWeightPercent,
        h2kg:MassLossFraction,
        h2kg:PolymerMassLoss,
        h2kg:PtOnCarbonWeightPercent,
        h2kg:ReductionOnsetTemperature ;
    h2kg:usesInstrument h2kg:SynchronousThermalAnalyzer,
        h2kg:ThermogravimetricAnalyzer .

h2kg:ThreeDLaserScanningMicroscopyMeasurement a h2kg:Measurement ;
    rdfs:label "Three D Laser Scanning Microscopy Measurement"@en ;
    dcterms:description "Confocal 3D laser scanning microscopy on ~0.25 cm² central region to measure surface topography."@en ;
    skos:altLabel "laser scanning microscopy"@en ;
    skos:prefLabel "Three D Laser Scanning Microscopy Measurement"@en ;
    h2kg:hasOutputData h2kg:SurfaceTopographyDataset ;
    h2kg:hasParameter h2kg:HeightStepSize,
        h2kg:LaserWavelength,
        h2kg:LaserZStep,
        h2kg:MicroscopyMeasuredArea ;
    h2kg:measures h2kg:CatalystLayerThickness,
        h2kg:SurfaceRoughnessRq,
        h2kg:SurfaceRoughnessSa ;
    h2kg:usesInstrument h2kg:ConfocalMicroscope,
        h2kg:OlympusLEXTOLS5000 .

h2kg:ThreeIntervalThixotropyTest a h2kg:Measurement ;
    rdfs:label "Three Interval Thixotropy Test"@en ;
    dcterms:description "Rheology protocol with low-strain, high-strain, then recovery steps used to quantify thixotropy/structure recovery."@en ;
    skos:altLabel "thixotropy test"@en,
        "viscosity recovery test"@en ;
