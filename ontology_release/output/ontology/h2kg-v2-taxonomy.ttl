h2kg:AcidBaseTitrationMeasurement a owl:Class ;
    rdfs:label "Acid-base titration"@en ;
    dcterms:description "A composition measurement in which an acidic or basic titrant is added to determine the amount or concentration of a complementary basic or acidic analyte."@en ;
