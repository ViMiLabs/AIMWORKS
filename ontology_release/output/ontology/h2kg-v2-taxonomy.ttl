    dcterms:description "A class representing metadata used to describe the provenance, identity, structure, or context of another resource in H2KG."@en ;
    dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
    rdfs:subClassOf h2kg:Data ;
    skos:definition "Data that describes the identity, context, provenance, structure, management, or interpretation of another entity."@en ;
    skos:prefLabel "Metadata"@en ;
    h2kg:canonicalSemanticRole "Metadata" ;
    h2kg:definitionStatus "curated-structural" ;
    h2kg:migrationAction "preserve-existing-class" ;
    h2kg:reviewStatus "domain-expert-reviewed" ;
    h2kg:reviewerDecision "approved-domain-expert-review" ;
    h2kg:taxonomyModule "core" ;
    h2kg:taxonomyTopBranch "InformationEntity" .

h2kg:Mixture a owl:Class ;
