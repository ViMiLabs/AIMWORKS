      "@type": "h2kg:Measurement",
      "dcterms:description": {
        "@language": "en",
        "@value": "A measurement process that uses ion-cut scanning electron microscopy to characterize membrane-electrode-assembly cross sections and determine membrane-electrode-assembly thickness, gas diffusion layer thickness, and total porosity while generating SEM image and microstructure datasets."
      },
      "h2kg:hasInputMaterial": {
        "@id": "h2kg:MEAAssembly"
      },
      "h2kg:hasMeasurementSubject": {
        "@id": "h2kg:MEAAssembly"
      },
      "h2kg:hasOutputData": [
        {
          "@id": "h2kg:SEMMicrographDataset"
        },
        {
          "@id": "h2kg:MicrostructureImageDataset"
        },
        {
          "@id": "h2kg:SEMImageDataset"
        }
      ],
      "h2kg:hasParameter": [
        {
          "@id": "h2kg:PixelSize"
        },
        {
          "@id": "h2kg:DwellTime"
        },
        {
          "@id": "h2kg:Magnification"
        },
        {
          "@id": "h2kg:IonBeamEnergy"
        },
        {
          "@id": "h2kg:IonBeamCurrent"
        },
        {
          "@id": "h2kg:MicroscopyMeasuredArea"
        },
        {
          "@id": "h2kg:TotalAcquisitionTime"
        },
        {
          "@id": "h2kg:VacuumChamberPressure"
        },
        {
          "@id": "h2kg:CutThickness"
        },
        {
          "@id": "h2kg:Temperature"
        },
        {
          "@id": "h2kg:RelativeHumidity"
        },
        {
          "@id": "h2kg:ElectronBeamEnergy"
        },
        {
          "@id": "h2kg:ElectronCurrent"
        },
        {
          "@id": "h2kg:ExposureTime"
        }
      ],
      "h2kg:measures": [
        {
          "@id": "h2kg:GasDiffusionLayerThickness"
        },
        {
          "@id": "h2kg:MembraneElectrodeAssemblyThickness"
        },
        {
          "@id": "h2kg:TotalPorosity"
        }
      ],
      "h2kg:usesInstrument": {
        "@id": "h2kg:ICSEMInstrument"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "IC-SEM Imaging Measurement"
      },
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "ion-cut scanning electron microscopy"
        },
        {
          "@language": "en",
          "@value": "IC-SEM"
        },
        {
          "@language": "en",
          "@value": "ion-cut SEM"
        }
      ],
