        {
          "@id": "h2kg:Temperature"
        },
        {
          "@id": "h2kg:NeutronFlux"
        },
        {
          "@id": "h2kg:SampleDetectorDistance"
        },
        {
          "@id": "h2kg:RelativeHumidity"
        },
        {
          "@id": "h2kg:ExposureTime"
        },
        {
          "@id": "h2kg:SpatialResolution"
        },
        {
          "@id": "h2kg:PixelSize"
        },
        {
          "@id": "h2kg:ProjectionNumber"
        }
      ],
      "h2kg:measures": [
        {
          "@id": "h2kg:TortuosityFactor"
        },
        {
          "@id": "h2kg:AverageWaterDropletArea"
        },
        {
          "@id": "h2kg:AverageWaterDropletCount"
        }
      ],
      "h2kg:usesInstrument": {
        "@id": "h2kg:NeutronTomographyInstrument"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Neutron Tomography Measurement"
      },
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "HR Neutron CT"
        },
        {
          "@language": "en",
          "@value": "operando neutron tomography"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Neutron Tomography Measurement"
      }
