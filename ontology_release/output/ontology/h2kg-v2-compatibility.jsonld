        {
          "@id": "h2kg:Isopropanol"
        },
        {
          "@id": "h2kg:Solvent"
        },
        {
          "@id": "h2kg:SolventMixture"
        },
        {
          "@id": "h2kg:nButylAcetate"
        }
      ],
      "h2kg:hasOutputData": {
        "@id": "h2kg:SolventPhysicalPropertyDataset"
      },
      "h2kg:hasParameter": [
        {
          "@id": "h2kg:Temperature"
        },
        {
          "@id": "h2kg:WaterToIsopropanolMolarRatio"
        },
        {
          "@id": "h2kg:AlcoholMassFractionInSolventMixture"
        }
      ],
      "h2kg:measures": [
        {
          "@id": "h2kg:BoilingPoint"
        },
        {
          "@id": "h2kg:VaporPressure"
        },
        {
          "@id": "h2kg:SolubilityParameterTotal"
        },
        {
          "@id": "h2kg:Viscosity"
        },
        {
          "@id": "h2kg:SurfaceTension"
        },
        {
          "@id": "h2kg:HansenSolubilityParameterDispersion"
        },
        {
          "@id": "h2kg:HansenSolubilityParameterHydrogenBonding"
        },
        {
          "@id": "h2kg:DielectricConstant"
        },
        {
          "@id": "h2kg:HansenSolubilityParameterPolar"
        }
      ],
      "h2kg:usesInstrument": {
        "@id": "h2kg:Rheometer"
      },
