    {
      "@id": "h2kg:ICSEMImagingMeasurement",
      "@type": "h2kg:Measurement",
      "dcterms:description": {
        "@language": "en",
        "@value": "A measurement process that uses ion-cut scanning electron microscopy to characterize membrane-electrode-assembly cross sections and determine membrane-electrode-assembly thickness, gas diffusion layer thickness, and total porosity while generating SEM image and microstructure datasets."
