      "@type": "h2kg:Manufacturing",
      "dcterms:description": {
        "@language": "en",
        "@value": "A manufacturing process for electrospray deposition using Catalyst Ink and Proton Exchange Membrane with Syringe Pump, High Voltage Power Supply, and XY Moving Stage and producing Cathode Catalyst Layer, Electrosprayed Catalyst Layer, and Ionomer Nanofiber Scaffolding Catalyst Layer."
      },
      "h2kg:hasInputMaterial": [
        {
          "@id": "holy:Membrane"
        },
        {
          "@id": "h2kg:CatalystInk"
        }
      ],
      "h2kg:hasOutputMaterial": [
        {
          "@id": "h2kg:IonomerNanofiberScaffoldingCatalystLayer"
        },
        {
          "@id": "h2kg:CathodeCatalystLayer"
        },
        {
          "@id": "h2kg:ElectrosprayedCatalystLayer"
        }
      ],
