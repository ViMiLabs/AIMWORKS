      "h2kg:measures": [
        {
          "@id": "h2kg:TotalGasDiffusionResistance"
        },
        {
          "@id": "h2kg:IonomerFilmOxygenTransportResistivity"
        },
        {
          "@id": "h2kg:KnudsenOxygenTransportResistanceComponent"
        },
        {
          "@id": "h2kg:EffectiveOxygenDiffusionCoefficient"
        },
        {
          "@id": "h2kg:IonomerOxygenTransportResistanceComponent"
        },
        {
          "@id": "h2kg:ChargeTransferResistance"
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Distribution Of Relaxation Times Analysis"
      },
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "distribution of relaxation times"
        },
        {
          "@language": "en",
          "@value": "DRT"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Distribution Of Relaxation Times Analysis"
      }
    },
