      ],
      "skos:definition": {
        "@language": "en",
        "@value": "A dimensionless measure of the breadth of the distribution of decay rates obtained by cumulant analysis of a dynamic-light-scattering correlation function, equal to the second cumulant divided by the square of the mean decay rate."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Polydispersity Index"
      }
    },
