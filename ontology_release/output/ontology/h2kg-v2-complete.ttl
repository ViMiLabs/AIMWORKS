    dcterms:description "An instrument configuration for synchrotron and related X-ray computed tomography workflows that acquires tomographic projections and supports reconstructed-volume analysis for porous electrochemical and related material systems."@en ;
    dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
    rdfs:subClassOf h2kg:TomographyInstrument ;
    skos:altLabel "X-ray CT"@en,
        "X-ray computed tomography"@en ;
    skos:definition "An instrument configuration for synchrotron and related X-ray computed tomography workflows that acquires tomographic projections and supports reconstructed-volume analysis for porous electrochemical and related material systems."@en ;
    skos:prefLabel "X Ray CT Instrument"@en ;
    h2kg:canonicalSemanticRole "Instrument" ;
    h2kg:correctionAction "retain" ;
    h2kg:definitionStatus "source" ;
    h2kg:governanceStatus "approved" ;
    h2kg:migrationAction "retain" ;
    h2kg:taxonomyModule "core" ;
    h2kg:taxonomyTopBranch "Matter" .

