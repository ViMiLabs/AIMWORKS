<https://w3id.org/h2kg/hydrogen-ontology/profiles> a owl:Ontology ;
    dcterms:description "Value-free SHACL profiles that represent contextual workflow use without changing the intrinsic taxonomy of H2KG concepts."@en ;
    dcterms:title "H2KG workflow-use profiles"@en ;
    owl:imports <https://w3id.org/h2kg/hydrogen-ontology/releases/2.2.0> ;
    owl:versionInfo "2.2.0" .

h2kg:AFMInstrument a owl:Class ;
    rdfs:label "AFM Instrument"@en ;
    dcterms:description "An atomic force microscopy instrument used for in-situ or ex-situ topography and microstructure imaging of catalyst layers, membranes, and related electrochemical materials."@en ;
    dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
    rdfs:subClassOf h2kg:ProbeMicroscope ;
    skos:altLabel "AFM (NanoMan VS"@en,
        "Agilent 5500 AFM microscope"@en,
        "Multimode 8 AFM (Bruker)"@en,
        "atomic force microscope"@en ;
    skos:definition "An atomic force microscopy instrument used for in-situ or ex-situ topography and microstructure imaging of catalyst layers, membranes, and related electrochemical materials."@en ;
    skos:prefLabel "AFM Instrument"@en ;
    h2kg:canonicalSemanticRole "Instrument" ;
    h2kg:correctionAction "retain" ;
    h2kg:definitionStatus "source" ;
    h2kg:governanceStatus "approved" ;
    h2kg:migrationAction "retain" ;
    h2kg:taxonomyModule "core" ;
    h2kg:taxonomyTopBranch "Matter" .

h2kg:ASTDataset a owl:Class ;
    rdfs:label "AST Dataset"@en ;
    dcterms:description "A dataset containing operational data generated during an accelerated stress test protocol."@en ;
    dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
    rdfs:subClassOf h2kg:Dataset ;
    skos:altLabel "accelerated stress test dataset"@en ;
    skos:definition "A dataset containing operational data generated during an accelerated stress test protocol."@en ;
    skos:prefLabel "AST Dataset"@en ;
    h2kg:canonicalSemanticRole "Data" ;
    h2kg:correctionAction "retain" ;
    h2kg:definitionStatus "source" ;
    h2kg:governanceStatus "approved" ;
    h2kg:migrationAction "retain" ;
    h2kg:taxonomyModule "core" ;
    h2kg:taxonomyTopBranch "InformationEntity" .

h2kg:AcceleratedStressTestVoltageCycling a owl:Class ;
    rdfs:label "Accelerated Stress Test Voltage Cycling"@en ;
    dcterms:description "Operational accelerated stress test process that cycles cell voltage between defined limits in order to assess fuel-cell durability under controlled operating conditions."@en ;
    dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
    rdfs:subClassOf h2kg:CharacterizationMeasurement ;
    skos:altLabel "AST"@en,
        "accelerated stress testing"@en,
        "voltage cycling"@en ;
    skos:definition "Operational accelerated stress test process that cycles cell voltage between defined limits in order to assess fuel-cell durability under controlled operating conditions."@en ;
    skos:prefLabel "Accelerated Stress Test Voltage Cycling"@en ;
    h2kg:canonicalSemanticRole "Measurement" ;
    h2kg:correctionAction "retain" ;
    h2kg:definitionStatus "source" ;
    h2kg:governanceStatus "approved" ;
    h2kg:migrationAction "retain" ;
    h2kg:taxonomyModule "core" ;
    h2kg:taxonomyTopBranch "Process" .

h2kg:AcidBaseTitrationMeasurement a owl:Class ;
    rdfs:label "Acid-base titration"@en ;
    dcterms:description "A composition measurement in which an acidic or basic titrant is added to determine the amount or concentration of a complementary basic or acidic analyte."@en ;
    dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
    rdfs:subClassOf h2kg:CompositionMeasurement ;
    skos:altLabel "Acid Base Titration Measurement"@en,
        "acid-base titration"@en ;
    skos:definition "A composition measurement in which an acidic or basic titrant is added to determine the amount or concentration of a complementary basic or acidic analyte."@en ;
    skos:prefLabel "Acid-base titration"@en ;
    skos:scopeNote "The phosphoric-acid doping level workflow is a source-specific application and does not restrict the reusable acid-base titration measurement class."@en ;
    h2kg:canonicalSemanticRole "Measurement" ;
    h2kg:correctionAction "retain" ;
    h2kg:definitionStatus "curated" ;
    h2kg:governanceStatus "approved" ;
    h2kg:migrationAction "retain" ;
    h2kg:taxonomyModule "core" ;
    h2kg:taxonomyTopBranch "Process" .

