    rdfs:range qudt:QuantityValue .

h2kg:canonicalSemanticRole a owl:AnnotationProperty ;
    rdfs:label "canonical semantic role"@en ;
    skos:definition "Records the canonical H2KG semantic role assigned after separating scientific identity from a contextual workflow role."@en .

h2kg:correctionAction a owl:AnnotationProperty ;
    rdfs:label "correction action"@en ;
    skos:definition "Records the apply, retain, split, replace, or safe-deprecation action used for a taxonomy resource."@en .

h2kg:definitionStatus a owl:AnnotationProperty ;
    rdfs:label "definition status"@en ;
    skos:definition "Records whether a definition is sourced, curated, structural, or retained as legacy content."@en .

h2kg:fromMeasurement a owl:ObjectProperty ;
    rdfs:label "fromMeasurement"@en ;
    dcterms:description "An object property relating a data point to the measurement from which it was generated."@en ;
    rdfs:domain h2kg:DataPoint ;
    rdfs:range h2kg:Measurement .

h2kg:governanceStatus a owl:AnnotationProperty ;
    rdfs:label "governance status"@en ;
    skos:definition "Records the approved or legacy governance state of an H2KG resource."@en .

h2kg:hasIdentifier a owl:DatatypeProperty ;
    rdfs:label "hasIdentifier"@en ;
    dcterms:description "A datatype property relating a resource to a literal identifier used to distinguish or reference it."@en ;
    rdfs:range rdfs:Literal .

h2kg:hasMetadata a owl:ObjectProperty ;
    rdfs:label "hasMetadata"@en ;
