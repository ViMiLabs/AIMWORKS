h2kg:ACInputAmplitude a owl:Class ;
    rdfs:label "AC Input Amplitude"@en ;
    dcterms:description "Magnitude of the sinusoidal electrical excitation applied when acquiring an impedance-based strain-sensing signal, with the excitation quantity identified as voltage or current and the amplitude convention identified as peak, peak-to-peak, or root-mean-square."@en ;
    dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
    rdfs:subClassOf h2kg:QuantitativeCharacteristic ;
    skos:definition "Magnitude of the sinusoidal electrical excitation applied when acquiring an impedance-based strain-sensing signal, with the excitation quantity identified as voltage or current and the amplitude convention identified as peak, peak-to-peak, or root-mean-square."@en ;
    skos:prefLabel "AC Input Amplitude"@en ;
    skos:scopeNote "This characteristic can be selected as a workflow parameter through a Parameter record; contextual parameter use does not alter its intrinsic classification."@en ;
    h2kg:canonicalSemanticRole "Characteristic" ;
    h2kg:correctionAction "retain" ;
    h2kg:definitionStatus "curated" ;
    h2kg:governanceStatus "approved" ;
    h2kg:migrationAction "retain" ;
    h2kg:taxonomyModule "core" ;
    h2kg:taxonomyTopBranch "Characteristic" .

