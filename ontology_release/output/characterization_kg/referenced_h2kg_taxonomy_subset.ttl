h2kg:AFMInstrument a owl:Class ;
    rdfs:label "AFM Instrument"@en ;
    dcterms:description "An atomic force microscopy instrument used for in-situ or ex-situ topography and microstructure imaging of catalyst layers, membranes, and related electrochemical materials."@en ;
    dcterms:provenance "Migrated from the asserted H2KG v1 source through the versioned taxonomy registry."@en ;
    rdfs:subClassOf h2kg:ProbeMicroscope ;
    skos:altLabel "AFM (NanoMan VS"@en,
        "Agilent 5500 AFM microscope"@en,
        "Multimode 8 AFM (Bruker)"@en,
        "atomic force microscope"@en ;
    skos:definition "An atomic force microscopy instrument used for in-situ or ex-situ topography and microstructure imaging of catalyst layers, membranes, and related electrochemical materials."@en ;
    skos:prefLabel "AFM Instrument"@en ;
    h2kg:canonicalSemanticRole "Instrument" ;
    h2kg:correctionAction "retain" ;
    h2kg:definitionStatus "source" ;
    h2kg:governanceStatus "approved" ;
    h2kg:migrationAction "retain" ;
    h2kg:taxonomyModule "core" ;
    h2kg:taxonomyTopBranch "Matter" .

