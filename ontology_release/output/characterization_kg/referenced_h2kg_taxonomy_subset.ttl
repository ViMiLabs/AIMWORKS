h2kg:AtomicForceMicroscopyMeasurement a owl:Class ;
    rdfs:label "Atomic force microscopy"@en ;
    dcterms:description "A measurement process that uses atomic force microscopy for in-situ or ex-situ surface-topography and microstructure characterization, including catalyst-layer and membrane-electrode-assembly imaging as well as adsorbed-ionomer structure analysis."@en ;
