  h2kg:hasParameter <https://w3id.org/h2kg/examples/neutron-tomo#pixel-size-setting>, <https://w3id.org/h2kg/examples/neutron-tomo#exposure-time-setting>, <https://w3id.org/h2kg/examples/neutron-tomo#projection-number-setting>, <https://w3id.org/h2kg/examples/neutron-tomo#neutron-flux-setting>, <https://w3id.org/h2kg/examples/neutron-tomo#spatial-resolution-setting>, <https://w3id.org/h2kg/examples/neutron-tomo#sample-detector-distance-setting>, <https://w3id.org/h2kg/examples/neutron-tomo#temperature-setting>, <https://w3id.org/h2kg/examples/neutron-tomo#relative-humidity-setting> ;
  h2kg:hasMetadata <https://w3id.org/h2kg/examples/neutron-tomo#neutron-acquisition-metadata>, <https://w3id.org/h2kg/examples/neutron-tomo#source-record>, <https://w3id.org/h2kg/examples/neutron-tomo#publication-record> ;
