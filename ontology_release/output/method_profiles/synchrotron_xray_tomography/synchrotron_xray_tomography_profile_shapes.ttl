@prefix h2kg: <https://w3id.org/h2kg/hydrogen-ontology#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://w3id.org/h2kg/profiles/synchrotron_xray_tomography/MeasurementShape> a sh:NodeShape ;
  sh:targetClass h2kg:XRayComputedTomographyMeasurement ;
  sh:class h2kg:Measurement ;
  sh:property [ sh:path h2kg:hasInputMaterial ; sh:minCount 1 ; sh:class h2kg:Matter ] ;
  sh:property [ sh:path h2kg:usesInstrument ; sh:minCount 1 ; sh:class h2kg:Instrument ] ;
  sh:property [ sh:path h2kg:hasOutputData ; sh:minCount 1 ; sh:class h2kg:Data ] ;
  sh:property [ sh:path h2kg:hasParameter ; sh:node <https://w3id.org/h2kg/profiles/synchrotron_xray_tomography/ParameterRecordShape> ] .

<https://w3id.org/h2kg/profiles/synchrotron_xray_tomography/ParameterRecordShape> a sh:NodeShape ;
  sh:class h2kg:Parameter ;
  sh:property [
    sh:path h2kg:ofProperty ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:node [ sh:or ( [ sh:class h2kg:XRayBeamEnergy ] [ sh:class h2kg:ExposureTime ] [ sh:class h2kg:PixelSize ] [ sh:class h2kg:ProjectionNumber ] [ sh:class h2kg:SpatialResolution ] [ sh:class h2kg:SampleDetectorDistance ] [ sh:class h2kg:Temperature ] [ sh:class h2kg:RelativeHumidity ] [ sh:class h2kg:Magnification ] ) ]
  ] .



<https://w3id.org/h2kg/profiles/synchrotron_xray_tomography/QuantityValueShape> a sh:NodeShape ;
  sh:targetObjectsOf h2kg:hasQuantityValue ;
  sh:class qudt:QuantityValue ;
  sh:property [ sh:path qudt:numericValue ; sh:minCount 1 ] ;
  sh:or (
    [ sh:property [ sh:path qudt:unit ; sh:minCount 1 ] ; sh:property [ sh:path qudt:quantityKind ; sh:minCount 1 ] ]
    [ sh:property [ sh:path qudt:quantityKind ; sh:hasValue quantitykind:Count ] ]
    [ sh:property [ sh:path qudt:quantityKind ; sh:hasValue quantitykind:Dimensionless ] ]
  ) .
