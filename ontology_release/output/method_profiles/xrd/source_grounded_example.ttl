@prefix h2kg: <https://w3id.org/h2kg/hydrogen-ontology#> .
@prefix h2kg-pemfc: <https://w3id.org/h2kg/pemfc/hydrogen-ontology#> .
@prefix h2kg-pemwe: <https://w3id.org/h2kg/pemwe/hydrogen-ontology#> .
@prefix holy: <http://purl.org/holy/ns#> .
@prefix emmo: <https://w3id.org/emmo#> .
@prefix electrochemistry: <https://w3id.org/emmo/domain/electrochemistry#> .
@prefix pemfc: <https://w3id.org/emmo/domain/pemfc#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix chebi: <http://purl.obolibrary.org/obo/CHEBI_> .
@prefix oeo: <http://openenergy-platform.org/ontology/oeo/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/h2kg/examples/xrd#source-record>
  a h2kg:Metadata ;
  dcterms:title "Illustrative PEMFC Pt/C catalyst powder XRD case"@en ;
  rdfs:comment "Ontology-native XRD pilot case used to demonstrate the normalized H2KG XRD pattern."@en, "This package is not derived from a workbook sheet; values are illustrative and remain non-public example instances."@en .

<https://w3id.org/h2kg/examples/xrd#pdc-catalyst-powder>
  a h2kg:Matter, h2kg:CatalystPowder, h2kg:PtOnCarbonCatalyst ;
  rdfs:label "Pt/C catalyst powder sample"@en ;
  h2kg:hasMetadata <https://w3id.org/h2kg/examples/xrd#pdc-catalyst-powder-metadata> .

<https://w3id.org/h2kg/examples/xrd#pdc-catalyst-powder-metadata>
  a h2kg:Metadata ;
  rdfs:comment "Example only: commercial carbon-supported Pt catalyst powder."@en, "Supplier, lot, and Pt wt.% stay as metadata in the pilot."@en .

<https://w3id.org/h2kg/examples/xrd#conditioned-pdc-catalyst-powder>
  a h2kg:Matter, h2kg:CatalystPowder, h2kg:PtOnCarbonCatalyst ;
  rdfs:label "Conditioned Pt/C catalyst powder for XRD"@en ;
  h2kg:hasMetadata <https://w3id.org/h2kg/examples/xrd#conditioned-pdc-catalyst-powder-metadata> .

<https://w3id.org/h2kg/examples/xrd#conditioned-pdc-catalyst-powder-metadata>
  a h2kg:Metadata ;
  rdfs:comment "Example conditioning note: dry powder loaded on an XRD sample holder."@en .

<https://w3id.org/h2kg/examples/xrd#sample-conditioning-step>
  a h2kg:Manufacturing ;
  rdfs:label "Prepare Pt/C powder for XRD acquisition"@en ;
  h2kg:hasInputMaterial <https://w3id.org/h2kg/examples/xrd#pdc-catalyst-powder> ;
  h2kg:hasOutputMaterial <https://w3id.org/h2kg/examples/xrd#conditioned-pdc-catalyst-powder> .

<https://w3id.org/h2kg/examples/xrd#xrd-measurement-001>
  a h2kg:Measurement, h2kg:XRayDiffractionMeasurement ;
  rdfs:label "Pt/C catalyst powder XRD acquisition"@en ;
  h2kg:hasInputMaterial <https://w3id.org/h2kg/examples/xrd#conditioned-pdc-catalyst-powder> ;
  h2kg:usesInstrument <https://w3id.org/h2kg/examples/xrd#xrd-instrument-001> ;
  h2kg:hasParameter <https://w3id.org/h2kg/examples/xrd#xray-wavelength-setting>, <https://w3id.org/h2kg/examples/xrd#xrd-step-size-setting>, <https://w3id.org/h2kg/examples/xrd#xrd-two-theta-start-setting>, <https://w3id.org/h2kg/examples/xrd#xrd-two-theta-end-setting> ;
  h2kg:hasOutputData <https://w3id.org/h2kg/examples/xrd#xrd-pattern-dataset>, <https://w3id.org/h2kg/examples/xrd#xrd-acquisition-record> ;
  h2kg:hasMetadata <https://w3id.org/h2kg/examples/xrd#xrd-measurement-metadata> .

<https://w3id.org/h2kg/examples/xrd#xrd-measurement-metadata>
  a h2kg:Metadata ;
  rdfs:comment "Illustrative powder XRD scan for PEMFC catalyst characterization."@en .

<https://w3id.org/h2kg/examples/xrd#xrd-instrument-001>
  a h2kg:Instrument, h2kg:XRayDiffractometer ;
  rdfs:label "XRD instrument instance"@en ;
  h2kg:hasMetadata <https://w3id.org/h2kg/examples/xrd#xrd-instrument-metadata> .

<https://w3id.org/h2kg/examples/xrd#xrd-instrument-metadata>
  a h2kg:Metadata ;
  rdfs:comment "Example only: laboratory diffractometer model and holder details remain metadata."@en .

<https://w3id.org/h2kg/examples/xrd#xrd-pattern-dataset>
  a h2kg:Data, h2kg:XRDPatternDataset ;
  rdfs:label "Raw XRD pattern dataset"@en ;
  h2kg:hasMetadata <https://w3id.org/h2kg/examples/xrd#xrd-pattern-dataset-metadata> .

<https://w3id.org/h2kg/examples/xrd#xrd-pattern-dataset-metadata>
  a h2kg:Metadata ;
  rdfs:comment "Example only: diffraction pattern exported as a raw diffractogram file."@en .

<https://w3id.org/h2kg/examples/xrd#xrd-acquisition-record>
  a h2kg:Data, h2kg:ExperimentDataset ;
  rdfs:label "XRD acquisition record dataset"@en ;
  h2kg:hasMetadata <https://w3id.org/h2kg/examples/xrd#xrd-acquisition-record-metadata> .

<https://w3id.org/h2kg/examples/xrd#xrd-acquisition-record-metadata>
  a h2kg:Metadata ;
  rdfs:comment "Scan notes, run identifier, and acquisition-log details remain metadata."@en .

<https://w3id.org/h2kg/examples/xrd#peak-analysis-step>
  a h2kg:Process ;
  rdfs:label "Scherrer-style peak analysis"@en ;
  h2kg:hasInputData <https://w3id.org/h2kg/examples/xrd#xrd-pattern-dataset>, <https://w3id.org/h2kg/examples/xrd#xrd-acquisition-record> ;
  h2kg:hasMetadata <https://w3id.org/h2kg/examples/xrd#peak-analysis-step-metadata> .

<https://w3id.org/h2kg/examples/xrd#peak-analysis-step-metadata>
  a h2kg:Metadata ;
  rdfs:comment "Illustrative analysis note: Pt(111) peak used for peak-position, FWHM, and Scherrer-derived size calculations."@en, "Shape-factor and density assumptions remain analysis metadata in this round."@en .

<https://w3id.org/h2kg/examples/xrd#diffraction-peak-position-datapoint>
  a h2kg:DataPoint ;
  rdfs:label "Diffraction peak position data point"@en ;
  h2kg:ofProperty h2kg:DiffractionPeakPosition2Theta ;
  h2kg:fromMeasurement <https://w3id.org/h2kg/examples/xrd#xrd-measurement-001> ;
  h2kg:hasQuantityValue <https://w3id.org/h2kg/examples/xrd#diffraction-peak-position-datapoint-qv> ;
  prov:wasGeneratedBy <https://w3id.org/h2kg/examples/xrd#peak-analysis-step> .

<https://w3id.org/h2kg/examples/xrd#xrd-peak-fwhm-datapoint>
  a h2kg:DataPoint ;
  rdfs:label "XRD peak FWHM data point"@en ;
  h2kg:ofProperty h2kg:XRDPeakFWHM ;
  h2kg:fromMeasurement <https://w3id.org/h2kg/examples/xrd#xrd-measurement-001> ;
  h2kg:hasQuantityValue <https://w3id.org/h2kg/examples/xrd#xrd-peak-fwhm-datapoint-qv> ;
  prov:wasGeneratedBy <https://w3id.org/h2kg/examples/xrd#peak-analysis-step> .

<https://w3id.org/h2kg/examples/xrd#pt-crystallite-size-datapoint>
  a h2kg:DataPoint ;
  rdfs:label "Pt crystallite size data point"@en ;
  h2kg:ofProperty h2kg:PtCrystalliteSize ;
  h2kg:fromMeasurement <https://w3id.org/h2kg/examples/xrd#xrd-measurement-001> ;
  h2kg:hasQuantityValue <https://w3id.org/h2kg/examples/xrd#pt-crystallite-size-datapoint-qv> ;
  prov:wasGeneratedBy <https://w3id.org/h2kg/examples/xrd#peak-analysis-step> .

<https://w3id.org/h2kg/examples/xrd#theoretical-metal-surface-area-datapoint>
  a h2kg:DataPoint ;
  rdfs:label "Theoretical metal surface area data point"@en ;
  h2kg:ofProperty h2kg:TheoreticalMetalSurfaceArea ;
  h2kg:fromMeasurement <https://w3id.org/h2kg/examples/xrd#xrd-measurement-001> ;
  h2kg:hasQuantityValue <https://w3id.org/h2kg/examples/xrd#theoretical-metal-surface-area-datapoint-qv> ;
  prov:wasGeneratedBy <https://w3id.org/h2kg/examples/xrd#peak-analysis-step> .

<https://w3id.org/h2kg/examples/xrd#xray-wavelength-setting>
  a h2kg:Parameter, h2kg:XRayWavelength ;
  rdfs:label "X-ray wavelength setting"@en ;
  h2kg:hasQuantityValue <https://w3id.org/h2kg/examples/xrd#xray-wavelength-setting-qv> .

<https://w3id.org/h2kg/examples/xrd#xrd-step-size-setting>
  a h2kg:Parameter, h2kg:XRDStepSize ;
  rdfs:label "XRD step size setting"@en ;
  h2kg:hasQuantityValue <https://w3id.org/h2kg/examples/xrd#xrd-step-size-setting-qv> .

<https://w3id.org/h2kg/examples/xrd#xrd-two-theta-start-setting>
  a h2kg:Parameter, h2kg:XRDTwoThetaStart ;
  rdfs:label "XRD two theta start setting"@en ;
  h2kg:hasQuantityValue <https://w3id.org/h2kg/examples/xrd#xrd-two-theta-start-setting-qv> .

<https://w3id.org/h2kg/examples/xrd#xrd-two-theta-end-setting>
  a h2kg:Parameter, h2kg:XRDTwoThetaEnd ;
  rdfs:label "XRD two theta end setting"@en ;
  h2kg:hasQuantityValue <https://w3id.org/h2kg/examples/xrd#xrd-two-theta-end-setting-qv> .

<https://w3id.org/h2kg/examples/xrd#xray-wavelength-setting-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "0.15418"^^xsd:decimal ;
  qudt:quantityKind quantitykind:Wavelength ;
  qudt:unit unit:NanoM .

<https://w3id.org/h2kg/examples/xrd#xrd-step-size-setting-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "0.02"^^xsd:decimal ;
  qudt:quantityKind quantitykind:PlaneAngle ;
  qudt:unit unit:DEG .

<https://w3id.org/h2kg/examples/xrd#xrd-two-theta-start-setting-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "10"^^xsd:decimal ;
  qudt:quantityKind quantitykind:PlaneAngle ;
  qudt:unit unit:DEG .

<https://w3id.org/h2kg/examples/xrd#xrd-two-theta-end-setting-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "90"^^xsd:decimal ;
  qudt:quantityKind quantitykind:PlaneAngle ;
  qudt:unit unit:DEG .

<https://w3id.org/h2kg/examples/xrd#diffraction-peak-position-datapoint-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "39.8"^^xsd:decimal ;
  qudt:quantityKind quantitykind:PlaneAngle ;
  qudt:unit unit:DEG .

<https://w3id.org/h2kg/examples/xrd#xrd-peak-fwhm-datapoint-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "0.9"^^xsd:decimal ;
  qudt:quantityKind quantitykind:PlaneAngle ;
  qudt:unit unit:DEG .

<https://w3id.org/h2kg/examples/xrd#pt-crystallite-size-datapoint-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "3.1"^^xsd:decimal ;
  qudt:quantityKind quantitykind:Length ;
  qudt:unit unit:NanoM .

<https://w3id.org/h2kg/examples/xrd#theoretical-metal-surface-area-datapoint-qv>
  a qudt:QuantityValue ;
  qudt:numericValue "100"^^xsd:decimal ;
  qudt:quantityKind quantitykind:AreaPerMass ;
  qudt:unit unit:M2-PER-GM .
