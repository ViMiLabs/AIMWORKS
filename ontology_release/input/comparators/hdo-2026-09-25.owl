    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001057 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001057">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE A specification which defines the fields and their arrangement in a data structure.</obo:IAO_0000115>
        <obo:IAO_0100001 rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000040"/>
        <oboInOwl:hasNarrowSynonym>metadata schema specification</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>data schema specification</oboInOwl:hasRelatedSynonym>
