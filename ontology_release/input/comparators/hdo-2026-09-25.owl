        <obo:IAO_0000115 xml:lang="en">A relation that relates a digital object to another digital object that describes object access and modification policies.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has digital object policy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00006068 -->

