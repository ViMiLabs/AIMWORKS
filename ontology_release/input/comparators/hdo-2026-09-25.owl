    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000001 -->

    <owl:ObjectProperty rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000001">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A relation which holds between a representational entity and the entity or entities it represents, in whole or in part.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Beziehung, die zwischen zwei Entitäten besteht, wenn eine der Entitäten die andere ganz oder teilweise repräsentiert.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://ceur-ws.org/Vol-1515/regular10.pdf"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.merriam-webster.com/dictionary/about"/>
        <oboInOwl:hasNarrowSynonym xml:lang="en">concerned with</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">on the subject of</oboInOwl:hasNarrowSynonym>
        <rdfs:comment xml:lang="en">Aboutness holds between a representational entity (data, information, knowledge, etc) and the material or immaterial entities which are described or otherwise represented by it. Subspecifications of aboutness will likely follow some of the more clear logic in IAO, with specialisations such as &quot;mentions&quot; and &quot;denotes&quot; wth more complex relations such as &quot;misrepresents&quot; also to be considered.</rdfs:comment>
        <rdfs:label xml:lang="en">about</rdfs:label>
        <rdfs:label xml:lang="de">über</rdfs:label>
    </owl:ObjectProperty>
    


