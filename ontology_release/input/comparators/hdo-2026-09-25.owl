        <rdfs:domain rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000013"/>
        <rdfs:range rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00006088"/>
        <obo:IAO_0000115 xml:lang="en">A relation that describes one or more topics that a digital object is about.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">is about topic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00006069 -->

    <owl:ObjectProperty rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00006069">
        <owl:inverseOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00006070"/>
        <obo:IAO_0000115>A relation that relates an entity to a digital object that contains metadatata about this entity.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has metadata</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00006070 -->

    <owl:ObjectProperty rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00006070">
        <rdfs:domain rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000013"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">A relation that relates a digital object that contains data about an entity to that entity.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Is metadata for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00006071 -->

    <owl:ObjectProperty rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00006071">
        <rdfs:domain rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000013"/>
        <rdfs:range rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00002011"/>
        <obo:IAO_0000115 xml:lang="en">A relation that relates a digital object to the license that applies to the content of the Digital Object represented by the FDO, distinguishing it from the license of the FDO metadata itself.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">License here does not govern the metadata record (the FDO itself), but applies to the content of the Digital Object rather than the metadata.</rdfs:comment>
        <rdfs:label xml:lang="en">has digital object license</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00006074 -->

    <owl:ObjectProperty rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00006074">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000030"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000009"/>
                            <rdf:Description rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001037"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000018"/>
        <obo:IAO_0000115>This relation relates an information content entity, data or data set to a FAIR digital object it represents.</obo:IAO_0000115>
        <rdfs:comment>The domain of this property is restricted to the union of &quot;data&quot;, &quot;data set, and &quot;information content entity&quot; based on theoretical predictions. We intend to be as restrictive as possible for reasons of consistency. If the range meets requirements in practice and should be evaluated once put to use. In that case, the domain might be widened, e.g., to &quot;generically dependent continuant&quot; or &quot;entity&quot; in the future.</rdfs:comment>
        <rdfs:label xml:lang="en">is represented as FDO</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00006075 -->

    <owl:ObjectProperty rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00006075">
        <rdfs:domain rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000013"/>
        <rdfs:range rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000013"/>
        <obo:IAO_0000115 xml:lang="en">A relation that relates a digital object to another digital object that contains provenance data.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has provenance graph</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00006080 -->

    <owl:ObjectProperty rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00006080">
        <rdfs:domain rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000013"/>
        <rdfs:range rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000007"/>
        <obo:IAO_0000115 xml:lang="en">A relation that relates a digital object to a data type which is registered in a data type registry.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has digital object type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00006081 -->

    <owl:ObjectProperty rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00006081">
        <rdfs:subPropertyOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00006082"/>
        <rdfs:domain rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000007"/>
        <rdfs:range rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00006072"/>
        <obo:IAO_0000115 xml:lang="en">A relation that relates a data type to the registry where it is registered.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">is registered in data type registry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00006082 -->

    <owl:ObjectProperty rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00006082">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:range rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001049"/>
        <obo:IAO_0000115 xml:lang="en">A relation that relates a generically dependent continuant to the system where it is registered.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">is registered in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00006089 -->

    <owl:ObjectProperty rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00006089">
        <obo:IAO_0000115 xml:lang="en">A relation that specifies a topic (from a controlled vocabulary) that a digital object is related to.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">A relation which specifies a topic (from a controlled vocabulary) that a digital object is related to.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">A relation which specifies that an entity is part of a group of entities.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">A relation which specifies that an entity is part of another entity or a set of entites.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">is member of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00006090 -->

    <owl:ObjectProperty rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00006090">
        <rdfs:subPropertyOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00006089"/>
        <rdfs:range rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00002008"/>
        <obo:IAO_0000115 xml:lang="en">A relation which specifies the topic which  belongs to a controlled vocabulary and represents the subject matter of a FAIR digital object.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">The relation is introduced to specify the topic that a digital object is about.</rdfs:comment>
        <rdfs:label xml:lang="en">is member of Vocabulary</rdfs:label>
    </owl:ObjectProperty>
    


