        <rdfs:range rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00006073"/>
        <obo:IAO_0000115 xml:lang="en">A relation that relates a digital object to the access protocol information that a client can use to access this object.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has digital object location access protocol</rdfs:label>
    </owl:ObjectProperty>
    


