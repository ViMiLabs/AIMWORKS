    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000026 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000026">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000029"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">Metadata which describe properties inherent to data.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Metadaten, welche Eigenschaften beschreiben, die Daten zu eigen sind.</obo:IAO_0000115>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-0065-0762"/>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-1008-4530"/>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-2209-9385"/>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-8941-954X"/>
        <dce:contributor rdf:resource="https://orcid.org/0000-0003-0575-2853"/>
        <dce:contributor rdf:resource="https://orcid.org/0000-0003-2804-688X"/>
        <oboInOwl:hasDbXref rdf:resource="https://techterms.com/definition/metadata"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.ahdictionary.com/word/search.html?q=metadata"/>
        <rdfs:label xml:lang="en">intrinsic metadata</rdfs:label>
        <rdfs:label xml:lang="de">intrinsische Metadaten</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Intrinsische Metadaten</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">intrinsic metadata</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="en">intrinsic metadatum</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="de">intrinsisches Metadatum</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000027 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A role which can be realised by any digital entity when it is used to find and access another digital entity.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Rolle, die von jeder digitalen Entität realisiert werden kann, wenn sie verwendet wird, um eine andere digitale Entität zu finden und darauf zuzugreifen.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym xml:lang="de">Bezeichnung eines Feldes</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="de">Feldbezeichnung</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">field description</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="https://cs.stackexchange.com/questions/107439/what-is-a-key-in-computer-science"/>
        <rdfs:comment xml:lang="en">In most cases, keys are strings encountered by users and/or programme. In key-value pairs, the key is used to locate one or more values structured in a field (and optionally part of a record). Good keys unambiguously reference their fields.</rdfs:comment>
        <rdfs:label xml:lang="de">Schlüssel</rdfs:label>
        <rdfs:label xml:lang="en">key</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Schlüssel</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">keys</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Schüssel</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">key</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000028 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000028">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000046"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A string which is (1) composed of a fixed-length sequence of digits and (2) references an exact location in a computer&apos;s memory. </obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein String, der (1) aus einer Zeichensequenz festgeleger Länge besteht und (2) auf einen exakten Ort im Computerspeicher verweist.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Memory_address"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.computerhope.com/jargon/m/memoaddr.htm"/>
        <rdfs:comment xml:lang="en">There is an ambiguity around &quot;location&quot; in much the same way as &quot;address&quot;. Here, location is used to denote the actual physical part of the device which stores data. The memory in question is typically understood as the computer&apos;s random access memory (RAM).</rdfs:comment>
        <rdfs:label xml:lang="de">Speicheradresse</rdfs:label>
        <rdfs:label xml:lang="en">memory address</rdfs:label>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000029 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000029">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000009"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">Data which are about other data.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Daten, die andere Daten beschreiben.</obo:IAO_0000115>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-0065-0762"/>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-1008-4530"/>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-2209-9385"/>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-8941-954X"/>
        <dce:contributor rdf:resource="https://orcid.org/0000-0003-0575-2853"/>
        <dce:contributor rdf:resource="https://orcid.org/0000-0003-2804-688X"/>
        <oboInOwl:hasDbXref rdf:resource="https://techterms.com/definition/metadata"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.ahdictionary.com/word/search.html?q=metadata"/>
        <rdfs:comment xml:lang="en">Many sources conflate metadata with informative metadata, which would be more rightly called metainformation as not all metadata is informative and some may be misinformative - please refer to definition of &quot;data&quot; and &quot;information&quot;. Depending of the type of characteristics being described, metadata can either be contextual or intrinsic. Richness of metadata depends on the application case, for more information please refer to the definition of &quot;rich metadata&quot;.</rdfs:comment>
        <rdfs:label xml:lang="de">Metadaten</rdfs:label>
        <rdfs:label xml:lang="en">metadata</rdfs:label>
        <skos:note xml:lang="en">Data which are intended to contextualise or otherwise qualify other data. Examples include file size, date created, method used to generate the data and identifiers for people who worked on the data.
Metadata itself is considered data - as such data that is about metadata is per this here given definition also metadata.</skos:note>
        <skos:note xml:lang="de">Daten, die dazu dienen, andere Daten in einen Kontext zu setzen oder anderweitig zu beschreiben. Beispiele dafür sind etwa die Dateigröße, das Erstellungsdatum, die Methode, mit der die Daten erzeugt wurden, und die Identifier der Personen, die an den Daten gearbeitet haben. Metadaten selber sind Daten - daher sind Daten die andere Metadaten beschreiben - per der hier gegebenen Definition - auch Metadaten.</skos:note>
        <hob:HDO_00001024 xml:lang="de">Metadaten</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">metadata</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000030 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000030">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">An element which belongs to the set of elements linked together in a graph.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein Element, das zu einem Satz an Elementen gehört, die durch einen Graphen miteinander verbunden werden.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="de">Ecke</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">point</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">vertex</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">From the point of view of graph theory, nodes are treated as featureless and indivisible elements, although they may have additional structure depending on the application from which the graph arises; for instance, a semantic network is a graph in which the nodes represent concepts or classes of objects.</rdfs:comment>
        <rdfs:label xml:lang="de">Knoten</rdfs:label>
        <rdfs:label xml:lang="en">node</rdfs:label>
        <rdfs:seeAlso>https://en.wikipedia.org/wiki/Node_(computer_science)</rdfs:seeAlso>
        <rdfs:seeAlso>https://en.wikipedia.org/wiki/Vertex_(graph_theory)</rdfs:seeAlso>
        <rdfs:seeAlso>https://en.wiktionary.org/wiki/vertex</rdfs:seeAlso>
        <hob:HDO_00001024 xml:lang="en">nodes</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000031 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000031">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000009"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">Data which an agent acts upon.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Daten, auf die ein Agent hinarbeitet.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym xml:lang="en">data of interest</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="https://dictionary.cambridge.org/us/dictionary/english/object"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.merriam-webster.com/dictionary/object"/>
        <oboInOwl:hasRelatedSynonym xml:lang="en">input data</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">target data</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">Object data is any data which is acted upon by some agent (i.e. is the &quot;object&quot; of that agent&apos;s activity). This could include subject data, its associated metadata, or any incidental data acted upon. Naturally, object data must exist prior to the action. TODO: Check synonyms, Final approval</rdfs:comment>
        <rdfs:label xml:lang="de">Objektdaten</rdfs:label>
        <rdfs:label xml:lang="en">object data</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Objektdaten</hob:HDO_00001024>
        <hob:HDO_00001024>object data</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000032 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000032">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000014"/>
        <obo:IAO_0000115 xml:lang="en">A graph which has a structure conforming to an ontological graph specification.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="den">Ein gerichteter azyklischer Graph, dessen Strukturiertheit einer ontologischen Graphenspezifikation entspricht.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="ISBN:9780387355443"/>
        <oboInOwl:hasDbXref rdf:resource="https://mitpress.mit.edu/books/building-ontologies-basic-formal-ontology"/>
        <oboInOwl:hasDbXref rdf:resource="https://mondo.monarchinitiative.org/pages/faq/"/>
        <rdfs:label xml:lang="de">Ontologischer Graph</rdfs:label>
        <rdfs:label xml:lang="en">ontological graph</rdfs:label>
        <rdfs:seeAlso>https://en.wiktionary.org/wiki/ontology</rdfs:seeAlso>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q324254</rdfs:seeAlso>
        <hob:HDO_00001024 xml:lang="de">Ontologische Graphen</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">ontological graphs</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000033 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000033">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00006028"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">Structured data which uses a formal language to model knowledge about another entity  or domain, throuh defining entities (classes) and declaring the logical relationships between them (relations).</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Strukturierte Daten, die eine formale Sprache verwenden, um Wissen über eine andere Entität oder einen Bereich zu modellieren, indem sie Entitäten (Klassen) definieren und die logischen Beziehungen zwischen ihnen (Relationen) deklarieren.</obo:IAO_0000115>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-2209-9385"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Ontology_(information_science)"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.w3.org/TR/ld-glossary/#ontology"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.w3.org/standards/semanticweb/ontology"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.w3.org/wiki/Good_Ontologies"/>
        <oboInOwl:hasNarrowSynonym xml:lang="de">Domänenontologie</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">domain ontology</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">hybrid ontology</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">upper ontology</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">data model</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">This is a broad definition of ontology that is inclusive of both digitised and non-digitised assets (e.g. a set of logical proofs on paper). Specialisations of this term (e.g. ontological graph) can be used for more semantic precision. The term &quot;ontology&quot; can also generally refer to the branch of metaphysics concerned with the types, categorisation, and relationships between things in the world. In this glossary, we concern ourselves only with the computational artifact that encodes some outcome of that domain. Most ontologies will have human-readable node and edge labels, as well as definitions and synonyms for the entities they represent. In this way, they may include terminology functions native to, e.g., controlled vocabularies, thesauri, and taxonomies. Further, most ontologies are encoded in RDF or an OWL serialisation, to support reasoning and querying. Definitions used may be domain-specific and consequently differ between fields. For example, consider the concept &quot;card&quot; which has many different meanings depending on the domain. For example, An ontology about the domain of poker would define it as the &quot;playing card&quot;, while an ontology about the domain of computer hardware would define it as a &quot;computer hardware card&quot;. We note that if dealing with concepts, there might be an overlap between the term ontology and the term data model. </rdfs:comment>
        <rdfs:label xml:lang="de">Ontologie</rdfs:label>
        <rdfs:label xml:lang="en">ontology</rdfs:label>
        <skos:note xml:lang="en">A structured collection of terms, their definitions and the relationships between them expressed in a formal manner which supports machine-driven reasoning.</skos:note>
        <skos:note xml:lang="de">Eine strukturierte Sammlung von Begriffen, ihren Definitionen und ihren Beziehungen untereinander, die in einer formalen, typischerweise maschinenlesbaren Weise ausgedrückt ist. </skos:note>
        <hob:HDO_00001024 xml:lang="de">Ontologien</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">Ontologies</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000034 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000034">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001036"/>
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00006084"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">An information profile which describes the structure of a persistent identifier record.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein Informationsprofil, das die Struktur eines Persistent Identifier Records beschreibt.</obo:IAO_0000115>
        <obo:OMO_0003000 xml:lang="de">PID Informationsprofil</obo:OMO_0003000>
        <obo:OMO_0003000 xml:lang="en">PID information profile</obo:OMO_0003000>
        <oboInOwl:hasDbXref rdf:resource="https://ec.europa.eu/info/sites/info/files/research_and_innovation/ki0420576enn.pdf"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.rd-alliance.org/system/files/RDA%20Recommendation%20on%20PID%20Kernel%20Information_final.pdf"/>
        <rdfs:comment xml:lang="en">Both The Research Data Alliance (RDA) and the European Open Science Cloud (EOSC) Executive Board provide definitions only for a PID kernel information profile. We note that the creation and maintenance of PID information profiles is a community-centric effort. The challenge is to ensure that profiles generated by communities are recognised and parseable by repositories (or external tools). Profiles that are both recognised and well-implemented will support automated validation and indexing of PID records, allowing a wide range of operations to be performed on the metadata discovered through persistent identifiers. For HMC and other consortia, careful curation and registration of such profiles are strongly recommended, as well as efforts to encourage reuse.

Note that there is significant overlap with the class HDO_00000035 &quot;persistent identifier kernel information profile&quot; whose only difference to the current class is that information is deemed essential. Thus in practice individuals might be asserted to and of the two classes depending on how strict they are.</rdfs:comment>
        <rdfs:label xml:lang="de">Informationsprofil eines persistenten Identifiers</rdfs:label>
        <rdfs:label xml:lang="en">persistent identifier information profile</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Informationsprofile von persistenten Identifier</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">persistent identifier information profiles</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000035 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000035">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00006085"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A kernel information profile which is associated with a persistent identifier.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Das Kernelinformationsprofil welches mit einem persistenten Identifiers verbunden ist.</obo:IAO_0000115>
        <obo:OMO_0003000 xml:lang="de">PID Kernelinformationsprofil</obo:OMO_0003000>
        <obo:OMO_0003000 xml:lang="en">PID kernel information profile</obo:OMO_0003000>
        <dce:contributor rdf:resource="https://orcid.org/0000-0003-4322-180X"/>
        <oboInOwl:hasBroadSynonym>Kernel Information Profile</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="https://www.rd-alliance.org/system/files/RDA%20Recommendation%20on%20PID%20Kernel%20Information_final.pdf"/>
        <oboInOwl:hasRelatedSynonym xml:lang="de">persistenter Identifier Kernelinformationsprofil</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">We note that the term kernel information profile could in principle be used independently of the PID concept. In practice the term is mostly used in the context of records connected to persistent identifiers however, it is inserted as a broad synonym here rather than being a separate class higher in the hierarchy.</rdfs:comment>
        <rdfs:label xml:lang="de">Kerninformationsprofil eines persistenten Identifiers</rdfs:label>
        <rdfs:label xml:lang="en">persistent identifier kernel information profile</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Kerninformationsprofile von persistenten Identifiern</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">persitent identifier kernel information profiles</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000036 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000036">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000039"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A record which is composed of fields primarily about a digital resource referenced by a persistent identifier.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein Datensatz, der aus Feldern besteht, die sich hauptsächlich auf eine digitale Ressource beziehen, die durch einen persistent Identifier referenziert werden. </obo:IAO_0000115>
        <obo:OMO_0003000 xml:lang="en">PID information record</obo:OMO_0003000>
        <obo:OMO_0003000 xml:lang="en">PID record</obo:OMO_0003000>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-4344-0837"/>
        <dce:contributor rdf:resource="https://orcid.org/0000-0003-2804-688X"/>
        <oboInOwl:hasDbXref rdf:resource="http://hdl.handle.net/11304/a027f953-b810-4f5f-94ed-9e3e61ad7e13"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.rd-alliance.org/system/files/PID-report_v6.1_2017-12-13_final.pdf"/>
        <oboInOwl:hasExactSynonym xml:lang="en">persistent identifier information record</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">persistenter Identifier Information Record</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">the PID record is usually structured by the PID information profile [add LINK TO PROFILE] and stored alongside a PID</rdfs:comment>
        <rdfs:label xml:lang="en">persistent identifier record</rdfs:label>
        <rdfs:label xml:lang="de">persistenter Identifier Record</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">persistent identifier Records</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">persistent identifier records</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">persistent Identifier Record</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">persistent identifier record</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000037 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000037">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000038"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A programmatic value which contains a memory address.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein programmatischer Wert, der eine Speicheradresse enthält.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Pointer_(computer_programming)"/>
        <rdfs:comment xml:lang="en">The definition of &quot;value&quot; in the computer science sense, is still stabilising in this glossary, although should be servicable.</rdfs:comment>
        <rdfs:label xml:lang="de">Zeiger</rdfs:label>
        <rdfs:label xml:lang="en">pointer</rdfs:label>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000038 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000038">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000009"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">Data which (1) are stored in a computer&apos;s memory and (2) which can be manipulated by a program.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Daten, die (1) im Speicher eines Computers hinterlegt sind und (2) durch ein (Computer-)Programm verändert werden können.</obo:IAO_0000115>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-3949-818X"/>
        <oboInOwl:hasBroadSynonym xml:lang="en">value</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Value_(computer_science)#lrvalue"/>
        <rdfs:comment xml:lang="en">The here defined value can be any amount and combination of numbers, characters or else encoding a single signifier. Here, when we refer to &quot;a computer&apos;s memory&quot;, we specifically refer to the random access memory (RAM). This is not to say that memory addressed cannot be stored elsewhere, but manipulation typically occurs via RAM.</rdfs:comment>
        <rdfs:label xml:lang="en">programmatic value</rdfs:label>
        <rdfs:label xml:lang="de">programmatischer Wert</rdfs:label>
        <hob:HDO_00001024 xml:lang="en">programmatic values</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="de">programmatische Werte</hob:HDO_00001024>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000038"/>
        <owl:annotatedProperty rdf:resource="http://purl.org/dc/elements/1.1/contributor"/>
        <owl:annotatedTarget rdf:resource="https://orcid.org/0000-0002-3949-818X"/>
        <rdfs:comment>Jos Lehmann</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000039 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000039">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000005"/>
        <obo:IAO_0000115 xml:lang="en">Structured data which contains at least one field.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Strukturierte Daten, die aus mindestens einem Feld bestehen.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Record_(computer_science)"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.wikidata.org/wiki/Q2470517"/>
        <oboInOwl:hasNarrowSynonym xml:lang="de">Register</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="de">Registratur</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">compound data</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">struct</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">structure</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">Records are built from fields e.g. Key-Value pairs, and often include additional metadata about those fields in other substructures.</rdfs:comment>
        <rdfs:label xml:lang="de">Aufzeichung</rdfs:label>
        <rdfs:label xml:lang="en">record</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Aufzeichungen</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">records</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000040 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001005"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A specification which is formalised and concise.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Spezifikation welche formalisiert und präzise ist.</obo:IAO_0000115>
        <dce:contributor rdf:resource="https://orcid.org/0000-0003-0833-7989"/>
        <oboInOwl:hasDbXref rdf:resource="https://de.wikipedia.org/wiki/Schema_(Informatik)"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wiktionary.org/wiki/schema#English"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.sciencedirect.com/topics/computer-science/metadata-schema"/>
        <rdfs:comment xml:lang="en">A schema can take many forms with different levels of formality (i.e. from ad-hoc to highly formalised), but the intent is to have a regular and systematic approach to the description of a data structure. A digital schema is often expressed in a formal language (e.g. XML, JSON) such that data can be parsed and validated automatically according to the schema. Alternatively, they might be diagrammatic or illustrative like a schema for a relational database management system.</rdfs:comment>
        <rdfs:label xml:lang="de">Schema</rdfs:label>
        <rdfs:label xml:lang="en">schema</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Schemas</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="de">Schemata</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="de">Schemen</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">schemata</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">schemes</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Schema</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">schema</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000041 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000041">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">OBSOLETE An entity which is structured.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">OBSOLETE Eine Entität, die strukturiert ist.</obo:IAO_0000115>
        <oboInOwl:consider rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000005"/>
        <oboInOwl:consider rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000118"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/PATO_0000141"/>
        <oboInOwl:hasDbXref rdf:resource="https://dictionary.cambridge.org/dictionary/english/structure"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Structure"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.collinsdictionary.com/dictionary/english/structure"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.duden.de/rechtschreibung/Struktur"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.merriam-webster.com/dictionary/structure"/>
        <oboInOwl:hasRelatedSynonym xml:lang="en">struct</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">Structures may be intentional or incidental, relations might be defined explicitly or be implicit. Structures may have only two elements or components, and these may be of different kinds. An entity serving as a frame/scaffold (one component) holding a single entity (another component) meets this definition. TODO: see discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/88</rdfs:comment>
        <rdfs:comment>We re-arranged the approach to structuredness which will now be modeled as a quality. 
A class `structure` at this level of generality is not required for HDO</rdfs:comment>
        <rdfs:label xml:lang="de">obsolete Struktur</rdfs:label>
        <rdfs:label xml:lang="en">obsolete structure</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <hob:HDO_00001024 xml:lang="de">Strukturen</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">structures</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Struktur</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">structure</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000042 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000042">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000009"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">Data which an agent has declared as the main focus of a process.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Daten, die durch einen Agenten als Fokus eines Prozesses festgelegt wurden.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym xml:lang="en">data of interest</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="https://dictionary.cambridge.org/us/dictionary/english/subject"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.merriam-webster.com/dictionary/subject"/>
        <rdfs:comment xml:lang="en">This class has been created to distinguish data based on the intentionality of one or more agents. Data becomes the &quot;subject&quot; of those processes when the agent determines it to be so, prior to or during the process. This becomes especially useful when, for example, a data structure has multiple components bearing data with different roles such as subject data and metadata. </rdfs:comment>
        <rdfs:label xml:lang="de">Subjektdaten</rdfs:label>
        <rdfs:label xml:lang="en">subject data</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Subjektdaten</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">subject data</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000043 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000043">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000047"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">An identifier which some agent has committed to maintain - in the long term - as a valid reference to an entity.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein Identifier, für den ein Akteur sich verpflichtet hat, ihn als gültige Referenz auf eine Entität - über einen langen Zeitraum - zur Verfügung zu stellen und zu erhalten.</obo:IAO_0000115>
        <obo:OMO_0003012 xml:lang="en">PI</obo:OMO_0003012>
        <obo:OMO_0003012 xml:lang="en">PID</obo:OMO_0003012>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-2209-9385"/>
        <oboInOwl:hasDbXref rdf:resource="https://datascience.codata.org/articles/10.5334/dsj-2017-009/"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.forschungsdaten.org/index.php/Persistent_Identifier"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.rd-alliance.org/system/files/PID-report_v6.1_2017-12-13_final.pdf"/>
        <rdfs:comment xml:lang="en">In this definition, we are attempting to maintain enough generality to include PIDs which are used in non-networked systems. The agents maintaining persistent identifiers can be diverse, for example, http://hdl.handle.net/ or http://www.ncbi.nlm.nih.gov/pubmed/ </rdfs:comment>
        <rdfs:label xml:lang="en">persistent identifier</rdfs:label>
        <rdfs:label xml:lang="de">persistenter Identifier</rdfs:label>
        <skos:note xml:lang="en">A persistent identifier is a long-lasting reference to an object. Some persistent identifiers are linked to kernel information profiles which provide metadata or information about that object when the persistent identifier is resolved.</skos:note>
        <skos:note xml:lang="de">Ein persistenter Identifier ist ein dauerhafter Verweis auf ein Objekt. Einige persistente Identifier sind mit Kerninformationsprofilen verknüpft, die Metadaten oder Informationen über das Objekt liefern, wenn dieser persistente Identifier aufgelöst wird.</skos:note>
        <hob:HDO_00001024 xml:lang="en">persistent identifiers</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="de">persistente Identifier</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000044 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000044">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. A specification which is expressed in a formal language and defines (1) the set of valid values a member of a data type can assume, and (2) the set of valid operations that can be carried out on a member of that data type.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">OBSOLETE. Eine Spezifikation, die in einer formalen Sprache ausgedrückt ist für einen Datentyp definiert (1) welche gültigen Werte dieser annehmen, und (2) welche gültigen Operationen mit diesem durchgeführt werden können.</obo:IAO_0000115>
        <obo:IAO_0000116>Abstract data type is included in data type as a narrow synonym.</obo:IAO_0000116>
        <obo:IAO_0100001 rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000007"/>
        <obo:OMO_0003012 xml:lang="en">ADT</obo:OMO_0003012>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Abstract_data_type"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Special:BookSources/978-0-66940000-7"/>
        <oboInOwl:hasDbXref rdf:resource="https://opendsa-server.cs.vt.edu/ODSA/Books/CS3/html/Glossary.html#term-abstract-data-type"/>
        <oboInOwl:hasDbXref rdf:resource="https://services.informatik.hs-mannheim.de/~schramm/ads/files/Kapitel08.pdf"/>
        <oboInOwl:hasDbXref rdf:resource="https://web.mit.edu/6.005/www/fa16/classes/11-abstract-data-types/"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.geeksforgeeks.org/abstract-data-types/"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.tutorialspoint.com/abstract-data-type-in-data-structures"/>
        <oboInOwl:hasNarrowSynonym xml:lang="en">data type</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">data type model</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Abstract data type is included in data type as a narrow synonym.</rdfs:comment>
        <rdfs:comment xml:lang="en">Abstract data types are theoretical constructs, agnostic to implementation environment and intended to support logically coherent, conceptual development of abstract algorithms or other digital assets. In that sense, they abstract the type of data from the use of that data (e.g. in a programme or algorithm). They can be represented in a wide variety of ways, but offer generalisable properties against which any given implementation can be validated. In the context of a programming language, an abstract data type can specify basic types of data (i.e. boolean, real, char) and related stuctures (i.e. array, struct), as well as more idiosyncratic constructs.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete abstract data type</rdfs:label>
        <rdfs:label xml:lang="de">obsolete obsolete_abstrakter Datentyp</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <hob:HDO_00001024 xml:lang="en">abstract data types</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="de">abstrakte Datentypen</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000045 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000045">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000048"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A unique identifier which some agent has committed to maintain - in the long term - as a valid reference to an entity.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein eindeutiger Identifier, für den ein Akteur zusichert hat, dass die Referenz auf die Entität über einen langen Zeitraum gültig bleibt. </obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym xml:lang="en">persistent identifier</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="de">persistenter Identifier</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="https://de.wikipedia.org/wiki/Persistent_Identifier"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/String_(computer_science)"/>
        <rdfs:comment xml:lang="en">The agents maintaining persistent identifiers can be diverse, for example http://hdl.handle.net/ or http://www.ncbi.nlm.nih.gov/pubmed/</rdfs:comment>
        <rdfs:label xml:lang="en">persistent unique identifier</rdfs:label>
        <rdfs:label xml:lang="de">persistenter eindeutiger Identifier</rdfs:label>
        <hob:HDO_00001024 xml:lang="en">persistent unique identifiers</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="de">persistente eindeutige Identifier</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000046 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000046">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000007"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">An data type which is composed of a finite sequence of symbols.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein Datentyp, der aus einer endlichen Folge von Zeichen besteht.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://de.wikipedia.org/wiki/Zeichenkette"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/String_(computer_science)"/>
        <oboInOwl:hasExactSynonym xml:lang="de">Zeichenfolge</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">Zeichenkette</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">Zeichenreihe</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">The characters that can be used for a string of a specific data type are typically defined by the underlying abstract data type and encoded according to a character encoding specification (i.e ASCII, ISO_8859 or Unicode). </rdfs:comment>
        <rdfs:label xml:lang="de">String</rdfs:label>
        <rdfs:label xml:lang="en">string</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Strings</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">strings</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000047 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000047">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000046"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A string which is used to label and recognisably refers to an entity or class of entities.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein String, der einen Entität oder eine Klasse von Entitäten benennt und erkennbar auf diese verweist.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym xml:lang="de">Bezeichung</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="de">Kennung</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="de">Kennzeichen</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="https://de.wikipedia.org/wiki/Identifikator"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/String_(computer_science)"/>
        <oboInOwl:hasExactSynonym xml:lang="de">Identifikator</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="de">Identifizierungszeichen</oboInOwl:hasNarrowSynonym>
        <rdfs:comment xml:lang="en">This term is broadly defined, as it is used widely - with slight to major changes in meaning - in many different contexts (e.g. within a program code, for authentification purposes, in terms of a physical description). Subclasses of this term can and should be created for more precision.</rdfs:comment>
        <rdfs:label xml:lang="de">Identifier</rdfs:label>
        <rdfs:label xml:lang="en">identifier</rdfs:label>
        <hob:HDO_00001024 xml:lang="en">identifiers</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000048 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000048">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000047"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">An identifier which has no exact string matches among all identifiers used in a system.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein Identifier, der keine exakte (String-)Übereinstimmung mit anderen, innerhalb eines Systems verwendeten, Identifiern aufweist. </obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://de.wikipedia.org/wiki/Identifikator"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/String_(computer_science)"/>
        <rdfs:comment xml:lang="en">Note that a unique identifier does not guarantee unambiguous identification. A unique identifier can be (mis)used to refer to two distinct entities. Checks to prevent this must be implemented in digital systems.</rdfs:comment>
        <rdfs:label xml:lang="en">unique identifier</rdfs:label>
        <hob:HDO_00001024 xml:lang="en">unique identifiers</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000101 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000101">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000001"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00006036"/>
                        <owl:someValuesFrom rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_10000047"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00006036"/>
                <owl:someValuesFrom rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_10000047"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An entity which realizes the unit role.</obo:IAO_0000115>
        <obo:IAO_0000115>Eine Entität, die die Einheiten-Rolle verwirklicht.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym xml:lang="en">unit of measurement</oboInOwl:hasNarrowSynonym>
        <rdfs:comment xml:lang="en">A stick that has been calibrated to be one metre in length and that is used to measure a distance realises a unit role and is thus a unit. The agent doing the measuring records a length of &quot;3 metres&quot;. The &quot;meters&quot; in that data is about the relevant property of the unit used to measure the length, and is the &quot;unit information&quot;.</rdfs:comment>
        <rdfs:comment xml:lang="en">This class should not be used to annotate information about units (e.g., the &apos;m&apos; in &apos;3m&apos;) as it references the actual entity that was used as a unit. Please use &apos;unit information&apos; for that purpose.</rdfs:comment>
        <rdfs:comment xml:lang="en">This is an experimental class, there are some concerns about this class being so close to the class entity.</rdfs:comment>
        <rdfs:label xml:lang="de">Einheit</rdfs:label>
        <rdfs:label xml:lang="en">unit</rdfs:label>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000106 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000106">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001023"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">Software which enables agents to interact with one or more databases using functions that allow access, modification, storage, retrieval, and (re)organization of data.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Software, die Benutzern die Möglichkeit gibt, mit einer oder mehreren Datenbanken zu interagieren und dabei Funktionen zu nutzen, die den Zugang, die Eingabe, die Speicherung, den Abruf und die (Neu-)Organisation von Daten in großem Umfang ermöglichen.</obo:IAO_0000115>
        <obo:OMO_0003012 xml:lang="de">DBMS</obo:OMO_0003012>
        <obo:OMO_0003012 xml:lang="en">DBMS</obo:OMO_0003012>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-2209-9385"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Database"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.oracle.com/database/what-is-database/"/>
        <rdfs:comment xml:lang="en">It may be necessary to revisit these terms once &quot;system&quot; is added to the glossary. Because of the close relationship between them, the term &quot;database&quot; is often used casually to refer to both a database and the DBMS used to manipulate it</rdfs:comment>
        <rdfs:label xml:lang="de">Datenbankmanagementsystem</rdfs:label>
        <rdfs:label xml:lang="en">database management system</rdfs:label>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000107 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000107">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000005"/>
        <obo:IAO_0000115 xml:lang="en">Structured data which has structuredness conforming to a database specification.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Strukturierte Daten, deren Strukturiertheit einer Datenbankspezifikation entspricht.</obo:IAO_0000115>
        <obo:OMO_0003012 xml:lang="de">DB</obo:OMO_0003012>
        <obo:OMO_0003012 xml:lang="en">DB</obo:OMO_0003012>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-2209-9385"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Database"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.oracle.com/database/what-is-database/"/>
        <rdfs:comment xml:lang="en">Because of the close relationship between them, the term &quot;database&quot; is often used casually to refer to both a database and the database management system used to manipulate it. Here, we use the term to refer to any organised collection of data that forms the basis of some activity and the term &quot;database system&quot; to describe the combination of a database and a database management system. It is generally assumed that the organisation of data in a database will enhance efficiency of operations such as search, retrieval, update, and auditing. These actions are usually performed through a database management system.</rdfs:comment>
        <rdfs:label xml:lang="de">Datenbank</rdfs:label>
        <rdfs:label xml:lang="en">database</rdfs:label>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000108 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000108">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000109"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A database system which is used to store and preserve digital assets following a policy or rule set that defines the storage and access norms.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein Datenbanksystem, das zur Speicherung und Aufbewahrung digitaler Bestände gemäß einer Richtlinie oder eines Regelwerks, das Speicher- und Zugriffsnormen definiert, verwendet wird.</obo:IAO_0000115>
        <obo:OMO_0003000 xml:lang="en">repo</obo:OMO_0003000>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-2209-9385"/>
        <oboInOwl:hasBroadSynonym xml:lang="de">Repositorium</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="de">Repository</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">repository</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/NCIT_C114457"/>
        <oboInOwl:hasExactSynonym xml:lang="de">digitales Repositorium</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">A repository includes digital storage locations as well as some form of software used to manage digital assets. A repository can, itself, contain another repository. For example, a data lake can contain a database within it.</rdfs:comment>
        <rdfs:label xml:lang="en">digital repository</rdfs:label>
        <rdfs:label xml:lang="de">digitales Repository</rdfs:label>
        <skos:note xml:lang="en">A place where data, code, software, or other digital assets are stored.</skos:note>
        <skos:note xml:lang="de">Ein Ort, an dem Daten, Code und andere digitale Inhalte gespeichert werden.</skos:note>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000109 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000109">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001049"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A system which is composed of (1) one or more databases and (2) a database management system.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein System, das aus (1) einer oder mehreren Datenbanken und (2) einem Datenbankmanagementsystem besteht.</obo:IAO_0000115>
        <obo:OMO_0003000 xml:lang="de">Datenbank</obo:OMO_0003000>
        <obo:OMO_0003000 xml:lang="en">database</obo:OMO_0003000>
        <obo:OMO_0003012 xml:lang="de">DBS</obo:OMO_0003012>
        <obo:OMO_0003012 xml:lang="en">DBS</obo:OMO_0003012>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-2209-9385"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.oracle.com/database/what-is-database/"/>
        <rdfs:comment xml:lang="en">Any data that is stored in a database system is typically cleaned, enriched, and transformed so it complies with the database schema (the extract-transform-load). The term database is often used colloquially to refer to a database system. Here, we try to unpack and reconcile terms that are, informally, often used interchangeably. </rdfs:comment>
        <rdfs:label xml:lang="de">Datenbanksystem</rdfs:label>
        <rdfs:label xml:lang="en">database system</rdfs:label>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000110 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000110">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">OBSOLETE A unit role which is realized when some quality of an entity is used to measure a corresponding quality of another.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">OBSOLETE TBD </obo:IAO_0000115>
        <obo:IAO_0100001 rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_10000047"/>
        <oboInOwl:hasDbXref rdf:resource="https://doi.org/10.1351/goldbook."/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Unit_of_measurement"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/1"/>
        <oboInOwl:hasDbXref>ISO/IEC Guide 99:2007</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym xml:lang="en">measurement unit</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Extraneous to unit role - can be inferred if needed.</rdfs:comment>
        <rdfs:label xml:lang="de">obsolete TBD (Maßeinheit Rolle)</rdfs:label>
        <rdfs:label xml:lang="en">obsolete unit of measurement role</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <hob:HDO_00001024 xml:lang="de">TBD</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">unit of measurement roles</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">TBD</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">unit of measurement role</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000111 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000025"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000101"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="de">Information welche die Einheit identifiziert, die verwendet wird, um die Größe einer Eigenschaft quantitativ auszudrücken.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">Information which identifies the unit used to quantiatively express the magnitude of some quality.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://doi.org/10.1351/goldbook."/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Unit_of_measurement"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/1"/>
        <oboInOwl:hasDbXref>ISO/IEC Guide 99:2007</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym xml:lang="de">Einheit</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="de">Messeinheit</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">unit</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">unit of measurement</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">This information identifies the magnitude of some entity&apos;s quality which was used as unity (i.e. the unit) in the quantification of some numeric data. For example, the &quot;m&quot; in &quot;3 m&quot; is the unit information which identifies that some entity A was used to measure the quality &quot;length&quot; of another entity B, and that entity A thereby realised the unit role in the process of measurement. For units calculated from constants or other means of derivation, we hold that there still is - at the beginning of that chain - some physical entity which bears the unit role. Multiple constants and standard values are often used in these derivations. Ideally, the entity which fulfils the unit role should be standardised.</rdfs:comment>
        <rdfs:comment xml:lang="en">Unit information should not be confused with unit, event though both are often used interchangeably. Unit information is used, for example, when expressing a measurement.</rdfs:comment>
        <rdfs:label xml:lang="de">Einheitsinformation</rdfs:label>
        <rdfs:label xml:lang="en">unit information</rdfs:label>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000112 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000112">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000009"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001010"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                                <owl:someValuesFrom rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001060"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">Data which encode a signifier of a quantity.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Daten, die ein Zeichen einer Menge, Größe oder eines Ausmaßes kodieren.</obo:IAO_0000115>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-3949-818X"/>
        <oboInOwl:hasDbXref rdf:resource="https://doi.org/10.1351/goldbook."/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Unit_of_measurement"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/1"/>
        <oboInOwl:hasDbXref>ISO/IEC Guide 99:2007</oboInOwl:hasDbXref>
        <rdfs:comment xml:lang="en">Quantitative data are typically expressed in numbers, but for numerical data to be considered quantitative, it must also convey the information expressed in the definition. Quantitative data are expressed by numerical data in connection with a unit.</rdfs:comment>
        <rdfs:label xml:lang="de">quantitative Daten</rdfs:label>
        <rdfs:label xml:lang="en">quantitative data</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">quantitative Daten</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">quantitative data</hob:HDO_00001024>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000112"/>
        <owl:annotatedProperty rdf:resource="http://purl.org/dc/elements/1.1/contributor"/>
        <owl:annotatedTarget rdf:resource="https://orcid.org/0000-0002-3949-818X"/>
        <rdfs:comment>Jos Lehmann</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000113 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000113">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">OBSOLETE A format which defines how data is to be structured to conform to an abstract data type.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">OBSOLETE Ein Format, welches definiert, wie Daten strukturiert werden müssen, um einem abstrakten Datentyp zu entsprechen.</obo:IAO_0000115>
        <obo:IAO_0100001 rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00007025"/>
        <oboInOwl:hasDbXref rdf:resource="http://edamontology.org/format_1915"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/NCIT_C42761"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/PATO_0000141"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Data_format"/>
        <rdfs:comment>`data format` will be added as synonym of `data structure specification`</rdfs:comment>
        <rdfs:comment xml:lang="en">to be adjusted The terms data format is often used in a loose manner to refer to both the specification of the data structure and the data structure itself. TODO: gloss TODO: see discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/88</rdfs:comment>
        <rdfs:label xml:lang="de">obsolete Datenformat</rdfs:label>
        <rdfs:label xml:lang="en">obsolete data format</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:note xml:lang="de">TODO</skos:note>
        <skos:note xml:lang="en">TODO</skos:note>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000114 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001005"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A specification which defines the rules (e.g. syntax, grammar and/or vocabulary) that can be used to encode data.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Spezifikation, welche die Regeln (Syntax, Grammatik und/oder Vokabular) definiert, die zur Kodierung von Daten verwendet werden können.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://edamontology.org/format_1915"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/NCIT_C42761"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/PATO_0000141"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Data_format"/>
        <rdfs:comment xml:lang="en">A data format typically defines has organizational parts as well as syntax in which data is represented. Data formats are sometimes also referred to as &quot;languages&quot; or &quot;data languages&quot; (as opposed to &quot;programming language&quot;. Examples are Markup, YAML, JSON or XML.</rdfs:comment>
        <rdfs:label xml:lang="de">Datenformat</rdfs:label>
        <rdfs:label xml:lang="en">data format</rdfs:label>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000116 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000116">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000005"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">Structured data which is serialised in a way to conform with a file format.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Strukturierte Daten, welche so serialisiert sind, dass sie einem Dateiformat entsprechen.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym xml:lang="de">Computerdatei</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">computer file</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/PATO_0000141"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/STATO_0000002"/>
        <oboInOwl:hasDbXref rdf:resource="http://semanticscience.org/resource/SIO_000396"/>
        <rdfs:comment xml:lang="en">Because within this ontology we define file in the sense of digital files (i.e. not paper-files) we deliberately use exact synonyms like &quot;computer file&quot; in this class. A file does not need to be stored in a computer, it can be stored in any medium, as long as it can be transfer to a computer memory. A file are associated with a abstract file type and a file format. Files constitutes a identifiable and logically coherent information entities. They can be stored in a computer memory, or any other digital medium. TODO: see discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/88</rdfs:comment>
        <rdfs:label xml:lang="de">Datei</rdfs:label>
        <rdfs:label xml:lang="en">file</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Dateien</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">files</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000117 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000117">
        <rdfs:comment xml:lang="en">DEPRECATED TODO: see discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/88</rdfs:comment>
        <rdfs:comment>This quality has been consolidated with the &quot;structured&quot; quality</rdfs:comment>
        <rdfs:label xml:lang="de">DEPRECATED structural quality</rdfs:label>
        <rdfs:label xml:lang="en">DEPRECATED structural quality</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000118"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000118 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A quality which inheres in a bearer by virtue of that bearer&apos;s parts being intentionally held in relation to one another by some means.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/PATO_0000141"/>
        <oboInOwl:hasDbXref rdf:resource="https://dictionary.cambridge.org/dictionary/english/structure"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Structure"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.collinsdictionary.com/dictionary/english/structure"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.duden.de/rechtschreibung/Struktur"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.merriam-webster.com/dictionary/structure"/>
        <oboInOwl:hasExactSynonym xml:lang="en">structured</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">strukturiert</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="de">Eine Qualität, die einem Träger dadurch innewohnt, dass zwischen seinen Teilen beabsichtigte Beziehungen bestehen.</rdfs:comment>
        <rdfs:label xml:lang="de">Strukturiertheit</rdfs:label>
        <rdfs:label xml:lang="en">structuredness</rdfs:label>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000119 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000119">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">OBSOLETE Information which identifies the file format a structured and unitary collection of data conforms to.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">OBSOLETE Informationen, die das Dateiformat einer strukturierten, einheitlichen Datensammlung benennen.</obo:IAO_0000115>
        <obo:IAO_0100001 rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000114"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/PATO_0000141"/>
        <oboInOwl:hasDbXref rdf:resource="https://dictionary.cambridge.org/dictionary/english/structure"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Structure"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.collinsdictionary.com/dictionary/english/structure"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.duden.de/rechtschreibung/Struktur"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.merriam-webster.com/dictionary/structure"/>
        <rdfs:comment xml:lang="en">TODO: see discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/88</rdfs:comment>
        <rdfs:comment>`file type` will be added as synonym of `file format`</rdfs:comment>
        <rdfs:label xml:lang="de">obsolete file type</rdfs:label>
        <rdfs:label xml:lang="en">obsolete file type</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000120 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000120">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">OBSOLETE A specification which describes how to arrange an entity&apos;s parts such that it assumes a defined structure.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">OBSOLETE To be adjusted Eine Spezifikation, die beschreibt, wie die Teile einer Entität anzuordnen sind um eine bestimmte Struktur zu erhalten.</obo:IAO_0000115>
        <obo:IAO_0100001 rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00007025"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/PATO_0000141"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.duden.de/rechtschreibung/Struktur"/>
        <rdfs:comment xml:lang="en">TODO: see discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/88</rdfs:comment>
        <rdfs:comment>the content of this is separated into `file format` and `data structure specification`</rdfs:comment>
        <rdfs:label xml:lang="de">obsolete format</rdfs:label>
        <rdfs:label xml:lang="en">obsolete format</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00000121 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00000121">
        <rdfs:comment xml:lang="en">DEPRECATED TODO: see discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/88</rdfs:comment>
        <rdfs:comment>We deem this quality to no longer be relevant enough in the context of
data.

After all, all data is structure. What we sometimes call &quot;unstructured data&quot;
is merely not in a structure which is easily usable with the tools and for
the purpose at hand.</rdfs:comment>
        <rdfs:label xml:lang="de">DEPRECATED unstructured</rdfs:label>
        <rdfs:label xml:lang="en">DEPRECATED unstructured</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000118"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001001 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001005"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A specification which describes how to create or modify some entity such that it resembles the standard for a set or a type, allowing it to be considered a member of that set or type.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Spezifikation, die beschreibt, wie eine Entität erstellt oder verändert werden muss, um einem Standard einer Menge oder eines Typs zu entsprechen und somit als Mitglied dieser angesehen zu werden.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym xml:lang="de">Standard</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">standard</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">Different types of standards can be discriminated based on how they came to be, i.e. either through community wide adoption or through sanctioned actions of a legal authority.</rdfs:comment>
        <rdfs:label xml:lang="de">Standardspezifikation</rdfs:label>
        <rdfs:label xml:lang="en">standard specification</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Standardspezifikationen</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">standard specifications</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Standardspezifikation</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">standard specification</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001002 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001002">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001001"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A standard specification which is or has been widely adopted and implemented within a community of practice.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Standardspezifikation, die weitläufig innerhalb einer Anwendungsgemeinschaft angenommen und umgesetzt wird.</obo:IAO_0000115>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-2209-9385"/>
        <oboInOwl:hasRelatedSynonym xml:lang="de">De Facto Standard</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">de facto standard</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="de">De-facto-Standardspezifikation</rdfs:label>
        <rdfs:label xml:lang="en">de facto standard specification</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">De-facto-Standardspezifikationen</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">de facto standard specifications</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">De-facto-Standardspezifikation</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">de facto standard specification</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001003 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001003">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001001"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A standard specification which must be met in order to comply with a requirement issued by a competent legal authority.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Standardspezifikation, die eingehalten werden muss um eine von einer befugten juristischen Instanz erlassene Anforderung zu befolgen.</obo:IAO_0000115>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-2209-9385"/>
        <oboInOwl:hasRelatedSynonym xml:lang="de">De-jure-Standard</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">de jure standard</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">In order to be considered de jure, there must be some legally binding mechanism which declares that some standard specification must be used for a given purpose. This will naturally vary from jurisdiction to jurisdiction. For example, the General Data Protection Regulation (GDPR) of the European Union includes a legally binding specification of the standard metadata that must be present in a privacy policy. This is in the form of, for example, a template for privacy policies: https://gdpr.eu/privacy-notice/</rdfs:comment>
        <rdfs:label xml:lang="de">De-jure-Standardspezifikation</rdfs:label>
        <rdfs:label xml:lang="en">de jure standard specification</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">De-jure-Standardspezifikationen</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">de jure standard specifications</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">De-jure-Standardspezifikation</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">de jure standard specification</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001004 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001004">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001001"/>
        <obo:IAO_0000115 xml:lang="en">A standard specification which pertains to metadata.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Standardspezifikation, die sich auf Metadaten bezieht.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Metadata_standard"/>
        <oboInOwl:hasRelatedSynonym xml:lang="de">Metadaten-Standard</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">metadata standard</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">It should be noted that the definition of metadata vs. data can be different depending on use and/or application.</rdfs:comment>
        <rdfs:label xml:lang="de">Metadaten-Standardspezifikation</rdfs:label>
        <rdfs:label xml:lang="en">metadata standard specification</rdfs:label>
        <skos:note xml:lang="en">Information on how to create a standardized representation of metadata that allows unambiguous interpretation.</skos:note>
        <skos:note xml:lang="de">Informationen darüber, wie man eine standardisierte Darstellung von Metadaten erstellt, die eine eindeutige Interpretation ermöglicht.</skos:note>
        <hob:HDO_00001024 xml:lang="de">Metadaten-Standardspezifikationen</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">metadata standard specifications</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Metadaten-Standardspezifikation</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">metadata standard specification</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001005 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000025"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00007040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">Information which defines the requirements that must be met in order for an entity to be considered a member of a set or a type.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Informationen, die Anforderungen definieren, die erfüllt sein müssen, damit eine Entität als Mitglied einer Gruppe oder eines Typs angesehen werden kann.</obo:IAO_0000115>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-2209-9385"/>
        <rdfs:comment>Specifications can be used as a reference in validation processes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifications typically list their criteria in recommendation or guidance documents, and are issued by organisations or interest groups for a field of application. Generally some form of formalisation (i.e. a compiled document) is required in order for these recommendations to be adopted by a community.</rdfs:comment>
        <rdfs:label xml:lang="de">Spezifikation</rdfs:label>
        <rdfs:label xml:lang="en">specification</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Spezifikationen</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">specifications</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Spezifikation</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">specification</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001006 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001006">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000007"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">An abstract data type which specifies how a symbolic representation is associated with a computational value that may change over time.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein abstrakter Datentyp welcher spezifiziert wie eine symbolische Repräsentation (z.B. String) mit einem über die Zeit veränderlichem Wert assoziiert ist. </obo:IAO_0000115>
        <obo:OMO_0003000 xml:lang="de">var</obo:OMO_0003000>
        <obo:OMO_0003000 xml:lang="en">var</obo:OMO_0003000>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-2209-9385"/>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-5077-7497"/>
        <oboInOwl:hasBroadSynonym xml:lang="de">Variable</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">variable</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Variable_(computer_science)"/>
        <rdfs:comment xml:lang="en">This term can be defined on very different levels. On (1) an general, abstract level (2) at the level of the specification within a given programming language (e.g. &quot;JAVA variable&quot;) (3) at the level of an instance that is used in a specific piece of code (e.g. $foo). The definition here aims at the most general level, the others can be defined if necessary. A key concept is the fact that a variable maintains its identity while the associated value may change over time (i.e. when a computer program is executed and running). How this is (technically) achieved on implementation level (on the level (2) &amp; (3)) is programming language specific. </rdfs:comment>
        <rdfs:label xml:lang="de">Computervariable</rdfs:label>
        <rdfs:label xml:lang="en">computational variable</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Computervariable</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="de">Computervariablen</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">computational variables</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Computervariable</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">computational variable</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001007 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A disposition which inheres in data and which is realised when that data is accurately identified through a digital system&apos;s search or discovery functions.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Veranlagung von Daten, die realisiert wird, wenn diese Daten präzise durch die Suchfunktionen eines digitalen Systems identifiziert werden.</obo:IAO_0000115>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-2209-9385"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Discoverability"/>
        <oboInOwl:hasExactSynonym xml:lang="en">Discoverability</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">Findbarkeit</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">Queries to find data may be either primarily directed towards associated metadata (i.e. most likely when it comes to larger data sets with complex structure) or directed towards the data itself (i.e. most likely in cases where data can be easily exposed as text). An example for the latter might be the search for a specific gene sequence. The result of such a query might then however be connected to metadata for further filtering the results. This definition is for the findability of data in a general sense. A more specific situation applies to findability according to the FAIR principles which is defined elsewhere. </rdfs:comment>
        <rdfs:label xml:lang="de">Auffindbarkeit</rdfs:label>
        <rdfs:label xml:lang="en">findability</rdfs:label>
        <skos:note xml:lang="de">Das Potential von Daten, durch eine Abfrage nach ihnen selbst oder ihren Metadaten entdeckt zu werden.</skos:note>
        <skos:note xml:lang="en">The potential of data to be accurately identified as a result of a query towards it or its metadata.</skos:note>
        <hob:HDO_00001026 xml:lang="de">Auffindbarkeit</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">Findability</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001008 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001008">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001007"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="de">Auffindbarkeit, welche Daten zu eigen ist, die (1) mit einem persistenten global eindeutigen Identifier und (2) mit umfangreichen Metadaten assoziiert sind.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">Findability which inheres in data that is associated with (1) a globally unique persistent identifier and (2) rich metadata.</obo:IAO_0000115>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-2209-9385"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.go-fair.org/fair-principles/"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.nature.com/articles/sdata201618.pdf"/>
        <oboInOwl:hasExactSynonym xml:lang="de">Findbarkeit im Sinne der FAIR Prinzipien</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">Please refer to the definition of &quot;rich metadata&quot; as well as general &quot;findability&quot; defined elsewhere.</rdfs:comment>
        <rdfs:label xml:lang="de">Auffindbarkeit entsprechend den FAIR-Prinzipien</rdfs:label>
        <rdfs:label xml:lang="en">findability according to the FAIR principles</rdfs:label>
        <skos:note xml:lang="de">Das Potential von Daten, genau gefunden zu werden, aufgrund (1) ihrer Zuordnung zu einem weltweit eindeutigen, persistenten Identifier, der weitere Suchvektoren eröffnet, (2) ihrer Beschreibung durch umfangreiche Metadaten, (3) ihrer eindeutigen Zuordnung zu diesen umfangreichen Metadaten und (4) ihrer Registrierung in durchsuchbaren Ressourcen.</skos:note>
        <skos:note xml:lang="en">The potential of data to be accurately discovered due to (1) its association with a persistent globally unique identifier that opens additional search vectors, (2) its description by rich metadata, (3) its unambiguous association with that rich metadata and (4) it being registered or indexed in searchable resources.</skos:note>
        <hob:HDO_00001026 xml:lang="de">Auffindbarkeit entsprechend den FAIR-Prinzipien</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">findability according to the FAIR principles</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001009 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001009">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001018"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A human community which (1) has members that are involved in related planned processes and (2) share knowledge about these processes through regular interaction. </obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Gemeinschaft von Menschen, die (1) Akteure von einander ähnlichen geplanten Prozessen sind, und (2) durch regelmäßige Interaktion Wissen über diese Prozesse austauschen.</obo:IAO_0000115>
        <obo:OMO_0003012 xml:lang="en">CoP</obo:OMO_0003012>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Community_of_practice"/>
        <oboInOwl:hasDbXref rdf:resource="https://wenger-trayner.com/introduction-to-communities-of-practice/"/>
        <oboInOwl:hasExactSynonym xml:lang="de">Anwendergemeinschaft</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">Übungsgemeinschaft</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="de">Interessengemeinschaft</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="de">Interessensgemeinschaft</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">community of interest</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="de">Anwendungsgemeinschaft</rdfs:label>
        <rdfs:label xml:lang="en">community of practice</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Anwendungsgemeinschaften</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">communities of practice</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Anwendungsgemeinschaft</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">community of practice</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001010 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001010">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001011"/>
        <obo:IAO_0000115 xml:lang="en">A planned process during which a signifier is represented in a form that can be transmitted and understood by at least one agent.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein geplanter Prozess währenddessen ein Zeichen in einer Form repräsentiert wird, die von mindestens einem:er Agent:in übertragen und verstanden werden kann.</obo:IAO_0000115>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-3949-818X"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Encoding_(semiotics)"/>
        <rdfs:comment xml:lang="de">Die Formen, die für diese Repräsentation gewählt werden, sollten zu einem standardisierten Notationssystem gehören, das von mindestens einem Agenten verstanden wird.</rdfs:comment>
        <rdfs:comment xml:lang="en">The forms chosen for this representation should belong to a standardized system of notation that is understood by at least one agent.</rdfs:comment>
        <rdfs:label xml:lang="de">Kodierungsprozess</rdfs:label>
        <rdfs:label xml:lang="en">encoding process</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Kodierungsprozesse</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">encoding processes</hob:HDO_00001024>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001010"/>
        <owl:annotatedProperty rdf:resource="http://purl.org/dc/elements/1.1/contributor"/>
        <owl:annotatedTarget rdf:resource="https://orcid.org/0000-0002-3949-818X"/>
        <rdfs:comment>Jos Lehmann</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001011 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A process that attempts to follow a plan specification.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein Prozess, der so gestaltet ist, dass ein bestimmtes Ergebnis erzielt wird.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym xml:lang="de">Plan</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">plan</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="http://semanticscience.org/resource/SIO_000076"/>
        <oboInOwl:hasRelatedSynonym xml:lang="de">Agenda</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="de">Vorgehen</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">action plan</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">agenda</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">The realisation of the planned process will happen by valid execution of the planned process. The planned process may be formalised within a plan specification. TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b</rdfs:comment>
        <rdfs:label xml:lang="de">geplanter Prozess</rdfs:label>
        <rdfs:label xml:lang="en">planned process</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">geplante Prozesse</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">planned processes</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">geplanter Prozess</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">planned process</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001012 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001012">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001011"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A planned process during which technology is applied.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein geplanter Prozess, während dem Technologie eingesetzt wird.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Technology"/>
        <oboInOwl:hasRelatedSynonym xml:lang="de">technisches Verfahren</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b</rdfs:comment>
        <rdfs:label xml:lang="de">technischer Prozess</rdfs:label>
        <rdfs:label xml:lang="en">technological process</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">technische Prozesse</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">technological processes</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">technischer Prozess</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">technological process</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001013 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A collection of entities which explicitly includes knowledge about how to use the other entities as tools in various planned processes.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Sammlung von Entitäten, welche explizit das Wissen darüber einschließt, wie diese Entitäten als Werkzeuge in verschiedenen geplanten Prozesses genutzt werden können.</obo:IAO_0000115>
        <obo:OMO_0003000 xml:lang="de">Tech</obo:OMO_0003000>
        <obo:OMO_0003000 xml:lang="en">tech</obo:OMO_0003000>
        <oboInOwl:hasDbXref rdf:resource="https://casrai-test.evision.ca/glossary-term/technology/"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.oxfordlearnersdictionaries.com/definition/american_english/technology"/>
        <oboInOwl:hasNarrowSynonym xml:lang="en">digital technology</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="de">digitale Technologie</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="de">Hightech</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="de">Technik</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">hightech</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">The entities of such a collection may be but are not limited to tools, methods/techniques, concepts, knowledge systems as well as the skills of personnel to be able to use them. As such it can be seen as the application of knowledge for practical purposes.</rdfs:comment>
        <rdfs:label xml:lang="de">Technologie</rdfs:label>
        <rdfs:label xml:lang="en">technology</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Technologien</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">technologies</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Technologie</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">technology</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001014 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001014">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001049"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A system which can function as technology.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein System, das als Technologie wirken kann.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Technology"/>
        <oboInOwl:hasExactSynonym xml:lang="de">Technik</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="de">Hightech System</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">hightech system</oboInOwl:hasNarrowSynonym>
        <rdfs:comment xml:lang="en">This class will be populated by inference TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b</rdfs:comment>
        <rdfs:label xml:lang="de">technisches System</rdfs:label>
        <rdfs:label xml:lang="en">technological system</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">technische systeme</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">technological systems</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">technisches System</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">technological system</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001015 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00006036"/>
                <owl:someValuesFrom rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00006026"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A continuant which realises a tool role.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein continuant, die eine Rolle als Werkzeug realisiert.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://casrai-test.evision.ca/glossary-term/tool/"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Tool"/>
        <oboInOwl:hasNarrowSynonym xml:lang="en">digital tool</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="de">digitales Tool</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="de">digitales Werkzeug</oboInOwl:hasNarrowSynonym>
        <rdfs:comment xml:lang="en">A tool might extend the capability of a user and/or give it the capability to perform a process that is not possible without it. Tools are not part of the entity (i.e. Input) that an action is performed on (i.e. a wrench is not part of the car) and are typically not consumed during the process.</rdfs:comment>
        <rdfs:label xml:lang="de">Werkzeug</rdfs:label>
        <rdfs:label xml:lang="en">tool</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Werkzeuge</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">tools</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Werkzeug</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">tool</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001016 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001016">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. A collection of tools which is intended for a particular purpose.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">OBSOLETE. Eine Sammlung von Werkzeugen, die für einen bestimmten Zweck vorgesehen ist.</obo:IAO_0000115>
        <obo:IAO_0100001 rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001015"/>
        <oboInOwl:hasDbXref rdf:resource="https://dictionary.cambridge.org/dictionary/english/tooling"/>
        <oboInOwl:hasRelatedSynonym xml:lang="de">Toolbox</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">tool box</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">The purpose can be to assist an agent in accomplishing a specified set of objectives e.g. within a planned process. The term &quot;tooling&quot; is also used with alternative meaning e.g. when describing the process of getting or making the right tools or equipment for a particular purpose. Within the scope of this glossary (digital assets &amp; software) there are however more precise terms (&quot;programming&quot; vs. &quot;tooling a software&quot;). For that reason, we intend to use the term strictly in the sense of the here given definition. TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b</rdfs:comment>
        <rdfs:comment>We deem that it is not used primarily in digitization context (commonly in the manufacturing.</rdfs:comment>
        <rdfs:label xml:lang="de">obsolete Werkzeugsammlung</rdfs:label>
        <rdfs:label xml:lang="en">obsolete tooling</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <hob:HDO_00001024 xml:lang="de">Werkzeugsammlungen</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">tooling</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Werkzeugsammlung</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">tooling</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001017 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001017">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001049"/>
        <obo:IAO_0000115 xml:lang="en">A system which consists of components that are digital.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein System welches aus digitalen Einzelteilen besteht.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym xml:lang="en">software system</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">A digital system could be a digital repository which consists of digital components such as a database management system and a database.</rdfs:comment>
        <rdfs:comment xml:lang="en">The terms software system and digital system are very close but not the same, specifically because most software consists of multiple components and could be seen as a software system. We note however that first, a digital system might also include digital components that are not software (such as data); second the term software system is generally used for the congregation of a software (which is a specification) such as a specific instance of a software running somewhere; and third the term system (as in software system versus software) is generally used for entities with increasing complexity - the threshold for which is arbitrary. For these reasons we keep the terms software and digital system separate in the ontology with software system being a related synonym of digital system.</rdfs:comment>
        <rdfs:label xml:lang="de">Digitales System</rdfs:label>
        <rdfs:label xml:lang="en">digital system</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Digitale Systeme</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">digital systems</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="en">Digitales System</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">digital system</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001018 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001018">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A group of persons which have a characteristic in common. </obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Gruppe von Personen mit einem gemeinsamen Merkmal.</obo:IAO_0000115>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-2209-9385"/>
        <oboInOwl:hasBroadSynonym xml:lang="de">Gruppe</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">community</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">group</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/NCIT_C16453"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/PCO_0000027"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Community"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.merriam-webster.com/dictionary/community"/>
        <oboInOwl:hasExactSynonym xml:lang="de">Gemeinschaft</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">Personengemeinschaft</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">Consider merging / replacing with PCO&apos;s human community.</rdfs:comment>
        <rdfs:label xml:lang="de">Menschengemeinschaft</rdfs:label>
        <rdfs:label xml:lang="en">human community</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Menschengemeinschaften</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">human communities</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Menschengemeinschaft</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">human community</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001019 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">An entity which is the output of a process.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Entität, die das Ergebnis eines Prozesses ist.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/NCIT_C51980"/>
        <oboInOwl:hasExactSynonym xml:lang="de">Erzeugnis</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">The entity can be object or service. TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b</rdfs:comment>
        <rdfs:label xml:lang="de">Produkt</rdfs:label>
        <rdfs:label xml:lang="en">product</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Produkte</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">products</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Produkt</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">product</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001020 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001020">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001023"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">Software which communicates between users and system software to direct hardware operations.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Software, die zwischen dem Benutzer und der Systemsoftware kommuniziert, um den Betrieb der Hardware zu steuern.</obo:IAO_0000115>
        <obo:OMO_0003000 xml:lang="de">App</obo:OMO_0003000>
        <obo:OMO_0003000 xml:lang="en">app</obo:OMO_0003000>
        <oboInOwl:hasBroadSynonym xml:lang="de">Anwendung</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="de">Applikation</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">application</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Application_software"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Software"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.webopedia.com/definitions/application-software/"/>
        <oboInOwl:hasExactSynonym xml:lang="de">Computeranwendung</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">computer application</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">When using a computer users might not be aware that their actions guide hardware operations. Hardware operations include the operation of RAM or the CPU. Hardware operation can thus be considered unavoidable when operating a computer. TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b</rdfs:comment>
        <rdfs:label xml:lang="de">Anwendungssoftware</rdfs:label>
        <rdfs:label xml:lang="en">application software</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Anwendungssoftware</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">application software</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Anwendungssoftware</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">application software</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001021 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001021">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A tool which can generate and/or manipulate metadata.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein Werkzeug, welches Metadaten erstellen und/oder verabeiten kann.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym xml:lang="de">Metadatenwerkzeug</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">metadata tool</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="https://whatis.techtarget.com/definition/metadata-management"/>
        <oboInOwl:hasExactSynonym xml:lang="en">Metadata management software</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">Metadatenmanagementsoftware</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">Metadatenwerkzeug</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">metadata tool</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b</rdfs:comment>
        <rdfs:label xml:lang="de">Metadatenmanagementwerkzeug</rdfs:label>
        <rdfs:label xml:lang="en">metadata management tool</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Metadatenmanagementwerkzeuge</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">metadata management tools</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Metadatenmanagementwerkzeug</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">metadata management tool</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001022 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001022">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001072"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A service that is offered via an interface in the world wide web.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein Dienst, der über eine Schnittstelle im World Wide Web angeboten wird.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym xml:lang="de">Dienst</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">Service</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/OBIws_0000104"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Web_service"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.w3.org/TR/2004/NOTE-ws-gloss-20040211/#webservice"/>
        <rdfs:comment xml:lang="en">A web service is typically a software system designed to support interoperable machine-to-machine interaction over a network. The interface could either be a GUI or an API which is described in a machine-processable format. TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b</rdfs:comment>
        <rdfs:label xml:lang="de">Webservice</rdfs:label>
        <rdfs:label xml:lang="en">web service</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Webservices</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">web services</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Webservice</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">web service</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001023 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000007"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">An action specification whose concretisations direct the actions of hardware.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Aktions-Spezifikation, deren Konkretisierungen die Aktionen von Hardware steuern.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym xml:lang="de">Softwaresystem</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">software system</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Computer_language"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Software"/>
        <oboInOwl:hasNarrowSynonym xml:lang="de">Computer Software</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">computer software</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">software component</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">software method</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">software module</oboInOwl:hasNarrowSynonym>
        <rdfs:comment xml:lang="en">Software can be implemented in multiple computer languages. We use this as a top-level class to accommodate both ad-hoc scripts which have a more sequential nature, as well as engineered software which has a higher degree of nestedness, usually includes more formal planning and employs rigorous unit and beta testing during implementation. TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b</rdfs:comment>
        <rdfs:label xml:lang="de">Software</rdfs:label>
        <rdfs:label xml:lang="en">software</rdfs:label>
        <skos:note xml:lang="de">Anweisungen, die in einem Programm, Skript oder einer anderen symbolischen Form kodiert sind, und die, wenn sie ausgeführt werden, Hardware anleiten, was zu tun ist.</skos:note>
        <skos:note xml:lang="en">Instructions which are encoded in a program, script, or another symbolic form and which, when executed, tell hardware what to do.</skos:note>
        <hob:HDO_00001024 xml:lang="de">Software</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">software</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Software</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">software</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001025 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001025">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000045"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A persistent unique identifier which has had its uniqueness verified against a globally authoritative registry.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein eindeutiger, persistenter Identifier, dessen Eindeutigkeit durch den Abgleich mit einer Registry sichergestellt wurde, die globale Autorität hat.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym xml:lang="en">persistent identifier</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="de">persistenter Identifier</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="https://de.wikipedia.org/wiki/Persistent_Identifier"/>
        <rdfs:comment xml:lang="en">This is the ideal PID to realize FAIRness. In general, it is expected that - once created - a persistent unique identifier will be stored in the globally authoritative registry it is verified against. The registry will then prevent duplication of the persistent unique identifier as new identifiers are added. </rdfs:comment>
        <rdfs:label xml:lang="en">persistent globally unique identifier</rdfs:label>
        <rdfs:label xml:lang="de">persistenter global eindeutiger Identifier</rdfs:label>
        <hob:HDO_00001024 xml:lang="en">persistent globally unique identifiers</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="de">persistente global eindeutige Identifier</hob:HDO_00001024>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001027 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A quality which inheres in data, by virtue of that data having the dispositions of findability, accessibility, interoperability and re-usability according to the FAIR principles. </obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Eigenschaft, die Daten haben, wenn sie die Veranlagungen zur Auffindbarkeit, Zugänglichkeit, Interoperabilität und Wiederverwendbarkeit gemäß den FAIR-Prinzipien aufweisen.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="de">FAIR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FAIR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">FAIRness von Daten</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">data FAIRness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="de">FAIRness von Metadaten</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">metadata FAIRness</oboInOwl:hasNarrowSynonym>
        <rdfs:comment xml:lang="en">We note that, an absolute measure for FAIRness is not possible. This is because FAIRness will always depend on specific application cases or operational environments. The FAIR Principles are, after all, high-level principles. Several projects have implemented quantitative and semi-quantitative measures of FAIRness, but these measures also require specific implementations and/or interpretations of the FAIR Principles. While some aspects of the FAIR principles can be measured in absolute terms (i.e. is there a PID?) others (i.e. is the metadata rich?) require advanced foreknowledge of a representative sample of possible application cases.</rdfs:comment>
        <rdfs:label xml:lang="de">FAIRness</rdfs:label>
        <rdfs:label xml:lang="en">FAIRness</rdfs:label>
        <rdfs:seeAlso>https://ardc.edu.au/resources/aboutdata/fair-data/fair-self-assessment-tool/</rdfs:seeAlso>
        <rdfs:seeAlso>https://fairaware.dans.knaw.nl/</rdfs:seeAlso>
        <rdfs:seeAlso>https://www.biorxiv.org/content/10.1101/225490v3.full.pdf</rdfs:seeAlso>
        <rdfs:seeAlso>https://www.fairsfair.eu/f-uji-automated-fair-data-assessment-tool</rdfs:seeAlso>
        <rdfs:seeAlso>https://www.go-fair.org/fair-principles/</rdfs:seeAlso>
        <skos:note xml:lang="de">Die Eigenschaft von Daten, wenn sie entsprechend der FAIR-Prinzipien auffindbar, zugänglich, interoperabel und wiederverwendbar sind.</skos:note>
        <skos:note xml:lang="en">The property of data, if they are findable, accessible, interoperable and re-usable according to the FAIR principles. </skos:note>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001029 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A quality which inheres in data, by virtue of that data being sufficiently informative to support the completion of one or more planned processes.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Eigenschaft die Daten haben, wenn sie ausreichend informativ für die Durchführung eines, oder mehrerer, definierter geplanter Prozesse sind.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="de">Reichhaltigkeit von Daten</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">data richness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">reich</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">rich</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="de">Reichhaltigkeit von Metadaten</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">metadata richness</oboInOwl:hasNarrowSynonym>
        <rdfs:comment xml:lang="en">The term &quot;rich metadata&quot; is often used loosely, e.g. in the descriptions of the FAIR (sub)principles. We note that the &quot;richness&quot; of metadata is depending on the aims, criteria, and capabilities of the agents that would use it. As such, metadata can only be labelled as &quot;rich&quot; when the complete (or at least a representative) set of use cases, it will be subject to, is known - along with their specifications. Even in the latter case, new (re)uses of the metadata, unknown at the time at which metadata is generated or gathered, can easily arise. Thus it is generally recommended to gather and record all feasible metadata as much as possible. These metadata may cover contextual factors, data structure, administrative aspects, provenance, or/and the results of analyses performed upon the metadata or its associated data. We note that in the case of the FAIR (sub)principles, the richness of metadata is specifically required to realise the findability and reusability or related data. Being informative is a quantitative measurable attribute. Please refer to the definition of information in this glossary for further information.</rdfs:comment>
        <rdfs:label xml:lang="de">Reichhaltigkeit</rdfs:label>
        <rdfs:label xml:lang="en">richness</rdfs:label>
        <rdfs:seeAlso>https://www.go-fair.org/fair-principles/</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001030 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001030">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000002"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A classification system which is used to hierarchically categorise semantic artefacts according to their semantic expressiveness.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein Klassifizierungssystem, das zur hierarchischen Einordnung semantischer Artefakte auf Basis ihrer semantischen Ausdrucksfähigkeit verwendet wird.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://inmyownterms.com/is-this-a-glossary-a-lexicon-or-a-thesaurus-how-to-tell-them-apart/"/>
        <rdfs:comment xml:lang="en">Most common semantic resources that are put into relation in this context are (in increasing grade of semantic expressiveness) Glossaries, Taxonomies, Thesauri, Topic Maps, and Ontologies.</rdfs:comment>
        <rdfs:label xml:lang="en">semantic ladder</rdfs:label>
        <hob:HDO_00001026 xml:lang="en">semantic ladder</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001031 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A quality which inheres in an semantic artefact by virtue of its ability to encode the meaning of data in a form that is accessible to humans and/or machines and allows inference.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Eigenschaft, die ein semantischer Artefakt hat, wenn sie Wissen speichern und in einer Form darstellen kann, die für menschliche und/oder maschinelle Akteure zugänglich ist.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Semantic_property."/>
        <rdfs:comment xml:lang="en">The minimum level of semantic expressiveness depends on whether the entity is to be used by human or machine agents. For a human, a simple controlled list of terms can be regarded as a semantic entity as the knowledge possessed by the human can react to and reason over it. However, it would not be, by itself, a semantic entity for a machine agent, which only processes it as strings of data. Machine agents would need some form of structure to establish logically consistent relationships between classes such as synonymy, antonymy, hyponymy, and hypernymy. This can be further increased by adding axiomatic relationships with domain and range constraints suitable for machine reasoning. Semantic artifacts include but are not limited to digital glossaries, thesauri, taxonomies and ontologies.</rdfs:comment>
        <rdfs:label xml:lang="en">semantic expressiveness</rdfs:label>
        <rdfs:label xml:lang="de">semantische Ausdruckskraft</rdfs:label>
        <hob:HDO_00001026 xml:lang="en">semantic expressiveness</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="de">semantische Ausdruckskraft</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001032 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001032">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00007031"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A list which contains exactly two elements in a fixed order.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein Objekt, welches genau zwei Elemente enthält, die eine feste Abfolge haben.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://en.wiktionary.org/wiki/ordered_pair"/>
        <oboInOwl:hasExactSynonym xml:lang="en">2-tuples</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">Exchanging one or both elements or changing the order would result in a different object.</rdfs:comment>
        <rdfs:label xml:lang="de">geordnetes Paar</rdfs:label>
        <rdfs:label xml:lang="en">ordered pair</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">geordnete Paare</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">ordered pairs</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">geordnetes Paar</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">ordered pair</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001033 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001033">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">An abstract representation of an entity which (1) is based on a substantial collection of information, (2) grants its bearer reliable familiarity with that entity, and (3) can be used to reason and take action about that entity.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine abstrakte Abbildung einer Entität, die (1) aus umfangreichen Informationen aufgebaut ist, (2) ihrem Träger eine zuverlässige Vertrautheit mit dieser Entität gewährt und (3) dazu verwendet werden kann, Überlegungen und Schlussfolgerungen über die Entität zu ziehen und diesbezüglich zu handeln.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://en.wiktionary.org/wiki/knowledge"/>
        <rdfs:comment xml:lang="en">For example, an expert with knowledge about the salinity range of the Arctic Ocean (constructed from large amounts of information on the topic would be able to reason that a salinity value of 43% is a likely error, rather than a real measurement. We note that the term &apos;abstract representation&apos; used in this definition should not be confused with the term &apos;knowledge representation&apos; that is used in the field of artificial intelligence and computer reasoning and typically is a formalised form of knowledge. </rdfs:comment>
        <rdfs:label xml:lang="de">Wissen</rdfs:label>
        <rdfs:label xml:lang="en">knowledge</rdfs:label>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001034 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001034">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001033"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">Knowledge, which has been encoded in a machine-readable and actionable form.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Wissen, das in für Maschinen lesbarer und verwendbarer Form codiert wurde. </obo:IAO_0000115>
        <rdfs:label xml:lang="en">digital knowledge</rdfs:label>
        <rdfs:label xml:lang="de">digitales Wissen</rdfs:label>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001035 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A quality which inheres in data, by virtue of (1) the absence of restrictions - monetary, technical, or otherwise - upon their use, (2) the data being hosted in a repository which allows, in whole or in part, the free access to them, (3) the data containing all information required for license compliance, and (4) the data being serialised in such a way as to readily allow identification of, access to, and modification of their parts.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Eigenschaft, die Daten haben, wenn (1) ihre Nutzung keinen monetären, technischen oder sonstigen Beschränkungen unterliegt, (2) sie in einem Repositorium gehostet werden, das den freien Download der Daten, bzw. Teile dieser über das Internet ermöglicht, (3) die Daten alle für die Einhaltung der Lizenzbestimmungen erforderlichen Informationen enthalten und (4) Zugang zu sowie Änderungen einzelner Komponenten dieser Daten einfach möglich ist.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym xml:lang="de">Offenheit von Metadaten</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">metadata openness</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="de">Offenheit</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">open</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">openness</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">We might need a separate definition for &quot;open&quot; that also applies to entities like software (could be data) and license (or &quot;license openness&quot;). We note that the term &quot;open&quot; is used in various fields with differing meanings. While the given definition here is applicable to terms, such as open data (for research data) or open-source software (for program code), it should be differentiated from the meaning of the term open access (in publishing). The latter has fewer constraints with respect to e.g., hosting, format and re-use. The absence of legal restriction for re-use can be ensured by making sure that the data or software in question as well as the format it is stored in are under a license specifying permission to re-use and modify, such as e.g. CC-BY. The requirements to cite the source are not seen as a restriction on re-use or modification in the sense of the given definition here. Covering reasonable one-time reproduction costs (e.g., fees to cover the costs when ordering a physical medium containing the requested data or software) is not seen as a monetary restriction in the sense of this definition. </rdfs:comment>
        <rdfs:label xml:lang="de">Offenheit von Daten</rdfs:label>
        <rdfs:label xml:lang="en">data openness</rdfs:label>
        <rdfs:seeAlso>https://en.wikipedia.org/wiki/Open_source</rdfs:seeAlso>
        <rdfs:seeAlso>https://opendefinition.org/od/2.1/en/</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001036 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001036">
        <owl:equivalentClass rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00006084"/>
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000040"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A schema which represents or constitutes the structure of metadata.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein Schema, dass die Struktur von Metadaten beschreibt.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://www.sciencedirect.com/topics/computer-science/metadata-schema"/>
        <oboInOwl:hasNarrowSynonym>information proile</oboInOwl:hasNarrowSynonym>
        <rdfs:comment xml:lang="en">A metadata schema is used to (pre-)define the structure of metadata. For example, the arrangement of fields in a BibTex template constitutes a metadata schema to be used by a reference management system. Note that the term &quot;metadata standard&quot; is not a exact synonym of &quot;metadata schema&quot;, even though these terms are often used interchangeably. Not all schemata are standardised and not all metadata standards are schemata, however one could have a standard metadata schema. </rdfs:comment>
        <rdfs:label xml:lang="de">Metadatenschema</rdfs:label>
        <rdfs:label xml:lang="en">metadata schema</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001036"/>
        <rdfs:seeAlso>https://ddialliance.org/Specification/DDI-Codebook/2.5/</rdfs:seeAlso>
        <rdfs:seeAlso>https://www.dublincore.org/</rdfs:seeAlso>
        <skos:note xml:lang="en">A template which shows how metadata is to be structured and stored. </skos:note>
        <skos:note xml:lang="de">Eine Vorlage, die zeigt, wie Metadaten strukturiert und gespeichert werden sollten. </skos:note>
        <hob:HDO_00001024 xml:lang="de">Metadatenschemas</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="de">Metadatenschemata</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="de">Metadatenschemen</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">metadata schemas</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">metadata schemata</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Metadatenschema</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">metadata schema</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001037 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A generically dependent continuant which is composed always of multiple data instances, which are grouped intentionally according to one or more common characteristics.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein generisch abhängiges Kontinuum, welches immer aus mehreren Daten besteht, die aufgrund einer oder mehrerer gemeinsamer Merkmale mit Absicht zusammengestellt wurden.</obo:IAO_0000115>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-3949-818X"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/NCIT_C47824"/>
        <oboInOwl:hasDbXref rdf:resource="https://de.wikipedia.org/wiki/Datenbasis"/>
        <oboInOwl:hasExactSynonym xml:lang="en">dataset</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="de">Datenbasis</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">Intention may be related to analysis, storage or publication of that data(set). For example, all files that are stored together on one CD-ROM or DVD might constitute a dataset as they are stored physically together. The organisation of the collection might strongly differ between application cases.</rdfs:comment>
        <rdfs:label xml:lang="de">Datensatz</rdfs:label>
        <rdfs:label xml:lang="en">data set</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Datensätze</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">data sets</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Datensatz</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">data set</hob:HDO_00001026>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001037"/>
        <owl:annotatedProperty rdf:resource="http://purl.org/dc/elements/1.1/contributor"/>
        <owl:annotatedTarget rdf:resource="https://orcid.org/0000-0002-3949-818X"/>
        <rdfs:comment>Jos Lehmann</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001038 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001038">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000109"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A database system which has (1) been optimised to support a defined set of analyses and (2) stores data in a predefined structure using standards and conventions.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein Datenbanksystem, das (1) zur Unterstützung einer bestimmten Reihe von Analysen optimiert wurde und (2) Daten in einer vordefinierten Struktur unter Verwendung von Standards und Konventionen speichert.</obo:IAO_0000115>
        <obo:OMO_0003012 xml:lang="en">- DW - DWH</obo:OMO_0003012>
        <oboInOwl:hasDbXref rdf:resource="https://aws.amazon.com/big-data/datalakes-and-analytics/what-is-a-data-lake/"/>
        <oboInOwl:hasDbXref rdf:resource="https://de.ryte.com/wiki/Data_Warehouse"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Data_warehouse"/>
        <oboInOwl:hasNarrowSynonym xml:lang="en">data mart</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">enterprise data warehouse</oboInOwl:hasNarrowSynonym>
        <rdfs:comment xml:lang="en">In the design process of a DW the purpose of the DW should be at its core. This differentiates it from a generic database which could be multi-purpose or simply used for storing structured data without a specific application in mind (e.g. for creating analytical reports, real time operational reporting).</rdfs:comment>
        <rdfs:label xml:lang="de">Data Warehouse</rdfs:label>
        <rdfs:label xml:lang="en">data warehouse</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Data Warehouses</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">data warehouses</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Data Warehouse</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">data warehouse</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001039 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001039">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000108"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A digital repository which is centralised and allows the storage of data as-is.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein digitales Repository, welches zentralisiert ist und die Speicherung von Daten im Ist-Zustand ermöglicht.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://aws.amazon.com/big-data/datalakes-and-analytics/what-is-a-data-lake/"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Data_lake"/>
        <rdfs:comment xml:lang="en">In this context, &quot;centralised&quot; suggests that - from the user perspective - the repository behaves as a cohesive whole and that there is a single point of access. Data stored in the data lake does not have to conform to any pre- defined schema, and may be structured or unstructured. Users can pull arbitrary data from the data lake for downstream purposes, but will likely have to curate or modify it to be suitable for cross-comparison or other downstream actions A data lake usually prioritises the preservation of large quantities of data (over, for example, curating it to a high standard of interoperability) and make it available for further processing downstream, if desired. Hosted data might be e.g. raw copies of source system data, sensor data, etc.</rdfs:comment>
        <rdfs:label xml:lang="de">Data Lake</rdfs:label>
        <rdfs:label xml:lang="en">data lake</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Data Lakes</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">data lakes</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Data Lake</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">data lake</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001040 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001040">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000108"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A digital repository which is hosted on and managed by a cloud-based system.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein digitales Repositorium, welches auf einem cloudbasierten System gehostet und von diesem verwaltet wird. </obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://aws.amazon.com/what-is-cloud-storage/?nc1=h_ls"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Cloud_storage"/>
        <oboInOwl:hasExactSynonym xml:lang="de">Cloudspeicher</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="de">Remote-Speicher</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">remote storage</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="de">Cloud-Speicher</rdfs:label>
        <rdfs:label xml:lang="en">cloud storage</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Cloud-Speicher</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">cloud storage</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Cloud-Speicher</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">cloud storage</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001041 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001041">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A set, whose members have one or more attributes in common.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Menge, deren Mitglieder eine oder mehrere Eigenschaften gemeinsam haben.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="de">Kategorie</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">Typ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">category</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">set</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">type</oboInOwl:hasExactSynonym>
