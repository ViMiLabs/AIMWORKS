        <hob:HDO_00001026 xml:lang="de">Klasse</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">class</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001042 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001042">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001049"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A system which (1) consists of a single server or a federated network of servers operating as a single coherent digital system, and (2) can be accessed from multiple locations.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein System, welches (1) aus einem Server oder einem föderierten Netzwerk von Servern besteht, die als zusammenhängendes digitales System operieren, und (2) auf das von unterschiedlichen Standorten aus zugegriffen werden kann.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym xml:lang="en">cloud</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="https://aws.amazon.com/what-is-cloud-storage/?nc1=h_ls"/>
        <oboInOwl:hasDbXref rdf:resource="https://azure.microsoft.com/en-us/overview/what-is-the-cloud/"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Cloud_storage"/>
        <rdfs:comment xml:lang="en">In many cases, cloud-based systems are accessible via the internet. However, in some cases where security or web-access issues are barriers (e.g. in the military or in the health sectors, or on field missions) this might not be the case. Cloud-based systems may and often do use distributed solutions to offer to compute infrastructure, storage, and other services. Distributed systems create redundancy, which often provides increased reliability. Resources might be distributed and joined in logical pools, e.g. for data storage. Access for the user may be offered via a GUI, a client, or an API. The physical environment as well as the software used to manage a cloud-based system, may be offered by a host or cloud service provider. </rdfs:comment>
        <rdfs:label xml:lang="de">Cloudbasiertes System</rdfs:label>
        <rdfs:label xml:lang="en">cloud-based system</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Cloudbasierte systeme</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">cloud-based systems</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Cloudbasiertes System</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">cloud-based system</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001043 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001043">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000020"/>
        <obo:IAO_0000115 xml:lang="en">A graph which has structuredness conforming to a knowledge graph specification.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein Graph, dessen Strukturiertheit einer Wissensgraph-Spezifikation entspricht.</obo:IAO_0000115>
        <obo:OMO_0003012 xml:lang="en">KG</obo:OMO_0003012>
        <oboInOwl:hasBroadSynonym xml:lang="en">knowledge base</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Knowledge_graph"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.ibm.com/cloud/learn/knowledge-graph"/>
        <oboInOwl:hasRelatedSynonym xml:lang="en">semantic network</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">A network of real-world entities — i.e. objects, events, situations, or concepts — and the relationship between them. The content of the KG is typically human- and machine-readable. The Google Knowledge Graph is an example of a large-scale knowledge graph used by Google and its services to enhance its search engine&apos;s results.</rdfs:comment>
        <rdfs:label xml:lang="de">Wissensgraph</rdfs:label>
        <rdfs:label xml:lang="en">knowledge graph</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Wissensgraphen</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">knowledge graphs</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Wissensgraph</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">knowledge graph</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001044 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001044">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001023"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">Software which is encoded in a form that allows it to be processed and acted upon by a processing unit without prior interpretation or compilation.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Software, die in einer Form kodiert ist, die es erlaubt sie ohne vorherige Interpretation oder Kompilierung von einer Verarbeitungseinheit auszuführen.</obo:IAO_0000115>
        <obo:OMO_0003000 xml:lang="de">exe</obo:OMO_0003000>
        <obo:OMO_0003000 xml:lang="en">exe</obo:OMO_0003000>
        <oboInOwl:hasExactSynonym xml:lang="de">Exe-Datei</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">ausführbare Datei</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">executable</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">executable file</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">We note that during further development of the artefact the term executable will likely have to be defined specifically (i.e. as a disposition or property). TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b</rdfs:comment>
        <rdfs:label xml:lang="de">Ausführbare Software</rdfs:label>
        <rdfs:label xml:lang="en">executable software</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Ausführbare Software</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">executable software</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Ausführbare Software</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">executable software</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001045 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001045">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001023"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">Software which is expressed in a programming language.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Software, die in einer Programmiersprache ausgedrückt ist.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym xml:lang="de">Computer Program</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">computer program</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="de">Skript</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">script</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b</rdfs:comment>
        <rdfs:label xml:lang="de">Programm</rdfs:label>
        <rdfs:label xml:lang="en">program</rdfs:label>
        <rdfs:seeAlso>https://en.wikipedia.org/wiki/Programming_language</rdfs:seeAlso>
        <hob:HDO_00001024 xml:lang="de">Programme</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">programs</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Programm</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">program</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001046 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001005"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A specification which defines the rules (syntax and grammar) that can be used to encode instructions to be executed by a processing unit. </obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Spezifikation, die die Regeln (Syntax und Grammatik) festlegt, welche verwendet werden können, um Anweisungen zu kodieren, die von einer Verarbeitungseinheit ausgeführt werden sollen. </obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym xml:lang="de">Maschinensprache</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">machine language</oboInOwl:hasNarrowSynonym>
        <rdfs:comment xml:lang="en">Different programming languages provide different levels of abstraction relative to the hardware. A script in python has a higher level of abstraction than instructions that are encoded in binary code. Consequently, the instructions encoded in a programming language require a different level of translation steps in order to direct hardware, depending on what programming language they are implemented in. The use of an interpreter for the execution of a script, or its compilation to binary can be seen as such translation steps. TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b</rdfs:comment>
        <rdfs:label xml:lang="de">Programmiersprache</rdfs:label>
        <rdfs:label xml:lang="en">programming language</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Programmiersprachen</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">programming languages</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Programmiersprache</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">programming language</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001047 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001047">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001023"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">Software which is embedded in hardware components to direct basic hardware functions or provide hardware abstraction services to higher-level software.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Software, die in Hardware-Komponenten eingebettet ist, um deren grundlegende Hardware-Funktionen zu steuern oder Hardware-Abstraktionsdienste für übergeordnete Software bereitzustellen.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">In some cases, the involved hardware might be so simple or minimal, that it can be operated exclusively through firmware - in such a case firmware would act as the operating system of the device in question. TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b</rdfs:comment>
        <rdfs:label xml:lang="de">Firmware</rdfs:label>
        <rdfs:label xml:lang="en">firmware</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Firmware</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">firmware</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Firmware</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">firmware</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001049 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">An entity which consists of multiple components that are integrated and behave as a whole.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Entität, welche aus mehreren Komponenten besteht, die integriert sind und sich als ein Ganzes verhalten.</obo:IAO_0000115>
        <obo:OMO_0003000 xml:lang="de">Sys</obo:OMO_0003000>
        <obo:OMO_0003000 xml:lang="en">sys</obo:OMO_0003000>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25700"/>
        <rdfs:comment xml:lang="en">This is a definition that takes into account the BFO and NCIT defintion. We created this because the BFO definition is unstable at the moment and we intended to have the defnition less restrictive with respect to the neccessity of a system having to be a material entity. </rdfs:comment>
        <rdfs:label xml:lang="de">System</rdfs:label>
        <rdfs:label xml:lang="en">system</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Systeme</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">systems</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">System</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">system</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001050 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000006"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A narrative object in which all propositions adhere to the rules of a programming language.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">A role which inheres in an entity and is realized when that entity is used to represent a single element of a set or a part of a whole.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Ein narratives Objekt, in dem alle Aussagen den Regeln einer Programmiersprache folgen.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://www.thefreedictionary.com/computer+code"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.wikidata.org/wiki/Property:P3295"/>
        <oboInOwl:hasDbXref>ISO/IEC Guide 99:2007</oboInOwl:hasDbXref>
        <rdfs:comment xml:lang="en">The definition provided here allows for flexibility to address that code can be concretised in multiple data types (e.g. program code, markdown) and file formats. TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b potentially add synonyms source code Quelltext</rdfs:comment>
        <rdfs:label xml:lang="de">Programmcode</rdfs:label>
        <rdfs:label xml:lang="en">program code</rdfs:label>
        <skos:note xml:lang="de">Eine kodierte Form von Anweisungen, die einer bestimmten Programmiersprache folgt.</skos:note>
        <skos:note xml:lang="en">The encoded form of instructions according to the rules of a given programming language. </skos:note>
        <hob:HDO_00001024 xml:lang="de">Programmcodes</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">program codes</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Programmcode</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">program code</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001051 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001051">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00000046"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A string which (1) is part of a file name and (2) indicates the file format.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Eine Zeichenfolge, die (1) Teil eines Dateinamens ist und (2) bei der Bearbeitung durch eine Maschine auf das Dateiformat deutet.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">file extension</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="de">Dateinnamenerweiterung</rdfs:label>
        <rdfs:label xml:lang="en">file name extension</rdfs:label>
        <hob:HDO_00001026 xml:lang="de">Dateinamenerweiterung</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">file name extension</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001052 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001052">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001023"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">Software which provides a platform for other software such that they can operate collectively as a single coherent system.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Software, die eine Plattform für andere Software bietet, so dass sie gemeinsam als ein ein zusammenhängendes System arbeiten kann.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/System_software"/>
        <rdfs:comment xml:lang="en">TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b</rdfs:comment>
        <rdfs:label xml:lang="de">System Software</rdfs:label>
        <rdfs:label xml:lang="en">system software</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">System Software</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">system software</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">System Software</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">system software</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001053 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001053">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/hob/HDO_00001052"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">System software which manages the operation of a specified range of hardware. </obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Systemsoftware, die den Betrieb bestimmter Hardware verwaltet. </obo:IAO_0000115>
        <rdfs:comment xml:lang="en">The here specified range of hardware pertains to the typical sets of hardware comprised in a computer (e.g. CPU, motherboard, RAM, GPU, sound card). By operating these components an operating system provides common services for application software towards these components. TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b</rdfs:comment>
        <rdfs:label xml:lang="de">Betriebssystem</rdfs:label>
        <rdfs:label xml:lang="en">operating system</rdfs:label>
        <hob:HDO_00001024 xml:lang="de">Betriebssysteme</hob:HDO_00001024>
        <hob:HDO_00001024 xml:lang="en">operating systems</hob:HDO_00001024>
        <hob:HDO_00001026 xml:lang="de">Betriebssystem</hob:HDO_00001026>
        <hob:HDO_00001026 xml:lang="en">operating system</hob:HDO_00001026>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001054 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001054">
        <rdfs:comment xml:lang="en">DEPRECATED The term hardware is used complementary to the term software (which controls hardware actions). A personal computer can be considered a typical data processing system. TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b</rdfs:comment>
        <rdfs:comment>Reimplemented as a subclass of BFO:material entity.</rdfs:comment>
        <rdfs:label xml:lang="de">DEPRECATED Hardware</rdfs:label>
        <rdfs:label xml:lang="en">DEPRECATED hardware</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/HDO_00007001"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/hob/HDO_00001055 -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/hob/HDO_00001055">
