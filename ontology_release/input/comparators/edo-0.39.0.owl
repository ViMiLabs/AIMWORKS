    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/characterisation-methodology/chameo#OpticalMicroscopy -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/characterisation-methodology/chameo#OpticalMicroscopy">
