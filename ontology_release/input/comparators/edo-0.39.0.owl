    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_885b462e_f6bc_412d_8b94_9425e13af0c7 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_885b462e_f6bc_412d_8b94_9425e13af0c7">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_c995ae70_3b84_4ebb_bcfc_69e6a281bb88"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_aecc6094_c6a5_4a36_a825_8a497a2ae112"/>
        <rdfs:comment xml:lang="en">electric current that flows in a constant direction, i.e. a current with a constant sign</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/modules/electrochemistry-testing#"/>
        <rdfs:label xml:lang="en">DirectCurrent</rdfs:label>
        <skos:altLabel xml:lang="en">DC</skos:altLabel>
        <skos:prefLabel xml:lang="en">DirectCurrent</skos:prefLabel>
        <ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>https://www.wikidata.org/wiki/Q159241</ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
        <ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 xml:lang="en">https://dbpedia.org/page/Direct_current</ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">electric current that flows in a constant direction, i.e. a current with a constant sign</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">I_{DC}</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The term ‘direct current’ should be used where there is ambiguity concerning the constancy of direction of current. See alternating current.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
        <ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d xml:lang="en">https://en.wikipedia.org/wiki/Direct_current</ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
        <ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 xml:lang="en">https://goldbook.iupac.org/terms/view/D01767</ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_885b462e_f6bc_412d_8b94_9425e13af0c7"/>
        <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <owl:annotatedTarget xml:lang="en">electric current that flows in a constant direction, i.e. a current with a constant sign</owl:annotatedTarget>
        <dcterms:source>J. M. Pingarron et al., Terminology of electrochemical methods of analysis (IUPAC Recommendations 2019), Pure and Applied Chemistry, 4, 92, 2020, 641-694. https://doi.org/10.1515/pac-2018-0109</dcterms:source>
    </owl:Axiom>
    


