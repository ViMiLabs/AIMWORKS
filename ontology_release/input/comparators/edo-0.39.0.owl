    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_1422cde1_929e_46b6_b0dc_1010eebc5dfd -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_1422cde1_929e_46b6_b0dc_1010eebc5dfd">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_2946d40b_24a1_47fa_8176_e3f79bb45064"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_2d896559_eee3_447c_9759_87c854a4266a"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_bed1d005_b04e_4a90_94cf_02bc678a8569"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#EMMO_f6070071_d054_4b17_9d2d_f446f7147d0f"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The quantity defined by IUPAC (electrochemical potential, goldbook E01945) is the molar one, MolarElectrochemicalPotential; this class is its per-particle counterpart, carrying an energy unit.</rdfs:comment>
        <rdfs:comment xml:lang="en">electrochemical potential of a charged species per particle: its chemical potential per particle plus the electrostatic energy of its charge in the local electric potential</rdfs:comment>
        <rdfs:comment xml:lang="en">in quantum mechanical terms, electrochemical potential is defined as the energy level of the electron orbitals in the species that have a 50 percent probability of occupancy</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">ElectrochemicalPotential</rdfs:label>
        <skos:prefLabel xml:lang="en">ElectrochemicalPotential</skos:prefLabel>
        <skos:related rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_7fe804b8_6126_4132_be8f_b4985d61b1f6"/>
        <ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>https://www.wikidata.org/wiki/Q62525</ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">electrochemical potential of a charged species per particle: its chemical potential per particle plus the electrostatic energy of its charge in the local electric potential</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d xml:lang="en">https://en.wikipedia.org/wiki/Electrochemical_potential</ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_1422cde1_929e_46b6_b0dc_1010eebc5dfd"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="en">in quantum mechanical terms, electrochemical potential is defined as the energy level of the electron orbitals in the species that have a 50 percent probability of occupancy</owl:annotatedTarget>
        <dcterms:source>J. Newman and K. E. Thmoas-Alyea, Electrochemical Systems, 3rd ed. Hoboken, New Jersey: John Wiley &amp; Sons, 2004.</dcterms:source>
    </owl:Axiom>
    


