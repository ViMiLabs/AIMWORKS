    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_bbb1d95b_72d1_44f6_b07e_a3d7d41ac215 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_bbb1d95b_72d1_44f6_b07e_a3d7d41ac215">
