    <!-- https://w3id.org/emmo#EMMO_8aba9715_d542_4a79_a778_6115d2b4febd -->

    <owl:Class rdf:about="https://w3id.org/emmo#EMMO_8aba9715_d542_4a79_a778_6115d2b4febd">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8af3b008_0e32_4684_85ab_a52a8e7b6877"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_cd24eb82_a11c_4a31_96ea_32f870c5580a"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#EMMO_94c663c8_1d99_45aa_a172_93d19ea95856"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Collective agency occurs when two or more individuals act as a group, in accordance with certain principles or procedures that constitute and organize the group.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://plato.stanford.edu/entries/agency/#OthKinAgeMenShaColRelArt"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/agency#"/>
        <rdfs:label xml:lang="en">CollectiveAgency</rdfs:label>
        <skos:prefLabel xml:lang="en">CollectiveAgency</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Collective agency occurs when two or more individuals act as a group, in accordance with certain principles or procedures that constitute and organize the group.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The group acting collectively is intended to be represented as an item, meaning that all members of the group should have had at least one causal interaction with another member. The collective action in fact is taken in accordance with certain principles or procedures that constitute and organize the group itself that requires implicitly a causal interaction between members.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:Class>
    


    <!-- https://w3id.org/emmo#EMMO_8af3b008_0e32_4684_85ab_a52a8e7b6877 -->

