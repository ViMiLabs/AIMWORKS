        <ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>http://qudt.org/vocab/unit/MilliM-PER-DAY</ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
        <ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>mm.d-1</ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
        <ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>mm/d</ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
