        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_057e7d57_aff0_49de_911a_8861d85cef40"/>
        <rdfs:comment xml:lang="en">A language object is a discrete data entity respecting specific language syntactic rules (a well-formed formula).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/noncoherentsiunits#"/>
        <rdfs:label xml:lang="en">Language</rdfs:label>
        <skos:prefLabel xml:lang="en">Language</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A language object is a discrete data entity respecting specific language syntactic rules (a well-formed formula).</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_d8d2144e_5c8d_455d_a643_5caf4d8d9df8"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <owl:annotatedTarget xml:lang="en">Language</owl:annotatedTarget>
        <ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From Latin lingua (“tongue, speech, language”), from Old Latin dingua (“tongue”).</ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
    </owl:Axiom>
    


