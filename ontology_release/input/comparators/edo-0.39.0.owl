    <!-- https://w3id.org/emmo/domain/chemical-substance#substance_3032a52b_72ee_4f3f_95d7_5011e0967e85 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/chemical-substance#substance_3032a52b_72ee_4f3f_95d7_5011e0967e85">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/chemical-substance#substance_dc68514f_b592_4e1b_a00f_fbb29f2fafbd"/>
        <rdfs:comment xml:lang="en">A polysulfone-based polymer functionalized with quaternary ammonium groups, used as an anion-conducting membrane material in electrochemical applications.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/chemical-substance#"/>
        <rdfs:label xml:lang="en">QuaternaryAmmoniumPolySulfone</rdfs:label>
        <skos:note xml:lang="en">Quaternary ammonium polysulfones are a class of anion exchange polymers where quaternary ammonium functional groups are grafted onto a polysulfone backbone, enabling ionic conductivity in alkaline electrochemical systems. They are structurally distinct from other ion-conducting polymers such as imidazolium-functionalized or piperidinium-based materials due to their sulfone-containing aromatic backbone. Including this term supports precise semantic classification of anion exchange membrane materials in energy and polymer ontologies.</skos:note>
        <skos:note xml:lang="en">Quaternary ammonium polysulfones are widely used in anion exchange membranes for fuel cells, electrolyzers, and related alkaline electrochemical devices.</skos:note>
        <skos:prefLabel xml:lang="en">QuaternaryAmmoniumPolySulfone</skos:prefLabel>
        <ns1:EMMO_4c8480cf_56de_41da_8699_f12a9033313a xml:lang="en">Quaternary ammonium polysulfones are chemically and functionally distinct from piperidinium- and imidazolium-functionalized polymers due to differences in cation stability and hydroxide conductivity behavior.</ns1:EMMO_4c8480cf_56de_41da_8699_f12a9033313a>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A polysulfone-based polymer functionalized with quaternary ammonium groups, used as an anion-conducting membrane material in electrochemical applications.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


