        <ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 xml:lang="en">https://dbpedia.org/page/Galvanic_cell</ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">electrochemical cell in which chemical reactions occur spontaneously and chemical energy is converted into electrical energy.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">An electrochemical cell that spontaneously produces work.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
