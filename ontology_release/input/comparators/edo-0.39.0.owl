        <skos:hiddenLabel xml:lang="en">CoulombEfficiency/%</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">CoulombicEfficiency</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Used in battery cycling to express the ratio of the charge delivered during discharge to the charge supplied during the preceding charge. Not to be confused with FaradaicEfficiency, the fraction of the total charge that contributes to a specific reaction.</skos:scopeNote>
        <ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f xml:lang="en">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=482-05-39</ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">ratio of the electric charge discharged from a secondary battery to the electric charge provided during the preceding charge</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
