        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_3a6578ac_aee0_43b9_9bc6_1eb208c8c9a9"/>
        <dcterms:isReplacedBy rdf:resource="https://w3id.org/emmo#EMMO_3a6578ac_aee0_43b9_9bc6_1eb208c8c9a9"/>
        <rdfs:comment xml:lang="en">Deprecated in 0.38.0: the electrode polarity and the bearing component belong to the cell structure (hasNegativeElectrode / hasPositiveElectrode, hasCoating, hasActiveMaterial), not to the class name. The class is kept, with a defining axiom, so that data typed with it still classifies and data stated through the structure classifies under it.</rdfs:comment>
        <rdfs:comment xml:lang="en">porosity of the positive electrode coating</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">PositiveElectrodeCoatingPorosity</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:prefLabel xml:lang="en">PositiveElectrodeCoatingPorosity</skos:prefLabel>
        <skos:scopeNote xml:lang="en">State the polarity through the cell structure instead: the cell hasPositiveElectrode an electrode, the electrode hasCoating an ElectrodeCoating, and the coating hasProperty a Porosity.</skos:scopeNote>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">porosity of the positive electrode coating</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
