            <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_2dd512a1_5187_47cc_b0b8_141214e22b59"/>
            <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_33e0ac8b_a318_4285_b1de_e95347784632"/>
