        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
        <rdfs:comment xml:lang="en">A symbol that stands for a single unit.</rdfs:comment>
