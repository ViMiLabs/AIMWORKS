            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_b2282816_b7a3_44c6_b2cb_3feff1ceb7fe"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_d91940f0_c8b6_4505_9b68_6bf6cfc5c544"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A positive surface overpotential produces a positive (anodic) current.</rdfs:comment>
        <rdfs:comment xml:lang="en">The driving force for an electrochemcial charge-transfer reaction.</rdfs:comment>
        <rdfs:comment xml:lang="en">The potential of a working electrode relative to a reference electrode of the same kinds placed in the solution adjacent to the surface of the working electrode (just outside the double layer).</rdfs:comment>
        <rdfs:comment xml:lang="en">\eta_s = \phi_{electrode} - \phi_{solution} - E_{eq}</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">SurfaceOverpotential</rdfs:label>
        <skos:altLabel xml:lang="en">SurfacePolarization</skos:altLabel>
        <skos:prefLabel xml:lang="en">SurfaceOverpotential</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The potential of a working electrode relative to a reference electrode of the same kinds placed in the solution adjacent to the surface of the working electrode (just outside the double layer).</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_60741c58_a10d_4aa6_bb68_0066a6ff8e30"/>
        <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <owl:annotatedTarget xml:lang="en">The potential of a working electrode relative to a reference electrode of the same kinds placed in the solution adjacent to the surface of the working electrode (just outside the double layer).</owl:annotatedTarget>
        <dcterms:references>J. Newman and K. E. Thmoas-Alyea, Electrochemical Systems, 3rd ed. Hoboken, New Jersey: John Wiley &amp; Sons, 2004.</dcterms:references>
    </owl:Axiom>
    


