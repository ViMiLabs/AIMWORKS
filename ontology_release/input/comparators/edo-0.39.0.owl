    <!-- https://w3id.org/emmo#EMMO_8e52c42b_e879_4473_9fa1_4b23428b392b -->

    <owl:ObjectProperty rdf:about="https://w3id.org/emmo#EMMO_8e52c42b_e879_4473_9fa1_4b23428b392b">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_a9a9d824_5ba1_4dac_a407_e42bf63350ca"/>
