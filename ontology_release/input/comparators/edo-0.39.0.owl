        <rdfs:label xml:lang="en">D85ParticleSize</rdfs:label>
        <skos:prefLabel xml:lang="en">D85ParticleSize</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">a statistical measure used in particle size distribution analysis, indicating the particle diameter below which 10% of the sample&apos;s particles fall.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
