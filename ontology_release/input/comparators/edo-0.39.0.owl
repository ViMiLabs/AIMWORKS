k</skos:example>
        <skos:prefLabel xml:lang="en">Variable</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A variable is a symbolic object that stands for any other mathematical object, such as  number, a vector, a matrix, a function, the argument of a function, a set, an element of a set.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_1eed0732_e3f1_4b2c_a9c4_b4e75eeb5895"/>
