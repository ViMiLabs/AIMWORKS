        <electrochemistry_1b718841_5d72_4071_bb71_fc4a754f5e30 xml:lang="en">[&apos;positive_electrode&apos;,&apos;active_materials&apos;,0,&apos;diffusion_constant&apos;,&apos;arrhenius&apos;,&apos;activation_energy&apos;]</electrochemistry_1b718841_5d72_4071_bb71_fc4a754f5e30>
