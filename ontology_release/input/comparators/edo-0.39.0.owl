        <rdfs:label xml:lang="en">NernstEinsteinEquation</rdfs:label>
        <rdfs:seeAlso xml:lang="en">KohlrauschsLaw</rdfs:seeAlso>
        <skos:prefLabel xml:lang="en">NernstEinsteinEquation</skos:prefLabel>
        <ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>https://www.wikidata.org/wiki/Q9325636</ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">an equation relating the limiting molar conductivity Λ_m^0  to the ionic diffusion coefficients.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">\Lambda_m^0 = (F^2/(R*T)) * (v_{+} * z_{+}^2 * D_{+} + v_{–} * z_{–}^2 * D_{–})</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
        <ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d xml:lang="en">https://en.wikipedia.org/wiki/Einstein_relation_(kinetic_theory)#Nernst%E2%80%93Einstein_equation</ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    </owl:Class>
    


