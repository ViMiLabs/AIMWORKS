    <!-- https://w3id.org/emmo#EMMO_03eb9b46_8ff0_4fcd_b1a0_73f65ae7434e -->

    <owl:Class rdf:about="https://w3id.org/emmo#EMMO_03eb9b46_8ff0_4fcd_b1a0_73f65ae7434e">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_45fec702_54cb_4508_b47e_bdc581229e22"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/manufacturing#"/>
        <rdfs:label xml:lang="en">AdditiveManufacturing</rdfs:label>
        <skos:altLabel xml:lang="en">GenerativeManufacturing</skos:altLabel>
        <skos:prefLabel xml:lang="en">AdditiveManufacturing</skos:prefLabel>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>process of joining materials to make parts from 3D model data, usually layer upon layer, as opposed to subtractive manufacturing (3.1.29) and formative manufacturing methodologies,</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_03eb9b46_8ff0_4fcd_b1a0_73f65ae7434e"/>
        <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <owl:annotatedTarget>process of joining materials to make parts from 3D model data, usually layer upon layer, as opposed to subtractive manufacturing (3.1.29) and formative manufacturing methodologies,</owl:annotatedTarget>
        <rdfs:seeAlso>ISO 23704-1:2022(en), 3.1.2</rdfs:seeAlso>
    </owl:Axiom>
    


