        <ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>http://qudt.org/vocab/constant/VonKlitzingConstant</ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
        <ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 xml:lang="en">The von Klitzing constant is defined as Planck constant divided by the square of the elementary charge.</ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Resistance quantum.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
