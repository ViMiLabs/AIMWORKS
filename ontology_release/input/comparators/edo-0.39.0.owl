    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_d91940f0_c8b6_4505_9b68_6bf6cfc5c544 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_d91940f0_c8b6_4505_9b68_6bf6cfc5c544">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_e272f229_7b45_4436_9b0b_30391ee4e5be"/>
        <rdfs:comment xml:lang="en">An open-circuit potential at which, in addition, all interfacial charge-transfer equilibria are established. An electrode at a mixed potential, or an insertion electrode resting on a hysteresis branch, has an open-circuit potential that is not an equilibrium electrode potential.</rdfs:comment>
        <rdfs:comment xml:lang="en">Eeq is related to the standard electrode potential by the Nernst equation.</rdfs:comment>
        <rdfs:comment xml:lang="en">Temperature and activities of relevant species must be specified.</rdfs:comment>
        <rdfs:comment xml:lang="en">electrode potential when the electrode reaction is in equilibrium.</rdfs:comment>
        <rdfs:comment xml:lang="en">potential of an electrode when no electric current flows through the cell and all local charge transfer equilibria across phase boundaries that are represented in the cell diagram (except at possible electrolyte-electrolyte junctions) and local chemical equilibria are established</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">EquilibriumElectrodePotential</rdfs:label>
        <skos:altLabel xml:lang="en">EquilibriumPotential</skos:altLabel>
        <skos:altLabel xml:lang="en">NernstPotential</skos:altLabel>
        <skos:altLabel xml:lang="en">ReversiblePotential</skos:altLabel>
        <skos:prefLabel xml:lang="en">EquilibriumElectrodePotential</skos:prefLabel>
        <skos:related rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_53616dc6_b921_4beb_9ab2_cafa4ba16406"/>
        <skos:related rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_7fe804b8_6126_4132_be8f_b4985d61b1f6"/>
        <skos:related rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_fe3a6c9a_85b8_4da6_aa4f_71c8de74939e"/>
        <ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=114-02-12</ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">potential of an electrode when no electric current flows through the cell and all local charge transfer equilibria across phase boundaries that are represented in the cell diagram (except at possible electrolyte-electrolyte junctions) and local chemical equilibria are established</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d xml:lang="en">https://en.wikipedia.org/wiki/Reversal_potential</ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_d91940f0_c8b6_4505_9b68_6bf6cfc5c544"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="en">electrode potential when the electrode reaction is in equilibrium.</owl:annotatedTarget>
        <dcterms:source>International Electrotechnical Commission (IEC), IEC 60050 - International Electrotechnical Vocabulary, retrieved from: https://www.electropedia.org</dcterms:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_d91940f0_c8b6_4505_9b68_6bf6cfc5c544"/>
        <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <owl:annotatedTarget xml:lang="en">potential of an electrode when no electric current flows through the cell and all local charge transfer equilibria across phase boundaries that are represented in the cell diagram (except at possible electrolyte-electrolyte junctions) and local chemical equilibria are established</owl:annotatedTarget>
        <dcterms:source>J. M. Pingarrón et al., Terminology of electrochemical methods of analysis (IUPAC Recommendations 2019), Pure and Applied Chemistry, 4, 92, 2020, 641-694. https://doi.org/10.1515/pac-2018-0109</dcterms:source>
    </owl:Axiom>
    


