    <!-- https://w3id.org/emmo#EMMO_4b2c223f_89fb_4407_b1b6_24774b7fe770 -->

    <owl:Class rdf:about="https://w3id.org/emmo#EMMO_4b2c223f_89fb_4407_b1b6_24774b7fe770">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_9895a1b4_f0a5_4167_ac5e_97db40b8bfcc"/>
