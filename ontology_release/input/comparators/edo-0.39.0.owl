    <owl:Class rdf:about="https://w3id.org/emmo#EMMO_3397f270_dfc1_4500_8f6f_4d0d85ac5f71">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_21205421_5783_4d3e_81e5_10c5d894a88a"/>
        <rdfs:subClassOf>
