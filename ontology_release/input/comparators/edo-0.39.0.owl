    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_8a5083b0_cd23_4f8c_99e8_b9ccd6f9f3a2 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_8a5083b0_cd23_4f8c_99e8_b9ccd6f9f3a2">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_0acd0fc2_1048_4604_8e90_bf4e84bd87df"/>
        <rdfs:comment xml:lang="en">electrochemical cell that has two half-cells separated by a wall permeable to ions, both containing the same electrolyte differing only in their ion concentrations</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/reference/electrochemistry-reference#"/>
        <rdfs:label xml:lang="en">ConcentrationCell</rdfs:label>
        <skos:prefLabel xml:lang="en">ConcentrationCell</skos:prefLabel>
        <ns1:EMMO_157fdf31_6387_42be_8e72_10530519214a>https://raw.githubusercontent.com/emmo-repo/domain-electrochemistry/dev/docs/assets/img/fig/png/ConcentrationCell.png</ns1:EMMO_157fdf31_6387_42be_8e72_10530519214a>
        <ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>https://www.wikidata.org/wiki/Q903563</ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
        <ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f xml:lang="en">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=114-03-08</ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">electrochemical cell that has two half-cells separated by a wall permeable to ions, both containing the same electrolyte differing only in their ion concentrations</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">a concentration cell produces a voltage as it attempts to reach equilibrium, which will occur when the concentration in both cells is equal.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
        <ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d xml:lang="en">https://en.wikipedia.org/wiki/Concentration_cell</ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    </owl:Class>
    <owl:Axiom>
