        <rdfs:comment xml:lang="en">a measure of the rate at which particles or heat or fluids spread</rdfs:comment>
        <rdfs:comment xml:lang="en">not to be confused with MassDiffusivity (i.e., DiffusionCoefficient)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
        <rdfs:label xml:lang="en">Diffusivity</rdfs:label>
