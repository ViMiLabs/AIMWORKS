    <!-- https://w3id.org/emmo/domain/characterisation-methodology/chameo#CalibrationData -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/characterisation-methodology/chameo#CalibrationData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/characterisation-methodology/chameo#CharacterisationData"/>
        <rdfs:comment xml:lang="en">Calibration data are used to provide correction of measured data or perform uncertainty calculations. They are generally the result of a measuerement on a reference specimen.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/characterisation-methodology/chameo#"/>
        <rdfs:label xml:lang="en">CalibrationData</rdfs:label>
        <skos:prefLabel xml:lang="en">CalibrationData</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Calibration data are used to provide correction of measured data or perform uncertainty calculations. They are generally the result of a measuerement on a reference specimen.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/characterisation-methodology/chameo#CalibrationProcess -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/characterisation-methodology/chameo#CalibrationProcess">
