        <rdfs:comment xml:lang="en">A quantity expressing the proportion of the principal component in a substance, typically reported as mass fraction or volume fraction, used to characterise the degree of contamination by impurities.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">Purity</rdfs:label>
        <skos:prefLabel xml:lang="en">Purity</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Purity is a fundamental material property required to accurately report electrochemical experiments, as it directly affects the actual concentration of active species in solution.</skos:scopeNote>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A quantity expressing the proportion of the principal component in a substance, typically reported as mass fraction or volume fraction, used to characterise the degree of contamination by impurities.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


