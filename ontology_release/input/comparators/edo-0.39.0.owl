        <rdfs:comment xml:lang="en">a two-step charging process in which a constant current is applied until a set upper cutoff voltage is reached and then the cell is potentiostatically held at that voltage until the current falls below some set threshhold value</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/modules/electrochemistry-testing#"/>
        <rdfs:label xml:lang="en">ConstantCurrentConstantVoltageCharging</rdfs:label>
        <skos:altLabel xml:lang="en">CCCV</skos:altLabel>
        <skos:prefLabel xml:lang="en">ConstantCurrentConstantVoltageCharging</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">a two-step charging process in which a constant current is applied until a set upper cutoff voltage is reached and then the cell is potentiostatically held at that voltage until the current falls below some set threshhold value</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


