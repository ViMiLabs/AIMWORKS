        <owl:annotatedTarget xml:lang="en">ISO/ASTM TR 52906:2022 Additive manufacturing
sintering: process of heating a powder metal compact to increase density and/or improve mechanical properties via solid state diffusion</owl:annotatedTarget>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.iso.org/obp/ui/#iso:std:iso-astm:tr:52906:ed-1:v1:en:term:3.9</rdfs:isDefinedBy>
