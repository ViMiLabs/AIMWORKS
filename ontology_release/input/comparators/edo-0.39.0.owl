    </owl:ObjectProperty>
    


    <!-- https://w3id.org/emmo#EMMO_7329967c_3972_4c99_b478_84f66436620d -->

    <owl:ObjectProperty rdf:about="https://w3id.org/emmo#EMMO_7329967c_3972_4c99_b478_84f66436620d">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_7afbed84_7593_4a23_bd88_9d9c6b04e8f6"/>
        <rdfs:domain rdf:resource="https://w3id.org/emmo#EMMO_90ae56e4_d197_49b6_be1a_0049e4756606"/>
        <rdfs:range rdf:resource="https://w3id.org/emmo#EMMO_2553c342_fc28_47d8_8e19_7a98fa08f150"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
