    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_7fc10197_41d9_4c1e_a107_928f03eb2d36 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_7fc10197_41d9_4c1e_a107_928f03eb2d36">
