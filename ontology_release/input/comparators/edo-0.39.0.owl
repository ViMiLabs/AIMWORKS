        <ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>https://en.wikipedia.org/wiki/Center_of_mass</ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    </owl:Class>
    


