    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_743c71a3_b80c_42e3_92fa_13a67b8167df -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_743c71a3_b80c_42e3_92fa_13a67b8167df">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_02eb0465_4f94_453c_8c1f_5ddf80134634"/>
        <rdfs:comment xml:lang="en">The time elapsed from initial commissioning until an electrochemical cell or battery reaches a defined end-of-life criterion under specified storage or use conditions, independent of the number of charge–discharge cycles performed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">CalendarLife</rdfs:label>
        <skos:note xml:lang="en">Commonly measured at 25 °C, 35 °C, and 45 °C with cells held at 50% or 100% state of charge; Arrhenius or power-law models are used to extrapolate to operational lifetime.</skos:note>
        <skos:prefLabel xml:lang="en">CalendarLife</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Characterises time-dependent degradation that occurs independently of cycling load. Particularly relevant for automotive (typically 15-year targets) and stationary storage (20+ year targets) applications.</skos:scopeNote>
        <ns1:EMMO_4c8480cf_56de_41da_8699_f12a9033313a xml:lang="en">CalendarLife and CycleLife are independent quantities. A cell may reach calendar end-of-life before its rated cycle count if stored at elevated temperature or high state of charge for extended periods.</ns1:EMMO_4c8480cf_56de_41da_8699_f12a9033313a>
        <ns1:EMMO_5f7abc2a_5b50_41c3_8def_c8ba7c3b083e xml:lang="en">End-of-life is typically defined as 80% capacity retention or 20% power fade relative to initial values; the criterion used must be stated alongside the value.</ns1:EMMO_5f7abc2a_5b50_41c3_8def_c8ba7c3b083e>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The time elapsed from initial commissioning until an electrochemical cell or battery reaches a defined end-of-life criterion under specified storage or use conditions, independent of the number of charge–discharge cycles performed.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_b6730304_cabc_4104_b415_14218466445c xml:lang="en">Strongly dependent on storage temperature and state of charge. Values reported without these conditions specified cannot be meaningfully compared. Accelerated ageing tests at elevated temperature require validated time–temperature superposition models to extrapolate to use conditions.</ns1:EMMO_b6730304_cabc_4104_b415_14218466445c>
    </owl:Class>
    


