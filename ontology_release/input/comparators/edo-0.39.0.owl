        <ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f xml:lang="en">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=114-02-08</ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">electrode that serves only as a source or sink for electrons without playing a chemical role in the electrode reaction</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Noble metals, mercury, and carbon are typically used as (nearly) inert electrodes.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:Class>
    <owl:Axiom>
