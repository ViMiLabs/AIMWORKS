    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_2f0b8724_290a_4c52_839b_927948ef8855 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_2f0b8724_290a_4c52_839b_927948ef8855">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_43003c86_9d15_433b_9789_ee2940920656"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_aecc6094_c6a5_4a36_a825_8a497a2ae112"/>
        <rdfs:comment xml:lang="en">The gap sets the electrolyte path length between the electrode surface and the separator surface, and with it the ohmic contribution of that electrolyte layer to the cell resistance. In flow cells it also affects electrolyte flow and bubble removal.</rdfs:comment>
        <rdfs:comment xml:lang="en">Zero for zero-gap cell designs, where the electrode is pressed directly against the separator or membrane.</rdfs:comment>
        <rdfs:comment xml:lang="en">the width of the spacing between an electrode surface and the adjacent separator or ion-exchange membrane in an electrolysis cell or other electrochemical cell</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">ElectrodeToSeparatorGapWidth</rdfs:label>
        <skos:altLabel xml:lang="en">ElectrodeMembraneGapWidth</skos:altLabel>
        <skos:altLabel xml:lang="en">ElectrodeToMembraneDistance</skos:altLabel>
        <skos:altLabel xml:lang="en">ElectrodeToMembraneGapWidth</skos:altLabel>
        <skos:altLabel xml:lang="en">ElectrodeToSeparatorDistance</skos:altLabel>
        <skos:note xml:lang="en">neither IEC nor IUPAC define this quantity; this class codifies common usage in the water-electrolysis, CO2-electrolysis and flow-cell literature</skos:note>
        <skos:prefLabel xml:lang="en">ElectrodeToSeparatorGapWidth</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">the width of the spacing between an electrode surface and the adjacent separator or ion-exchange membrane in an electrolysis cell or other electrochemical cell</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


