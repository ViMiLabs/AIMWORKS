        <ns1:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>6-30</ns1:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Vector quantity μ causing a change to its energy ΔW in an external magnetic field of field flux density B:

    ΔW = −μ · B</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
