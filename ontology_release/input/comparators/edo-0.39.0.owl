        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The relation between a collection and one of its item members.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/emmo#EMMO_70da982d_1810_4b01_9630_a28e216ecd9a -->

    <owl:ObjectProperty rdf:about="https://w3id.org/emmo#EMMO_70da982d_1810_4b01_9630_a28e216ecd9a">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_8e52c42b_e879_4473_9fa1_4b23428b392b"/>
        <rdfs:domain rdf:resource="https://w3id.org/emmo#EMMO_64963ed6_39c9_4258_85e0_6466c4b5420c"/>
        <rdfs:range rdf:resource="https://w3id.org/emmo#EMMO_4299e344_a321_4ef2_a744_bacfcce80afc"/>
        <rdfs:comment xml:lang="en">The holistic relation connecting a workflow with one of its tasks.</rdfs:comment>
