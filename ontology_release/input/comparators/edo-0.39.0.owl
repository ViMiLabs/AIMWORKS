    <!-- https://w3id.org/emmo#EMMO_814b6b76_e0ca_4953_a832_d1816fb695f1 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/emmo#EMMO_814b6b76_e0ca_4953_a832_d1816fb695f1">
