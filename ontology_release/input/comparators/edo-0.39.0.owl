    <!-- https://w3id.org/emmo#EMMO_799c067b_083f_4365_9452_1f1433b03676 -->

    <rdfs:Datatype rdf:about="https://w3id.org/emmo#EMMO_799c067b_083f_4365_9452_1f1433b03676">
        <rdfs:comment xml:lang="en">A datatype for a specifying a physcial quantity as a string consisting of a numerical, a separator and an SI unit.</rdfs:comment>
        <rdfs:label xml:lang="en">SIQuantityDatatype</rdfs:label>
        <skos:example xml:lang="en">&quot;3 cm&quot;</skos:example>
        <skos:example xml:lang="en">A more complete example showing how to specify the value of a physical quantity in turtle using this datatype:

    height1 a emmo:Height ;
        hasSIQuantityValue &quot;3 cm&quot;^^emmo:SIQuantityDatatype .</skos:example>
        <skos:prefLabel xml:lang="en">SIQuantityDatatype</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A datatype for a specifying a physcial quantity as a string consisting of a numerical, a separator and an SI unit.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The unit should be a valid, possible prefixed, derived SI unit.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </rdfs:Datatype>
    


