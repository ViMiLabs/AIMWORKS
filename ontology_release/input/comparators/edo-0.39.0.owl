    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_0a6cf2fa_3466_4dd2_a7dd_e5a42cf9c386 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_0a6cf2fa_3466_4dd2_a7dd_e5a42cf9c386">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_a2946006_513a_40cb_b4a8_710ea5401461"/>
        <rdfs:comment xml:lang="en">the average characteristic size of the pores in a porous material, typically derived from a pore size distribution</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">MeanPoreSize</rdfs:label>
        <skos:note xml:lang="en">Mean pore size is a fundamental descriptor of porous materials that directly influences transport properties such as ionic conductivity, diffusion, and electrolyte accessibility in electrochemical systems. It is widely used in characterizing electrodes, separators, and catalysts. Including this term supports consistent semantic representation of structure–property relationships in electrochemistry.</skos:note>
        <skos:prefLabel xml:lang="en">MeanPoreSize</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Mean pore size is commonly obtained from techniques such as gas adsorption (e.g., BET/BJH analysis), mercury intrusion porosimetry, capilary flow porometery, or imaging methods. It complements related descriptors like pore size distribution, porosity, and specific surface area, which are already relevant in electrochemical material modeling.</skos:scopeNote>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">the average characteristic size of the pores in a porous material, typically derived from a pore size distribution</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>https://goldbook.iupac.org/terms/view/P04760</ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_0a90e2fc_96a7_4777_a2a1_4f219636b7ac -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_0a90e2fc_96a7_4777_a2a1_4f219636b7ac">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_e272f229_7b45_4436_9b0b_30391ee4e5be"/>
        <owl:disjointWith rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_79d665cd_8408_4fcc_aa02_551f7c9aea47"/>
        <owl:disjointWith rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_d91940f0_c8b6_4505_9b68_6bf6cfc5c544"/>
        <rdfs:comment xml:lang="en">For an insertion electrode this is the lithiation (or, generally, insertion) branch. It is an open-circuit potential but not an equilibrium electrode potential: the electrode rests in a metastable state.</rdfs:comment>
        <rdfs:comment xml:lang="en">open-circuit potential of an electrode on the branch of its hysteresis loop reached under cathodic (reducing) current</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">CathodicBranchOpenCircuitPotential</rdfs:label>
        <skos:prefLabel xml:lang="en">CathodicBranchOpenCircuitPotential</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">open-circuit potential of an electrode on the branch of its hysteresis loop reached under cathodic (reducing) current</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
