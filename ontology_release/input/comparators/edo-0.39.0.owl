        <skos:prefLabel xml:lang="en">JoulePerCubicMetre</skos:prefLabel>
        <ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>http://qudt.org/vocab/unit/J-PER-M3</ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
