        <ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Volt</ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">SI unit for electric potential difference.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The volt is the unit of electric potential difference—electric potential difference is also known as voltage. The size of 1 volt is officially defined as the potential difference between two points of a wire carrying a current of 1 ampere when the power dissipated in the wire is 1 watt.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
        <ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://en.wikipedia.org/wiki/Volt?oldid=494812083</ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
        <ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>https://doi.org/10.1351/goldbook.V06634</ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>
    </owl:Class>
    


