        <skos:altLabel xml:lang="de">Fügen</skos:altLabel>
        <skos:prefLabel xml:lang="en">JoinManufacturing</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A manufacturing involving the creation of long-term connection of several workpieces.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
