        <rdfs:comment xml:lang="en">the electrochemical dissolution of a material to soluble species</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/reference/electrochemistry-reference#"/>
        <rdfs:label xml:lang="en">Electrodissolution</rdfs:label>
        <skos:example xml:lang="en">Dissolution of metallic copper as Zn^{2+} during corrosion or anodization.</skos:example>
        <skos:note xml:lang="en">It can be regarded as the reversal of electrodeposition.</skos:note>
        <skos:prefLabel xml:lang="en">Electrodissolution</skos:prefLabel>
