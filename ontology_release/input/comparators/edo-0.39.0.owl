        <skos:prefLabel xml:lang="en">CurrentInterruptDevice</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">safety component that permanently interrupts the electric current path between an electrode and its terminal when the internal pressure of the cell exceeds a predetermined limit</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">commonly integrated in the cap assembly of cylindrical lithium-ion cells, where it protects against overpressure caused by e.g. overcharging; its activation is irreversible and permanently disables the cell</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_1fc5642c_b7b2_43bf_ad20_f96001db8800 -->

