        <ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>https://www.wikidata.org/wiki/Q242657</ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
        <ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-49</ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
        <ns1:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>6-23</ns1:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
