        <rdfs:isDefinedBy>http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PascalSecondPerCubicMetre</rdfs:label>
        <rdfs:seeAlso>http://www.efunda.com/glossary/units/units--acoustic_impedance--pascal_second_per_cubic_meter.cfm</rdfs:seeAlso>
