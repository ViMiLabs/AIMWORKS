    <!-- https://w3id.org/emmo#EMMO_08cb807c_e626_447b_863f_e2835540e918 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/emmo#EMMO_08cb807c_e626_447b_863f_e2835540e918">
        <rdf:type rdf:resource="https://w3id.org/emmo#EMMO_e7aac247_31d6_4b2e_9fd2_e842b1b7ccac"/>
        <rdfs:comment xml:lang="en">The universe is considered as a causally self-connected object, encompassing all other objects. For this reason is unique.</rdfs:comment>
        <rdfs:comment>u ≡ σx⟨P(x, x)⟩</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/mereocausality#"/>
        <rdfs:label xml:lang="en">universe</rdfs:label>
        <skos:prefLabel xml:lang="en">universe</skos:prefLabel>
        <ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">The universe is considered as a causally self-connected object, encompassing all other objects. For this reason is unique.</ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
        <ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84>u ≡ σx⟨P(x, x)⟩</ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_08cb807c_e626_447b_863f_e2835540e918"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="https://w3id.org/emmo#EMMO_e7aac247_31d6_4b2e_9fd2_e842b1b7ccac"/>
        <ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">This axiom reflects the fact the the universe is causally self-connected. In fact, a  non causally connected universe would have been the sum of causally independend sub-universes, without any knowledge of others.
This axiom may be seen as Ockam&apos;s razor applied to causality.</ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_08cb807c_e626_447b_863f_e2835540e918"/>
        <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84"/>
        <owl:annotatedTarget>u ≡ σx⟨P(x, x)⟩</owl:annotatedTarget>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">This definition reads: &quot;The universe is the sum of all entities that are part of themselves&quot;. Since parthood (P) is reflexive by axiom, then the universe is the sum of all mereological entities.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:Axiom>
    <rdf:Description>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The rule for the subproperty chain:
inverse (hasSign) o inverse (hasReferent) ⇒ hasInterpreter</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </rdf:Description>
    <rdf:Description>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The rule for the subproperty chain:
 inverse (hasReferent) o inverse (hasInterpreter) ⇒ hasSign</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </rdf:Description>
    <rdf:Description>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The rule for the subproperty chain:
 inverse (hasInterpreter) o inverse (hasSign) ⇒ hasReferent</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </rdf:Description>
    <rdf:Description>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:qualifiedCardinality>
    </rdf:Description>
    <rdf:Description>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:qualifiedCardinality>
    </rdf:Description>
