    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_f330680b_347e_45b3_9113_5ce09d18d60b -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_f330680b_347e_45b3_9113_5ce09d18d60b">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_f76884f7_964e_488e_9bb7_1b2453e9e817"/>
        <rdfs:comment xml:lang="en">vent of special design which allows to release gas from a cell in order to avoid excessive internal pressure and thereby to preclude rupture or explosion of the cell container</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/reference/electrochemistry-reference#"/>
        <rdfs:label xml:lang="en">PressureReliefVent</rdfs:label>
        <skos:prefLabel xml:lang="en">PressureReliefVent</skos:prefLabel>
        <ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=482-02-41</ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">vent of special design which allows to release gas from a cell in order to avoid excessive internal pressure and thereby to preclude rupture or explosion of the cell container</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_f330680b_347e_45b3_9113_5ce09d18d60b"/>
        <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
