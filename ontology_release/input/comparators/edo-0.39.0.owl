    <!-- https://w3id.org/emmo#emmo_fd2aa864_eef7_4c3d_8243_9ea832d9df3e -->

    <owl:Class rdf:about="https://w3id.org/emmo#emmo_fd2aa864_eef7_4c3d_8243_9ea832d9df3e">
