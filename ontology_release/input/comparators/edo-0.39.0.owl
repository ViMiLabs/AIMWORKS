    <!-- https://w3id.org/emmo/domain/characterisation-methodology/chameo#SecondaryIonMassSpectrometry -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/characterisation-methodology/chameo#SecondaryIonMassSpectrometry">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/characterisation-methodology/chameo#Spectrometry"/>
        <rdfs:comment xml:lang="en">Secondary-ion mass spectrometry (SIMS) is a technique used to analyze the composition of solid surfaces and thin films by sputtering the surface of the specimen with a focused primary ion beam and collecting and analyzing ejected secondary ions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/characterisation-methodology/chameo#"/>
        <rdfs:label xml:lang="en">SecondaryIonMassSpectrometry</rdfs:label>
        <skos:altLabel xml:lang="en">SIMS</skos:altLabel>
        <skos:prefLabel xml:lang="en">SecondaryIonMassSpectrometry</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Secondary-ion mass spectrometry (SIMS) is a technique used to analyze the composition of solid surfaces and thin films by sputtering the surface of the specimen with a focused primary ion beam and collecting and analyzing ejected secondary ions.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/characterisation-methodology/chameo#ShearOrTorsionTesting -->

