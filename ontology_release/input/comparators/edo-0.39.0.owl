        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_18ce5200_00f5_45bb_8c6f_6fb128cd41ae"/>
        <owl:disjointWith rdf:resource="https://w3id.org/emmo#EMMO_c9c8f824_9127_4f93_bc21_69fe78a7f6f2"/>
