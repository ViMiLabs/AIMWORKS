        <rdfs:comment xml:lang="en">Quantifies the raw data acquisition rate, if applicable.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/characterisation-methodology/chameo#"/>
        <rdfs:label xml:lang="en">DataAcquisitionRate</rdfs:label>
        <skos:prefLabel xml:lang="en">DataAcquisitionRate</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Quantifies the raw data acquisition rate, if applicable.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/characterisation-methodology/chameo#DataAnalysis -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/characterisation-methodology/chameo#DataAnalysis">
