    <!-- https://w3id.org/emmo#EMMO_2553c342_fc28_47d8_8e19_7a98fa08f150 -->

    <owl:Class rdf:about="https://w3id.org/emmo#EMMO_2553c342_fc28_47d8_8e19_7a98fa08f150">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_9d799b43_e188_4047_8167_121d96b31a26"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/emmo#EMMO_7329967c_3972_4c99_b478_84f66436620d"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#EMMO_90ae56e4_d197_49b6_be1a_0049e4756606"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An object which is a temporal part of another object.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
        <rdfs:label xml:lang="en">SubObject</rdfs:label>
        <skos:example xml:lang="en">If an inhabited house is considered as an house that is occupied by some people in its majority of time, then an interval of inhabited house in which occasionally nobody is in there is no more an inhabited house, but an unhinabited house, since this temporal part does not satisfy the criteria of the whole.</skos:example>
        <skos:prefLabel xml:lang="en">SubObject</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An object which is a temporal part of another object.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Here we consider a temporal interval that is lower than the characteristic time of the physical process that provides the causality connection between the object parts.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:Class>
    


