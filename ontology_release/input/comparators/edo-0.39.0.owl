        <ns1:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>10-52</ns1:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Quotient of the linear attenuation coefficient µ and the number density, n, of atoms in the substance.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
