    <!-- https://w3id.org/emmo/domain/chemical-substance#substance_180ac854_f837_46ed_a4d8_4407b91fb95a -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/chemical-substance#substance_180ac854_f837_46ed_a4d8_4407b91fb95a">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/chemical-substance#substance_dc68514f_b592_4e1b_a00f_fbb29f2fafbd"/>
        <rdfs:comment xml:lang="en">A cationic polymer consisting of an arylene backbone functionalized with imidazolium groups, forming an ion-conducting polymeric material.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/chemical-substance#"/>
        <rdfs:label xml:lang="en">PolyAryleneImidazolium</rdfs:label>
        <skos:note xml:lang="en">Poly(arylene imidazolium)s are a distinct class of cationic polymers featuring imidazolium-functionalized arylene backbones, widely used in ion-conducting membranes and electrochemical applications. They exhibit unique properties such as ionic conductivity, thermal stability, and tunable charge transport behavior. Including this term is necessary to clearly distinguish this polymer family within broader polymer and ionic liquid material ontologies.</skos:note>
        <skos:note xml:lang="en">This polymer class is primarily used in advanced electrochemical systems such as fuel cell membranes and CO2 separation materials. The absence of standardized ontology entries motivates explicit inclusion for interoperability in materials informatics frameworks.</skos:note>
        <skos:prefLabel xml:lang="en">PolyAryleneImidazolium</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A cationic polymer consisting of an arylene backbone functionalized with imidazolium groups, forming an ion-conducting polymeric material.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


