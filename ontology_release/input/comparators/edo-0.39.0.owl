    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_a10ede13_c895_4f56_a728_b1aab512b31b -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_a10ede13_c895_4f56_a728_b1aab512b31b">
