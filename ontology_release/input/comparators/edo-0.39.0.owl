        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_d7f8cab9_b035_4ecd_be63_292672572526"/>
        <dcterms:isReplacedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_d7f8cab9_b035_4ecd_be63_292672572526"/>
        <rdfs:comment xml:lang="en">Deprecated in 0.38.0: the electrode polarity and the bearing component belong to the cell structure (hasNegativeElectrode / hasPositiveElectrode, hasCoating, hasActiveMaterial), not to the class name. The class is kept, with a defining axiom, so that data typed with it still classifies and data stated through the structure classifies under it.</rdfs:comment>
        <rdfs:comment xml:lang="en">the activation energy barrier in an Arrhenius expression for the diffusivity of lithium in the positive electrode</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">ActivationEnergyOfGuestDiffusivityInPositiveElectrodeActiveMaterial</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:prefLabel xml:lang="en">ActivationEnergyOfGuestDiffusivityInPositiveElectrodeActiveMaterial</skos:prefLabel>
        <skos:scopeNote xml:lang="en">State the polarity through the cell structure instead: the cell hasPositiveElectrode an electrode, the electrode hasActiveMaterial a material, the material hasProperty a GuestDiffusivity, and the diffusivity hasProperty an ActivationEnergy.</skos:scopeNote>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">the activation energy barrier in an Arrhenius expression for the diffusivity of lithium in the positive electrode</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
