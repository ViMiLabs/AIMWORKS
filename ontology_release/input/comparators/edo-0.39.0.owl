        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The relation between an entity that overlaps another without being its part.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:ObjectProperty>
    


