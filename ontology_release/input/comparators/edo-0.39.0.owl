        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">RatedCapacity</rdfs:label>
        <rdfs:seeAlso>https://w3id.org/emmo/domain/electrochemistry#electrochemistry_5ebeea80_af22_456b_9087_78c2a8465c58</rdfs:seeAlso>
        <rdfs:seeAlso>https://w3id.org/emmo/domain/electrochemistry#electrochemistry_e1fd84eb_acdb_4b2c_b90c_e899d552a3ee</rdfs:seeAlso>
        <skos:prefLabel xml:lang="en">RatedCapacity</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The term &apos;rated capacity&apos; is used by manufacturers to specify the energy storage capability of a product under some controlled test conditions. The value is often determined during a constant current load until the a voltage limit is reached, under controlled temperature conditions. The &apos;rated capacity&apos; helps to compare performance across different devices and provides a bisis for performing system engineering calculations. It can also be used as a basis for calculating other terms like the C-Rate, state-of-charge, and state-of-health of the device. The rated capacity at beginning of life serves as a reference for capacity-fade analysis during long-term cycling.</skos:scopeNote>
        <ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f xml:lang="en">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=482-03-15</ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
        <ns1:EMMO_5f7abc2a_5b50_41c3_8def_c8ba7c3b083e xml:lang="en">The value of rated capacity should be reported together with information on the conditions under which it was determined (e.g. voltage limits, applied current, temperature).</ns1:EMMO_5f7abc2a_5b50_41c3_8def_c8ba7c3b083e>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">capacity value of a battery [or electrode or electrochemical device] determined under specified conditions and declared by the manufacturer</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_b6730304_cabc_4104_b415_14218466445c xml:lang="en">The value for rated capacity does not necessarily represent the actual capacity in real-world usage, as factors like temperature, rate, and state-of-health affect the effective capacity.</ns1:EMMO_b6730304_cabc_4104_b415_14218466445c>
        <ns1:EMMO_cc65321f_1964_4f16_aea3_2a8edf2f3394 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo#AmpereHour</ns1:EMMO_cc65321f_1964_4f16_aea3_2a8edf2f3394>
        <ns1:EMMO_cc65321f_1964_4f16_aea3_2a8edf2f3394>https://w3id.org/emmo#MilliAmpereHour</ns1:EMMO_cc65321f_1964_4f16_aea3_2a8edf2f3394>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9b3b4668_0795_4a35_9965_2af383497a26"/>
        <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <owl:annotatedTarget xml:lang="en">capacity value of a battery [or electrode or electrochemical device] determined under specified conditions and declared by the manufacturer</owl:annotatedTarget>
        <dcterms:source>International Electrotechnical Commission (IEC), IEC 60050 - International Electrotechnical Vocabulary, retrieved from: https://www.electropedia.org</dcterms:source>
    </owl:Axiom>
    


    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9b44a651_afa9_4889_ae07_9ac49ede8ac1 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9b44a651_afa9_4889_ae07_9ac49ede8ac1">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_aecc6094_c6a5_4a36_a825_8a497a2ae112"/>
        <rdfs:comment xml:lang="en">The electrode-level counterpart of TemperatureCoefficientOfTheOpenCircuitVoltage (IEV 482-03-33), which is defined for a cell or battery. Cell models use it per electrode as the entropic change coefficient, proportional to the reaction entropy.</rdfs:comment>
        <rdfs:comment xml:lang="en">quotient of the change in open-circuit potential of an electrode by the corresponding change in temperature</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">TemperatureCoefficientOfTheOpenCircuitPotential</rdfs:label>
        <skos:altLabel xml:lang="en">EntropicChangeCoefficient</skos:altLabel>
        <skos:prefLabel xml:lang="en">TemperatureCoefficientOfTheOpenCircuitPotential</skos:prefLabel>
        <skos:related rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_3bb5ae23_59fa_4bc7_9495_803eb6719f28"/>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">quotient of the change in open-circuit potential of an electrode by the corresponding change in temperature</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9b6853e7_3412_463d_b5a9_82c14acebf7d -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9b6853e7_3412_463d_b5a9_82c14acebf7d">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_f76884f7_964e_488e_9bb7_1b2453e9e817"/>
        <rdfs:comment xml:lang="en">a tank for holding catholyte</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/reference/electrochemistry-reference#"/>
        <rdfs:label xml:lang="en">CatholyteTank</rdfs:label>
        <skos:prefLabel xml:lang="en">CatholyteTank</skos:prefLabel>
        <skos:related rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_15b852b5_19cc_49ab_849f_7df6175fb2be"/>
        <skos:related rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_38755e67_9d3b_4a82_bd8d_ef40a70379c1"/>
        <skos:related rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_c2e3af24_a76b_4bab_9b48_57f21455d721"/>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">a tank for holding catholyte</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">usually used in a flow cell system</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9bc02662_9799_4593_906d_638a841d7352 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9bc02662_9799_4593_906d_638a841d7352">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_ac9723d1_bac0_4109_874e_32849de9299b"/>
        <rdfs:comment xml:lang="en">a structural representation of the double layer that states that the accumulation of electric charge on the surface of the electrode is balanced by a layer of ions in the electrolyte</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/reference/electrochemistry-reference#"/>
        <rdfs:label xml:lang="en">HelmholtzModel</rdfs:label>
        <skos:prefLabel xml:lang="en">HelmholtzModel</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">a structural representation of the double layer that states that the accumulation of electric charge on the surface of the electrode is balanced by a layer of ions in the electrolyte</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">proposed by Hermann von Helmholtz in 1853</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">the first model for the double layer</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9bf40017_3f58_4030_ada7_cb37a3dfda2d -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9bf40017_3f58_4030_ada7_cb37a3dfda2d">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_e88f75d6_9a17_4cfc_bdf7_43d7cea5a9a1"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_02eb0465_4f94_453c_8c1f_5ddf80134634"/>
        <rdfs:comment xml:lang="en">According to to Thévenin&apos;s theorem can any linear electric curcuit be replaced with a voltage source in series with an impedance. This impedance is for historical reasons termed &quot;internal resistance&quot;.</rdfs:comment>
        <rdfs:comment xml:lang="en">For batteries, it the internal resistance the resistance of the cell.</rdfs:comment>
        <rdfs:comment xml:lang="en">impedance of a linear circuit&apos;s Thévenin representation</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">InternalResistance</rdfs:label>
        <skos:prefLabel xml:lang="en">InternalResistance</skos:prefLabel>
        <ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>https://www.wikidata.org/wiki/Q2527701</ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
        <ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=485-15-04</ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">impedance of a linear circuit&apos;s Thévenin representation</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d xml:lang="en">https://en.wikipedia.org/wiki/Internal_resistance</ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
        <electrochemistry_097ea615_c209_4edd_a1a1_5eea71d98fe8 xml:lang="en">dcir/ohms</electrochemistry_097ea615_c209_4edd_a1a1_5eea71d98fe8>
        <electrochemistry_811aafc3_0c6d_470e_b67e_ff5c82992609 xml:lang="en">DCIR(O)</electrochemistry_811aafc3_0c6d_470e_b67e_ff5c82992609>
        <electrochemistry_a07dd85b_d0df_4d5d_8b0c_14d20ea3fe45 xml:lang="en">internal_resistance</electrochemistry_a07dd85b_d0df_4d5d_8b0c_14d20ea3fe45>
    </owl:Class>
    


