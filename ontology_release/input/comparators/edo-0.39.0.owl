    <!-- https://w3id.org/emmo#EMMO_d893d373_b579_4867_841e_1c2b31a8d2c6 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/emmo#EMMO_d893d373_b579_4867_841e_1c2b31a8d2c6">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_3f2e4ac2_8ef3_4a14_b826_60d37f15f8ee"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:comment xml:lang="en">The relation between two individuals representing entities that share at least one of their parts.</rdfs:comment>
        <rdfs:comment>Oxy ≡ ∃z(Pzx ∧ Pzy)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/mereocausality#"/>
        <rdfs:label xml:lang="en">overlaps</rdfs:label>
        <skos:prefLabel xml:lang="en">overlaps</skos:prefLabel>
        <ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84>Oxy ≡ ∃z(Pzx ∧ Pzy)</ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The relation between two individuals representing entities that share at least one of their parts.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_d893d373_b579_4867_841e_1c2b31a8d2c6"/>
        <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84"/>
        <owl:annotatedTarget>Oxy ≡ ∃z(Pzx ∧ Pzy)</owl:annotatedTarget>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#EMMO_a8bd7094_6b40_47af_b1f4_a69d81a3afbd"/>
    </owl:Axiom>
    


    <!-- https://w3id.org/emmo#EMMO_da27d905_beb6_44ea_a330_a2dd9c17b263 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/emmo#EMMO_da27d905_beb6_44ea_a330_a2dd9c17b263">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_f275e4e9_062b_4ca4_a679_4f26ec0a48ae"/>
        <rdfs:domain rdf:resource="https://w3id.org/emmo#EMMO_0527413c_b286_4e9c_b2d0_03fb2a038dee"/>
