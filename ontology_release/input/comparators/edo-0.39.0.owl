    <!-- https://w3id.org/emmo#Gray -->

    <owl:Class rdf:about="https://w3id.org/emmo#Gray">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_847f1d9f_205e_46c1_8cb6_a9e479421f88"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8"/>
                <owl:hasValue>Gy</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">SI unit for absorbed dose.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siunits#"/>
        <rdfs:label xml:lang="en">Gray</rdfs:label>
        <skos:prefLabel xml:lang="en">Gray</skos:prefLabel>
        <schema:unitCode>A95</schema:unitCode>
        <ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>http://qudt.org/vocab/unit/GRAY</ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
        <ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>Gy</ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
        <ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Grey</ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">SI unit for absorbed dose.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>The SI unit of radiation dose. Radiation carries energy, and when it is absorbed by matter the matter receives this energy. The dose is the amount of energy deposited per unit of mass. One gray is defined to be the dose of one joule of energy absorbed per kilogram of matter, or 100 rad. The unit is named for the British physician L. Harold Gray (1905-1965), an authority on the use of radiation in the treatment of cancer.

-- QUDT</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
        <ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">//en.wikipedia.org/wiki/Grey?oldid=494774160</ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
        <ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>https://doi.org/10.1351/goldbook.G02696</ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>
    </owl:Class>
    


