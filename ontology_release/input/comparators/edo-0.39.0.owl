    <!-- https://w3id.org/emmo/domain/chemical-substance#substance_5a4a9e9f_a1fe_42e6_8382_6a5edfa6b4a5 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/chemical-substance#substance_5a4a9e9f_a1fe_42e6_8382_6a5edfa6b4a5">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_12a9a254_9791_4a00_b045_f397bc3ab2bc"/>
        <rdfs:comment xml:lang="en">a homogeneous mixture of gases constituting Earth’s atmosphere, primarily composed of nitrogen, oxygen, argon, and trace gases</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/chemical-substance#"/>
        <rdfs:label xml:lang="en">Air</rdfs:label>
        <skos:note xml:lang="en">Air is a ubiquitous and chemically relevant mixture that acts as a reactant, solvent, and environmental medium in many chemical processes. It is essential for representing atmospheric conditions, gas-phase reactions, and exposure contexts in chemical substance modeling. Including “Air” ensures consistent reference to a well-defined, commonly used mixture across domains.</skos:note>
        <skos:note xml:lang="en">Air should be modeled as a natural, variable-composition mixture rather than a pure substance, with potential extensions to specify dry air, humid air, or polluted air where needed.</skos:note>
        <skos:prefLabel xml:lang="en">Air</skos:prefLabel>
        <ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>https://www.wikidata.org/wiki/Q7391292</ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
        <ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25>https://dbpedia.org/resource/Air</ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">a homogeneous mixture of gases constituting Earth’s atmosphere, primarily composed of nitrogen, oxygen, argon, and trace gases</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>https://en.wikipedia.org/wiki/Air</ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
        <ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>https://goldbook.iupac.org/terms/view/C01214</ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>
