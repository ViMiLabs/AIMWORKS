    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_79d665cd_8408_4fcc_aa02_551f7c9aea47 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_79d665cd_8408_4fcc_aa02_551f7c9aea47">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_e272f229_7b45_4436_9b0b_30391ee4e5be"/>
        <owl:disjointWith rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_d91940f0_c8b6_4505_9b68_6bf6cfc5c544"/>
        <rdfs:comment xml:lang="en">For an insertion electrode this is the delithiation (or, generally, de-insertion) branch. It is an open-circuit potential but not an equilibrium electrode potential: the electrode rests in a metastable state.</rdfs:comment>
        <rdfs:comment xml:lang="en">open-circuit potential of an electrode on the branch of its hysteresis loop reached under anodic (oxidising) current</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">AnodicBranchOpenCircuitPotential</rdfs:label>
        <skos:prefLabel xml:lang="en">AnodicBranchOpenCircuitPotential</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">open-circuit potential of an electrode on the branch of its hysteresis loop reached under anodic (oxidising) current</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


