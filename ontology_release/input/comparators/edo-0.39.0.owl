    <!-- https://w3id.org/emmo#EMMO_7b79b2ac_3cf2_4d3b_8cdc_bcabb59d869e -->

    <owl:Class rdf:about="https://w3id.org/emmo#EMMO_7b79b2ac_3cf2_4d3b_8cdc_bcabb59d869e">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_b32fe85d_2f7b_4972_9dd7_7cf20d4bba59"/>
        <owl:disjointWith rdf:resource="https://w3id.org/emmo#EMMO_8b1367d6_0133_4b56_acc1_fa8b058169e3"/>
        <rdfs:comment xml:lang="en">A chausal chain whose quantum parts are of the same standard model fundamental type.</rdfs:comment>
        <rdfs:comment xml:lang="en">An elementary particle is a causal chain of quantum entities of the same type. For example, an elementary electron is a sequence of fundamental electrons only.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/standardmodel#"/>
        <rdfs:label xml:lang="en">ElementaryParticle</rdfs:label>
        <skos:altLabel xml:lang="en">SingleParticleChain</skos:altLabel>
        <skos:example xml:lang="en">An electron. A quark. A photon.</skos:example>
        <skos:prefLabel xml:lang="en">ElementaryParticle</skos:prefLabel>
        <ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">An elementary particle is a causal chain of quantum entities of the same type. For example, an elementary electron is a sequence of fundamental electrons only.</ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
        <ns1:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>DisjointUnionOf: ElementaryFermion, ElementaryBoson</ns1:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A chausal chain whose quantum parts are of the same standard model fundamental type.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_7b79b2ac_3cf2_4d3b_8cdc_bcabb59d869e"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <owl:annotatedTarget xml:lang="en">ElementaryParticle</owl:annotatedTarget>
        <ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From Latin elementārius (“elementary”), from elementum (“one of the four elements of antiquity; fundamentals”).</ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
    </owl:Axiom>
    


