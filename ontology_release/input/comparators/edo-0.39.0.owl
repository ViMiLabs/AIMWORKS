        <rdfs:label xml:lang="en">CPlusPlus</rdfs:label>
        <skos:altLabel xml:lang="en">C++</skos:altLabel>
        <skos:prefLabel xml:lang="en">CPlusPlus</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A language object respecting the syntactic rules of C++.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
