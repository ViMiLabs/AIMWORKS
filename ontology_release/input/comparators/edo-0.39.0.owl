    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_f591a444_89d6_4093_836d_7d53895edce4 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_f591a444_89d6_4093_836d_7d53895edce4">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_4f2d3939_91b1_4001_b8ab_7d19074bf845"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_c5047d29_4e68_43ee_8355_3e8f05dc70a5"/>
        <rdfs:comment xml:lang="en">For Electrochemical Impedance Spectroscopy, the Peak Potential Amplitude is usually small, (normally 5 to 10 mV).</rdfs:comment>
        <rdfs:comment xml:lang="en">half of the peak-to-peak amplitude of a periodic voltage perturbation within a single time period, with respect to a reference potential value</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">AmplitudeOfAlternatingVoltage</rdfs:label>
        <skos:prefLabel xml:lang="en">AmplitudeOfAlternatingVoltage</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">half of the peak-to-peak amplitude of a periodic voltage perturbation within a single time period, with respect to a reference potential value</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">This term should denote half of the peak-to-peak amplitude. Peak-to-peak and r.m.s. amplitudes should be so specified.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
        <ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>https://doi.org/10.1351/goldbook.A00311</ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_f591a444_89d6_4093_836d_7d53895edce4"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="en">For Electrochemical Impedance Spectroscopy, the Peak Potential Amplitude is usually small, (normally 5 to 10 mV).</owl:annotatedTarget>
        <dcterms:source>PINGARRÓN, José M., et al. Terminology of electrochemical methods of analysis (IUPAC Recommendations 2019). Pure and Applied Chemistry, 2020, 92.4: 641-694.</dcterms:source>
    </owl:Axiom>
    


