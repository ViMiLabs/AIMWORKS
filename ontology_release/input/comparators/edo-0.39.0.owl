    <!-- https://w3id.org/emmo#EMMO_53ed8611_2cd7_4286_9ef0_36572117b963 -->

    <owl:Class rdf:about="https://w3id.org/emmo#EMMO_53ed8611_2cd7_4286_9ef0_36572117b963">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_802d3e92_8770_4f98_a289_ccaaab7fdddf"/>
        <rdfs:comment xml:lang="en">A mereological fusion is any entity that is made up of two or more quantum entities, regardless of the fact that they are or not self-connected. It captures the idea of set, but excluding singletons.</rdfs:comment>
        <rdfs:comment xml:lang="en">The class of individuals representing mereological fusions consisting of two or more quantum entities.</rdfs:comment>
        <rdfs:comment xml:lang="en">The union of the CausalCluster and CausalStructure classes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/standardmodel#"/>
        <rdfs:label xml:lang="en">Fusion</rdfs:label>
        <skos:example xml:lang="en">An atom, a group of persons, a fluid.</skos:example>
        <skos:prefLabel xml:lang="en">Fusion</skos:prefLabel>
        <ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">A mereological fusion is any entity that is made up of two or more quantum entities, regardless of the fact that they are or not self-connected. It captures the idea of set, but excluding singletons.</ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
        <ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 xml:lang="en">The union of the CausalCluster and CausalStructure classes.</ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84>
        <ns1:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>EquivalentTo: CausalCluster or CausalStructure</ns1:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The class of individuals representing mereological fusions consisting of two or more quantum entities.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_53ed8611_2cd7_4286_9ef0_36572117b963"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <owl:annotatedTarget xml:lang="en">Fusion</owl:annotatedTarget>
        <ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From Latin fusio, from fundere ‘pour, melt’.</ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
    </owl:Axiom>
    


