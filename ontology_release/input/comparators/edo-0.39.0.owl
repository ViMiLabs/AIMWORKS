        <ns1:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>9-22</ns1:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">For substance X in a liquid or a solid mixture; quotient of absolute activity of substance X and the product of absolute activity of the pure substance X at the same temperature and pressure and amount-of-substance fraction of substance X.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
