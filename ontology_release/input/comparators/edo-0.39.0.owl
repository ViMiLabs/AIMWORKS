    <!-- https://w3id.org/emmo#EMMO_aa987900_caf1_4ce2_82fa_6b1d6fbd2ead -->

    <owl:ObjectProperty rdf:about="https://w3id.org/emmo#EMMO_aa987900_caf1_4ce2_82fa_6b1d6fbd2ead">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_3f2e4ac2_8ef3_4a14_b826_60d37f15f8ee"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <owl:propertyDisjointWith rdf:resource="https://w3id.org/emmo#EMMO_d893d373_b579_4867_841e_1c2b31a8d2c6"/>
        <rdfs:comment xml:lang="en">The relation between individuals representing non-overlapping entities (i.e. that have no parts in common).</rdfs:comment>
        <rdfs:comment>Dxy ≡ ¬Oxy.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/mereocausality#"/>
