        <skos:altLabel xml:lang="en">OCVHold</skos:altLabel>
        <skos:prefLabel xml:lang="en">OpenCircuitHold</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A process in which the electric current is kept constant at 0 (i.e., open-circuit conditions).</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


