        <skos:altLabel xml:lang="en">Reciprocal Square Giga Electron Volt</skos:altLabel>
        <skos:prefLabel xml:lang="en">ReciprocalSquareGigaElectronVolt</skos:prefLabel>
        <ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>http://qudt.org/vocab/unit/PER-GigaEV2</ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
