    <!-- https://w3id.org/emmo#EMMO_8cf62c94_ae5f_4f80_8669_d5f91178db6d -->

    <owl:Class rdf:about="https://w3id.org/emmo#EMMO_8cf62c94_ae5f_4f80_8669_d5f91178db6d">
