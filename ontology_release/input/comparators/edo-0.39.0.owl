        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">At positive potentials, Au forms an oxide and/or chemisorbed oxygen layer, while in the presence of complexing anions, such as chloride or cyanide, it readily undergoes oxidation and dissolution, limiting its working potential range and its applications.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_6fec8cc1_4e6c_428e_8343_6cf3c286a185"/>
