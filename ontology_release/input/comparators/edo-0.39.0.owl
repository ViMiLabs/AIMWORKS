        <skos:prefLabel xml:lang="en">Base64Binary</skos:prefLabel>
        <ns1:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>EquivalentTo: hasDataValue some xsd:base64Binary</ns1:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Base-64 encoding of binary data.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


