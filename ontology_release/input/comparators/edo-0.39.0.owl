    <!-- https://w3id.org/emmo#SquareMetrePerSecond -->

    <owl:Class rdf:about="https://w3id.org/emmo#SquareMetrePerSecond">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_b33cc5b5_a9dc_4082_b497_14d1654c5591"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_8189b42e_0995_423a_a26c_51168b27c3cf"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Square Metres per second is the SI derived unit of angular momentum, defined by distance or displacement in metres multiplied by distance again in metres and divided by time in seconds. The unit is written in symbols as m2/s or m2u00b7s-1 or m2s-1. It may be better understood when phrased as &quot;metres per second times metres&quot;, i.e. the momentum of an object with respect to a position.

-- QUDT</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/coherentsiunits#"/>
        <rdfs:isDefinedBy>http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">SquareMetrePerSecond</rdfs:label>
        <skos:altLabel xml:lang="en">Square Metre per Second</skos:altLabel>
        <skos:prefLabel xml:lang="en">SquareMetrePerSecond</skos:prefLabel>
        <ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>http://qudt.org/vocab/unit/M2-PER-SEC</ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
        <ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>m2.s-1</ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
        <ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>m2/s</ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
        <ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>m²/s</ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Square Metres per second is the SI derived unit of angular momentum, defined by distance or displacement in metres multiplied by distance again in metres and divided by time in seconds. The unit is written in symbols as m2/s or m2u00b7s-1 or m2s-1. It may be better understood when phrased as &quot;metres per second times metres&quot;, i.e. the momentum of an object with respect to a position.

-- QUDT</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


