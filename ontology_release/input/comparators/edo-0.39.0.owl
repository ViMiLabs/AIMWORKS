    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_0c9017b4_6efd_4e2b_8e24_48b60ebe9315 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_0c9017b4_6efd_4e2b_8e24_48b60ebe9315">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_49263a32_eca6_4644_8144_0d3b14c26d0a"/>
        <rdfs:comment xml:lang="en">the dissolution of molecules from a gas into another phase</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/reference/electrochemistry-reference#"/>
        <rdfs:label xml:lang="en">GasDissolution</rdfs:label>
        <skos:example xml:lang="en">Absorption of CO₂ into an alkaline electrolyte forming carbonate species.</skos:example>
        <skos:example xml:lang="en">Hydrogen evolution during water electrolysis.</skos:example>
        <skos:note xml:lang="en">Often leads to efficiency loss or mechanical degradation in electrochemical devices.</skos:note>
        <skos:prefLabel xml:lang="en">GasDissolution</skos:prefLabel>
        <skos:related rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_4288b145_ba79_4989_92f8_86086679b0fe"/>
