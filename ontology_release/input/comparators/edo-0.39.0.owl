    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_a5962e05_466d_46a4_8951_bea59d7326e5 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_a5962e05_466d_46a4_8951_bea59d7326e5">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_faab3f84_e475_4a46_af9c_7d249f0b9aef"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_02eb0465_4f94_453c_8c1f_5ddf80134634"/>
        <rdfs:comment xml:lang="en">ratio of the electric charge discharged from a secondary battery to the electric charge provided during the preceding charge</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">CoulombicEfficiency</rdfs:label>
        <skos:altLabel xml:lang="en">ChargeEfficiency</skos:altLabel>
