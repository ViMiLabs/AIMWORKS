    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9c557caa_61e2_4fa9_a517_4bad01a68122 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9c557caa_61e2_4fa9_a517_4bad01a68122">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9a823d64_9d10_4a29_9cbd_9bbdad7985bc"/>
        <rdfs:comment xml:lang="en">an electrode in which the primary active material consists of titanium or titanium compounds</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/reference/electrochemistry-reference#"/>
        <rdfs:label xml:lang="en">TitaniumBasedElectrode</rdfs:label>
        <skos:prefLabel xml:lang="en">TitaniumBasedElectrode</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">an electrode in which the primary active material consists of titanium or titanium compounds</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">often represented in cell designations by the letter T</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">this class is intended to enable designations based on IEC recommendations</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9c657fdc_b9d3_4964_907c_f9a6e8c5f52b -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9c657fdc_b9d3_4964_907c_f9a6e8c5f52b">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_2d896559_eee3_447c_9759_87c854a4266a"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_4ebe2ef1_eea8_4b10_822d_7a68215bd24d"/>
        <rdfs:comment xml:lang="en">Equal to the open-circuit potential of the positive electrode minus that of the negative electrode, the reference electrode cancelling. The open-circuit potential of a single electrode is OpenCircuitPotential, not this class.</rdfs:comment>
        <rdfs:comment xml:lang="en">IEC 80000-6 names this quantity source voltage (its former name there was electromotive force): the voltage between the terminals of a source when no current flows through it; hence the equivalence with emmo:SourceVoltage. The electromotive force as IUPAC defines it, with all interfacial equilibria established, is EquilibriumCellVoltage.</rdfs:comment>
        <rdfs:comment xml:lang="en">voltage of a cell or battery when the discharge current is zero</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">OpenCircuitVoltage</rdfs:label>
        <skos:altLabel xml:lang="en">OCV</skos:altLabel>
        <skos:altLabel xml:lang="en">ZeroCurrentCellPotential</skos:altLabel>
        <skos:prefLabel xml:lang="en">OpenCircuitVoltage</skos:prefLabel>
        <ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>https://www.wikidata.org/wiki/Q1812203</ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
        <ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=482-03-32</ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">voltage of a cell or battery when the discharge current is zero</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d xml:lang="en">https://en.wikipedia.org/wiki/Open-circuit_voltage</ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9c657fdc_b9d3_4964_907c_f9a6e8c5f52b"/>
        <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <owl:annotatedTarget xml:lang="en">voltage of a cell or battery when the discharge current is zero</owl:annotatedTarget>
        <dcterms:source>International Electrotechnical Commission (IEC), IEC 60050 - International Electrotechnical Vocabulary, retrieved from: https://www.electropedia.org</dcterms:source>
    </owl:Axiom>
    


