                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The joule-second is a unit equal to a joule multiplied by a second, used to measure action or angular momentum. The joule-second is the unit used for Planck&apos;s constant.

-- QUDT</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/coherentsiunits#"/>
        <rdfs:isDefinedBy>http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">JouleSecond</rdfs:label>
        <skos:altLabel xml:lang="en">Joule Second</skos:altLabel>
        <skos:prefLabel xml:lang="en">JouleSecond</skos:prefLabel>
        <ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>http://qudt.org/vocab/unit/J-SEC</ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
        <ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>J.s</ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
        <ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>J⋅s</ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The joule-second is a unit equal to a joule multiplied by a second, used to measure action or angular momentum. The joule-second is the unit used for Planck&apos;s constant.

-- QUDT</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


