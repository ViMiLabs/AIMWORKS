    <!-- https://w3id.org/emmo#EMMO_5369d256_5866_4729_adc2_1498ee9a4959 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/emmo#EMMO_5369d256_5866_4729_adc2_1498ee9a4959">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_4832e353_6a2d_4deb_9a5b_96989afaff2d"/>
        <owl:inverseOf rdf:resource="https://w3id.org/emmo#EMMO_9950720f_a0b4_40f5_92db_071a3e4bbf4b"/>
        <rdfs:domain rdf:resource="https://w3id.org/emmo#EMMO_d7788d1a_020d_4c78_85a1_13563fcec168"/>
        <rdfs:range rdf:resource="https://w3id.org/emmo#EMMO_19608340_178c_4bfd_bd4d_0d3b935c6fec"/>
