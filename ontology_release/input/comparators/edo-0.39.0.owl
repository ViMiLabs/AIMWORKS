    <!-- https://w3id.org/emmo/domain/chemical-substance#substance_9f3b59a2_b2af_4b5b_919c_0c68d10f3edf -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/chemical-substance#substance_9f3b59a2_b2af_4b5b_919c_0c68d10f3edf">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/chemical-substance#substance_b325bdd7_0adf_4522_a4ef_20cd6929e094"/>
        <rdfs:comment xml:lang="en">A perfluoroalkyl substance consisting of a fully fluorinated carbon chain terminating in a carboxylic acid functional group.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/chemical-substance#"/>
        <rdfs:label xml:lang="en">PerfluorocarboxylicAcid</rdfs:label>
        <skos:note xml:lang="en">Perfluorocarboxylic acids (PFCAs) are a distinct and widely recognized subclass of PFAS with a shared structural motif and consistent chemical behavior. They are frequently referenced in environmental science, toxicology, and regulatory frameworks as a separate category from other fluorinated substances. Including this term enables precise semantic classification and interoperability across chemical substance ontologies.</skos:note>
        <skos:note xml:lang="en">Perfluorocarboxylic acids include compounds such as trifluoroacetic acid and perfluorooctanoic acid, which are relevant due to their persistence, bioaccumulation potential, and industrial use. The class is commonly treated</skos:note>
        <skos:prefLabel xml:lang="en">PerfluorocarboxylicAcid</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A perfluoroalkyl substance consisting of a fully fluorinated carbon chain terminating in a carboxylic acid functional group.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


