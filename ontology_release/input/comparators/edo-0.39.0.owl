    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_f509645f_eb27_470e_9112_7ab828ed40d3 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_f509645f_eb27_470e_9112_7ab828ed40d3">
