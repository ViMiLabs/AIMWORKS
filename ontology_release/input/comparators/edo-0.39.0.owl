        <rdfs:comment xml:lang="en">conventional designation value for battery energy content, used as a product label</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">NominalEnergy</rdfs:label>
        <rdfs:seeAlso>RatedEnergy</rdfs:seeAlso>
        <skos:note xml:lang="en">Conventional designation value for the energy content of a battery, used to identify and label a product class. The nominal energy is a rounded or representative figure (not a manufacturer&apos;s guarantee) and may differ from energy measured under actual operating conditions.</skos:note>
