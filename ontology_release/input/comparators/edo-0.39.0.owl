    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_7b3eb826_b968_493a_8396_cc3a5f09ecb3 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_7b3eb826_b968_493a_8396_cc3a5f09ecb3">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9bf40017_3f58_4030_ada7_cb37a3dfda2d"/>
        <rdfs:comment xml:lang="en">Internal resistance of an electrochemical cell determined from the voltage response to a direct-current pulse, calculated as ΔV/ΔI at a specified elapsed time after pulse onset.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">DCInternalResistance</rdfs:label>
        <rdfs:seeAlso>ACInternalResistance</rdfs:seeAlso>
        <skos:altLabel xml:lang="en">DCIR</skos:altLabel>
        <skos:note xml:lang="en">Encompasses contributions from ohmic resistance and from electrochemical kinetic processes — charge-transfer resistance and short-timescale diffusion — active within the measurement interval. Typically reported in milliohms (mΩ)</skos:note>
        <skos:prefLabel xml:lang="en">DCInternalResistance</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Used to characterise power capability and resistive losses under pulsed discharge conditions; a standard output of the Hybrid Pulse Power Characterisation (HPPC) protocol.</skos:scopeNote>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Internal resistance of an electrochemical cell determined from the voltage response to a direct-current pulse, calculated as ΔV/ΔI at a specified elapsed time after pulse onset.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_b6730304_cabc_4104_b415_14218466445c xml:lang="en">Values are not directly comparable between measurements made with different pulse durations or current magnitudes. Measurement conditions must be reported alongside the value.</ns1:EMMO_b6730304_cabc_4104_b415_14218466445c>
    </owl:Class>
    


