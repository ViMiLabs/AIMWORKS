    <!-- https://w3id.org/emmo#EMMO_dba27ca1_33c9_4443_a912_1519ce4c39ec -->

    <owl:ObjectProperty rdf:about="https://w3id.org/emmo#EMMO_dba27ca1_33c9_4443_a912_1519ce4c39ec">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_9a50a0ae_841a_46fe_8b23_3df319b60611"/>
        <rdfs:domain rdf:resource="https://w3id.org/emmo#EMMO_90ae56e4_d197_49b6_be1a_0049e4756606"/>
        <rdfs:range rdf:resource="https://w3id.org/emmo#EMMO_ceaaf9f7_fd11_424b_8fda_9afa186af186"/>
        <rdfs:comment xml:lang="en">The relation between an object and one of its holistic part that contributes to the object under some spatial-based criteria.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
