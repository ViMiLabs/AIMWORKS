    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_b9a72491_8a50_4cac_a131_1e95d72b57ee -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_b9a72491_8a50_4cac_a131_1e95d72b57ee">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_ddade648_2033_47b6_bc36_b562a9af591e"/>
        <rdfs:comment xml:lang="en">plot of current versus applied potential (I-E) for a given system</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/modules/electrochemistry-testing#"/>
        <rdfs:label xml:lang="en">CurrentPotentialPlot</rdfs:label>
        <skos:altLabel xml:lang="en">CurrentPotentialCurve</skos:altLabel>
        <skos:altLabel xml:lang="en">ElectricCurrentPotentialCurve</skos:altLabel>
        <skos:prefLabel xml:lang="en">CurrentPotentialPlot</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">plot of current versus applied potential (I-E) for a given system</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The curve is sigmoidal in hydrodynamic voltammetry, voltammetry at microelectrodes and polarography, or peak-shaped in ac voltammetry, differential pulse voltammetry, square- wave voltammetry, stripping voltammetry, and derivative techniques.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_b9a72491_8a50_4cac_a131_1e95d72b57ee"/>
        <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <owl:annotatedTarget xml:lang="en">plot of current versus applied potential (I-E) for a given system</owl:annotatedTarget>
        <dcterms:source>Pingarron José M., et al. &quot;Terminology of electrochemical methods of analysis (IUPAC Recommendations 2019).&quot; Pure and Applied Chemistry
 92.4 (2020): 641-694. DOI: https://doi.org/10.1515/pac-2018-0109</dcterms:source>
    </owl:Axiom>
    


    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_b9bece97_a511_4cb9_88a2_b5bd5c5e5d74 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_b9bece97_a511_4cb9_88a2_b5bd5c5e5d74">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_6f2c88c9_5c04_4953_a298_032cc3ab9b77"/>
        <rdfs:comment xml:lang="en">electrochemical cell with a working electrode, reference electrode, and auxiliary electrode</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/reference/electrochemistry-reference#"/>
        <rdfs:label xml:lang="en">ThreeElectrodeElectrochemicalCell</rdfs:label>
        <skos:prefLabel xml:lang="en">ThreeElectrodeElectrochemicalCell</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The working electrode is the site of interest where the electrochemical process occurs, the reference electrode provides a stable potential, and the auxiliary (counter) electrode completes the circuit.</skos:scopeNote>
        <ns1:EMMO_5f7abc2a_5b50_41c3_8def_c8ba7c3b083e xml:lang="en">A potentiostat can be used to maintain a potential difference between the working and reference electrodes.</ns1:EMMO_5f7abc2a_5b50_41c3_8def_c8ba7c3b083e>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">electrochemical cell with a working electrode, reference electrode, and auxiliary electrode</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Electric current flows between the working and auxiliary electrodes. Electrode potential may be measured between the working and reference electrodes.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_b9bece97_a511_4cb9_88a2_b5bd5c5e5d74"/>
        <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <owl:annotatedTarget xml:lang="en">electrochemical cell with a working electrode, reference electrode, and auxiliary electrode</owl:annotatedTarget>
        <dcterms:source>J. M. Pingarron et al., Terminology of electrochemical methods of analysis (IUPAC Recommendations 2019), Pure and Applied Chemistry, 4, 92, 2020, 641-694. https://doi.org/10.1515/pac-2018-0109</dcterms:source>
    </owl:Axiom>
    


    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_b9ec3155_16cb_49b4_b23f_3d7a5681328d -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_b9ec3155_16cb_49b4_b23f_3d7a5681328d">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_faab3f84_e475_4a46_af9c_7d249f0b9aef"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_aecc6094_c6a5_4a36_a825_8a497a2ae112"/>
        <rdfs:comment xml:lang="en">In lithium-ion degradation-mode analysis this is the loss of lithium inventory (LLI). It is a ratio of capacities, not a mass, volume or amount fraction; a cell can lose cyclable inventory while its electrodes keep their full capacity.</rdfs:comment>
        <rdfs:comment xml:lang="en">fraction of the charge-carrier inventory of a cell lost to degradation, the inventory being expressed as the capacity it could deliver: the difference between a reference and the present inventory capacity, divided by the reference</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">ChargeCarrierInventoryLossFraction</rdfs:label>
        <skos:prefLabel xml:lang="en">ChargeCarrierInventoryLossFraction</skos:prefLabel>
        <skos:related rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_0a0de817_addc_46a5_8ba2_255d48cdf366"/>
        <skos:related rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_652b94f1_290d_4d9e_820a_eda4c71eb90d"/>
        <skos:related rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_b1b406fe_2579_4f13_b1ac_84fc3fd0e15f"/>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">fraction of the charge-carrier inventory of a cell lost to degradation, the inventory being expressed as the capacity it could deliver: the difference between a reference and the present inventory capacity, divided by the reference</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


