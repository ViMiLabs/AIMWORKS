    <!-- https://w3id.org/emmo#EMMO_43e499a1_ca67_4380_ac08_cfc52a93ad04 -->

    <owl:Class rdf:about="https://w3id.org/emmo#EMMO_43e499a1_ca67_4380_ac08_cfc52a93ad04">
