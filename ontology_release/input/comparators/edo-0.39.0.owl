    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_1f5ed349_d69b_4c38_bae3_1a7663bfc0ef">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_f76884f7_964e_488e_9bb7_1b2453e9e817"/>
        <rdfs:comment xml:lang="en">safety component that permanently interrupts the electric current path between an electrode and its terminal when the internal pressure of the cell exceeds a predetermined limit</rdfs:comment>
