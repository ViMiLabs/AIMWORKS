    <!-- https://w3id.org/emmo#EMMO_8c537c06_8e1d_4a3b_a251_1c89bb2c4790 -->

    <owl:Class rdf:about="https://w3id.org/emmo#EMMO_8c537c06_8e1d_4a3b_a251_1c89bb2c4790">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_d7788d1a_020d_4c78_85a1_13563fcec168"/>
        <rdfs:comment xml:lang="en">An icon that mimics the spatial or temporal shape of the object.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/semiotics#"/>
        <rdfs:label xml:lang="en">ResemblanceIcon</rdfs:label>
        <skos:example xml:lang="en">A geographical map that imitates the shape of the landscape and its properties at a specific historical time.</skos:example>
        <skos:prefLabel xml:lang="en">ResemblanceIcon</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An icon that mimics the spatial or temporal shape of the object.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">An icon that focus on WHERE/WHEN the object is, in the sense of spatial or temporal shape.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The subclass of icon inspired by Peirceian category a) the image, which depends on a simple quality (e.g. picture).</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_8c537c06_8e1d_4a3b_a251_1c89bb2c4790"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <owl:annotatedTarget xml:lang="en">ResemblanceIcon</owl:annotatedTarget>
        <ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From Old French sambler, sembler, from Late Latin similāre, present active infinitive of similō, from Latin similis, from Proto-Italic *semalis, from Proto-Indo-European *sem- (“together, one”).</ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
    </owl:Axiom>
    


