    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_37a06684_e6b6_4e1e_82ca_105868e3b6c9 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_37a06684_e6b6_4e1e_82ca_105868e3b6c9">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_0acd0fc2_1048_4604_8e90_bf4e84bd87df"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_c76dbfeb_f3d9_44d4_9cbe_0946924f311f"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_fb988878_ee54_4350_9ee9_228c00c3ad35"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_e08d43cf_93e4_49c6_bcb6_472be52ae7fc"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_7729c34e_1ae9_403d_b933_1765885e7f29"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">an electrochemical device in which the counter electrode also serves as the reference electrode, so that the measured cell voltage approximates the potential of the working electrode relative to that reference; the counter electrode is typically an excess of a reversible electrode material, such as lithium metal in a lithium-ion battery half-cell</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/reference/electrochemistry-reference#"/>
        <rdfs:label xml:lang="en">HalfCellDevice</rdfs:label>
        <skos:prefLabel xml:lang="en">HalfCellDevice</skos:prefLabel>
        <ns1:EMMO_0fa6566e_500f_4d24_baa9_b2b22c9a0b72 xml:lang="en">Do not conflate a HalfCellDevice (an experimental two-electrode setup for characterising an electrode) with an ElectrochemicalHalfCell (the combination of one electrode and one electrolyte).</ns1:EMMO_0fa6566e_500f_4d24_baa9_b2b22c9a0b72>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">an electrochemical device in which the counter electrode also serves as the reference electrode, so that the measured cell voltage approximates the potential of the working electrode relative to that reference; the counter electrode is typically an excess of a reversible electrode material, such as lithium metal in a lithium-ion battery half-cell</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


