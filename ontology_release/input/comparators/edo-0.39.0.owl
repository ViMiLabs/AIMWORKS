    <!-- https://w3id.org/emmo#EMMO_49267eba_5548_4163_8f36_518d65b583f9 -->

    <owl:Class rdf:about="https://w3id.org/emmo#EMMO_49267eba_5548_4163_8f36_518d65b583f9">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_c5ddfdba_c074_4aa4_ad6b_1ac4942d300d"/>
        <rdfs:comment xml:lang="en">The class of causal objects that stand for world objects according to a specific representational perspective.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/reductionistic#"/>
        <rdfs:label xml:lang="en">Perspective</rdfs:label>
        <skos:prefLabel xml:lang="en">Perspective</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The class of causal objects that stand for world objects according to a specific representational perspective.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">This class is the practical implementation of the EMMO pluralistic approach for which the only objective categorization is provided by the Universe individual and all the Quantum individuals.
Between these two extremes, there are several subjective ways to categorize real world objects, each one provide under a &apos;Perspective&apos; subclass.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_49267eba_5548_4163_8f36_518d65b583f9"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <owl:annotatedTarget xml:lang="en">Perspective</owl:annotatedTarget>
        <ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From medieval Latin perspectiva ‘(science of) optics’, from perspect- ‘looked at closely’, from the verb perspicere, from per- ‘through’ + specere ‘to look’.</ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
    </owl:Axiom>
    


    <!-- https://w3id.org/emmo#EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8 -->

    <owl:Class rdf:about="https://w3id.org/emmo#EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_86ca9b93_1183_4b65_81b8_c0fcd3bba5ad"/>
        <rdfs:comment xml:lang="en">An object which is instrumental for reaching a particular purpose through its characteristic functioning process, with particular reference to mechanical or electronic equipment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/modules/electrochemistry-testing#"/>
        <rdfs:label xml:lang="en">Device</rdfs:label>
        <skos:altLabel xml:lang="en">Equipment</skos:altLabel>
        <skos:altLabel xml:lang="en">Machine</skos:altLabel>
        <skos:prefLabel xml:lang="en">Device</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An object which is instrumental for reaching a particular purpose through its characteristic functioning process, with particular reference to mechanical or electronic equipment.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
        <owl:annotatedTarget xml:lang="en">Equipment</owl:annotatedTarget>
        <ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From French équipement, from équiper ‘equip’.</ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
        <owl:annotatedTarget xml:lang="en">Machine</owl:annotatedTarget>
        <ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From Latin māchina (“a machine, engine, contrivance, device, stratagem, trick”), from Doric Greek μᾱχᾰνᾱ́ (mākhanā́), cognate with Attic Greek μηχᾰνή (mēkhanḗ, “a machine, engine, contrivance, device”), from which comes mechanical.</ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <owl:annotatedTarget xml:lang="en">Device</owl:annotatedTarget>
        <ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From Old French &quot;deviser&quot;, meaning: arrange, plan, contrive. Literally &quot;dispose in portions,&quot; from Vulgar Latin &quot;divisare&quot;, frequentative of Latin dividere, meaning &quot;to divide&quot;.</ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
    </owl:Axiom>
    


    <!-- https://w3id.org/emmo#EMMO_49804605_c0fe_4538_abda_f70ba1dc8a5d -->

    <owl:Class rdf:about="https://w3id.org/emmo#EMMO_49804605_c0fe_4538_abda_f70ba1dc8a5d">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_846b637b_7b12_47a1_9430_0274b2f588ac"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/emmo#EMMO_d43af210_f854_4432_a891_ce3022e3b558"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#EMMO_43e9a05d_98af_41b4_92f6_00f79a09bfce"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A process which is a spatial part of another process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
        <rdfs:label xml:lang="en">SubProcess</rdfs:label>
        <skos:example xml:lang="en">Breathing is a subprocess of living for a human being.</skos:example>
        <skos:prefLabel xml:lang="en">SubProcess</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A process which is a spatial part of another process.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">In the EMMO the relation of participation to a process falls under mereotopology.

Since topological connection means causality, then the only way for a real world object to participate to a process is to be a part of it.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:Class>
    


