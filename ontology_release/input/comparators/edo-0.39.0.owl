    <!-- https://w3id.org/emmo#HertzPerTesla -->

    <owl:Class rdf:about="https://w3id.org/emmo#HertzPerTesla">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_4dbe2b16_3e84_4049_898d_eb89bcc925a2"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_8189b42e_0995_423a_a26c_51168b27c3cf"/>
