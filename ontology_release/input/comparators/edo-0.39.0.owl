        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_f76884f7_964e_488e_9bb7_1b2453e9e817"/>
        <rdfs:comment xml:lang="en">an internal compartment of the electrochemical flow cell through which catholyte flows</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/reference/electrochemistry-reference#"/>
        <rdfs:label xml:lang="en">CatholyteCompartment</rdfs:label>
        <skos:note xml:lang="en">CatholyteTank holds the anolyte typically outside of the eletrochemical cell, where the term CatholyteCompartment describes a space inside the electrochemical flow cell.</skos:note>
        <skos:prefLabel xml:lang="en">CatholyteCompartment</skos:prefLabel>
        <skos:related rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_14df0300_de16_4298_94ae_48652e250b78"/>
