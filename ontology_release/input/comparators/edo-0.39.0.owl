        <rdfs:label xml:lang="en">SideReaction</rdfs:label>
        <skos:altLabel xml:lang="en">SecondaryReaction</skos:altLabel>
        <skos:prefLabel xml:lang="en">SideReaction</skos:prefLabel>
        <ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>https://www.wikidata.org/wiki/Q22117434</ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
        <ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=114-02-06</ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
        <ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=482-03-13</ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">chemical reaction which occurs in addition to the main process</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_b6730304_cabc_4104_b415_14218466445c xml:lang="en">Side reactions can lead to degradation, gas formation, or loss of active material.</ns1:EMMO_b6730304_cabc_4104_b415_14218466445c>
        <ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d xml:lang="en">https://en.wikipedia.org/wiki/Side_reaction</ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_f47611a2_e081_47f0_b287_3fda5f706154"/>
