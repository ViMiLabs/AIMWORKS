        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">for solutions, product for all substances B of concentration c_B of substance B in power of its stoichiometric number v_B: K_p = \sum_B{c_B^{v_B}}.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
