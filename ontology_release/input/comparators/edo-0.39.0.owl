    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_8abde9d0_84f6_4b4f_a87e_86028a397100 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_8abde9d0_84f6_4b4f_a87e_86028a397100">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9b3b4668_0795_4a35_9965_2af383497a26"/>
        <rdfs:comment xml:lang="en">the rated capacity that is representative of the typical value associated with a cell as stated by the manufacturer</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">NominalCapacity</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_a7a4614f_2426_46f3_8475_cda4a9fabfce"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_b7781ebc_90a7_4f19_997f_aed28dee1b01"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_d3c0078e_c1d3_461e_873d_e5c3adf441c5"/>
        <skos:prefLabel xml:lang="en">NominalCapacity</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The value for &apos;nominal capacity&apos; is provided by manufacturers as an indication of the expected performance of the device under a set of defined nominal conditions. It serves as a benchmark for comparing different devices.</skos:scopeNote>
        <ns1:EMMO_5f7abc2a_5b50_41c3_8def_c8ba7c3b083e xml:lang="en">To ensure meaningful comparisons, nominal capacity values should always be evaluated under matching test conditions.</ns1:EMMO_5f7abc2a_5b50_41c3_8def_c8ba7c3b083e>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">the rated capacity that is representative of the typical value associated with a cell as stated by the manufacturer</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_b6730304_cabc_4104_b415_14218466445c xml:lang="en">While nominal capacity provides a useful reference, actual capacity depends on various factors, including temperature, rate, and state-of-health.</ns1:EMMO_b6730304_cabc_4104_b415_14218466445c>
        <ns1:EMMO_cc65321f_1964_4f16_aea3_2a8edf2f3394 rdf:resource="https://w3id.org/emmo#AmpereHour"/>
        <ns1:EMMO_cc65321f_1964_4f16_aea3_2a8edf2f3394 rdf:resource="https://w3id.org/emmo#MilliAmpereHour"/>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_8ae1ee53_5866_4d94_8715_35e90626fa55 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_8ae1ee53_5866_4d94_8715_35e90626fa55">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_0f007072_a8dd_4798_b865_1bf9363be627"/>
        <rdfs:comment xml:lang="en">an electrode designed to operate fully immersed in a liquid electrolyte</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/reference/electrochemistry-reference#"/>
        <rdfs:label xml:lang="en">ImmersionElectrode</rdfs:label>
        <skos:note xml:lang="en">An ImmersionElectrode is a common electrochemical configuration where the electrode operates fully submerged in a liquid electrolyte, distinct from the existing terms GasDiffusionElectrode and AirElectrode. Addition of this term improves clarity when modelling electrode–electrolyte interfaces and complements existing electrode classifications.</skos:note>
        <skos:prefLabel xml:lang="en">ImmersionElectrode</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This concept contrasts with gas-diffusion and partially wetted electrodes by explicitly requiring full immersion in a liquid phase, which impacts transport phenomena, reaction kinetics, and modelling assumptions.e</skos:scopeNote>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">an electrode designed to operate fully immersed in a liquid electrolyte</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


