    <!-- https://w3id.org/emmo#AmperePerMetre -->

    <owl:Class rdf:about="https://w3id.org/emmo#AmperePerMetre">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_e6b83139_ba92_4fbd_a8b2_c8dde55844a1"/>
        <rdfs:subClassOf>
