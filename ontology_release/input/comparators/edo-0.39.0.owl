    <owl:Class rdf:about="https://w3id.org/emmo#MicroMolePerSquareMetrePerSecond">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_9ff3bf8e_2168_406e_8251_1d158fc948ae"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_a94aec97_71ff_4574_b111_a52d77d2c230"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_c6d4a5e0_7e95_44df_a6db_84ee0a8bbc8e"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_d4e0a0ab_2f67_4f87_a0db_b544e6dceed4"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#MolePerSquareMetrePerSecond"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_8189b42e_0995_423a_a26c_51168b27c3cf"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0E-6</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">One part per 10**6 (million) of the SI unit of quantity of matter (the mole) per SI unit area per SI unit of time.  This term is based on the number of photons in a certain waveband incident per unit time (s) on a unit area (m2) divided by the Avogadro constant (6.022 x 1023 mol-1). It is used commonly to describe PAR in the 400-700 nm waveband. Definition Source: Thimijan, Richard W., and Royal D. Heins. 1982. Photometric, Radiometric, and Quantum Light Units of Measure: A Review of Procedures for Interconversion. HortScience 18:818-822.

-- QUDT</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/noncoherentsiunits#"/>
        <rdfs:label>MicroMolePerSquareMetrePerSecond</rdfs:label>
        <skos:altLabel xml:lang="en">Micromoles per square metre per second</skos:altLabel>
        <skos:prefLabel>MicroMolePerSquareMetrePerSecond</skos:prefLabel>
        <ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>http://qudt.org/vocab/unit/MicroMOL-PER-M2-SEC</ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
        <ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>umol.m-2.s-1</ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
        <ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>umol/m2/s</ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
        <ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>µmol/(m²⋅s)</ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">One part per 10**6 (million) of the SI unit of quantity of matter (the mole) per SI unit area per SI unit of time.  This term is based on the number of photons in a certain waveband incident per unit time (s) on a unit area (m2) divided by the Avogadro constant (6.022 x 1023 mol-1). It is used commonly to describe PAR in the 400-700 nm waveband. Definition Source: Thimijan, Richard W., and Royal D. Heins. 1982. Photometric, Radiometric, and Quantum Light Units of Measure: A Review of Procedures for Interconversion. HortScience 18:818-822.

-- QUDT</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
