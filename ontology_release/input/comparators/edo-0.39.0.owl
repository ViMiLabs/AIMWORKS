    <!-- https://w3id.org/emmo#EMMO_51e72e5c_ab21_4d0e_ad9f_b168eca89cf4 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/emmo#EMMO_51e72e5c_ab21_4d0e_ad9f_b168eca89cf4">
