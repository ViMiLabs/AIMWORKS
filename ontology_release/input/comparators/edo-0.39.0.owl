    </owl:Axiom>
    


    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_f42746ba_724c_4ab9_aa04_61b062f23076 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_f42746ba_724c_4ab9_aa04_61b062f23076">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_f76884f7_964e_488e_9bb7_1b2453e9e817"/>
        <rdfs:comment xml:lang="en">A deformable sealing component placed between cell assembly layers to prevent fluid leakage and define the active electrode area through controlled compression.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/reference/electrochemistry-reference#"/>
        <rdfs:label xml:lang="en">Gasket</rdfs:label>
        <skos:note xml:lang="en">Electrochemical (flow) cells require gaskets to seal the electrolyte compartments and define the active electrode area through compression. Gaskets are a distinct, functionally critical cell component that determines compression ratio, contact resistance, and electrolyte leakage.</skos:note>
        <skos:prefLabel xml:lang="en">Gasket</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Gaskets in electrochemical (flow) cells are typically made from polymer materials (e.g. PTFE, Viton, silicone) and their thickness directly determines electrode compression, which affects mass transport and contact resistance. They are a required component in any flow cell metadata description alongside electrodes, membrane, and flow field. The term is distinct from Separator and Membrane which describe ionically active components, whereas a gasket is purely a mechanical sealing element.</skos:scopeNote>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A deformable sealing component placed between cell assembly layers to prevent fluid leakage and define the active electrode area through controlled compression.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>https://en.wikipedia.org/wiki/Gasket</ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_f47611a2_e081_47f0_b287_3fda5f706154 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_f47611a2_e081_47f0_b287_3fda5f706154">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_8a1c9a7b_978c_4421_a9c1_d0b07b42aab9"/>
