        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Data processing activities performed on the secondary data to determine the characterisation property (e.g. classification, quantification), which can be performed manually or exploiting a model.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/characterisation-methodology/chameo#DataFiltering -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/characterisation-methodology/chameo#DataFiltering">
