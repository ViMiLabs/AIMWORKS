    <!-- https://w3id.org/emmo/domain/chemical-substance#substance_2e88fcc8_43b3_48f6_9e5b_165746374117 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/chemical-substance#substance_2e88fcc8_43b3_48f6_9e5b_165746374117">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/chemical-substance#substance_dc68514f_b592_4e1b_a00f_fbb29f2fafbd"/>
        <rdfs:comment xml:lang="en">A cationic polymer consisting of an aryl backbone functionalized with piperidinium groups, used primarily in ion-conducting membrane materials.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/chemical-substance#"/>
        <rdfs:label xml:lang="en">PolyArylPiperidinium</rdfs:label>
        <skos:note xml:lang="en">Poly(aryl piperidinium)s are a class of cationic polymers featuring piperidinium-functionalized aryl backbones, commonly used in anion exchange membranes and electrochemical energy systems. They are structurally and functionally distinct from other ionic polymers such as imidazolium- or ammonium-based systems. Including this term enables precise semantic classification of emerging membrane materials in electrochemical and polymer ontologies.</skos:note>
        <skos:note xml:lang="en">Poly(aryl piperidinium)s are an emerging class of anion exchange membrane materials used in alkaline fuel cells and related electrochemical devices. Their distinct backbone–cation architecture differentiates them from imidazolium- and ammonium-based polymer electrolytes, motivating explicit ontology representation for materials informatics and energy systems modeling.</skos:note>
        <skos:prefLabel xml:lang="en">PolyArylPiperidinium</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A cationic polymer consisting of an aryl backbone functionalized with piperidinium groups, used primarily in ion-conducting membrane materials.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


