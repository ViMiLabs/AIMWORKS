        <ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-05-23</ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
        <ns1:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>10-4.3</ns1:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
