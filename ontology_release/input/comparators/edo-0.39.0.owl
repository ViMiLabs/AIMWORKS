        <ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f xml:lang="en">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-04-47</ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
        <ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25>https://dbpedia.org/page/Heat_capacity</ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25>
        <ns1:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>5-15</ns1:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
