    <!-- https://w3id.org/emmo#FaradPerMetre -->

    <owl:Class rdf:about="https://w3id.org/emmo#FaradPerMetre">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_5f89cb0c_3171_47ee_b2ab_027a07c34c4b"/>
        <rdfs:subClassOf>
