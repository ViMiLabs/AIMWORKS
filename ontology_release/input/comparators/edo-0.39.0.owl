        <rdfs:range rdf:resource="https://w3id.org/emmo#EMMO_c5ddfdba_c074_4aa4_ad6b_1ac4942d300d"/>
        <rdfs:comment xml:lang="en">The relation between two causally reachable entities through a path of contacts relations (i.e. representing physical interactions).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/mereocausality#"/>
        <rdfs:label xml:lang="en">alongsideWith</rdfs:label>
        <skos:altLabel xml:lang="en">coexistsWith</skos:altLabel>
        <skos:altLabel xml:lang="en">concurrentWith</skos:altLabel>
        <skos:altLabel xml:lang="en">interactsWith</skos:altLabel>
        <skos:example xml:lang="en">I&apos;m interacting with another tennis player through a ball. Or, two people in a webconference are interacting using a mediator which is the network signal.</skos:example>
        <skos:prefLabel xml:lang="en">alongsideWith</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The relation between two causally reachable entities through a path of contacts relations (i.e. representing physical interactions).</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:ObjectProperty>
    


