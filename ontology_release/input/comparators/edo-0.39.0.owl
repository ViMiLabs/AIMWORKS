    <!-- https://w3id.org/emmo/domain/chemical-substance#substance_f375bff6_79d0_472a_9469_393bf1dbfae2 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/chemical-substance#substance_f375bff6_79d0_472a_9469_393bf1dbfae2">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/chemical-substance#substance_dc68514f_b592_4e1b_a00f_fbb29f2fafbd"/>
        <rdfs:comment xml:lang="en">A sulfonated derivative of polyetheretherketone (PEEK) containing sulfonic acid (–SO₃H) functional groups that enable proton conduction.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/chemical-substance#"/>
        <rdfs:label xml:lang="en">SulfonatedPolyEtherEtherKetone</rdfs:label>
        <skos:altLabel xml:lang="en">SPEEK</skos:altLabel>
        <skos:note xml:lang="en">Sulfonated polyetheretherketone (SPEEK) is a chemically modified derivative of PEEK in which sulfonic acid groups are introduced to the aromatic backbone, enabling proton-conducting behavior. It must be explicitly distinguished from base PEEK due to its fundamentally altered ion transport, hydrophilicity, and membrane performance characteristics. Including this term enables precise representation of proton exchange membrane materials in electrochemical and polymer ontologies.</skos:note>
        <skos:prefLabel xml:lang="en">SulfonatedPolyEtherEtherKetone</skos:prefLabel>
        <ns1:EMMO_4c8480cf_56de_41da_8699_f12a9033313a xml:lang="en">SPEEK should be modeled as a functionalized derivative of PEEK rather than a separate base polymer class. This distinction is important for accurately representing proton exchange membrane behavior in fuel cells and related electrochemical systems.</ns1:EMMO_4c8480cf_56de_41da_8699_f12a9033313a>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A sulfonated derivative of polyetheretherketone (PEEK) containing sulfonic acid (–SO₃H) functional groups that enable proton conduction.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


