        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_8189b42e_0995_423a_a26c_51168b27c3cf"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1000.0</owl:hasValue>
            </owl:Restriction>
