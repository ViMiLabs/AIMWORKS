            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">a type of electrode specifically designed for gaseous reactants or products or both</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/reference/electrochemistry-reference#"/>
        <rdfs:label xml:lang="en">GasDiffusionElectrode</rdfs:label>
        <skos:altLabel xml:lang="en">GDE</skos:altLabel>
        <skos:prefLabel xml:lang="en">GasDiffusionElectrode</skos:prefLabel>
        <ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>https://www.wikidata.org/wiki/Q909759</ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
        <ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=485-02-02</ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">a type of electrode specifically designed for gaseous reactants or products or both</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A gas diffusion electrode usually comprises one or more porous layers, like the gas diffusion layer and the catalyst layer.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Gas diffusion electrodes can be gas diffusion anodes or gas diffusion cathodes.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Gas diffusion electrodes can be used in batteries, fuel cells, and electrolyzers.</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
        <ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d xml:lang="en">https://en.wikipedia.org/wiki/Gas_diffusion_electrode</ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    </owl:Class>
