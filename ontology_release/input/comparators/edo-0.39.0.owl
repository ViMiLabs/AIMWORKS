    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_469b9516_a96d_4aa2_b8e5_05ae982e2084 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_469b9516_a96d_4aa2_b8e5_05ae982e2084">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_a5962e05_466d_46a4_8951_bea59d7326e5"/>
        <rdfs:comment xml:lang="en">The ratio of electrical charge delivered in the first discharge to the charge consumed in the first charge of an electrochemical cell, expressed as a percentage.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">InitialCoulombicEfficiency</rdfs:label>
        <skos:altLabel xml:lang="en">FirstCycleCoulombicEfficiency</skos:altLabel>
        <skos:altLabel xml:lang="en">ICE</skos:altLabel>
        <skos:prefLabel xml:lang="en">InitialCoulombicEfficiency</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Often used in lithium-ion cell characterisation; especially significant for graphite, silicon, and other anode materials that form an SEI layer on the first cycle.</skos:scopeNote>
        <ns1:EMMO_4c8480cf_56de_41da_8699_f12a9033313a xml:lang="en">Captures irreversible first-cycle losses that permanently reduce deliverable capacity and cannot be recovered by subsequent cycling. Must not be conflated with CoulombicEfficiency measured in later cycles.</ns1:EMMO_4c8480cf_56de_41da_8699_f12a9033313a>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The ratio of electrical charge delivered in the first discharge to the charge consumed in the first charge of an electrochemical cell, expressed as a percentage.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


