        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_d4e0a0ab_2f67_4f87_a0db_b544e6dceed4"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#Gray"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_8189b42e_0995_423a_a26c_51168b27c3cf"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0E-6</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">0.000001 fold of the SI unit of radiation dose. Radiation carries energy, and when it is absorbed by matter the matter receives this energy. The dose is the amount of energy deposited per unit of mass. One gray is defined to be the dose of one joule of energy absorbed per kilogram of matter, or 100 rad. The unit is named for the British physician L. Harold Gray (1905-1965), an authority on the use of radiation in the treatment of cancer.

-- QUDT</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/prefixedsiunits#"/>
        <rdfs:label>MicroGray</rdfs:label>
        <skos:altLabel xml:lang="en">MicroGray</skos:altLabel>
        <skos:prefLabel>MicroGray</skos:prefLabel>
        <ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>http://qudt.org/vocab/unit/MicroGRAY</ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
        <ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>uGy</ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
        <ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>µGy</ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">0.000001 fold of the SI unit of radiation dose. Radiation carries energy, and when it is absorbed by matter the matter receives this energy. The dose is the amount of energy deposited per unit of mass. One gray is defined to be the dose of one joule of energy absorbed per kilogram of matter, or 100 rad. The unit is named for the British physician L. Harold Gray (1905-1965), an authority on the use of radiation in the treatment of cancer.

-- QUDT</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>http://en.wikipedia.org/wiki/Grey?oldid=494774160</ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    </owl:Class>
    


