        <skos:prefLabel xml:lang="en">InstantaneousCurrent</skos:prefLabel>
        <ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>https://www.wikidata.org/wiki/Q108057717</ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">value of an electric current at an instant in time</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 xml:lang="en">https://goldbook.iupac.org/terms/view/I03062</ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>
