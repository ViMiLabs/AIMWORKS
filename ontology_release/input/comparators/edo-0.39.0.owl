        <skos:prefLabel xml:lang="en">CandelaPerLumen</skos:prefLabel>
        <ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>http://qudt.org/vocab/unit/CD-PER-LM</ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
        <ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>cd/lm</ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Candela per Lumen.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
