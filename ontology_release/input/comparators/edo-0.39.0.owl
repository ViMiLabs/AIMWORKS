        <ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">With the causal cluster term we address an heterogeneous group of entities, which possess the common feature of having at least two causally non connected quanta. It comprises collections (non self-connected entities) and causal systems (entities extended in space).</ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
        <ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 xml:lang="en">The disjoint union of the CausalSystem and Collection classes.</ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84>
        <ns1:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>EquivalentTo: Collection or CausalSystem</ns1:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The class of individuals representing causal clusters.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_76bd5e44_bf5a_49f9_a517_eea5e8bcbc2d"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <owl:annotatedTarget xml:lang="en">CausalCluster</owl:annotatedTarget>
        <ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From Proto-Germanic *klas-, *klus- (“to clump, lump together”).</ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
    </owl:Axiom>
    


