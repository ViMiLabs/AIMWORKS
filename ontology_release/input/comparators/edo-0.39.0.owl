    <!-- https://w3id.org/emmo#EMMO_8679c7d3_fd5d_49ba_bc1f_1bb820a1f73f -->

    <owl:Class rdf:about="https://w3id.org/emmo#EMMO_8679c7d3_fd5d_49ba_bc1f_1bb820a1f73f">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_90589553_5625_4074_8f0d_0532fd7eb42b"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/manufacturing#"/>
        <rdfs:label xml:lang="en">DefinedEdgeCutting</rdfs:label>
