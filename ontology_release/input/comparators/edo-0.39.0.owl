    <!-- https://w3id.org/emmo#EMMO_506f7823_52bc_40cb_be07_b3b1e10cce13 -->

    <owl:Class rdf:about="https://w3id.org/emmo#EMMO_506f7823_52bc_40cb_be07_b3b1e10cce13">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_f2ca6dd0_0e5f_4392_a92d_cafdae6cfc95"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_bed1d005_b04e_4a90_94cf_02bc678a8569"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#EMMO_044f83a6_ade4_4441_9c73_5490dd93344f"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Defines the Candela base unit in the SI system.</rdfs:comment>
        <rdfs:comment xml:lang="en">The luminous efficacy of monochromatic radiation of frequency 540 × 10 12 Hz, K cd , is a technical constant that gives an exact numerical relationship between the purely physical characteristics of the radiant power stimulating the human eye (W) and its photobiological response defined by the luminous flux due to the spectral responsivity of a standard observer (lm) at a frequency of 540 × 10 12 hertz.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
        <rdfs:label xml:lang="en">LuminousEfficacyOf540THzRadiation</rdfs:label>
        <skos:prefLabel xml:lang="en">LuminousEfficacyOf540THzRadiation</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The luminous efficacy of monochromatic radiation of frequency 540 × 10 12 Hz, K cd , is a technical constant that gives an exact numerical relationship between the purely physical characteristics of the radiant power stimulating the human eye (W) and its photobiological response defined by the luminous flux due to the spectral responsivity of a standard observer (lm) at a frequency of 540 × 10 12 hertz.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


