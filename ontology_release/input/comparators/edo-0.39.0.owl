    <!-- https://w3id.org/emmo/domain/characterisation-methodology/chameo#CharacterisationTechnique -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/characterisation-methodology/chameo#CharacterisationTechnique">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_c7013b53_3071_410b_a5e4_a8d266dcdfb5"/>
        <rdfs:comment xml:lang="en">The description of the overall characterisation technique. It can be composed of different steps (e.g. sample preparation, calibration, measurement, post-processing).</rdfs:comment>
        <rdfs:comment xml:lang="en">The description of the overall characterisation technique. It can be composed of different steps (e.g. sample preparation, calibration, measurement, post-processing). A characterisation technique is not only related to the measurement process which can be one of its steps.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/modules/electrochemistry-testing#"/>
        <rdfs:label xml:lang="en">CharacterisationTechnique</rdfs:label>
