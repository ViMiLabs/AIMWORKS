    <!-- https://w3id.org/emmo#CubicMetrePerMole -->

    <owl:Class rdf:about="https://w3id.org/emmo#CubicMetrePerMole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_aa7397ff_2815_434e_9b99_e4c6a80e034e"/>
