        <owl:inverseOf rdf:resource="https://w3id.org/emmo#EMMO_928f6ec2_7564_4c8d_9a10_7a601fa89602"/>
        <rdfs:comment xml:lang="en">Direct parthood is the non transitive version of parthood enabling the establishment of hierarchy of granularities, starting with an entity and providing several granularity levels of parthood.</rdfs:comment>
        <rdfs:comment xml:lang="en">The non-transitive version of proper parthood property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/mereocausality#"/>
        <rdfs:label xml:lang="en">hasDirectPart</rdfs:label>
        <skos:altLabel xml:lang="en">hasImmediatePart</skos:altLabel>
        <skos:prefLabel xml:lang="en">hasDirectPart</skos:prefLabel>
        <ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">Direct parthood is the non transitive version of parthood enabling the establishment of hierarchy of granularities, starting with an entity and providing several granularity levels of parthood.</ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The non-transitive version of proper parthood property.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:ObjectProperty>
    


