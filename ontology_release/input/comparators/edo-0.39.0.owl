    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_4ebe2ef1_eea8_4b10_822d_7a68215bd24d -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_4ebe2ef1_eea8_4b10_822d_7a68215bd24d">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_17b031fb_4695_49b6_bb69_189ec63df3ee"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_aecc6094_c6a5_4a36_a825_8a497a2ae112"/>
        <rdfs:comment xml:lang="en">difference of electric potentials measured between identical metallic leads to two electrodes of an electrochemical cell</rdfs:comment>
        <rdfs:comment xml:lang="en">voltage between the terminals of an electrochemical cell</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">CellVoltage</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#EMMO_17b031fb_4695_49b6_bb69_189ec63df3ee"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#EMMO_4f2d3939_91b1_4001_b8ab_7d19074bf845"/>
        <skos:altLabel xml:lang="en">AppliedPotential</skos:altLabel>
        <skos:hiddenLabel xml:lang="en">Ecell/V</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Voltage/V</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Volts</skos:hiddenLabel>
        <skos:note xml:lang="en">Cell voltage fluctuates based on factors such as applied current, internal resistance, temperature, and composition.</skos:note>
        <skos:prefLabel xml:lang="en">CellVoltage</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Cell voltage represents the instantaneous electrical potential difference between the positive and negative electrodes of an electrochemical cell. It is a key parameter for monitoring battery performance, estimating state-of-charge, and diagnosing potential failures.</skos:scopeNote>
        <ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=114-03-10</ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">voltage between the terminals of an electrochemical cell</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 xml:lang="en">https://doi.org/10.1351/goldbook.A00424</ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>
        <electrochemistry_097ea615_c209_4edd_a1a1_5eea71d98fe8 xml:lang="en">volts</electrochemistry_097ea615_c209_4edd_a1a1_5eea71d98fe8>
        <electrochemistry_1b717a20_17e3_4480_8c60_c4ae94058f05 xml:lang="en">Voltage (V)</electrochemistry_1b717a20_17e3_4480_8c60_c4ae94058f05>
        <electrochemistry_69022178_77b8_4669_97e2_351d45356e5a xml:lang="en">Ecell/V</electrochemistry_69022178_77b8_4669_97e2_351d45356e5a>
        <electrochemistry_811aafc3_0c6d_470e_b67e_ff5c82992609 xml:lang="en">Voltage(V)</electrochemistry_811aafc3_0c6d_470e_b67e_ff5c82992609>
        <electrochemistry_8377c1f7_2b09_4632_9a4d_bb318438adbb xml:lang="en">cell_voltage_v</electrochemistry_8377c1f7_2b09_4632_9a4d_bb318438adbb>
        <electrochemistry_a07dd85b_d0df_4d5d_8b0c_14d20ea3fe45 xml:lang="en">voltage</electrochemistry_a07dd85b_d0df_4d5d_8b0c_14d20ea3fe45>
        <electrochemistry_ea9f4dba_8ca2_419e_9cdf_ce54e9ebbd46 xml:lang="en">Potential (V)</electrochemistry_ea9f4dba_8ca2_419e_9cdf_ce54e9ebbd46>
    </owl:Class>
