    <!-- https://w3id.org/emmo#EMMO_70bbb94e_2ca7_4d73_ba01_6397f134d172 -->

    <owl:Class rdf:about="https://w3id.org/emmo#EMMO_70bbb94e_2ca7_4d73_ba01_6397f134d172">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_057e7d57_aff0_49de_911a_8861d85cef40"/>
        <rdfs:comment xml:lang="en">A symbolic data is a data that is rooted on some specified symbolic based encoding, such as floating point numbers, strings, integer. When a symbolic data is used for expressing numerical data (e.g., integer), it is not to be intended as a mathematical entity (even if it may be interpreted as such) but as a syntactic structure (datastructures or datatypes) based on concatenated tokens (or symbols, letters) that can deliver data.</rdfs:comment>
        <rdfs:comment xml:lang="en">The class for entities which stands for a specific data format expressed using a symbolic encoding.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
        <rdfs:label xml:lang="en">SymbolicData</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.w3.org/TR/2012/REC-xmlschema11-2-20120405/#built-in-datatypes</rdfs:seeAlso>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.w3.org/TR/rdf11-concepts/</rdfs:seeAlso>
        <rdfs:seeAlso>https://www.w3.org/TR/2012/REC-owl2-syntax-20121211/#Datatype_Maps</rdfs:seeAlso>
        <rdfs:seeAlso>https://www.w3schools.com/xml/schema_dtypes_numeric.asp</rdfs:seeAlso>
        <skos:altLabel>LiteralData</skos:altLabel>
        <skos:prefLabel xml:lang="en">SymbolicData</skos:prefLabel>
        <ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">A symbolic data is a data that is rooted on some specified symbolic based encoding, such as floating point numbers, strings, integer. When a symbolic data is used for expressing numerical data (e.g., integer), it is not to be intended as a mathematical entity (even if it may be interpreted as such) but as a syntactic structure (datastructures or datatypes) based on concatenated tokens (or symbols, letters) that can deliver data.</ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
        <ns1:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>DisjointUnionOf: ArrayData, ScalarData</ns1:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The class for entities which stands for a specific data format expressed using a symbolic encoding.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
