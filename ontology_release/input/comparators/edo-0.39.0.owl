        <skos:altLabel xml:lang="en">RecoveredCapacity</skos:altLabel>
        <skos:note xml:lang="en">defined in IEC 61960-3, 3.1 as charge (capacity) recovery; together with charge retention it separates reversible self-discharge from permanent capacity loss</skos:note>
        <skos:prefLabel xml:lang="en">ChargeRecovery</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">the ratio of the capacity that a cell can deliver after storage followed by a recharge to a stated reference capacity, commonly expressed as a percentage</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_02aefb7a_d6ce_4b6e_b854_f7b3d641f670 -->

