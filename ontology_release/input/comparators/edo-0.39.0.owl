    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_964cd426_f3cf_4a52_8c5d_0490cf48edb5 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_964cd426_f3cf_4a52_8c5d_0490cf48edb5">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9bf40017_3f58_4030_ada7_cb37a3dfda2d"/>
        <rdfs:comment xml:lang="en">The magnitude of the complex impedance of an electrochemical cell at a specified alternating-current frequency, typically 1 kHz.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#"/>
        <rdfs:label xml:lang="en">ACInternalResistance</rdfs:label>
        <skos:altLabel xml:lang="en">ACIR</skos:altLabel>
        <skos:note xml:lang="en">Determined by electrochemical impedance spectroscopy or by a single-frequency AC perturbation technique. Typically reported in milliohms (mΩ).</skos:note>
        <skos:prefLabel xml:lang="en">ACInternalResistance</skos:prefLabel>
        <skos:scopeNote xml:lang="en">At 1 kHz, reactive contributions from double-layer capacitance and Warburg diffusion are suppressed for typical battery geometries, making the result a practical approximation of ohmic resistance.</skos:scopeNote>
        <ns1:EMMO_4c8480cf_56de_41da_8699_f12a9033313a xml:lang="en">The measurement frequency must be stated alongside the value. At frequencies above a few kilohertz, inductive reactance from cell tabs and interconnects can dominate the measured impedance.</ns1:EMMO_4c8480cf_56de_41da_8699_f12a9033313a>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The magnitude of the complex impedance of an electrochemical cell at a specified alternating-current frequency, typically 1 kHz.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_b6730304_cabc_4104_b415_14218466445c xml:lang="en">Characteristically lower than DCInternalResistance because electrochemical kinetic contributions are excluded at the measurement frequency. The two quantities must not be used interchangeably.</ns1:EMMO_b6730304_cabc_4104_b415_14218466445c>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_97bc06e6_6141_47ec_9e81_fd9e6a5b07c7 -->

