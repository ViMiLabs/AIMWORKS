            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An equation with variables can always be represented as:

f(v0, v1, ..., vn) = g(v0, v1, ..., vn)

where f is the left hand and g the right hand  side expressions and v0, v1, ..., vn are the variables.</rdfs:comment>
        <rdfs:comment xml:lang="en">The class of &apos;mathematical&apos;-s that stand for a statement of equality between two mathematical expressions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/reference/electrochemistry-reference#"/>
        <rdfs:label xml:lang="en">Equation</rdfs:label>
        <skos:example xml:lang="en">2+3 = 5
x^2 +3x  = 5x
dv/dt = a
sin(x) = y</skos:example>
        <skos:prefLabel xml:lang="en">Equation</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The class of &apos;mathematical&apos;-s that stand for a statement of equality between two mathematical expressions.</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
