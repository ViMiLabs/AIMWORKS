    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_0508a114_544a_4f54_a7de_9b947fb4b618 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_0508a114_544a_4f54_a7de_9b947fb4b618">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_fb0d9eef_92af_4628_8814_e065ca255d59"/>
        <rdfs:comment xml:lang="en">a solid electrolyte is a solid material where the predominant charge carriers are ions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/reference/electrochemistry-reference#"/>
        <rdfs:label xml:lang="en">SolidElectrolyte</rdfs:label>
        <skos:altLabel xml:lang="en">FastIonConductor</skos:altLabel>
        <skos:altLabel xml:lang="en">SolidStateElectrolyte</skos:altLabel>
        <skos:example xml:lang="en">NASICON (Na Super Ionic Conductor), which has the general formula Na1+xZr2P3-xSix O12 , 0 &lt; x &lt; 3.</skos:example>
        <skos:prefLabel xml:lang="en">SolidElectrolyte</skos:prefLabel>
        <ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 xml:lang="en">a solid electrolyte is a solid material where the predominant charge carriers are ions.</ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84>
        <ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d xml:lang="en">https://en.wikipedia.org/wiki/Fast_ion_conductor</ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_0508a114_544a_4f54_a7de_9b947fb4b618"/>
        <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84"/>
        <owl:annotatedTarget xml:lang="en">a solid electrolyte is a solid material where the predominant charge carriers are ions.</owl:annotatedTarget>
        <dcterms:source>J. M. Pingarron et al., Terminology of electrochemical methods of analysis (IUPAC Recommendations 2019), Pure and Applied Chemistry, 4, 92, 2020, 641-694. https://doi.org/10.1515/pac-2018-0109</dcterms:source>
    </owl:Axiom>
    


    <!-- https://w3id.org/emmo/domain/electrochemistry#electrochemistry_057bb143_639c_472b_99ed_ffa1867f6e63 -->

    <owl:Class rdf:about="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_057bb143_639c_472b_99ed_ffa1867f6e63">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_a0a619d7_da95_41f0_8bc3_9c19d636d543"/>
        <rdfs:comment xml:lang="en">electrode made of glassy carbon material with an intertwined graphitic ribbon structure, formed by pyrolysis of a resol precursor at temperatures up to 3000 °C</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/reference/electrochemistry-reference#"/>
        <rdfs:label xml:lang="en">GlassyCarbonElectrode</rdfs:label>
        <skos:altLabel xml:lang="en">GCE</skos:altLabel>
        <skos:prefLabel xml:lang="en">GlassyCarbonElectrode</skos:prefLabel>
        <ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">electrode made of glassy carbon material with an intertwined graphitic ribbon structure, formed by pyrolysis of a resol precursor at temperatures up to 3000 °C</ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">extremely resistant to many chemicals, impermeable to gases and liquids, and has good electrical conductivity, high hardness and strength, and biocompatibility</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">glassy carbon combines glass-like mechanical characteristics with physical properties similar to graphite, owing to its “graphene ribbon” structure</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">one of the most frequently used working electrodes</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_057bb143_639c_472b_99ed_ffa1867f6e63"/>
        <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <owl:annotatedTarget xml:lang="en">electrode made of glassy carbon material with an intertwined graphitic ribbon structure, formed by pyrolysis of a resol precursor at temperatures up to 3000 °C</owl:annotatedTarget>
        <dcterms:source>J. M. Pingarron et al., Terminology of electrochemical methods of analysis (IUPAC Recommendations 2019), Pure and Applied Chemistry, 4, 92, 2020, 641-694. https://doi.org/10.1515/pac-2018-0109</dcterms:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_057bb143_639c_472b_99ed_ffa1867f6e63"/>
        <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <owl:annotatedTarget xml:lang="en">extremely resistant to many chemicals, impermeable to gases and liquids, and has good electrical conductivity, high hardness and strength, and biocompatibility</owl:annotatedTarget>
        <dcterms:source>J. M. Pingarron et al., Terminology of electrochemical methods of analysis (IUPAC Recommendations 2019), Pure and Applied Chemistry, 4, 92, 2020, 641-694. https://doi.org/10.1515/pac-2018-0109</dcterms:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_057bb143_639c_472b_99ed_ffa1867f6e63"/>
        <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <owl:annotatedTarget xml:lang="en">glassy carbon combines glass-like mechanical characteristics with physical properties similar to graphite, owing to its “graphene ribbon” structure</owl:annotatedTarget>
        <dcterms:source>J. M. Pingarron et al., Terminology of electrochemical methods of analysis (IUPAC Recommendations 2019), Pure and Applied Chemistry, 4, 92, 2020, 641-694. https://doi.org/10.1515/pac-2018-0109</dcterms:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_057bb143_639c_472b_99ed_ffa1867f6e63"/>
        <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <owl:annotatedTarget xml:lang="en">one of the most frequently used working electrodes</owl:annotatedTarget>
        <dcterms:source>J. M. Pingarron et al., Terminology of electrochemical methods of analysis (IUPAC Recommendations 2019), Pure and Applied Chemistry, 4, 92, 2020, 641-694. https://doi.org/10.1515/pac-2018-0109</dcterms:source>
    </owl:Axiom>
    


