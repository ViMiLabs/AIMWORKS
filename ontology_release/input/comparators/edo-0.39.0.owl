                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_8189b42e_0995_423a_a26c_51168b27c3cf"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Farad Per Meter (F/m) is a unit in the category of Electric permittivity. It is also known as farad/meter. This unit is commonly used in the SI unit system. Farad Per Meter has a dimension of M-1L-3T4I2 where M is mass, L is length, T is time, and I is electric current. This unit is the standard SI unit in this category.

-- QUDT</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/coherentsiunits#"/>
        <rdfs:isDefinedBy>http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">FaradPerMetre</rdfs:label>
        <skos:altLabel xml:lang="en">Farad per Metre</skos:altLabel>
        <skos:prefLabel xml:lang="en">FaradPerMetre</skos:prefLabel>
        <ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>http://qudt.org/vocab/unit/FARAD-PER-M</ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
