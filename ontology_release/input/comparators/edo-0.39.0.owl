        <ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The EMMO adheres to Atomistic General Extensional Mereology (AGEM).</ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    </owl:ObjectProperty>
